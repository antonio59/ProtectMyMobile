# Cache rules for static assets only. Security headers for ALL responses
# (assets + SSR) are set centrally in src/worker.ts — edit them there.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og-image.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/*.svg
  Cache-Control: public, max-age=604800

/Scenarios/*
  Cache-Control: public, max-age=604800
