{
  "$schema": "https://docs.fallow.tools/schemas/fallowrc.json",
  "entry": ["src/**/*.{ts,tsx,astro}", "convex/**/*.ts", "netlify/functions/**/*.{ts,mts}", "scripts/**/*.{ts,mjs}", "astro.config.mjs"],
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".astro/**",
    "convex/_generated/**",
    "src/styles/design-tokens*.json",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "**/__tests__/**",
    "**/__mocks__/**",
    "public/**",
    "scripts/convert-og-image.mjs"
  ],
  "ignoreDependencies": [
    "@astrojs/netlify",
    "@astrojs/react",
    "@astrojs/sitemap",
    "@sentry/astro",
    "@resvg/resvg-js",
    "@tailwindcss/typography",
    "chart.js",
    "lightningcss-linux-x64-gnu",
    "marked",
    "nanostores",
    "rss-parser"
  ],
  "duplicates": {
    "threshold": 0,
    "mode": "mild",
    "ignoreImports": true
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30
  }
}
