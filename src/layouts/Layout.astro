---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  schema?: object | object[];
}

const siteUrl = "https://protectmymobile.xyz";
const defaultDescription = "A phone is stolen in London every five minutes. ProtectMyMobile tracks live police.uk theft data and gives you prevention checklists, security checkups, and a step-by-step emergency guide if yours is taken.";
const { 
  title, 
  description = defaultDescription,
  canonicalPath = "",
  ogImage = "/og-image.png",
  ogType = "website",
  publishedTime,
  modifiedTime,
  schema
} = Astro.props;

const canonicalUrl = `${siteUrl}${canonicalPath}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Default Organization schema
const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "ProtectMyMobile",
  "url": siteUrl,
  "logo": `${siteUrl}/logo-icon.png`,
  "description": "UK phone theft prevention and recovery: live police.uk theft data, prevention checklists, and a step-by-step emergency guide.",
  "areaServed": {
    "@type": "Country",
    "name": "United Kingdom"
  },
  "sameAs": []
};

// WebSite schema for search box
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "ProtectMyMobile",
  "url": siteUrl,
  "description": description,
  "publisher": {
    "@type": "Organization",
    "name": "ProtectMyMobile"
  }
};

const additionalSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const schemas = [defaultSchema, websiteSchema, ...additionalSchemas];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1" />
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="mobile theft UK, phone security, UK mobile providers, prevent phone theft, report stolen phone, secure banking apps, mobile security guide, phone stolen london, phone stolen UK, london travel safety, tourist safety london, visiting london phone theft, london trip security" />
    <meta name="author" content="ProtectMyMobile" />
    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="GB" />
    <meta name="geo.placename" content="United Kingdom" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ProtectMyMobile — a phone is stolen in London every five minutes. UK phone theft prevention and recovery guide." />
    <!-- Square variant for platforms that crop to 1:1 (WhatsApp, Instagram DMs, feed previews) -->
    <meta property="og:image" content={`${siteUrl}/og-image-square.png`} />
    <meta property="og:image:width" content="1080" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content="ProtectMyMobile — a phone is stolen in London every five minutes. UK phone theft prevention and recovery guide." />
    <meta property="og:site_name" content="ProtectMyMobile" />
    <meta property="og:locale" content="en_GB" />
    
    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="ProtectMyMobile — a phone is stolen in London every five minutes. UK phone theft prevention and recovery guide." />
    {ogType === "article" && publishedTime && (
      <>
        <meta property="article:published_time" content={publishedTime} />
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
        <meta property="article:author" content="ProtectMyMobile" />
        <meta property="article:publisher" content="ProtectMyMobile" />
      </>
    )}
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="ProtectMyMobile News" href="/rss.xml" />

    <!-- Hreflang Tags for UK English content -->
    <link rel="alternate" hreflang="en-GB" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Schema.org JSON-LD -->
    {schemas.map((s) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />
    ))}
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#16130f" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="ProtectMyMobile" />
    <link rel="apple-touch-icon" href="/logo-icon.png" />

    <!-- Theme — default to light, respect saved preference only -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        }
        // Default is light — no class needed
      })();
    </script>
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,700&family=Archivo:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,700&family=Archivo:wght@400;500;600;700&display=swap" /></noscript>
    
    <!-- Initialize Convex URL for analytics -->
    <script is:inline define:vars={{ convexUrl: import.meta.env.PUBLIC_CONVEX_URL || '' }}>
      window.__CONVEX_URL = convexUrl;
    </script>
  </head>
  <body class="bg-background text-foreground">
    <slot />

    <!-- Cookie Consent Banner -->
    <CookieConsent />

    {/* Mobile Floating Action Button - appears after scroll */}
    <a
      href="/emergency"
      id="mobile-fab"
      class="fixed bottom-6 right-6 z-50 md:hidden bg-destructive text-destructive-foreground rounded-full px-4 py-3 shadow-xl shadow-red-600/30 flex items-center gap-2 font-semibold text-sm translate-y-24 opacity-0 transition-all duration-300 hover:scale-105 active:scale-95"
      aria-label="Emergency - Phone stolen?"
    >
      <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
      <span>Phone Stolen?</span>
    </a>

    <script is:inline>
      (function() {
        const fab = document.getElementById('mobile-fab');
        if (!fab) return;
        let shown = false;
        function onScroll() {
          if (window.scrollY > 300 && !shown) {
            fab.classList.remove('translate-y-24', 'opacity-0');
            shown = true;
          } else if (window.scrollY <= 100 && shown) {
            fab.classList.add('translate-y-24', 'opacity-0');
            shown = false;
          }
        }
        window.addEventListener('scroll', onScroll, { passive: true });
      })();
    </script>
  </body>
</html>
