---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  schema?: object | object[];
}

const siteUrl = "https://protectmymobile.xyz";
const { 
  title, 
  description = "ProtectMyMobile helps UK residents and visitors secure their mobile phones, provides step-by-step guidance if your phone is stolen, and offers comprehensive mobile security resources for London and UK travel.",
  canonicalPath = "",
  ogImage = "/og-image.png",
  schema
} = Astro.props;

const canonicalUrl = `${siteUrl}${canonicalPath}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Default Organization schema
const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "ProtectMyMobile",
  "url": siteUrl,
  "logo": `${siteUrl}/favicon.svg`,
  "description": "UK and London travel resource for mobile phone theft prevention and recovery",
  "areaServed": {
    "@type": "Country",
    "name": "United Kingdom"
  },
  "sameAs": []
};

// WebSite schema for search box
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "ProtectMyMobile",
  "url": siteUrl,
  "description": description,
  "publisher": {
    "@type": "Organization",
    "name": "ProtectMyMobile"
  }
};

const additionalSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const schemas = [defaultSchema, websiteSchema, ...additionalSchemas];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="mobile theft UK, phone security, UK mobile providers, prevent phone theft, report stolen phone, secure banking apps, mobile security guide, phone stolen london, phone stolen UK, london travel safety, tourist safety london, visiting london phone theft, london trip security" />
    <meta name="author" content="ProtectMyMobile" />
    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="GB" />
    <meta name="geo.placename" content="United Kingdom" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="ProtectMyMobile" />
    <meta property="og:locale" content="en_GB" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@protectmymobile" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="ProtectMyMobile News" href="/rss.xml" />

    <!-- Hreflang Tags for UK English content -->
    <link rel="alternate" hreflang="en-GB" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    
    <!-- Schema.org JSON-LD -->
    {schemas.map((s) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />
    ))}
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563eb" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="ProtectMyMobile" />
    <link rel="apple-touch-icon" href="/logo-icon.png" />
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" /></noscript>
    
    <!-- Umami Analytics -->
    <script defer is:inline src="https://umami.antoniosmith.xyz/script.js" data-website-id="54c6cb37-d0a6-475a-959b-07d04ba34920"></script>

    <!-- Initialize Convex URL for analytics -->
    <script is:inline define:vars={{ convexUrl: import.meta.env.PUBLIC_CONVEX_URL || '' }}>
      window.__CONVEX_URL = convexUrl;
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
