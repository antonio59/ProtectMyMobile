---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { Mail, Send, User, FileText } from 'lucide-react';
import { PRESS_EMAIL, FOI_FROM_EMAIL } from '../lib/mail';
---

<Layout 
  title="Contact | Antonio Smith | ProtectMyMobile"
  description="Get in touch about mobile theft data, media inquiries, corrections, or feedback about ProtectMyMobile."
>
  <HeaderMobile client:idle />
  
  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-4xl">

      <div class="bg-foreground text-background rounded-xl sm:rounded-2xl p-5 sm:p-6 md:p-8 mb-6 sm:mb-8">
        <div class="flex items-center gap-3 mb-3">
          <div class="bg-background/20 p-2.5 rounded-xl">
            <Mail aria-hidden="true" className="size-6" />
          </div>
          <h1 class="text-xl sm:text-2xl font-bold">Get in Touch</h1>
        </div>
        <p class="text-neutral-300 text-sm">
          Questions, corrections, media inquiries, or feedback: I read everything.
          Press: <a href={`mailto:${PRESS_EMAIL}`} class="underline underline-offset-2">{PRESS_EMAIL}</a>.
          FOI: <a href={`mailto:${FOI_FROM_EMAIL}`} class="underline underline-offset-2">{FOI_FROM_EMAIL}</a>.
        </p>
      </div>

      <div class="bg-card rounded-xl sm:rounded-2xl border border-border p-5 sm:p-6 md:p-8">
        <form id="contact-form" class="space-y-5" novalidate>
          <div>
            <label for="name" class="block text-sm font-semibold text-foreground mb-1.5">
              Your Name
            </label>
            <div class="relative">
              <User aria-hidden="true" className="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-muted-foreground" />
              <input
                type="text"
                id="name"
                name="name"
                required
                aria-describedby="name-error"
                class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-border bg-background text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/30"
                placeholder="Jane Smith"
              />
            </div>
            <p id="name-error" class="hidden mt-1.5 text-xs font-medium text-destructive"></p>
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-foreground mb-1.5">
              Email Address
            </label>
            <div class="relative">
              <Mail aria-hidden="true" className="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-muted-foreground" />
              <input
                type="email"
                id="email"
                name="email"
                required
                aria-describedby="email-error"
                class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-border bg-background text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/30"
                placeholder="jane@example.com"
              />
            </div>
            <p id="email-error" class="hidden mt-1.5 text-xs font-medium text-destructive"></p>
          </div>

          <div>
            <label for="subject" class="block text-sm font-semibold text-foreground mb-1.5">
              Subject
            </label>
            <div class="relative">
              <FileText aria-hidden="true" className="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-muted-foreground" />
              <input
                type="text"
                id="subject"
                name="subject"
                required
                aria-describedby="subject-error"
                class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-border bg-background text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/30"
                placeholder="Data correction, media inquiry, etc."
              />
            </div>
            <p id="subject-error" class="hidden mt-1.5 text-xs font-medium text-destructive"></p>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-foreground mb-1.5">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              aria-describedby="message-error"
              class="w-full px-4 py-2.5 rounded-lg border border-border bg-background text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition resize-y aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/30"
              placeholder="Tell me what's on your mind..."
            ></textarea>
            <p id="message-error" class="hidden mt-1.5 text-xs font-medium text-destructive"></p>
          </div>

          <!-- Spam trap: off-screen for sighted users, ignored by assistive tech,
               skipped by keyboard tab order. A real person never fills this in. -->
          <div class="sr-only" aria-hidden="true">
            <label for="website">Leave this field empty</label>
            <input
              type="text"
              id="website"
              name="website"
              tabindex="-1"
              autocomplete="off"
              value=""
            />
          </div>
          <input type="hidden" id="form-rendered-at" name="renderedAt" value="" />

          <button 
            type="submit" 
            id="submit-btn"
            class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-6 py-2.5 bg-primary text-primary-foreground rounded-lg font-semibold text-sm hover:bg-primary-hover transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <Send aria-hidden="true" className="size-4" />
            Send Message
          </button>

          <div id="form-status" class="hidden text-sm" role="status" aria-live="polite"></div>
        </form>
      </div>

      <div class="mt-6 sm:mt-8 text-center">
        <p class="text-xs text-muted-foreground">
          I respond to most messages within a few days. For urgent phone theft help, go to the <a href="/emergency" class="text-primary hover:underline">emergency guide</a>.
        </p>
      </div>

    </div>
  </main>
  
  <Footer />

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const status = document.getElementById('form-status') as HTMLDivElement;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    const honeypot = document.getElementById('website') as HTMLInputElement;
    const renderedAt = document.getElementById('form-rendered-at') as HTMLInputElement;

    // Stamp the moment the form became usable, so the API can reject
    // submissions that arrive impossibly fast.
    renderedAt.value = String(Date.now());

    const fields: { id: string; validate: (v: string) => string }[] = [
      { id: 'name', validate: (v) => (v.trim() ? '' : 'Please enter your name.') },
      { id: 'email', validate: (v) => (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) ? '' : 'Please enter a valid email address.') },
      { id: 'subject', validate: (v) => (v.trim() ? '' : 'Please enter a subject.') },
      { id: 'message', validate: (v) => (!v.trim() ? 'Please enter a message.' : v.length > 5000 ? 'Please keep your message under 5,000 characters.' : '') },
    ];

    function setFieldError(id: string, msg: string) {
      const input = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement;
      const err = document.getElementById(`${id}-error`) as HTMLParagraphElement;
      if (msg) {
        input.setAttribute('aria-invalid', 'true');
        err.textContent = msg;
        err.classList.remove('hidden');
      } else {
        input.removeAttribute('aria-invalid');
        err.textContent = '';
        err.classList.add('hidden');
      }
    }

    fields.forEach(({ id }) => {
      document.getElementById(id)?.addEventListener('input', () => setFieldError(id, ''));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.className = 'hidden text-sm';

      let firstInvalid: string | null = null;
      for (const { id, validate } of fields) {
        const input = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement;
        const msg = validate(input.value);
        setFieldError(id, msg);
        if (msg && !firstInvalid) firstInvalid = id;
      }
      if (firstInvalid) {
        document.getElementById(firstInvalid)?.focus();
        return;
      }

      btn.disabled = true;
      btn.innerHTML = '<span class="animate-spin size-4 border-2 border-white/30 border-t-white rounded-full"></span> Sending...';

      try {
        const res = await fetch('/api/contact/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: (document.getElementById('name') as HTMLInputElement).value,
            email: (document.getElementById('email') as HTMLInputElement).value,
            subject: (document.getElementById('subject') as HTMLInputElement).value,
            message: (document.getElementById('message') as HTMLTextAreaElement).value,
            website: honeypot.value,
            renderedAt: Number(renderedAt.value) || 0,
          }),
        });

        const data = await res.json();

        if (data.success) {
          status.className = 'bg-neutral-100 border border-border text-foreground rounded-lg p-3 text-sm';
          status.textContent = 'Message sent! I\'ll get back to you soon.';
          form.reset();
        } else {
          status.className = 'bg-warning-subtle border border-border text-warning rounded-lg p-3 text-sm';
          status.textContent = data.error || 'Something went wrong. Please try again.';
          if (/email/i.test(data.error || '')) setFieldError('email', data.error);
          else if (/too long|5,?000/i.test(data.error || '')) setFieldError('message', data.error);
        }
      } catch {
        status.className = 'bg-warning-subtle border border-border text-warning rounded-lg p-3 text-sm';
        status.textContent = 'Network error. Please check your connection and try again.';
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg> Send Message';
      }
    });
  </script>
</Layout>
