---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { Shield, IdCard, Fingerprint, Lock, ShieldCheck, AlertCircle, ArrowRight, CheckCircle2, Hash } from "lucide-react";
---

<Layout 
  title="Prevention Guides - Secure Your Mobile | ProtectMyMobile"
  description="Learn how to secure your mobile device with PIN locks, biometric security, and app-specific protection to prevent theft."
>
  <HeaderMobile client:load />
  
  <main class="bg-[#f3f2f1] min-h-screen">
    <div class="container mx-auto px-4 py-6 max-w-6xl">
      <!-- Hero Section -->
      <div class="bg-gradient-to-br from-primary to-blue-700 text-white rounded-2xl p-6 md:p-10 mb-8 shadow-xl">
        <div class="flex items-center gap-3 mb-3">
          <div class="bg-white/20 p-3 rounded-xl">
            <Shield class="h-8 w-8" />
          </div>
          <h1 class="text-2xl md:text-3xl font-bold">Prevention Guides</h1>
        </div>
        <p class="text-blue-100 text-sm md:text-base mb-6">
          Take these preventative measures to secure your phone and minimise risk in case of theft.
        </p>
        <a href="/security-checkup" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white text-primary rounded-xl font-semibold text-sm hover:bg-blue-50 transition-colors shadow-lg">
          <ShieldCheck class="h-4 w-4" />
          Take Security Checkup
          <ArrowRight class="h-4 w-4" />
        </a>
      </div>

      <!-- Essential Security Measures -->
      <section class="mb-10">
        <h2 class="text-xl md:text-2xl font-bold mb-6 flex items-center gap-2">
          <CheckCircle2 class="h-6 w-6 text-primary" />
          Essential Security Measures
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Secure SIM Card -->
          <div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-neutral-100">
            <div class="h-2 bg-gradient-to-r from-primary to-blue-600"></div>
            <div class="p-6">
              <div class="flex items-center gap-3 mb-4">
                <div class="bg-primary/10 rounded-xl p-3">
                  <IdCard class="h-6 w-6 text-primary" />
                </div>
                <h3 class="text-lg font-bold">Secure Your SIM</h3>
              </div>
              <p class="text-neutral-600 text-sm mb-4">
                Set a PIN for your SIM card to prevent unauthorised use if stolen.
              </p>
              <ol class="list-decimal pl-5 text-neutral-700 space-y-1 text-sm mb-4">
                <li>Go to Settings → Security</li>
                <li>Find "SIM card lock"</li>
                <li>Enable and set a unique PIN</li>
                <li>Store PIN securely offline</li>
              </ol>
              <div class="p-3 bg-yellow-50 border border-yellow-200 rounded-xl text-xs">
                <p class="text-yellow-800"><strong>Note:</strong> You'll need this PIN when restarting your phone.</p>
              </div>
            </div>
          </div>
          
          <!-- Biometric Authentication -->
          <div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-neutral-100">
            <div class="h-2 bg-gradient-to-r from-green-500 to-emerald-600"></div>
            <div class="p-6">
              <div class="flex items-center gap-3 mb-4">
                <div class="bg-green-100 rounded-xl p-3">
                  <Fingerprint class="h-6 w-6 text-green-600" />
                </div>
                <h3 class="text-lg font-bold">Biometric Auth</h3>
              </div>
              <p class="text-neutral-600 text-sm mb-4">
                Set up fingerprint or face recognition alongside a strong passcode.
              </p>
              <ol class="list-decimal pl-5 text-neutral-700 space-y-1 text-sm">
                <li>Go to Settings → Security</li>
                <li>Select Face ID or Fingerprint</li>
                <li>Register your biometrics</li>
                <li>Set 6+ digit backup passcode</li>
              </ol>
            </div>
          </div>
          
          <!-- App-Specific Security -->
          <div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-neutral-100">
            <div class="h-2 bg-gradient-to-r from-orange-500 to-red-500"></div>
            <div class="p-6">
              <div class="flex items-center gap-3 mb-4">
                <div class="bg-orange-100 rounded-xl p-3">
                  <Lock class="h-6 w-6 text-orange-600" />
                </div>
                <h3 class="text-lg font-bold">App Security</h3>
              </div>
              <p class="text-neutral-600 text-sm mb-4">
                Enable additional security for banking and payment apps.
              </p>
              <ol class="list-decimal pl-5 text-neutral-700 space-y-1 text-sm">
                <li>Open banking app settings</li>
                <li>Enable app-specific PIN</li>
                <li>Turn on 2FA if available</li>
                <li>Enable login notifications</li>
              </ol>
            </div>
          </div>
        </div>
      </section>
      
      <!-- IMEI Information -->
      <section class="mb-10">
        <div class="bg-white rounded-2xl shadow-md overflow-hidden border border-neutral-100">
          <div class="h-2 bg-gradient-to-r from-teal-500 to-cyan-500"></div>
          <div class="p-6 md:p-8">
            <div class="flex items-center gap-3 mb-4">
              <div class="bg-teal-100 rounded-xl p-3">
                <Hash class="h-6 w-6 text-teal-600" />
              </div>
              <h3 class="text-xl font-bold">Know Your IMEI Number</h3>
            </div>
            
            <p class="text-neutral-700 mb-6">
              Your IMEI is your phone's unique 15-digit identifier. You'll need this to report theft to police and your network.
            </p>
            
            <div class="grid md:grid-cols-2 gap-6">
              <div class="p-4 bg-blue-50 border border-blue-200 rounded-xl">
                <h4 class="font-semibold text-blue-900 mb-3">How to find your IMEI:</h4>
                <ul class="space-y-2 text-sm text-blue-800">
                  <li class="flex items-start gap-2">
                    <CheckCircle2 class="h-4 w-4 mt-0.5 flex-shrink-0" />
                    <span>Dial <code class="bg-blue-100 px-2 py-0.5 rounded font-mono">*#06#</code></span>
                  </li>
                  <li class="flex items-start gap-2">
                    <CheckCircle2 class="h-4 w-4 mt-0.5 flex-shrink-0" />
                    <span>Settings → About Phone → IMEI</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <CheckCircle2 class="h-4 w-4 mt-0.5 flex-shrink-0" />
                    <span>Check original phone box</span>
                  </li>
                </ul>
              </div>
              
              <div class="p-4 bg-neutral-100 rounded-xl">
                <h4 class="font-semibold text-neutral-900 mb-3">Where to store it safely:</h4>
                <ul class="space-y-2 text-sm text-neutral-700">
                  <li class="flex items-start gap-2">
                    <CheckCircle2 class="h-4 w-4 mt-0.5 flex-shrink-0 text-green-600" />
                    <span>Password manager (most secure)</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <CheckCircle2 class="h-4 w-4 mt-0.5 flex-shrink-0 text-green-600" />
                    <span>Email to yourself</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <CheckCircle2 class="h-4 w-4 mt-0.5 flex-shrink-0 text-green-600" />
                    <span>Written down at home</span>
                  </li>
                </ul>
              </div>
            </div>
            
            <div class="mt-6 p-4 bg-green-50 border border-green-200 rounded-xl flex items-start gap-3">
              <ShieldCheck class="h-5 w-5 text-green-600 mt-0.5 flex-shrink-0" />
              <div>
                <p class="font-medium text-green-800">We protect your privacy</p>
                <p class="text-green-700 text-sm">We never ask for or store your IMEI. Keep it private and secure.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="bg-gradient-to-r from-primary/10 to-blue-100 rounded-2xl p-6 md:p-8 border border-primary/20">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div>
            <h3 class="text-xl font-bold mb-2">How secure is your phone?</h3>
            <p class="text-neutral-700">Complete our quick assessment to identify security gaps.</p>
          </div>
          <a href="/security-checkup" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary text-white rounded-xl font-semibold hover:bg-primary/90 transition-colors shadow-lg">
            Start Security Checkup
            <ArrowRight class="h-4 w-4" />
          </a>
        </div>
      </section>
    </div>
  </main>
  
  <Footer />
</Layout>
