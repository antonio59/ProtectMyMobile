---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { Shield, IdCard, Fingerprint, Lock, ShieldCheck, ArrowRight, AlertTriangle, CheckCircle2, Hash, CloudUpload } from "lucide-react";
---

<Layout
  title="How To Prevent Phone Theft UK | Mobile Security Guide"
  description="Protect your phone from theft in London and UK. Expert tips on PIN locks, biometric security, device backups, tracking apps, and street-smart habits to keep your device safe."
  canonicalPath="/prevention"
  schema={[
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "How To Prevent Phone Theft in the UK",
      "description": "Complete guide to protecting your mobile phone from theft in the UK with security settings, tracking apps, and street-smart habits.",
      "author": { "@type": "Organization", "name": "ProtectMyMobile" },
      "publisher": { "@type": "Organization", "name": "ProtectMyMobile" }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How can I prevent my phone from being stolen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To prevent phone theft, enable strong security measures: set a SIM card PIN to prevent unauthorised use, use biometric authentication (fingerprint or face ID) alongside a 6+ digit passcode, enable app-specific security for banking apps with additional PINs and 2FA, and know your IMEI number by dialling *#06#. Keep your phone secure by being aware of your surroundings, especially in crowded areas."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best way to secure my phone in London?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The best way to secure your phone in London is to use multiple layers of security: enable SIM card lock from Settings > Security, set up biometric authentication with a strong backup passcode, secure your banking and payment apps with app-specific PINs, and store your IMEI number safely in a password manager. Be especially vigilant in busy areas like the London Underground, tourist attractions, and crowded streets."
          }
        },
        {
          "@type": "Question",
          "name": "Should I use a phone lanyard to prevent theft?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Phone lanyards can be helpful for preventing accidental drops and keeping your phone accessible, but they should be used alongside proper security measures. Enable SIM card locks, biometric security, and app-specific passwords. Be aware that lanyards alone won't prevent theft if someone forcibly grabs your phone. The most effective prevention combines physical awareness with strong digital security settings."
          }
        },
        {
          "@type": "Question",
          "name": "How do thieves steal phones on the tube?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Thieves on the London Underground typically use distraction techniques and target people using their phones near doors. Common methods include snatching phones as train doors close, targeting passengers who are distracted or have phones visible in pockets, and working in teams to create diversions. Protect yourself by keeping your phone secured when not in use, being extra vigilant near doors, and avoiding displaying expensive devices. If you must use your phone, position yourself away from the doors. If someone does grab it, let it go rather than be pulled after the phone or onto the platform: a phone is replaceable."
          }
        }
      ]
    }
  ]}
>
  <HeaderMobile client:idle />
  
  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-6xl">
      <!-- Hero Section -->
      <div class="bg-foreground text-background rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-10 lg:p-12 mb-6 sm:mb-8 md:mb-10">
        <div class="flex items-center gap-2 sm:gap-3 mb-3">
          <div class="bg-background/20 p-2 sm:p-3 rounded-xl">
            <Shield className="size-6 sm:size-8" />
          </div>
          <h1 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold">Prevention Guides</h1>
        </div>
        <p class="text-background/85 text-xs sm:text-sm md:text-base mb-4 sm:mb-6">
          Take these preventative measures to secure your phone and minimise risk in case of theft.
        </p>
        <div class="flex flex-col sm:flex-row gap-2 sm:gap-3">
          <a href="/security-checkup" class="inline-flex items-center justify-center gap-2 px-3 sm:px-4 py-2 sm:py-2.5 bg-card text-primary rounded-xl font-semibold text-xs sm:text-sm hover:bg-primary-subtle transition-colors">
            <ShieldCheck className="size-4" />
            Take Security Checkup
            <ArrowRight className="size-4" />
          </a>
          <a href="/emergency" class="inline-flex items-center justify-center gap-2 px-3 sm:px-4 py-2 sm:py-2.5 bg-destructive text-destructive-foreground rounded-xl font-semibold text-xs sm:text-sm hover:bg-destructive-hover transition-colors">
            <AlertTriangle className="size-4" />
            Already stolen? Emergency steps
            <ArrowRight className="size-4" />
          </a>
        </div>
      </div>

      <!-- Focused guides -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <h2 class="text-xl sm:text-2xl md:text-3xl font-bold mb-4 sm:mb-6">Focused guides</h2>
        <a href="/guides/charger-photo-alert" class="block bg-card rounded-xl sm:rounded-2xl transition-all duration-300 overflow-hidden border border-border group">
          <div class="h-1 bg-foreground"></div>
          <div class="p-4 sm:p-6 flex items-start gap-3 sm:gap-4">
            <div class="bg-neutral-100 rounded-xl p-2 sm:p-3 group-hover:scale-110 transition-transform">
              <Shield className="size-6 sm:size-8 text-foreground" />
            </div>
            <div class="flex-1">
              <h3 class="text-sm sm:text-base font-semibold mb-1 group-hover:text-primary transition-colors">Charger photo alert</h3>
              <p class="text-muted-foreground text-xs sm:text-sm md:text-base">
                If a stolen phone is plugged in to charge, a user-built shortcut can email you a front-camera photo and a location. iPhone and Android walkthrough — not a stock Apple or Google theft mode.
              </p>
            </div>
            <ArrowRight className="size-5 text-neutral-400 group-hover:text-primary group-hover:translate-x-1 transition-all flex-shrink-0 mt-1" />
          </div>
        </a>
      </section>

      <!-- Essential Security Measures -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <h2 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold mb-4 sm:mb-6 flex items-center gap-2">
          <CheckCircle2 className="size-6 sm:size-8 text-primary" />
          Essential Security Measures
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 md:gap-6">
          <!-- Secure SIM Card -->
          <div class="bg-card rounded-xl sm:rounded-2xl transition-all duration-300 overflow-hidden border border-border">
            <div class="h-1 bg-foreground"></div>
            <div class="p-4 sm:p-6">
              <div class="flex items-center gap-2 sm:gap-3 mb-3 sm:mb-4">
                <div class="bg-neutral-100 rounded-xl p-2 sm:p-3">
                  <IdCard className="size-6 sm:size-8 text-foreground" />
                </div>
                <h3 class="text-sm sm:text-base font-semibold">Secure Your SIM</h3>
              </div>
              <p class="text-muted-foreground text-xs sm:text-sm md:text-base mb-3 sm:mb-4">
                Set a PIN for your SIM card to prevent unauthorised use if stolen.
              </p>
              <ol class="list-decimal pl-5 text-foreground space-y-1 text-xs sm:text-sm md:text-base mb-3 sm:mb-4">
                <li>Go to Settings → Security</li>
                <li>Find "SIM card lock"</li>
                <li>Enable and set a unique PIN</li>
                <li>Store PIN securely offline</li>
              </ol>
              <div class="p-2 sm:p-3 bg-neutral-100 border border-border rounded-xl text-xs">
                <p class="text-foreground"><strong>Note:</strong> You'll need this PIN when restarting your phone.</p>
              </div>
            </div>
          </div>
          
          <!-- Biometric Authentication -->
          <div class="bg-card rounded-xl sm:rounded-2xl transition-all duration-300 overflow-hidden border border-border">
            <div class="h-1 bg-foreground"></div>
            <div class="p-4 sm:p-6">
              <div class="flex items-center gap-2 sm:gap-3 mb-3 sm:mb-4">
                <div class="bg-neutral-100 rounded-xl p-2 sm:p-3">
                  <Fingerprint className="size-6 sm:size-8 text-foreground" />
                </div>
                <h3 class="text-sm sm:text-base font-semibold">Biometric Auth</h3>
              </div>
              <p class="text-muted-foreground text-xs sm:text-sm md:text-base mb-3 sm:mb-4">
                Set up fingerprint or face recognition alongside a strong passcode.
              </p>
              <ol class="list-decimal pl-5 text-foreground space-y-1 text-xs sm:text-sm md:text-base">
                <li>Go to Settings → Security</li>
                <li>Select Face ID or Fingerprint</li>
                <li>Register your biometrics</li>
                <li>Set 6+ digit backup passcode</li>
              </ol>
            </div>
          </div>
          
          <!-- App-Specific Security -->
          <div class="bg-card rounded-xl sm:rounded-2xl transition-all duration-300 overflow-hidden border border-border">
            <div class="h-1 bg-foreground"></div>
            <div class="p-4 sm:p-6">
              <div class="flex items-center gap-2 sm:gap-3 mb-3 sm:mb-4">
                <div class="bg-neutral-100 rounded-xl p-2 sm:p-3">
                  <Lock className="size-6 sm:size-8 text-foreground" />
                </div>
                <h3 class="text-sm sm:text-base font-semibold">App Security</h3>
              </div>
              <p class="text-muted-foreground text-xs sm:text-sm md:text-base mb-3 sm:mb-4">
                Enable additional security for banking and payment apps.
              </p>
              <ol class="list-decimal pl-5 text-foreground space-y-1 text-xs sm:text-sm md:text-base">
                <li>Open banking app settings</li>
                <li>Enable app-specific PIN</li>
                <li>Turn on 2FA if available</li>
                <li>Enable login notifications</li>
              </ol>
            </div>
          </div>
        </div>
      </section>
      
      <!-- IMEI Information -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl overflow-hidden border border-border">
          <div class="h-1 bg-foreground"></div>
          <div class="p-4 sm:p-6 md:p-10 lg:p-12">
            <div class="flex items-center gap-2 sm:gap-3 mb-3 sm:mb-4">
              <div class="bg-neutral-100 rounded-xl p-2 sm:p-3">
                <Hash className="size-6 sm:size-8 text-foreground" />
              </div>
              <h3 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold">Know Your IMEI Number</h3>
            </div>

            <p class="text-foreground text-xs sm:text-sm md:text-base mb-4 sm:mb-6">
              Your IMEI is your phone's unique 15-digit identifier. You'll need this to report theft to police and your network.
            </p>

            <div class="grid md:grid-cols-2 gap-3 sm:gap-4 md:gap-6">
              <div class="p-4 sm:p-6 bg-primary-subtle border border-border rounded-xl sm:rounded-2xl">
                <h4 class="font-semibold text-primary mb-2 sm:mb-3 text-sm sm:text-base">How to find your IMEI:</h4>
                <ul class="space-y-2 text-xs sm:text-sm md:text-base text-primary">
                  <li class="flex items-start gap-2">
                    <CheckCircle2 className="size-4 mt-0.5 flex-shrink-0" />
                    <span>Dial <code class="bg-primary-muted px-2 py-0.5 rounded font-mono">*#06#</code></span>
                  </li>
                  <li class="flex items-start gap-2">
                    <CheckCircle2 className="size-4 mt-0.5 flex-shrink-0" />
                    <span>Settings → About Phone → IMEI</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <CheckCircle2 className="size-4 mt-0.5 flex-shrink-0" />
                    <span>Check original phone box</span>
                  </li>
                </ul>
              </div>

              <div class="p-4 sm:p-6 bg-neutral-100 rounded-xl sm:rounded-2xl">
                <h4 class="font-semibold text-foreground mb-2 sm:mb-3 text-sm sm:text-base">Where to store it safely:</h4>
                <ul class="space-y-2 text-xs sm:text-sm md:text-base text-foreground">
                  <li class="flex items-start gap-2">
                    <CheckCircle2 className="size-4 mt-0.5 flex-shrink-0 text-foreground" />
                    <span>Password manager (most secure)</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <CheckCircle2 className="size-4 mt-0.5 flex-shrink-0 text-foreground" />
                    <span>Written down at home</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <CheckCircle2 className="size-4 mt-0.5 flex-shrink-0 text-foreground" />
                    <span>Email to yourself &mdash; the least secure option, because anyone who gets into your inbox gets your IMEI. Use it only if you have nothing else.</span>
                  </li>
                </ul>
              </div>
            </div>

            <div class="mt-4 sm:mt-6 p-4 sm:p-6 bg-neutral-100 border border-border rounded-xl sm:rounded-2xl flex items-start gap-2 sm:gap-3">
              <ShieldCheck className="size-5 text-foreground mt-0.5 flex-shrink-0" />
              <div>
                <p class="font-medium text-foreground text-xs sm:text-sm md:text-base">We protect your privacy</p>
                <p class="text-foreground text-xs sm:text-sm">We never ask for or store your IMEI. Keep it private and secure.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Device Backups -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl overflow-hidden border border-border">
          <div class="h-1 bg-foreground"></div>
          <div class="p-4 sm:p-6 md:p-10 lg:p-12">
            <div class="flex items-center gap-2 sm:gap-3 mb-3 sm:mb-4">
              <div class="bg-neutral-100 rounded-xl p-2 sm:p-3">
                <CloudUpload className="size-6 sm:size-8 text-foreground" />
              </div>
              <h3 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold">Back Up Your Device</h3>
            </div>

            <p class="text-foreground text-xs sm:text-sm md:text-base mb-4 sm:mb-6">
              If your phone is stolen, the handset is replaceable but your photos, messages, and contacts may not be. An automatic cloud backup turns a theft into an inconvenience instead of a loss, and lets you restore everything to a replacement device in one step.
            </p>

            <div class="grid md:grid-cols-2 gap-3 sm:gap-4 md:gap-6">
              <div class="p-4 sm:p-6 bg-primary-subtle border border-border rounded-xl sm:rounded-2xl">
                <h4 class="font-semibold text-primary mb-2 sm:mb-3 text-sm sm:text-base">iPhone (iCloud Backup):</h4>
                <ol class="list-decimal pl-5 space-y-1 text-xs sm:text-sm md:text-base text-primary">
                  <li>Settings → your name → iCloud</li>
                  <li>Tap iCloud Backup → turn it on</li>
                  <li>Check "Last successful backup" is recent</li>
                  <li>Free tier is 5 GB; photos may need iCloud+ or Google Photos</li>
                </ol>
              </div>

              <div class="p-4 sm:p-6 bg-primary-subtle border border-border rounded-xl sm:rounded-2xl">
                <h4 class="font-semibold text-primary mb-2 sm:mb-3 text-sm sm:text-base">Android (Google backup):</h4>
                <ol class="list-decimal pl-5 space-y-1 text-xs sm:text-sm md:text-base text-primary">
                  <li>Settings → Google → Backup</li>
                  <li>Turn on "Backup by Google One"</li>
                  <li>Check the last backup date shown</li>
                  <li>Free tier is 15 GB, shared with Gmail and Drive</li>
                </ol>
              </div>
            </div>

            <div class="mt-4 sm:mt-6 p-4 sm:p-6 bg-neutral-100 border border-border rounded-xl sm:rounded-2xl flex items-start gap-2 sm:gap-3">
              <ShieldCheck className="size-5 text-foreground mt-0.5 flex-shrink-0" />
              <div>
                <p class="font-medium text-foreground text-xs sm:text-sm md:text-base">Test it before you need it</p>
                <p class="text-foreground text-xs sm:text-sm">Once a month, open your backup settings and confirm the last backup date. A backup that silently failed months ago is the most common reason victims lose everything.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="bg-foreground text-background rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-10 lg:p-12">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 sm:gap-4">
          <div>
            <h3 class="text-lg sm:text-xl md:text-2xl font-bold mb-2">How secure is your phone?</h3>
            <p class="text-neutral-400 text-xs sm:text-sm md:text-base">Complete our quick assessment to identify security gaps.</p>
            <p class="text-neutral-400 text-xs sm:text-sm md:text-base mt-2">If your phone has already been taken, go straight to the <a href="/emergency" class="underline underline-offset-2 font-semibold text-background hover:text-neutral-300 transition-colors">emergency guide</a>.</p>
          </div>
          <a href="/security-checkup" class="inline-flex items-center justify-center gap-2 px-3 sm:px-4 py-2 sm:py-2.5 bg-background text-foreground rounded-xl font-semibold text-xs sm:text-sm hover:bg-neutral-100 transition-colors whitespace-nowrap">
            Start Security Checkup
            <ArrowRight className="size-4" />
          </a>
        </div>
      </section>
    </div>
  </main>
  
  <Footer />
</Layout>
