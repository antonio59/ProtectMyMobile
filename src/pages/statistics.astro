---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import StatisticsDashboard from '../components/StatisticsDashboard';
import { getTheftStats } from '../lib/convexData';
import { BarChart3, TrendingUp, MapPin, AlertTriangle, Clock, Shield, ArrowRight, Calendar, Sun, Snowflake, Leaf } from 'lucide-react';

const statisticsSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "UK Mobile Phone Theft Statistics",
  "description": "Comprehensive data on mobile phone thefts across UK cities including London, Manchester, Birmingham. Live data from police.uk API.",
  "keywords": ["phone theft statistics UK", "London phone theft", "mobile crime UK", "snatch theft data"],
  "creator": { "@type": "Organization", "name": "ProtectMyMobile" },
  "temporalCoverage": "2017/2026",
  "spatialCoverage": { "@type": "Place", "name": "United Kingdom" },
  "url": "https://protectmymobile.xyz/statistics"
};

// Try to fetch live data from Convex
let liveStats = null;
let hasLiveData = false;
let lastUpdatedText = '';
try {
  liveStats = await getTheftStats();
  if (liveStats && liveStats.totalRecords > 0) {
    hasLiveData = true;
    if (liveStats.dateRange.latest) {
      const d = new Date(liveStats.dateRange.latest);
      lastUpdatedText = d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
    }
  }
} catch (e) {
  console.warn('Could not fetch live stats, using baseline data');
}

// Top 5 London hotspots
const londonHotspots = [
  { rank: 1, area: 'Westminster', thefts: '34,000+', description: 'Tourist areas, West End, transport hubs' },
  { rank: 2, area: 'Camden', thefts: '8,500+', description: 'Markets, nightlife, busy high streets' },
  { rank: 3, area: 'Tower Hamlets', thefts: '6,200+', description: 'Shoreditch, Brick Lane, City fringe' },
  { rank: 4, area: 'Hackney', thefts: '5,800+', description: 'Nightlife spots, busy cafes' },
  { rank: 5, area: 'Southwark', thefts: '4,900+', description: 'Borough Market, London Bridge' },
];

// City comparison data
const cityComparison = [
  { city: 'London', thefts: 116656, year: '2024', change: '+50% since 2017' },
  { city: 'Manchester', thefts: 12370, year: '2024', change: '+31%' },
  { city: 'Birmingham', thefts: 10408, year: '2024', change: '+25%' },
  { city: 'Leeds', thefts: 7165, year: '2024', change: '+28%' },
  { city: 'Liverpool', thefts: 5370, year: '2024', change: '+23%' },
];

const keyStats = [
  { value: '78,000', label: 'Snatch thefts UK (2024)', icon: AlertTriangle, color: 'red' },
  { value: '116,000+', label: 'London alone (2024)', icon: MapPin, color: 'orange' },
  { value: '150%', label: 'Increase since 2023', icon: TrendingUp, color: 'yellow' },
  { value: '0.8%', label: 'Result in charges', icon: Shield, color: 'teal' },
];
---

<Layout
  title="UK Phone Theft Statistics | Live Data, London Crime Hotspots & Trends"
  description="78,000+ phones stolen in UK. See live theft trends, London hotspots, borough data, seasonal patterns. Updated monthly from police.uk data."
  canonicalPath="/statistics"
  schema={statisticsSchema}
>
  <HeaderMobile client:idle />

  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-6xl">
      

      <!-- Hero Section -->
      <div class="bg-gradient-to-br from-purple-600 to-indigo-700 text-white rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-10 mb-6 sm:mb-8 shadow-xl">
        <div class="flex items-center gap-3 mb-3">
          <div class="bg-white/20 p-2 sm:p-3 rounded-xl">
            <BarChart3 class="size-6 sm:size-8" />
          </div>
          <h1 class="text-xl sm:text-2xl md:text-3xl font-bold">UK Mobile Theft Statistics</h1>
        </div>
        <p class="text-purple-100 text-xs sm:text-sm md:text-base mb-6">
          Real data on where, when, and how often phones are stolen across the UK.
          {hasLiveData ? ' Live data from police.uk, updated weekly.' : ' Based on Met Police, ONS, and Home Office data.'}
        </p>
        {lastUpdatedText && (
          <div class="inline-flex items-center gap-2 bg-white/10 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm mb-6">
            <svg class="size-4 text-green-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Data updated: {lastUpdatedText}</span>
          </div>
        )}

        <!-- Key Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-2 sm:gap-3">
          {keyStats.map((stat) => (
            <div class="bg-white/10 rounded-xl p-3 sm:p-4 text-center">
              <div class="text-xl sm:text-2xl md:text-3xl font-bold">{stat.value}</div>
              <div class="text-xs text-purple-200 mt-1">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Live Statistics Dashboard (from Convex) -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl shadow-md overflow-hidden border border-border">
          <div class="h-2 bg-gradient-to-r from-blue-500 to-indigo-500"></div>
          <div class="p-4 sm:p-6 md:p-8">
            <StatisticsDashboard client:visible />
          </div>
        </div>
      </section>

      <!-- London Hotspots -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl shadow-md overflow-hidden border border-border">
          <div class="h-2 bg-gradient-to-r from-red-500 to-orange-500"></div>
          <div class="p-4 sm:p-6 md:p-8">
            <div class="flex items-center gap-3 mb-2">
              <MapPin class="size-6 sm:size-8 text-red-500" />
              <h2 class="text-lg sm:text-xl font-bold">London Theft Hotspots</h2>
            </div>
            <p class="text-muted-foreground text-xs sm:text-sm md:text-base mb-6">
              London accounts for 75% of all UK phone thefts. These are the worst-affected boroughs.
              Westminster alone sees more thefts than any other city in the UK.
            </p>

            <div class="space-y-3">
              {londonHotspots.map((spot) => (
                <div class="flex items-center gap-3 sm:gap-4 p-3 sm:p-4 bg-neutral rounded-xl">
                  <span class={`size-6 sm:size-8 rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0 ${spot.rank === 1 ? 'bg-red-500 text-white' : spot.rank <= 3 ? 'bg-orange-500 text-white' : 'bg-neutral-300 text-foreground'}`}>
                    {spot.rank}
                  </span>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-baseline gap-2">
                      <h3 class="font-bold text-foreground text-xs sm:text-sm md:text-base">{spot.area}</h3>
                      <span class="text-destructive font-semibold text-xs sm:text-sm">{spot.thefts}</span>
                    </div>
                    <p class="text-xs text-muted-foreground truncate">{spot.description}</p>
                  </div>
                </div>
              ))}
            </div>

            <p class="text-xs text-muted-foreground mt-4">
              Source: Metropolitan Police & police.uk recorded crime data (2024–2025)
            </p>
          </div>
        </div>
      </section>

      <!-- City Comparison -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl shadow-md overflow-hidden border border-border">
          <div class="h-2 bg-gradient-to-r from-purple-500 to-indigo-500"></div>
          <div class="p-4 sm:p-6 md:p-8">
            <div class="flex items-center gap-3 mb-2">
              <BarChart3 class="size-6 sm:size-8 text-purple-500" />
              <h2 class="text-lg sm:text-xl font-bold">Major Cities Comparison</h2>
            </div>
            <p class="text-muted-foreground text-xs sm:text-sm md:text-base mb-6">
              Annual mobile phone theft figures by city. London dominates, but theft is rising across all major UK cities.
            </p>

            <div class="space-y-4">
              {cityComparison.map((city, i) => {
                const maxThefts = cityComparison[0].thefts;
                const width = (city.thefts / maxThefts) * 100;
                return (
                  <div>
                    <div class="flex items-center justify-between mb-2">
                      <div class="flex items-center gap-2 sm:gap-3">
                        <span class="font-bold text-foreground text-xs sm:text-sm md:text-base">{city.city}</span>
                        <span class="text-xs text-muted-foreground">({city.year})</span>
                      </div>
                      <div class="text-right">
                        <span class="font-bold text-foreground text-xs sm:text-sm md:text-base">{city.thefts.toLocaleString()}</span>
                        <span class="text-xs text-destructive ml-1 sm:ml-2">{city.change}</span>
                      </div>
                    </div>
                    <div class="w-full bg-neutral-100 rounded-full h-3 sm:h-4 md:h-5 overflow-hidden">
                      <div
                        class={`h-3 sm:h-4 md:h-5 rounded-full ${i === 0 ? 'bg-gradient-to-r from-red-500 to-red-600' : 'bg-gradient-to-r from-blue-400 to-blue-500'}`}
                        style={`width: ${width}%`}
                      ></div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </section>

      <!-- Time of Day Analysis -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl shadow-md overflow-hidden border border-border">
          <div class="h-2 bg-gradient-to-r from-orange-500 to-yellow-500"></div>
          <div class="p-4 sm:p-6 md:p-8">
            <div class="flex items-center gap-3 mb-2">
              <Clock class="size-6 sm:size-8 text-orange-500" />
              <h2 class="text-lg sm:text-xl font-bold">When Do Thefts Happen?</h2>
            </div>
            <p class="text-muted-foreground text-xs sm:text-sm md:text-base mb-6">
              Time-of-day breakdown showing peak risk periods. Knowing when you're most vulnerable helps you stay alert.
            </p>

            <div class="space-y-5">
              <div role="img" aria-label="Evening Rush 5pm to 7pm: 32% of thefts, Highest Risk">
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center justify-center size-6 bg-destructive-muted rounded-full" aria-hidden="true">
                      <svg class="size-4 text-destructive" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                    </span>
                    <span class="font-bold text-foreground text-xs sm:text-sm md:text-base">Evening Rush</span>
                    <span class="text-xs sm:text-sm text-muted-foreground">5pm - 7pm</span>
                  </div>
                  <span class="text-lg sm:text-xl font-bold text-destructive">32%</span>
                </div>
                <div class="w-full bg-neutral-100 rounded-full h-3 sm:h-4 md:h-5 overflow-hidden">
                  <div class="bg-gradient-to-r from-red-500 to-red-600 h-3 sm:h-4 md:h-5 rounded-full flex items-center justify-end pr-2" style="width: 100%">
                    <span class="text-white text-xs font-bold hidden sm:inline">Highest Risk</span>
                  </div>
                </div>
              </div>

              <div role="img" aria-label="Late Night 10pm to 2am: 28% of thefts, High Risk">
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center justify-center size-6 bg-orange-100 rounded-full" aria-hidden="true">
                      <svg class="size-4 text-orange-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                    </span>
                    <span class="font-bold text-foreground text-xs sm:text-sm md:text-base">Late Night</span>
                    <span class="text-xs sm:text-sm text-muted-foreground">10pm - 2am</span>
                  </div>
                  <span class="text-lg sm:text-xl font-bold text-orange-600">28%</span>
                </div>
                <div class="w-full bg-neutral-100 rounded-full h-3 sm:h-4 md:h-5 overflow-hidden">
                  <div class="bg-gradient-to-r from-orange-500 to-orange-600 h-3 sm:h-4 md:h-5 rounded-full" style="width: 87.5%"></div>
                </div>
              </div>

              <div role="img" aria-label="Morning Rush 7am to 9am: 18% of thefts, Moderate Risk">
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center justify-center size-6 bg-yellow-100 rounded-full" aria-hidden="true">
                      <svg class="size-4 text-yellow-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                    </span>
                    <span class="font-bold text-foreground text-xs sm:text-sm md:text-base">Morning Rush</span>
                    <span class="text-xs sm:text-sm text-muted-foreground">7am - 9am</span>
                  </div>
                  <span class="text-lg sm:text-xl font-bold text-yellow-600">18%</span>
                </div>
                <div class="w-full bg-neutral-100 rounded-full h-3 sm:h-4 md:h-5 overflow-hidden">
                  <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 h-3 sm:h-4 md:h-5 rounded-full" style="width: 56%"></div>
                </div>
              </div>

              <div role="img" aria-label="Afternoon 12pm to 5pm: 15% of thefts, Lower Risk">
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center justify-center size-6 bg-primary-muted rounded-full" aria-hidden="true">
                      <svg class="size-4 text-primary" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                    </span>
                    <span class="font-bold text-foreground text-xs sm:text-sm md:text-base">Afternoon</span>
                    <span class="text-xs sm:text-sm text-muted-foreground">12pm - 5pm</span>
                  </div>
                  <span class="text-lg sm:text-xl font-bold text-primary">15%</span>
                </div>
                <div class="w-full bg-neutral-100 rounded-full h-3 sm:h-4 md:h-5 overflow-hidden">
                  <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-3 sm:h-4 md:h-5 rounded-full" style="width: 47%"></div>
                </div>
              </div>

              <div role="img" aria-label="Other Times 2am to 7am and 9am to 12pm: 7% of thefts, Lowest Risk">
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center justify-center size-6 bg-neutral-100 rounded-full" aria-hidden="true">
                      <svg class="size-4 text-muted-foreground" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                    </span>
                    <span class="font-bold text-foreground text-xs sm:text-sm md:text-base">Other Times</span>
                    <span class="text-xs sm:text-sm text-muted-foreground">2am - 7am, 9am - 12pm</span>
                  </div>
                  <span class="text-lg sm:text-xl font-bold text-muted-foreground">7%</span>
                </div>
                <div class="w-full bg-neutral-100 rounded-full h-3 sm:h-4 md:h-5 overflow-hidden">
                  <div class="bg-neutral-400 h-3 sm:h-4 md:h-5 rounded-full" style="width: 22%"></div>
                </div>
              </div>
            </div>

            <div class="mt-6 p-4 bg-yellow-50 border border-yellow-200 rounded-xl">
              <p class="text-xs sm:text-sm text-yellow-800">
                <strong>Stay Alert:</strong> Be extra vigilant during evening rush hour and late at night. Keep devices secure and be aware of your surroundings.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Seasonal Patterns -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl shadow-md overflow-hidden border border-border">
          <div class="h-2 bg-gradient-to-r from-green-500 to-teal-500"></div>
          <div class="p-4 sm:p-6 md:p-8">
            <div class="flex items-center gap-3 mb-2">
              <Calendar class="size-6 sm:size-8 text-green-500" />
              <h2 class="text-lg sm:text-xl font-bold">Seasonal Patterns</h2>
            </div>
            <p class="text-muted-foreground text-xs sm:text-sm md:text-base mb-6">
              How theft rates change throughout the year. Understanding seasonal patterns helps you prepare.
            </p>

            <div class="grid md:grid-cols-3 gap-3 sm:gap-4 md:gap-6">
              <div class="bg-orange-50 border border-orange-200 rounded-xl p-4 sm:p-5">
                <div class="flex items-center gap-2 mb-3">
                  <Sun class="size-5 text-orange-500" />
                  <h3 class="font-bold text-foreground text-xs sm:text-sm md:text-base">Summer Spike</h3>
                </div>
                <p class="text-xs sm:text-sm text-foreground mb-2">
                  <strong>June - August:</strong> Thefts rise 25-30%
                </p>
                <p class="text-xs text-muted-foreground">
                  Outdoor dining, festivals, and tourists with phones out create more opportunities. "Table surfing" peaks.
                </p>
              </div>

              <div class="bg-destructive-subtle border border-red-200 rounded-xl p-4 sm:p-5">
                <div class="flex items-center gap-2 mb-3">
                  <Snowflake class="size-5 text-red-500" />
                  <h3 class="font-bold text-foreground text-xs sm:text-sm md:text-base">December Danger</h3>
                </div>
                <p class="text-xs sm:text-sm text-foreground mb-2">
                  <strong>December:</strong> Secondary peak (+20%)
                </p>
                <p class="text-xs text-muted-foreground">
                  Christmas shopping crowds, holiday parties, and reduced awareness due to alcohol consumption.
                </p>
              </div>

              <div class="bg-primary-subtle border border-blue-200 rounded-xl p-4 sm:p-5">
                <div class="flex items-center gap-2 mb-3">
                  <Leaf class="size-5 text-blue-500" />
                  <h3 class="font-bold text-foreground text-xs sm:text-sm md:text-base">Winter Lull</h3>
                </div>
                <p class="text-xs sm:text-sm text-foreground mb-2">
                  <strong>January - February:</strong> Lowest rates
                </p>
                <p class="text-xs text-muted-foreground">
                  Fewer people outdoors, darker evenings keep people home, reduced social activity post-holidays.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Why It Matters + What To Do -->
      <section class="grid md:grid-cols-2 gap-3 sm:gap-4 md:gap-6 mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl shadow-md p-4 sm:p-6 border border-border">
          <h3 class="text-lg sm:text-xl font-bold mb-4">Why These Numbers Matter</h3>
          <div class="space-y-3 text-xs sm:text-sm md:text-base text-foreground">
            <p>
              <strong>Beyond the device:</strong> Victims face identity theft, financial fraud, loss of irreplaceable photos, and emotional distress.
            </p>
            <p>
              <strong>Recovery is rare:</strong> Less than 5% of stolen phones are recovered. Prevention is crucial.
            </p>
            <p>
              <strong>Growing problem:</strong> The 150% year-on-year increase shows this is an escalating crisis requiring better awareness.
            </p>
          </div>
        </div>

        <div class="bg-card rounded-xl sm:rounded-2xl shadow-md p-4 sm:p-6 border border-border">
          <h3 class="text-lg sm:text-xl font-bold mb-4">Protect Yourself</h3>
          <div class="space-y-3">
            <a href="/prevention" class="flex items-center justify-between p-2.5 sm:p-3 bg-primary/5 border border-primary/20 rounded-xl hover:bg-primary/10 transition-colors">
              <div>
                <div class="font-semibold text-primary text-xs sm:text-sm md:text-base">Prevention Guide</div>
                <div class="text-xs text-muted-foreground">Security tips before theft occurs</div>
              </div>
              <ArrowRight class="size-5 text-primary flex-shrink-0" />
            </a>
            <a href="/emergency" class="flex items-center justify-between p-2.5 sm:p-3 bg-destructive-subtle border border-red-200 rounded-xl hover:bg-destructive-muted transition-colors">
              <div>
                <div class="font-semibold text-destructive-hover text-xs sm:text-sm md:text-base">Emergency Steps</div>
                <div class="text-xs text-muted-foreground">What to do if stolen</div>
              </div>
              <ArrowRight class="size-5 text-destructive flex-shrink-0" />
            </a>
            <a href="/products" class="flex items-center justify-between p-2.5 sm:p-3 bg-teal-50 border border-teal-200 rounded-xl hover:bg-teal-100 transition-colors">
              <div>
                <div class="font-semibold text-teal-700 text-xs sm:text-sm md:text-base">Protection Products</div>
                <div class="text-xs text-muted-foreground">Lanyards, bags, trackers & more</div>
              </div>
              <ArrowRight class="size-5 text-teal-600 flex-shrink-0" />
            </a>
          </div>
        </div>
      </section>

      <!-- Data Sources -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl shadow-md p-4 sm:p-6 border border-border">
          <h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3">Data Sources</h3>
          <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs text-muted-foreground">
            <div class="flex items-start gap-2">
              <Shield class="size-4 text-muted-foreground mt-0.5 flex-shrink-0" />
              <span>Police.uk API - Official recorded crime data, updated monthly</span>
            </div>
            <div class="flex items-start gap-2">
              <BarChart3 class="size-4 text-muted-foreground mt-0.5 flex-shrink-0" />
              <span>ONS Crime Survey - Annual estimates of phone theft prevalence</span>
            </div>
            <div class="flex items-start gap-2">
              <TrendingUp class="size-4 text-muted-foreground mt-0.5 flex-shrink-0" />
              <span>Met Police recorded crime statistics and FOI responses</span>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
