---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import StatisticsDashboard from '../components/StatisticsDashboard';
import { getTheftStats } from '../lib/convexData';
import { londonHotspots, hotspotsSource, hotspotThefts } from '../data/hotspots';
import { BarChart3, TrendingUp, MapPin, AlertTriangle, Shield, ArrowRight } from 'lucide-react';

const statisticsSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "UK Mobile Phone Theft Statistics",
  "description": "Comprehensive data on mobile phone thefts across UK cities including London, Manchester, Birmingham. Live data from police.uk API.",
  "keywords": ["phone theft statistics UK", "London phone theft", "mobile crime UK", "snatch theft data"],
  "creator": { "@type": "Organization", "name": "ProtectMyMobile" },
  "temporalCoverage": "2017/2026",
  "spatialCoverage": { "@type": "Place", "name": "United Kingdom" },
  "url": "https://protectmymobile.xyz/statistics"
};

// Try to fetch live data from Convex
let liveStats = null;
let hasLiveData = false;
let lastUpdatedText = '';
try {
  liveStats = await getTheftStats();
  if (liveStats && liveStats.totalRecords > 0) {
    hasLiveData = true;
    if (liveStats.dateRange.latest) {
      const d = new Date(liveStats.dateRange.latest);
      lastUpdatedText = d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
    }
  }
} catch (e) {
  console.warn('Could not fetch live stats, using baseline data');
}

// Top 5 London hotspots, from the shared dataset in src/data/hotspots.ts.
const topHotspots = londonHotspots.slice(0, 5);

// City comparison: theft-from-the-person offences recorded within roughly 1 mile
// of each city centre, July 2025 - June 2026 (latest police.uk data), with
// year-on-year change vs July 2024 - June 2025. Greater Manchester Police does
// not currently publish street-level data to police.uk, so Manchester is excluded.
const cityComparison = [
  { city: 'London (Westminster area)', thefts: hotspotThefts('Westminster'), year: 'Jul 2025 - Jun 2026', change: '-40.9% YoY' },
  { city: 'Camden (London)', thefts: hotspotThefts('Camden'), year: 'Jul 2025 - Jun 2026', change: '-28.7% YoY' },
  { city: 'Hackney (London)', thefts: hotspotThefts('Hackney'), year: 'Jul 2025 - Jun 2026', change: '-1.8% YoY' },
  { city: 'Tower Hamlets (London)', thefts: hotspotThefts('Tower Hamlets'), year: 'Jul 2025 - Jun 2026', change: '-18.4% YoY' },
  { city: 'Leeds', thefts: 528, year: 'Jul 2025 - Jun 2026', change: '-11.9% YoY' },
  { city: 'Birmingham', thefts: 436, year: 'Jul 2025 - Jun 2026', change: '-21.3% YoY' },
  { city: 'Liverpool', thefts: 376, year: 'Jul 2025 - Jun 2026', change: '-21.5% YoY' },
  { city: 'Brighton', thefts: 308, year: 'Jul 2025 - Jun 2026', change: '-23.2% YoY' },
  { city: 'Bristol', thefts: 282, year: 'Jul 2025 - Jun 2026', change: '+46.1% YoY' },
];

const keyStats = [
  { value: '78,000', label: 'Snatch thefts UK (CSEW, YE Mar 2024)', icon: AlertTriangle },
  { value: '117,211', label: 'London (2024, Met FOI)', icon: MapPin },
  { value: '−12.3%', label: 'Fall in London 2025 (Met)', icon: TrendingUp },
  { value: '248', label: 'Arrests in 4-week blitz (2026)', icon: Shield },
];

// Phones recorded stolen in London, calendar years 2019-2024: Met Police FOI
// disclosure (June 2025) - count of all offences in which a mobile phone was stolen.
// 2025: Met headline series (theft-from-person + robbery where a phone was stolen),
// announced Feb 2026 - counted differently, shown hatched.
const yearlyTrend = [
  { year: 2019, thefts: 91481, comparable: true },
  { year: 2020, thefts: 55820, comparable: true },
  { year: 2021, thefts: 63777, comparable: true },
  { year: 2022, thefts: 90810, comparable: true },
  { year: 2023, thefts: 115261, comparable: true },
  { year: 2024, thefts: 117211, comparable: true },
  { year: 2025, thefts: 71391, comparable: false },
];
const maxYearlyThefts = Math.max(...yearlyTrend.map((y) => y.thefts));
---

<Layout
  title="UK Phone Theft Statistics | Live Data, London Crime Hotspots & Trends"
  description="117,211 phones were stolen in London in 2024; thefts fell 12% in 2025. See live theft trends, London hotspots, borough data and city comparisons. Updated monthly from police.uk data."
  canonicalPath="/statistics"
  schema={statisticsSchema}
>
  <HeaderMobile client:idle />

  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-6xl">
      

      <!-- Hero Section -->
      <div class="bg-foreground text-background rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-10 mb-6 sm:mb-8 ">
        <div class="flex items-center gap-3 mb-3">
          <div class="bg-background/20 p-2 sm:p-3 rounded-xl">
            <BarChart3 className="size-6 sm:size-8" />
          </div>
          <h1 class="text-xl sm:text-2xl md:text-3xl font-bold">UK Mobile Theft Statistics</h1>
        </div>
        <p class="text-neutral-300 text-xs sm:text-sm md:text-base mb-6">
          Real data on where, when, and how often phones are stolen across the UK.
          {hasLiveData ? ' Live data from police.uk, updated weekly.' : ' Based on Met Police, ONS, and Home Office data.'}
        </p>
        {lastUpdatedText && (
          <div class="inline-flex items-center gap-2 bg-background/10 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm mb-6">
            <svg class="size-4 text-background" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Data updated: {lastUpdatedText}</span>
          </div>
        )}

        <!-- Key Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-2 sm:gap-3">
          {keyStats.map((stat) => (
            <div class="bg-background/10 rounded-xl p-3 sm:p-4 text-center">
              <div class="text-xl sm:text-2xl md:text-3xl font-bold tabular-nums">{stat.value}</div>
              <div class="text-xs text-neutral-400 mt-1">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Live Statistics Dashboard (from Convex) -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl  overflow-hidden border border-border">
          <div class="h-1 bg-foreground"></div>
          <div class="p-4 sm:p-6 md:p-8">
            <StatisticsDashboard client:visible />
          </div>
        </div>
      </section>

      <!-- Year-by-Year Trend -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl overflow-hidden border border-border">
          <div class="h-1 bg-foreground"></div>
          <div class="p-4 sm:p-6 md:p-8">
            <div class="flex items-center gap-3 mb-2">
              <TrendingUp className="size-6 sm:size-8 text-destructive" />
              <h2 class="text-lg sm:text-xl font-bold">Phones Stolen in London, Year by Year</h2>
            </div>
            <p class="text-muted-foreground text-xs sm:text-sm md:text-base mb-6">
              Recorded thefts climbed to a record peak in 2024, then fell sharply in 2025 after the Met's largest-ever crackdown.
            </p>

            <div class="flex items-end gap-1.5 sm:gap-3 h-40 sm:h-52 md:h-60" role="img" aria-label="Bar chart of phones recorded stolen in London per year: 91,481 in 2019, 55,820 in 2020, 63,777 in 2021, 90,810 in 2022, 115,261 in 2023, 117,211 in 2024, 71,391 in 2025">
              {yearlyTrend.map((entry) => (
                <div class="flex-1 flex flex-col items-center justify-end gap-1 h-full min-w-0">
                  <span class="text-[9px] sm:text-xs font-semibold text-foreground tabular-nums">
                    {entry.thefts >= 100000 ? `${Math.round(entry.thefts / 1000)}K` : entry.thefts.toLocaleString()}
                  </span>
                  <div
                    class={`w-full rounded-t-md ${entry.comparable ? 'bg-destructive' : 'bg-primary'}`}
                    style={`height: ${Math.max(4, Math.round((entry.thefts / maxYearlyThefts) * 100))}%`}
                  ></div>
                  <span class="text-[9px] sm:text-xs text-muted-foreground">{entry.year}</span>
                </div>
              ))}
            </div>

            <p class="text-xs text-muted-foreground mt-4">
              Source: Metropolitan Police. 2019–2024: FOI disclosure (June 2025), count of all recorded offences in which a mobile phone was stolen.
              2025 (dark bar): Met headline series (theft-from-person and robbery offences involving a phone), announced February 2026 (−12.3% vs 2024);
              counted on a narrower basis, so not directly comparable with earlier years. Jan–May 2026 is running a further 20.6% below the same period in 2025.
            </p>
          </div>
        </div>
      </section>

      <!-- London Hotspots -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl  overflow-hidden border border-border">
          <div class="h-1 bg-foreground"></div>
          <div class="p-4 sm:p-6 md:p-8">
            <div class="flex items-center gap-3 mb-2">
              <MapPin className="size-6 sm:size-8 text-destructive" />
              <h2 class="text-lg sm:text-xl font-bold">London Theft Hotspots</h2>
            </div>
            <p class="text-muted-foreground text-xs sm:text-sm md:text-base mb-6">
              London accounts for around two-thirds of theft-from-the-person offences in England & Wales (ONS). These are the worst-affected boroughs.
              Westminster alone sees more thefts than any other city in the UK.
            </p>

            <div class="space-y-3">
              {topHotspots.map((spot, i) => {
                const rank = i + 1;
                return (
                  <div class="flex items-center gap-3 sm:gap-4 p-3 sm:p-4 bg-neutral rounded-xl">
                    <span class={`size-6 sm:size-8 rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0 tabular-nums ${rank === 1 ? 'bg-destructive text-destructive-foreground' : rank <= 3 ? 'bg-foreground text-background' : 'bg-neutral-300 text-foreground'}`}>
                      {rank}
                    </span>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-baseline gap-2">
                        <h3 class="font-bold text-foreground text-xs sm:text-sm md:text-base">{spot.borough}</h3>
                        <span class="text-destructive font-semibold text-xs sm:text-sm tabular-nums">{spot.thefts.toLocaleString('en-GB')}</span>
                      </div>
                      <p class="text-xs text-muted-foreground truncate">{spot.description}</p>
                    </div>
                  </div>
                );
              })}
            </div>

            <p class="text-xs text-muted-foreground mt-4">
              Source: <a href={hotspotsSource.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">{hotspotsSource.sourceName}</a> (theft from the person within ~1 mile of each borough centre).
            </p>
          </div>
        </div>
      </section>

      <!-- City Comparison -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl  overflow-hidden border border-border">
          <div class="h-1 bg-foreground"></div>
          <div class="p-4 sm:p-6 md:p-8">
            <div class="flex items-center gap-3 mb-2">
              <BarChart3 className="size-6 sm:size-8 text-primary" />
              <h2 class="text-lg sm:text-xl font-bold">Major Cities Comparison</h2>
            </div>
            <p class="text-muted-foreground text-xs sm:text-sm md:text-base mb-6">
              Theft-from-the-person offences recorded within roughly a mile of each city centre, 12 months to June 2026 (police.uk).
              London dominates by an order of magnitude, and most areas are now falling year on year.
            </p>

            <div class="space-y-4">
              {cityComparison.map((city, i) => {
                const maxThefts = cityComparison[0].thefts;
                const width = (city.thefts / maxThefts) * 100;
                return (
                  <div>
                    <div class="flex items-center justify-between mb-2">
                      <div class="flex items-center gap-2 sm:gap-3">
                        <span class="font-bold text-foreground text-xs sm:text-sm md:text-base">{city.city}</span>
                        <span class="text-xs text-muted-foreground">({city.year})</span>
                      </div>
                      <div class="text-right">
                        <span class="font-bold text-foreground text-xs sm:text-sm md:text-base tabular-nums">{city.thefts.toLocaleString()}</span>
                        <span class="text-xs text-destructive ml-1 sm:ml-2">{city.change}</span>
                      </div>
                    </div>
                    <div class="w-full bg-neutral-100 rounded-full h-3 sm:h-4 md:h-5 overflow-hidden">
                      <div
                        class={`h-3 sm:h-4 md:h-5 rounded-full ${i === 0 ? 'bg-destructive' : 'bg-neutral-100'}`}
                        style={`width: ${width}%`}
                      ></div>
                    </div>
                  </div>
                );
              })}
            </div>

            <p class="text-xs text-muted-foreground mt-4">
              Source: <a href={hotspotsSource.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">{hotspotsSource.sourceName}</a>. London borough figures come from the shared hotspot dataset.
            </p>
          </div>
        </div>
      </section>

      <!-- Why It Matters + What To Do -->
      <section class="grid md:grid-cols-2 gap-3 sm:gap-4 md:gap-6 mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl  p-4 sm:p-6 border border-border">
          <h3 class="text-lg sm:text-xl font-bold mb-4">Why These Numbers Matter</h3>
          <div class="space-y-3 text-xs sm:text-sm md:text-base text-foreground">
            <p>
              <strong>Beyond the device:</strong> Victims face identity theft, financial fraud, loss of irreplaceable photos, and emotional distress.
            </p>
            <p>
              <strong>Recovery is rare:</strong> The vast majority of stolen phones are never recovered. Prevention is crucial.
            </p>
            <p>
              <strong>Turning a corner:</strong> After peaking at 117,211 in 2024, Met figures show London phone thefts fell 12.3% in 2025, but levels remain historically high.
            </p>
          </div>
        </div>

        <div class="bg-card rounded-xl sm:rounded-2xl  p-4 sm:p-6 border border-border">
          <h3 class="text-lg sm:text-xl font-bold mb-4">Protect Yourself</h3>
          <div class="space-y-3">
            <a href="/prevention" class="flex items-center justify-between p-2.5 sm:p-3 bg-primary/5 border border-primary/20 rounded-xl hover:bg-primary/10 transition-colors">
              <div>
                <div class="font-semibold text-primary text-xs sm:text-sm md:text-base">Prevention Guide</div>
                <div class="text-xs text-muted-foreground">Security tips before theft occurs</div>
              </div>
              <ArrowRight className="size-5 text-primary flex-shrink-0" />
            </a>
            <a href="/emergency" class="flex items-center justify-between p-2.5 sm:p-3 bg-destructive-subtle border border-destructive-muted rounded-xl hover:bg-destructive-muted transition-colors">
              <div>
                <div class="font-semibold text-destructive-hover text-xs sm:text-sm md:text-base">Emergency Steps</div>
                <div class="text-xs text-muted-foreground">What to do if stolen</div>
              </div>
              <ArrowRight className="size-5 text-destructive flex-shrink-0" />
            </a>
            <a href="/products" class="flex items-center justify-between p-2.5 sm:p-3 bg-neutral-100 border border-border rounded-xl hover:bg-neutral-100 transition-colors">
              <div>
                <div class="font-semibold text-foreground text-xs sm:text-sm md:text-base">Protection Products</div>
                <div class="text-xs text-muted-foreground">Lanyards, bags, trackers & more</div>
              </div>
              <ArrowRight className="size-5 text-foreground flex-shrink-0" />
            </a>
          </div>
        </div>
      </section>

      <!-- Data Sources & Methodology -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl  p-4 sm:p-6 border border-border">
          <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3">Sources &amp; Methodology</h2>
          <div class="grid sm:grid-cols-2 gap-3 text-xs text-muted-foreground mb-4">
            <div class="flex items-start gap-2">
              <Shield className="size-4 text-muted-foreground mt-0.5 flex-shrink-0" />
              <span><a href="https://data.police.uk/docs/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">police.uk API</a> - official street-level recorded crime, updated monthly. City and borough comparisons count theft-from-the-person offences within roughly 1 mile of each centre.</span>
            </div>
            <div class="flex items-start gap-2">
              <BarChart3 className="size-4 text-muted-foreground mt-0.5 flex-shrink-0" />
              <span><a href="https://www.met.police.uk/foi-ai/metropolitan-police/disclosure-2025/june-2025/thefts-mobile-phone-january2019-march2025/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Met Police FOI disclosure (June 2025)</a> - phones recorded stolen in London, 2019 to March 2025. This series counts every offence type in which a phone was stolen.</span>
            </div>
            <div class="flex items-start gap-2">
              <TrendingUp className="size-4 text-muted-foreground mt-0.5 flex-shrink-0" />
              <span><a href="https://news.met.police.uk/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Met Police press releases (Feb &amp; Jun 2026)</a> - headline series: theft-from-person and robbery offences involving a phone (81,365 in 2024, 71,391 in 2025), plus crackdown results. Counted on a narrower basis than the FOI series.</span>
            </div>
            <div class="flex items-start gap-2">
              <MapPin className="size-4 text-muted-foreground mt-0.5 flex-shrink-0" />
              <span><a href="https://www.ons.gov.uk/peoplepopulationandcommunity/crimeandjustice/bulletins/crimeinenglandandwales/latest" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">ONS, Crime in England and Wales</a> - police-recorded theft from the person, and Crime Survey (CSEW) snatch-theft estimates.</span>
            </div>
          </div>
          <div class="text-xs text-muted-foreground space-y-2 border-t border-border pt-3">
            <p><strong>Why two London totals?</strong> The Met publishes two series: a broad FOI count of all offences involving a stolen phone (117,211 in 2024) and a narrower headline count of theft-from-person and robbery offences (81,365 in 2024). Both are official; we label which is which wherever a number appears.</p>
            <p><strong>Recorded, not actual.</strong> All figures are police-recorded offences; true totals are higher because not every theft is reported.</p>
            <p><strong>Manchester &amp; Scotland.</strong> Greater Manchester Police does not currently publish street-level data to police.uk, and Police Scotland does not feed the police.uk street API, so no comparable counts are shown for those cities.</p>
            <p><strong>Corrections.</strong> Spotted a number that looks off? <a href="/contact-us" class="text-primary hover:underline">Tell us</a> and we'll check it against the source.</p>
          </div>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
