---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { BarChart3, TrendingUp, MapPin, AlertTriangle, Clock, Shield, ArrowRight, Calendar, Sun, Snowflake, Leaf } from 'lucide-react';

const statisticsSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "UK Mobile Phone Theft Statistics 2024",
  "description": "Comprehensive data on mobile phone thefts across UK cities including London, Manchester, Birmingham. Updated 2024 figures from Met Police and ONS.",
  "keywords": ["phone theft statistics UK", "London phone theft", "mobile crime UK", "snatch theft data"],
  "creator": { "@type": "Organization", "name": "ProtectMyMobile" },
  "temporalCoverage": "2017/2024",
  "spatialCoverage": { "@type": "Place", "name": "United Kingdom" }
};

// Top 5 London hotspots (simplified)
const londonHotspots = [
  { rank: 1, area: 'Westminster', thefts: '34,000+', description: 'Tourist areas, West End, transport hubs' },
  { rank: 2, area: 'Camden', thefts: '8,500+', description: 'Markets, nightlife, busy high streets' },
  { rank: 3, area: 'Tower Hamlets', thefts: '6,200+', description: 'Shoreditch, Brick Lane, City fringe' },
  { rank: 4, area: 'Hackney', thefts: '5,800+', description: 'Nightlife spots, busy cafes' },
  { rank: 5, area: 'Southwark', thefts: '4,900+', description: 'Borough Market, London Bridge' },
];

// City comparison data
const cityComparison = [
  { city: 'London', thefts: 116656, year: '2024', change: '+50% since 2017' },
  { city: 'Manchester', thefts: 8500, year: '2023', change: '+31%' },
  { city: 'Birmingham', thefts: 6200, year: '2023', change: '+25%' },
  { city: 'Leeds', thefts: 4100, year: '2023', change: '+28%' },
  { city: 'Liverpool', thefts: 3200, year: '2023', change: '+23%' },
];

// Key stats - updated with accurate 2024 data
const keyStats = [
  { value: '78,000', label: 'Snatch thefts UK (2024)', icon: AlertTriangle, color: 'red' },
  { value: '116,000+', label: 'London alone (2024)', icon: MapPin, color: 'orange' },
  { value: '150%', label: 'Increase since 2023', icon: TrendingUp, color: 'yellow' },
  { value: '0.8%', label: 'Result in charges', icon: Shield, color: 'teal' },
];
---

<Layout 
  title="UK Phone Theft Statistics 2024 | London Crime Hotspots & Data"
  description="78,000+ phones stolen in UK (2024). See London theft hotspots, borough data, seasonal trends. Real statistics from Met Police and ONS."
  canonicalPath="/statistics"
  schema={statisticsSchema}
>
  <HeaderMobile client:load />
  
  <main class="bg-[#f3f2f1] min-h-screen">
    <div class="container mx-auto px-4 py-6 max-w-6xl">
      
      <!-- Hero Section -->
      <div class="bg-gradient-to-br from-purple-600 to-indigo-700 text-white rounded-2xl p-6 md:p-10 mb-8 shadow-xl">
        <div class="flex items-center gap-3 mb-3">
          <div class="bg-white/20 p-3 rounded-xl">
            <BarChart3 class="h-8 w-8" />
          </div>
          <h1 class="text-2xl md:text-3xl font-bold">UK Mobile Theft Statistics</h1>
        </div>
        <p class="text-purple-100 text-sm md:text-base mb-6">
          Real data on where, when, and how often phones are stolen across the UK. Updated with latest police and ONS data.
        </p>
        
        <!-- Key Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          {keyStats.map((stat) => (
            <div class="bg-white/10 rounded-xl p-4 text-center">
              <div class="text-2xl md:text-3xl font-bold">{stat.value}</div>
              <div class="text-xs text-purple-200 mt-1">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- London Hotspots - Simplified -->
      <section class="mb-10">
        <div class="bg-white rounded-2xl shadow-md overflow-hidden border border-neutral-100">
          <div class="h-2 bg-gradient-to-r from-red-500 to-orange-500"></div>
          <div class="p-6 md:p-8">
            <div class="flex items-center gap-3 mb-2">
              <MapPin class="h-6 w-6 text-red-500" />
              <h2 class="text-xl font-bold">London Theft Hotspots (2024)</h2>
            </div>
            <p class="text-neutral-600 text-sm mb-6">London accounts for 75% of all UK phone thefts. These are the worst-affected boroughs.</p>
            
            <div class="space-y-3">
              {londonHotspots.map((spot) => (
                <div class="flex items-center gap-4 p-4 bg-neutral-50 rounded-xl">
                  <span class={`w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0 ${spot.rank === 1 ? 'bg-red-500 text-white' : spot.rank <= 3 ? 'bg-orange-500 text-white' : 'bg-neutral-300 text-neutral-700'}`}>
                    {spot.rank}
                  </span>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-baseline gap-2">
                      <h3 class="font-bold text-neutral-900">{spot.area}</h3>
                      <span class="text-red-600 font-semibold text-sm">{spot.thefts}</span>
                    </div>
                    <p class="text-xs text-neutral-500 truncate">{spot.description}</p>
                  </div>
                </div>
              ))}
            </div>
            
            <p class="text-xs text-neutral-500 mt-4">
              Source: Metropolitan Police recorded crime data 2024
            </p>
          </div>
        </div>
      </section>

      <!-- City Comparison -->
      <section class="mb-10">
        <div class="bg-white rounded-2xl shadow-md overflow-hidden border border-neutral-100">
          <div class="h-2 bg-gradient-to-r from-blue-500 to-indigo-500"></div>
          <div class="p-6 md:p-8">
            <div class="flex items-center gap-3 mb-2">
              <BarChart3 class="h-6 w-6 text-blue-500" />
              <h2 class="text-xl font-bold">Major Cities Comparison</h2>
            </div>
            <p class="text-neutral-600 text-sm mb-6">Annual mobile phone theft figures by city</p>
            
            <div class="space-y-4">
              {cityComparison.map((city, i) => {
                const maxThefts = cityComparison[0].thefts;
                const width = (city.thefts / maxThefts) * 100;
                return (
                  <div>
                    <div class="flex items-center justify-between mb-2">
                      <div class="flex items-center gap-3">
                        <span class="font-bold text-neutral-900">{city.city}</span>
                        <span class="text-xs text-neutral-500">({city.year})</span>
                      </div>
                      <div class="text-right">
                        <span class="font-bold text-neutral-900">{city.thefts.toLocaleString()}</span>
                        <span class="text-xs text-red-600 ml-2">{city.change}</span>
                      </div>
                    </div>
                    <div class="w-full bg-neutral-100 rounded-full h-4 overflow-hidden">
                      <div 
                        class={`h-4 rounded-full ${i === 0 ? 'bg-gradient-to-r from-red-500 to-red-600' : 'bg-gradient-to-r from-blue-400 to-blue-500'}`}
                        style={`width: ${width}%`}
                      ></div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </section>

      <!-- Time of Day Analysis -->
      <section class="mb-10">
        <div class="bg-white rounded-2xl shadow-md overflow-hidden border border-neutral-100">
          <div class="h-2 bg-gradient-to-r from-orange-500 to-yellow-500"></div>
          <div class="p-6 md:p-8">
            <div class="flex items-center gap-3 mb-2">
              <Clock class="h-6 w-6 text-orange-500" />
              <h2 class="text-xl font-bold">When Do Thefts Happen?</h2>
            </div>
            <p class="text-neutral-600 text-sm mb-6">Time-of-day breakdown showing peak risk periods</p>
            
            <div class="space-y-5">
              <div>
                <div class="flex justify-between items-center mb-2">
                  <div>
                    <span class="font-bold text-neutral-900">Evening Rush</span>
                    <span class="text-sm text-neutral-500 ml-2">5pm - 7pm</span>
                  </div>
                  <span class="text-xl font-bold text-red-600">32%</span>
                </div>
                <div class="w-full bg-neutral-100 rounded-full h-5 overflow-hidden">
                  <div class="bg-gradient-to-r from-red-500 to-red-600 h-5 rounded-full flex items-center justify-end pr-2" style="width: 100%">
                    <span class="text-white text-xs font-bold">Highest Risk</span>
                  </div>
                </div>
              </div>
              
              <div>
                <div class="flex justify-between items-center mb-2">
                  <div>
                    <span class="font-bold text-neutral-900">Late Night</span>
                    <span class="text-sm text-neutral-500 ml-2">10pm - 2am</span>
                  </div>
                  <span class="text-xl font-bold text-orange-600">28%</span>
                </div>
                <div class="w-full bg-neutral-100 rounded-full h-5 overflow-hidden">
                  <div class="bg-gradient-to-r from-orange-500 to-orange-600 h-5 rounded-full" style="width: 87.5%"></div>
                </div>
              </div>
              
              <div>
                <div class="flex justify-between items-center mb-2">
                  <div>
                    <span class="font-bold text-neutral-900">Morning Rush</span>
                    <span class="text-sm text-neutral-500 ml-2">7am - 9am</span>
                  </div>
                  <span class="text-xl font-bold text-yellow-600">18%</span>
                </div>
                <div class="w-full bg-neutral-100 rounded-full h-5 overflow-hidden">
                  <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 h-5 rounded-full" style="width: 56%"></div>
                </div>
              </div>
              
              <div>
                <div class="flex justify-between items-center mb-2">
                  <div>
                    <span class="font-bold text-neutral-900">Afternoon</span>
                    <span class="text-sm text-neutral-500 ml-2">12pm - 5pm</span>
                  </div>
                  <span class="text-xl font-bold text-blue-600">15%</span>
                </div>
                <div class="w-full bg-neutral-100 rounded-full h-5 overflow-hidden">
                  <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-5 rounded-full" style="width: 47%"></div>
                </div>
              </div>
              
              <div>
                <div class="flex justify-between items-center mb-2">
                  <div>
                    <span class="font-bold text-neutral-900">Other Times</span>
                    <span class="text-sm text-neutral-500 ml-2">2am - 7am, 9am - 12pm</span>
                  </div>
                  <span class="text-xl font-bold text-neutral-500">7%</span>
                </div>
                <div class="w-full bg-neutral-100 rounded-full h-5 overflow-hidden">
                  <div class="bg-neutral-400 h-5 rounded-full" style="width: 22%"></div>
                </div>
              </div>
            </div>
            
            <div class="mt-6 p-4 bg-yellow-50 border border-yellow-200 rounded-xl">
              <p class="text-sm text-yellow-800">
                <strong>Stay Alert:</strong> Be extra vigilant during evening rush hour and late at night. Keep devices secure and be aware of your surroundings.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Seasonal Patterns -->
      <section class="mb-10">
        <div class="bg-white rounded-2xl shadow-md overflow-hidden border border-neutral-100">
          <div class="h-2 bg-gradient-to-r from-green-500 to-teal-500"></div>
          <div class="p-6 md:p-8">
            <div class="flex items-center gap-3 mb-2">
              <Calendar class="h-6 w-6 text-green-500" />
              <h2 class="text-xl font-bold">Seasonal Patterns</h2>
            </div>
            <p class="text-neutral-600 text-sm mb-6">How theft rates change throughout the year</p>
            
            <div class="grid md:grid-cols-3 gap-4">
              <div class="bg-orange-50 border border-orange-200 rounded-xl p-5">
                <div class="flex items-center gap-2 mb-3">
                  <Sun class="h-5 w-5 text-orange-500" />
                  <h3 class="font-bold text-neutral-900">Summer Spike</h3>
                </div>
                <p class="text-sm text-neutral-700 mb-2">
                  <strong>June - August:</strong> Thefts rise 25-30%
                </p>
                <p class="text-xs text-neutral-600">
                  Outdoor dining, festivals, and tourists with phones out create more opportunities. "Table surfing" peaks.
                </p>
              </div>
              
              <div class="bg-red-50 border border-red-200 rounded-xl p-5">
                <div class="flex items-center gap-2 mb-3">
                  <Snowflake class="h-5 w-5 text-red-500" />
                  <h3 class="font-bold text-neutral-900">December Danger</h3>
                </div>
                <p class="text-sm text-neutral-700 mb-2">
                  <strong>December:</strong> Secondary peak (+20%)
                </p>
                <p class="text-xs text-neutral-600">
                  Christmas shopping crowds, holiday parties, and reduced awareness due to alcohol consumption.
                </p>
              </div>
              
              <div class="bg-blue-50 border border-blue-200 rounded-xl p-5">
                <div class="flex items-center gap-2 mb-3">
                  <Leaf class="h-5 w-5 text-blue-500" />
                  <h3 class="font-bold text-neutral-900">Winter Lull</h3>
                </div>
                <p class="text-sm text-neutral-700 mb-2">
                  <strong>January - February:</strong> Lowest rates
                </p>
                <p class="text-xs text-neutral-600">
                  Fewer people outdoors, darker evenings keep people home, reduced social activity post-holidays.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Why It Matters + What To Do -->
      <section class="grid md:grid-cols-2 gap-6 mb-10">
        <div class="bg-white rounded-2xl shadow-md p-6 border border-neutral-100">
          <h3 class="text-lg font-bold mb-4">Why These Numbers Matter</h3>
          <div class="space-y-3 text-sm text-neutral-700">
            <p>
              <strong>Beyond the device:</strong> Victims face identity theft, financial fraud, loss of irreplaceable photos, and emotional distress.
            </p>
            <p>
              <strong>Recovery is rare:</strong> Only 6% of stolen phones are recovered. Prevention is crucial.
            </p>
            <p>
              <strong>Growing problem:</strong> The 44% increase shows this is an escalating crisis requiring better awareness.
            </p>
          </div>
        </div>
        
        <div class="bg-white rounded-2xl shadow-md p-6 border border-neutral-100">
          <h3 class="text-lg font-bold mb-4">Protect Yourself</h3>
          <div class="space-y-3">
            <a href="/prevention" class="flex items-center justify-between p-3 bg-primary/5 border border-primary/20 rounded-xl hover:bg-primary/10 transition-colors">
              <div>
                <div class="font-semibold text-primary">Prevention Guide</div>
                <div class="text-xs text-neutral-600">Security tips before theft occurs</div>
              </div>
              <ArrowRight class="h-5 w-5 text-primary" />
            </a>
            <a href="/emergency" class="flex items-center justify-between p-3 bg-red-50 border border-red-200 rounded-xl hover:bg-red-100 transition-colors">
              <div>
                <div class="font-semibold text-red-700">Emergency Steps</div>
                <div class="text-xs text-neutral-600">What to do if stolen</div>
              </div>
              <ArrowRight class="h-5 w-5 text-red-600" />
            </a>
            <a href="/products" class="flex items-center justify-between p-3 bg-teal-50 border border-teal-200 rounded-xl hover:bg-teal-100 transition-colors">
              <div>
                <div class="font-semibold text-teal-700">Protection Products</div>
                <div class="text-xs text-neutral-600">Lanyards, bags, trackers & more</div>
              </div>
              <ArrowRight class="h-5 w-5 text-teal-600" />
            </a>
          </div>
        </div>
      </section>

    </div>
  </main>
  
  <Footer />
</Layout>
