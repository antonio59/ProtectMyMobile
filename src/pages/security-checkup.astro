---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import SecurityCheckupComponent from '../components/SecurityCheckup';
import { ShieldCheck, Clock, CheckCircle2 } from 'lucide-react';
---

<Layout 
  title="Security Checkup - Assess Your Mobile Security | ProtectMyMobile"
  description="Take our interactive security assessment to identify vulnerabilities and get personalised recommendations for protecting your mobile device."
>
  <HeaderMobile client:idle />
  
  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-4xl">
      <!-- Hero Section -->
      <div class="bg-foreground text-background rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-10 mb-6 sm:mb-8 ">
        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 mb-4">
          <div class="bg-background/20 p-3 sm:p-4 rounded-xl sm:rounded-2xl">
            <ShieldCheck class="size-8 sm:size-10" />
          </div>
          <div>
            <h1 class="text-xl sm:text-2xl md:text-3xl font-bold">Mobile Security Checkup</h1>
            <p class="text-neutral-300 mt-1">Discover how secure your phone really is</p>
          </div>
        </div>
        <div class="flex flex-wrap gap-3 sm:gap-4">
          <div class="flex items-center gap-2 bg-background/10 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm">
            <Clock class="size-3 sm:size-4" />
            <span>Takes 2-3 minutes</span>
          </div>
          <div class="flex items-center gap-2 bg-background/10 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm">
            <CheckCircle2 class="size-3 sm:size-4" />
            <span>12 quick questions</span>
          </div>
        </div>
      </div>
      
      <!-- Checkup Component -->
      <div class="bg-card rounded-xl sm:rounded-2xl  overflow-hidden border border-border">
        <SecurityCheckupComponent client:visible />
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
