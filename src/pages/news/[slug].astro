---
import Layout from '../../layouts/Layout.astro';
import HeaderMobile from '../../components/HeaderMobile';
import Footer from '../../components/Footer.astro';
import { getNewsPosts, getNewsPostBySlug } from '../../lib/convexData';
import { Calendar, ExternalLink, ArrowLeft, Clock, User, Tag } from 'lucide-react';
import { marked } from 'marked';

// Configure marked for better rendering
marked.setOptions({
  breaks: true,
  gfm: true,
});

// Required for static builds - generate paths for all published news posts
export async function getStaticPaths() {
  try {
    const posts = await getNewsPosts(true); // Get published posts only
    return posts.map((post) => ({
      params: { slug: post.slug },
    }));
  } catch (error) {
    console.error('Error generating static paths for news:', error);
    // Return empty array if no posts or error - won't generate any pages
    return [];
  }
}

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/news');
}

let post;
let error = null;

try {
  post = await getNewsPostBySlug(slug);
} catch (e) {
  error = e;
  console.error('Error fetching news post:', e);
}

if (!post) {
  return Astro.redirect('/news');
}

// Convert markdown to HTML
const contentHtml = marked.parse(post.content || '');

const categoryColors: Record<string, string> = {
  arrest: 'bg-red-100 text-red-800',
  seizure: 'bg-blue-100 text-blue-800',
  law_change: 'bg-teal-100 text-teal-800',
  statistics: 'bg-green-100 text-green-800',
  prevention_tip: 'bg-yellow-100 text-yellow-800',
  other: 'bg-gray-100 text-gray-800',
};

function formatDate(dateValue: string | number) {
  const date = typeof dateValue === 'number' ? new Date(dateValue) : new Date(dateValue);
  return date.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  });
}
---

<Layout 
  title={`${post.title} | ProtectMyMobile`}
  description={post.excerpt}
>
  <HeaderMobile client:load />
  
  <main class="bg-[#f3f2f1] min-h-screen">
    <div class="container mx-auto px-4 py-6 max-w-4xl">
      <!-- Back Link -->
      <a href="/news" class="inline-flex items-center gap-2 text-neutral-600 hover:text-primary transition-colors mb-6 text-sm font-medium">
        <ArrowLeft class="h-4 w-4" />
        Back to News
      </a>
      
      <!-- Article -->
      <article class="bg-white rounded-2xl shadow-xl overflow-hidden border border-neutral-100">
        <!-- Header -->
        <div class="p-6 md:p-8 border-b border-neutral-100">
          <!-- Category Badge -->
          <div class="mb-4">
            <span class={`inline-flex items-center gap-1 text-xs px-3 py-1.5 rounded-full font-medium ${categoryColors[post.category] || categoryColors.other}`}>
              <Tag class="h-3 w-3" />
              {post.category.replace('_', ' ')}
            </span>
          </div>
          
          <!-- Title -->
          <h1 class="text-2xl md:text-3xl font-bold text-neutral-900 mb-4 leading-tight">
            {post.title}
          </h1>
          
          <!-- Meta Info -->
          <div class="flex flex-wrap items-center gap-4 text-sm text-neutral-500">
            <div class="flex items-center gap-1.5">
              <Calendar class="h-4 w-4" />
              <span>{formatDate(post.publishedAt || post._creationTime)}</span>
            </div>
            {post.authorName && (
              <div class="flex items-center gap-1.5">
                <User class="h-4 w-4" />
                <span>{post.authorName}</span>
              </div>
            )}
            {post.sourceUrl && (
              <a href={post.sourceUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-primary hover:underline">
                <ExternalLink class="h-4 w-4" />
                <span>{post.sourceName || 'Source'}</span>
              </a>
            )}
          </div>
        </div>
        
        <!-- Content -->
        <div class="p-6 md:p-8">
          <article class="prose prose-neutral max-w-none prose-headings:text-neutral-900 prose-h1:text-2xl prose-h1:mt-0 prose-h1:mb-4 prose-h2:text-xl prose-h2:border-b prose-h2:border-neutral-200 prose-h2:pb-2 prose-h2:mt-6 prose-h2:mb-3 prose-a:text-primary prose-strong:text-neutral-900 prose-strong:font-bold prose-li:marker:text-primary">
            <div set:html={contentHtml} />
          </article>
        </div>
      </article>
      
      <!-- Related/Back CTA -->
      <div class="mt-8 bg-gradient-to-r from-primary/10 to-blue-100 rounded-2xl p-6 border border-primary/20">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <p class="text-neutral-700 font-medium">
            Stay informed about the latest mobile theft news.
          </p>
          <a href="/news" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-primary text-white rounded-xl font-semibold text-sm hover:bg-primary/90 transition-colors">
            View All News
            <ArrowLeft class="h-4 w-4 rotate-180" />
          </a>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>

<style>
  /* Style the markdown content */
  .prose {
    color: #374151;
    font-size: 1.125rem;
    line-height: 1.75;
  }
  
  .prose h1, .prose h2, .prose h3, .prose h4 {
    color: #111827;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  
  .prose h1 {
    font-size: 1.875rem;
    margin-top: 0;
    margin-bottom: 1rem;
  }
  
  .prose h2 {
    font-size: 1.5rem;
    border-bottom: 2px solid #e5e7eb;
    padding-bottom: 0.5rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  
  .prose h3 {
    font-size: 1.5rem;
  }
  
  .prose p {
    margin-bottom: 1.5rem;
    line-height: 1.75;
  }
  
  .prose ul {
    list-style-type: disc;
    margin-bottom: 1.5rem;
    margin-top: 1rem;
    padding-left: 2rem;
  }
  
  .prose ol {
    list-style-type: decimal;
    margin-bottom: 1.5rem;
    margin-top: 1rem;
    padding-left: 2rem;
  }
  
  .prose li {
    margin-bottom: 0.75rem;
    padding-left: 0.5rem;
    line-height: 1.75;
  }
  
  .prose li::marker {
    color: #1d4ed8;
    font-weight: 600;
  }
  
  .prose a {
    color: #1d4ed8;
    text-decoration: underline;
    font-weight: 500;
  }
  
  .prose a:hover {
    color: #1e40af;
  }
  
  .prose blockquote {
    border-left: 4px solid #1d4ed8;
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: #4b5563;
    background: #f3f4f6;
    padding: 1.5rem;
    border-radius: 0.5rem;
  }
  
  .prose strong {
    font-weight: 700;
    color: #111827;
  }
  
  .prose hr {
    margin: 2.5rem 0;
    border: none;
    border-top: 2px solid #e5e7eb;
  }
  
  .prose code {
    background: #f3f4f6;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
    font-family: monospace;
  }
  
  .prose em {
    font-style: italic;
    color: #4b5563;
  }
</style>
