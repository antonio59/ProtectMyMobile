---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import HeaderMobile from '../../components/HeaderMobile';
import Footer from '../../components/Footer.astro';
import { getNewsPosts, getNewsPostBySlug } from '../../lib/convexData';
import type { NewsPost } from '../../types/news';
import { Calendar, ExternalLink, ArrowLeft, Tag, ChevronRight, MessageSquare, BookOpen, Siren, ShieldAlert, Gavel, TrendingUp, Lightbulb, FileText } from 'lucide-react';
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';

// Configure marked for better rendering
marked.setOptions({
  breaks: true,
  gfm: true,
});

// Required for static builds
export async function getStaticPaths() {
  try {
    const posts = await getNewsPosts(true);
    return posts.map((post) => ({
      params: { slug: post.slug },
    }));
  } catch (error) {
    console.error('Error generating static paths for news:', error);
    return [];
  }
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/news');
}

let post: NewsPost | null = null;
let relatedPosts: NewsPost[] = [];
try {
  post = await getNewsPostBySlug(slug);
  if (post) {
    // Get related posts (same category, excluding current)
    const allPosts = await getNewsPosts(true);
    const currentCategory = post.category;
    relatedPosts = allPosts
      .filter((p: NewsPost) => p.category === currentCategory && p.slug !== slug)
      .slice(0, 3);
  }
} catch (e: unknown) {
  console.error('Error fetching news post:', e);
}

if (!post) {
  return Astro.redirect('/news');
}

// Convert markdown to HTML
const rawHtml = await marked.parse(post.content || '');
let sanitizedHtml = sanitizeHtml(rawHtml as string, {
  allowedTags: sanitizeHtml.defaults.allowedTags.concat(['img', 'h1', 'h2', 'h3']),
  allowedAttributes: {
    ...sanitizeHtml.defaults.allowedAttributes,
    a: ['href', 'name', 'target', 'rel'],
    img: ['src', 'alt', 'title'],
  },
  transformTags: {
    a: sanitizeHtml.simpleTransform('a', { rel: 'noopener noreferrer' }),
  },
});

// Remove duplicate title and excerpt from content body
const titleText = post.title.toLowerCase().trim();
const excerptText = post.excerpt?.toLowerCase().trim() || '';

// Strip duplicate H1 matching the title
let contentHtml = sanitizedHtml.replace(
  /^<h1[^>]*>.*?<\/h1>\s*/i,
  (match) => {
    const h1Text = match.replace(/<[^>]+>/g, '').trim().toLowerCase();
    if (h1Text === titleText || titleText.startsWith(h1Text) || h1Text.startsWith(titleText)) {
      return '';
    }
    return match;
  }
);

// Strip leading paragraph that matches the excerpt (common in scraped content)
if (excerptText && excerptText.length > 20) {
  contentHtml = contentHtml.replace(
    /^<p[^>]*>(.*?)<\/p>\s*/i,
    (match) => {
      const pText = match.replace(/<[^>]+>/g, '').trim().toLowerCase();
      if (pText === excerptText || excerptText.startsWith(pText) || pText.startsWith(excerptText)) {
        return '';
      }
      return match;
    }
  );
}

// Remove consecutive duplicate paragraphs (scraper artifact)
contentHtml = contentHtml.replace(
  /(<p[^>]*>.*?<\/p>)\s*\1/gi,
  '$1'
);

const categoryConfig: Record<string, { color: string; bg: string; border: string; label: string; icon: any; gradient: string }> = {
  arrest: { color: 'text-destructive-hover', bg: 'bg-destructive-subtle', border: 'border-red-200', label: 'Arrest', icon: Siren, gradient: 'from-red-500 to-red-600' },
  seizure: { color: 'text-orange-700', bg: 'bg-orange-50', border: 'border-orange-200', label: 'Seizure', icon: ShieldAlert, gradient: 'from-orange-500 to-orange-600' },
  law_change: { color: 'text-teal-700', bg: 'bg-teal-50', border: 'border-teal-200', label: 'Law Change', icon: Gavel, gradient: 'from-teal-500 to-teal-600' },
  statistics: { color: 'text-primary-hover', bg: 'bg-primary-subtle', border: 'border-blue-200', label: 'Statistics', icon: TrendingUp, gradient: 'from-blue-500 to-blue-600' },
  prevention_tip: { color: 'text-green-700', bg: 'bg-green-50', border: 'border-green-200', label: 'Tip', icon: Lightbulb, gradient: 'from-green-500 to-green-600' },
  other: { color: 'text-foreground', bg: 'bg-neutral', border: 'border-border', label: 'News', icon: FileText, gradient: 'from-neutral-500 to-neutral-600' },
};

function formatDate(dateValue: string | number) {
  const date = typeof dateValue === 'number' ? new Date(dateValue) : new Date(dateValue);
  return date.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  });
}

function toISODate(dateValue: string | number) {
  const date = typeof dateValue === 'number' ? new Date(dateValue) : new Date(dateValue);
  return date.toISOString();
}

function readingTime(text: string): number {
  const wordsPerMinute = 200;
  const words = text.trim().split(/\s+/).length;
  return Math.max(1, Math.ceil(words / wordsPerMinute));
}

const config = categoryConfig[post.category] || categoryConfig.other;
const pageUrl = `https://protectmymobile.xyz/news/${slug}`;
const isExternal = !!post.sourceUrl;

// Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": post.title,
  "description": post.excerpt,
  "datePublished": toISODate(post.publishedAt || post._creationTime),
  "dateModified": toISODate(post._creationTime),
  "author": {
    "@type": post.authorName ? "Person" : "Organization",
    "name": post.authorName || "ProtectMyMobile"
  },
  "publisher": {
    "@type": "Organization",
    "name": "ProtectMyMobile",
    "logo": {
      "@type": "ImageObject",
      "url": "https://protectmymobile.xyz/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": pageUrl
  },
  "image": post.featuredImageUrl || "https://protectmymobile.xyz/og-image.png",
  "articleSection": config.label,
  "url": pageUrl,
  "inLanguage": "en-GB"
};
---

<Layout 
  title={`${post.title} | ProtectMyMobile News`}
  description={post.excerpt}
  canonicalPath={`/news/${slug}`}
  ogType="article"
  ogImage={post.featuredImageUrl || "/og-image.png"}
  publishedTime={toISODate(post.publishedAt || post._creationTime)}
  modifiedTime={toISODate(post._creationTime)}
  schema={articleSchema}
>
  <HeaderMobile client:idle />
  
  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-5xl">
      
      <article class="bg-card rounded-xl sm:rounded-2xl shadow-lg overflow-hidden border border-border">
        {/* Featured Image */}
        {post.featuredImageUrl ? (
          <div class="w-full aspect-[16/9] sm:aspect-[21/9] overflow-hidden bg-neutral-100">
            <img 
              src={post.featuredImageUrl} 
              alt={post.title}
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        ) : (
          <div class={`w-full aspect-[16/9] sm:aspect-[21/9] bg-gradient-to-br ${config.gradient} flex items-center justify-center`}>
            <div class="bg-white/20 backdrop-blur-sm p-4 sm:p-6 rounded-2xl sm:rounded-3xl">
              {(() => {
                const PostIcon = config.icon;
                return <PostIcon class="size-12 sm:size-16 text-white" />;
              })()}
            </div>
          </div>
        )}

        {/* Article Header */}
        <header class={`px-4 sm:px-6 lg:px-8 py-5 sm:py-6 border-b ${config.border} ${config.bg}`}>
          <div class="flex items-center gap-2 mb-3 flex-wrap">
            <span class={`inline-flex items-center gap-1.5 text-[10px] sm:text-xs px-2.5 py-1 rounded-full font-medium bg-card border ${config.border} ${config.color}`}>
              <Tag class="size-3" />
              {config.label}
            </span>
            <span class="text-muted-foreground">&bull;</span>
            <span class="text-xs text-muted-foreground flex items-center gap-1">
              <Calendar class="size-3" />
              {formatDate(post.publishedAt || post._creationTime)}
            </span>
            <span class="text-muted-foreground">&bull;</span>
            <span class="text-xs text-muted-foreground flex items-center gap-1">
              <BookOpen class="size-3" />
              {readingTime(post.content || post.excerpt || '')} min read
            </span>
            {isExternal && (
              <>
                <span class="text-muted-foreground">&bull;</span>
                <span class="text-xs text-muted-foreground">External source</span>
              </>
            )}
          </div>

          <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold text-foreground leading-tight">
            {post.title}
          </h1>

          {post.sourceName && (
            <div class="mt-3 flex items-center gap-2">
              <span class="text-xs text-muted-foreground">Originally published by</span>
              <a 
                href={post.sourceUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1 text-xs text-primary hover:underline font-medium"
              >
                {post.sourceName}
                <ExternalLink class="size-3" />
              </a>
            </div>
          )}
        </header>

        {/* Article Content */}
        <div class="px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
          <div class="prose prose-sm sm:prose-base max-w-none prose-headings:text-foreground prose-h1:text-xl prose-h1:font-bold prose-h2:text-lg prose-h2:font-semibold prose-h2:border-b prose-h2:border-border prose-h2:pb-2 prose-h2:mt-6 prose-h2:mb-3 prose-a:text-primary prose-strong:text-foreground prose-ul:list-disc prose-ul:pl-5 prose-ol:list-decimal prose-ol:pl-5 prose-li:marker:text-muted-foreground">
            {contentHtml ? (
              <div set:html={contentHtml} />
            ) : (
              <p class="text-muted-foreground italic">{post.excerpt}</p>
            )}
          </div>

          {/* Prominent External Link CTA */}
          {isExternal && post.sourceUrl && (
            <div class="mt-8 p-5 sm:p-6 bg-gradient-to-br from-primary/5 to-blue-50 rounded-xl border border-primary/20">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                  <p class="text-sm font-medium text-foreground">
                    Read the full story on {post.sourceName}
                  </p>
                  <p class="text-xs text-muted-foreground mt-1">
                    This is a summary — the complete article is available at the original publisher.
                  </p>
                </div>
                <a 
                  href={post.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-primary text-white rounded-lg text-sm font-semibold hover:bg-primary-hover transition-colors whitespace-nowrap"
                >
                  Read full article
                  <ExternalLink class="size-4" />
                </a>
              </div>
            </div>
          )}

          {/* Community CTA */}
          <div class="mt-8 p-5 sm:p-6 bg-gradient-to-br from-amber-50 to-orange-50 rounded-xl border border-amber-200">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
              <div class="flex items-start gap-3">
                <div class="p-2.5 bg-card rounded-lg shadow-md">
                  <MessageSquare class="size-5 text-warning" />
                </div>
                <div>
                  <p class="text-sm font-bold text-foreground">
                    Have you been affected by phone theft?
                  </p>
                  <p class="text-xs text-muted-foreground mt-1">
                    Share your experience anonymously and help others understand the real risks.
                  </p>
                </div>
              </div>
              <a 
                href="/community-experiences#share"
                class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-warning text-white rounded-lg text-sm font-semibold hover:bg-amber-700 transition-colors whitespace-nowrap"
              >
                Share your experience
                <ChevronRight class="size-4" />
              </a>
            </div>
          </div>
        </div>

        {/* Article Footer */}
        <footer class="px-4 sm:px-6 lg:px-8 py-4 border-t border-border bg-neutral">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            {/* Share */}
            <div class="flex items-center gap-2">
              <span class="text-xs text-muted-foreground">Share:</span>
              <div class="flex items-center gap-1">
                <a
                  href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(post.title)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 rounded-lg bg-card border border-border text-muted-foreground hover:bg-neutral-900 hover:text-white hover:border-neutral-900 transition-colors"
                  aria-label="Share on Twitter"
                >
                  <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </a>
                <a
                  href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 rounded-lg bg-card border border-border text-muted-foreground hover:bg-[#1877F2] hover:text-white hover:border-[#1877F2] transition-colors"
                  aria-label="Share on Facebook"
                >
                  <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </a>
                <button
                  id="copy-link-btn"
                  class="p-2 rounded-lg bg-card border border-border text-muted-foreground hover:bg-neutral-100 transition-colors text-xs font-medium"
                  data-url={pageUrl}
                >
                  Copy link
                </button>
              </div>
            </div>

            {/* Back to News */}
            <a 
              href="/news" 
              class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-primary transition-colors"
            >
              <ArrowLeft class="size-4" />
              Back to all news
            </a>
          </div>
        </footer>
      </article>

      {/* Related Articles */}
      {relatedPosts.length > 0 && (
        <section class="mt-6 sm:mt-8">
          <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-4">
            More {config.label}s
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {relatedPosts.map(related => {
              const relatedConfig = categoryConfig[related.category] || categoryConfig.other;
              return (
                <a
                  href={related.sourceUrl || `/news/${related.slug}`}
                  target={related.sourceUrl ? "_blank" : undefined}
                  rel={related.sourceUrl ? "noopener noreferrer" : undefined}
                  class="group bg-card rounded-xl overflow-hidden border border-border hover:border-primary/30 hover:shadow-md transition-all"
                >
                  {related.featuredImageUrl ? (
                    <div class="w-full aspect-[16/9] overflow-hidden bg-neutral-100">
                      <img
                        src={related.featuredImageUrl}
                        alt={related.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        loading="lazy"
                      />
                    </div>
                  ) : (
                    <div class={`w-full aspect-[16/9] bg-gradient-to-br ${relatedConfig.gradient} flex items-center justify-center`}>
                      <div class="bg-white/20 backdrop-blur-sm p-2 rounded-xl">
                        {(() => {
                          const RelatedIcon = relatedConfig.icon;
                          return <RelatedIcon class="size-6 text-white" />;
                        })()}
                      </div>
                    </div>
                  )}
                  <div class="p-4">
                    <span class={`text-[10px] font-medium px-2 py-0.5 rounded-full ${relatedConfig.bg} ${relatedConfig.color}`}>
                      {relatedConfig.label}
                    </span>
                    <h3 class="mt-2 text-sm sm:text-base font-semibold text-foreground group-hover:text-primary transition-colors leading-tight line-clamp-2">
                      {related.title}
                    </h3>
                    <div class="mt-2 flex items-center gap-1 text-xs text-muted-foreground">
                      <ChevronRight class="size-3" />
                      <span>Read article</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}
    </div>
  </main>
  
  <Footer />

  <script>
    // Copy link functionality
    const copyBtn = document.getElementById('copy-link-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const url = copyBtn.getAttribute('data-url');
        if (url) {
          try {
            await navigator.clipboard.writeText(url);
            copyBtn.textContent = 'Copied!';
            setTimeout(() => {
              copyBtn.textContent = 'Copy link';
            }, 2000);
          } catch (err) {
            console.error('Failed to copy:', err);
          }
        }
      });
    }
  </script>
</Layout>

<style>
  .prose {
    color: #374151;
    line-height: 1.7;
  }
  .prose p {
    margin-bottom: 1rem;
  }
  .prose a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose a:hover {
    text-decoration: none;
  }
  .prose blockquote {
    border-left: 3px solid #2563eb;
    padding-left: 1rem;
    font-style: italic;
    color: #4b5563;
    margin: 1.5rem 0;
  }
  .prose img {
    border-radius: 0.5rem;
    margin: 1rem 0;
  }
</style>
