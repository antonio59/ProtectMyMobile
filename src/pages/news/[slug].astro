---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import HeaderMobile from '../../components/HeaderMobile';
import Footer from '../../components/Footer.astro';
import { getNewsPosts, getNewsPostBySlug } from '../../lib/convexData';
import { Calendar, ExternalLink, ArrowLeft, User, Tag, Share2 } from 'lucide-react';
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';

// Configure marked for better rendering
marked.setOptions({
  breaks: true,
  gfm: true,
});

// Required for static builds - generate paths for all published news posts
export async function getStaticPaths() {
  try {
    const posts = await getNewsPosts(true); // Get published posts only
    return posts.map((post) => ({
      params: { slug: post.slug },
    }));
  } catch (error) {
    console.error('Error generating static paths for news:', error);
    // Return empty array if no posts or error - won't generate any pages
    return [];
  }
}


const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/news');
}

let post;
try {
  post = await getNewsPostBySlug(slug);
} catch (e) {
  console.error('Error fetching news post:', e);
}

if (!post) {
  return Astro.redirect('/news');
}

// Convert markdown to HTML
const rawHtml = await marked.parse(post.content || '');
let sanitizedHtml = sanitizeHtml(rawHtml as string, {
  allowedTags: sanitizeHtml.defaults.allowedTags.concat(['img', 'h1', 'h2', 'h3']),
  allowedAttributes: {
    ...sanitizeHtml.defaults.allowedAttributes,
    a: ['href', 'name', 'target', 'rel'],
    img: ['src', 'alt', 'title'],
  },
  transformTags: {
    a: sanitizeHtml.simpleTransform('a', { rel: 'noopener noreferrer' }),
  },
});

// Remove duplicate title - if content starts with an h1 that matches the post title, strip it
const contentHtml = sanitizedHtml.replace(
  /^<h1[^>]*>.*?<\/h1>\s*/i,
  (match) => {
    // Only remove if the h1 content is similar to the post title (fuzzy match)
    const h1Text = match.replace(/<[^>]+>/g, '').trim().toLowerCase();
    const titleText = post.title.toLowerCase().trim();
    // Remove if h1 is identical or very similar (starts with same words)
    if (h1Text === titleText || titleText.startsWith(h1Text) || h1Text.startsWith(titleText)) {
      return '';
    }
    return match;
  }
);

const categoryColors: Record<string, string> = {
  arrest: 'bg-red-100 text-red-800',
  seizure: 'bg-blue-100 text-blue-800',
  law_change: 'bg-teal-100 text-teal-800',
  statistics: 'bg-green-100 text-green-800',
  prevention_tip: 'bg-yellow-100 text-yellow-800',
  other: 'bg-gray-100 text-gray-800',
};

function formatDate(dateValue: string | number) {
  const date = typeof dateValue === 'number' ? new Date(dateValue) : new Date(dateValue);
  return date.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  });
}

function toISODate(dateValue: string | number) {
  const date = typeof dateValue === 'number' ? new Date(dateValue) : new Date(dateValue);
  return date.toISOString();
}

// NewsArticle schema for SEO - following Google's structured data guidelines
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": post.title,
  "description": post.excerpt,
  "datePublished": toISODate(post.publishedAt || post._creationTime),
  "dateModified": toISODate(post._creationTime),
  "author": {
    "@type": post.authorName ? "Person" : "Organization",
    "name": post.authorName || "ProtectMyMobile"
  },
  "publisher": {
    "@type": "Organization",
    "name": "ProtectMyMobile",
    "logo": {
      "@type": "ImageObject",
      "url": "https://protectmymobile.xyz/favicon.svg",
      "width": 512,
      "height": 512
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://protectmymobile.xyz/news/${slug}`
  },
  "image": {
    "@type": "ImageObject",
    "url": post.featuredImageUrl || "https://protectmymobile.xyz/og-image.png",
    "width": 1200,
    "height": 630
  },
  "articleSection": post.category.replace('_', ' '),
  "keywords": "mobile phone theft, UK, " + post.category.replace('_', ' '),
  "isAccessibleForFree": true,
  "url": `https://protectmymobile.xyz/news/${slug}`,
  "inLanguage": "en-GB"
};

// Breadcrumb schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://protectmymobile.xyz/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "News",
      "item": "https://protectmymobile.xyz/news"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.title,
      "item": `https://protectmymobile.xyz/news/${slug}`
    }
  ]
};

const pageUrl = `https://protectmymobile.xyz/news/${slug}`;
const encodedUrl = encodeURIComponent(pageUrl);
const encodedTitle = encodeURIComponent(post.title);
---

<Layout 
  title={`${post.title} | ProtectMyMobile`}
  description={post.excerpt}
  canonicalPath={`/news/${slug}`}
  schema={[articleSchema, breadcrumbSchema]}
>
  <HeaderMobile client:load />
  
  <main class="bg-[#f3f2f1] min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-4xl">
      <!-- Back Link -->
      <a href="/news" class="inline-flex items-center gap-1.5 sm:gap-2 text-neutral-600 hover:text-primary transition-colors mb-4 sm:mb-6 text-xs sm:text-sm font-medium">
        <ArrowLeft class="h-3 w-3 sm:h-4 sm:w-4" />
        Back to News
      </a>

      <!-- Article -->
      <article class="bg-white rounded-xl sm:rounded-2xl shadow-xl overflow-hidden border border-neutral-100">
        <!-- Header -->
        <div class="p-4 sm:p-6 md:p-8 lg:p-10 border-b border-neutral-100">
          <!-- Category Badge -->
          <div class="mb-3 sm:mb-4">
            <span class={`inline-flex items-center gap-1 text-[10px] sm:text-xs px-2 sm:px-3 py-1 sm:py-1.5 rounded-full font-medium ${categoryColors[post.category] || categoryColors.other}`}>
              <Tag class="h-2.5 w-2.5 sm:h-3 sm:w-3" />
              {post.category.replace('_', ' ')}
            </span>
          </div>

          <!-- Title -->
          <h1 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold text-neutral-900 mb-3 sm:mb-4 leading-tight">
            {post.title}
          </h1>

          <!-- Meta Info -->
          <div class="flex flex-wrap items-center gap-2 sm:gap-4 text-xs sm:text-sm text-neutral-500">
            <div class="flex items-center gap-1 sm:gap-1.5">
              <Calendar class="h-3 w-3 sm:h-4 sm:w-4" />
              <span>{formatDate(post.publishedAt || post._creationTime)}</span>
            </div>
            {post.authorName && (
              <div class="flex items-center gap-1 sm:gap-1.5">
                <User class="h-3 w-3 sm:h-4 sm:w-4" />
                <span>{post.authorName}</span>
              </div>
            )}
            {post.sourceUrl && (
              <a href={post.sourceUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 sm:gap-1.5 text-primary hover:underline">
                <ExternalLink class="h-3 w-3 sm:h-4 sm:w-4" />
                <span>{post.sourceName || 'Source'}</span>
              </a>
            )}
          </div>
        </div>

        <!-- Content -->
        <div class="p-4 sm:p-6 md:p-8 lg:p-10">
          <article class="prose prose-sm sm:prose-base lg:prose-lg prose-neutral max-w-none prose-headings:text-neutral-900 prose-h1:text-xl prose-h1:sm:text-2xl prose-h1:mt-0 prose-h1:mb-4 prose-h2:text-lg prose-h2:sm:text-xl prose-h2:border-b prose-h2:border-neutral-200 prose-h2:pb-2 prose-h2:mt-6 prose-h2:mb-3 prose-a:text-primary prose-strong:text-neutral-900 prose-strong:font-bold prose-li:marker:text-primary">
            <div set:html={contentHtml} />
          </article>
        </div>
      </article>
      
      <!-- Share Section -->
      <div class="mt-4 sm:mt-6 lg:mt-8 bg-white rounded-xl sm:rounded-2xl shadow-md p-4 sm:p-6 border border-neutral-100">
        <div class="flex items-center gap-2 mb-3 sm:mb-4">
          <Share2 className="h-4 w-4 sm:h-5 sm:w-5 text-primary" />
          <h3 class="font-semibold text-neutral-900 text-sm sm:text-base">Share this article</h3>
        </div>
        <div class="grid grid-cols-3 sm:flex sm:flex-wrap gap-2 sm:gap-3">
          <!-- Twitter/X -->
          <a
            href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center sm:justify-start gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 sm:py-2.5 bg-neutral-900 text-white rounded-lg text-xs sm:text-sm font-medium hover:bg-neutral-800 transition-colors"
          >
            <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <span class="hidden sm:inline">Post</span>
          </a>

          <!-- Facebook -->
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center sm:justify-start gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 sm:py-2.5 bg-[#1877F2] text-white rounded-lg text-xs sm:text-sm font-medium hover:bg-[#166FE5] transition-colors"
          >
            <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span class="hidden sm:inline">Share</span>
          </a>

          <!-- WhatsApp -->
          <a
            href={`https://wa.me/?text=${encodedTitle}%20${encodedUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center sm:justify-start gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 sm:py-2.5 bg-[#25D366] text-white rounded-lg text-xs sm:text-sm font-medium hover:bg-[#20BD5A] transition-colors"
          >
            <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span class="hidden sm:inline">WhatsApp</span>
          </a>

          <!-- Reddit -->
          <a
            href={`https://reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center sm:justify-start gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 sm:py-2.5 bg-[#FF4500] text-white rounded-lg text-xs sm:text-sm font-medium hover:bg-[#E03D00] transition-colors"
          >
            <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/>
            </svg>
            <span class="hidden sm:inline">Reddit</span>
          </a>

          <!-- Copy Link -->
          <button
            id="copy-link-btn"
            class="inline-flex items-center justify-center sm:justify-start gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 sm:py-2.5 bg-neutral-100 text-neutral-700 rounded-lg text-xs sm:text-sm font-medium hover:bg-neutral-200 transition-colors col-span-2 sm:col-span-1"
            data-url={pageUrl}
          >
            <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
            </svg>
            <span id="copy-link-text">Copy link</span>
          </button>
        </div>
      </div>

      <!-- Related/Back CTA -->
      <div class="mt-4 sm:mt-6 bg-gradient-to-r from-primary/10 to-blue-100 rounded-xl sm:rounded-2xl p-4 sm:p-6 border border-primary/20">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-4">
          <p class="text-neutral-700 font-medium text-sm sm:text-base">
            Stay informed about the latest mobile theft news.
          </p>
          <a href="/news" class="inline-flex items-center justify-center gap-2 px-4 sm:px-6 py-2 sm:py-2.5 bg-primary text-white rounded-lg sm:rounded-xl font-semibold text-xs sm:text-sm hover:bg-primary/90 transition-colors">
            View All News
            <ArrowLeft class="h-3 w-3 sm:h-4 sm:w-4 rotate-180" />
          </a>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>

<style>
  /* Style the markdown content - Mobile first */
  .prose {
    color: #374151;
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  @media (min-width: 640px) {
    .prose {
      font-size: 1rem;
      line-height: 1.75;
    }
  }

  @media (min-width: 1024px) {
    .prose {
      font-size: 1.125rem;
    }
  }

  .prose h1, .prose h2, .prose h3, .prose h4 {
    color: #111827;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  @media (min-width: 640px) {
    .prose h1, .prose h2, .prose h3, .prose h4 {
      margin-top: 2rem;
      margin-bottom: 1rem;
    }
  }

  .prose h1 {
    font-size: 1.5rem;
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  @media (min-width: 640px) {
    .prose h1 {
      font-size: 1.875rem;
      margin-bottom: 1rem;
    }
  }

  .prose h2 {
    font-size: 1.25rem;
    border-bottom: 2px solid #e5e7eb;
    padding-bottom: 0.5rem;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }

  @media (min-width: 640px) {
    .prose h2 {
      font-size: 1.5rem;
      margin-top: 1.5rem;
      margin-bottom: 0.75rem;
    }
  }

  .prose h3 {
    font-size: 1.125rem;
  }

  @media (min-width: 640px) {
    .prose h3 {
      font-size: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .prose h3 {
      font-size: 1.5rem;
    }
  }

  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }

  @media (min-width: 640px) {
    .prose p {
      margin-bottom: 1.5rem;
      line-height: 1.75;
    }
  }

  .prose ul {
    list-style-type: disc;
    margin-bottom: 1.25rem;
    margin-top: 0.75rem;
    padding-left: 1.5rem;
  }

  @media (min-width: 640px) {
    .prose ul {
      margin-bottom: 1.5rem;
      margin-top: 1rem;
      padding-left: 2rem;
    }
  }

  .prose ol {
    list-style-type: decimal;
    margin-bottom: 1.25rem;
    margin-top: 0.75rem;
    padding-left: 1.5rem;
  }

  @media (min-width: 640px) {
    .prose ol {
      margin-bottom: 1.5rem;
      margin-top: 1rem;
      padding-left: 2rem;
    }
  }

  .prose li {
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
    line-height: 1.7;
  }

  @media (min-width: 640px) {
    .prose li {
      margin-bottom: 0.75rem;
      padding-left: 0.5rem;
      line-height: 1.75;
    }
  }

  .prose li::marker {
    color: #1d4ed8;
    font-weight: 600;
  }

  .prose a {
    color: #1d4ed8;
    text-decoration: underline;
    font-weight: 500;
  }

  .prose a:hover {
    color: #1e40af;
  }

  .prose blockquote {
    border-left: 3px solid #1d4ed8;
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: #4b5563;
    background: #f3f4f6;
    padding: 1rem;
    border-radius: 0.5rem;
  }

  @media (min-width: 640px) {
    .prose blockquote {
      border-left: 4px solid #1d4ed8;
      padding-left: 1.5rem;
      margin: 2rem 0;
      padding: 1.5rem;
    }
  }

  .prose strong {
    font-weight: 700;
    color: #111827;
  }

  .prose hr {
    margin: 2rem 0;
    border: none;
    border-top: 2px solid #e5e7eb;
  }

  @media (min-width: 640px) {
    .prose hr {
      margin: 2.5rem 0;
    }
  }

  .prose code {
    background: #f3f4f6;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.85em;
    font-family: monospace;
  }

  @media (min-width: 640px) {
    .prose code {
      padding: 0.25rem 0.5rem;
      font-size: 0.9em;
    }
  }

  .prose em {
    font-style: italic;
    color: #4b5563;
  }
</style>

<script>
  const copyBtn = document.getElementById('copy-link-btn');
  const copyText = document.getElementById('copy-link-text');
  
  copyBtn?.addEventListener('click', async () => {
    const url = copyBtn.getAttribute('data-url');
    if (url) {
      try {
        await navigator.clipboard.writeText(url);
        if (copyText) {
          copyText.textContent = 'Copied!';
          setTimeout(() => {
            copyText.textContent = 'Copy link';
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy:', err);
      }
    }
  });
</script>
