---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { Shield, Home, Search } from 'lucide-react';
---

<Layout 
  title="Page Not Found | ProtectMyMobile"
  description="The page you are looking for does not exist. Return to ProtectMyMobile homepage."
>
  <HeaderMobile client:idle />
  
  <main id="main-content" class="bg-neutral-100 min-h-[70vh] flex items-center justify-center">
    <div class="container mx-auto px-4 py-6 sm:py-8 md:py-12 text-center">
      <div class="bg-card rounded-xl sm:rounded-2xl shadow-xl p-4 sm:p-6 md:p-8 lg:p-12 max-w-2xl mx-auto">
        <div class="inline-flex items-center justify-center p-3 sm:p-4 bg-destructive-muted rounded-full mb-4 sm:mb-6">
          <Shield class="h-10 w-10 sm:h-12 sm:w-12 md:h-16 md:w-16 text-destructive" />
        </div>
        
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-3 sm:mb-4">404</h1>
        <h2 class="text-lg sm:text-xl md:text-2xl font-semibold text-neutral-700 mb-4 sm:mb-6">Page Not Found</h2>
        
        <p class="text-sm sm:text-base md:text-lg text-neutral-600 mb-6 sm:mb-8 max-w-md mx-auto">
          Sorry, we couldn't find the page you're looking for. It might have been moved, deleted, or never existed.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
          <a
            href="/"
            class="inline-flex items-center justify-center px-4 sm:px-6 py-2.5 sm:py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary/90 transition-colors text-sm sm:text-base"
          >
            <Home class="h-4 w-4 sm:h-5 sm:w-5 mr-2" />
            Back to Home
          </a>

          <a
            href="/resources"
            class="inline-flex items-center justify-center px-4 sm:px-6 py-2.5 sm:py-3 bg-card border-2 border-neutral-200 text-neutral-700 rounded-lg font-semibold hover:bg-neutral-50 transition-colors text-sm sm:text-base"
          >
            <Search class="h-4 w-4 sm:h-5 sm:w-5 mr-2" />
            Browse Resources
          </a>
        </div>
        
        <div class="mt-8 sm:mt-10 md:mt-12 pt-6 sm:pt-8 border-t border-neutral-100 text-xs sm:text-sm text-neutral-500">
          <p>If you believe this is an error, please <a href="/contact-us" class="text-primary hover:underline">contact us</a>.</p>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
