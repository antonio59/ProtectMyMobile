---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { Book, Shield, AlertTriangle, Building2, Phone, TrendingUp, Newspaper, ArrowRight, Users, ShoppingBag, MapPin, ExternalLink } from 'lucide-react';

// Every link below was opened and confirmed working on this date.
const externalLinksCheckedDate = "26 August 2026";

const externalResources = [
  {
    name: "Police.uk - contact the police",
    href: "https://www.police.uk/pu/contact-us",
    description: "The national starting point: 999 in an emergency, 101 for non-emergency enquiries, and online reporting forms for your local force. Also links to Crimestoppers if you want to report anonymously.",
  },
  {
    name: "Metropolitan Police - report a crime online",
    href: "https://www.met.police.uk/ro/report/ocr/af/how-to-report-a-crime/",
    description: "Report a theft or robbery in London and get the crime reference number your insurer and network will ask for.",
  },
  {
    name: "Metropolitan Police - protect your mobile phone",
    href: "https://www.met.police.uk/cp/crime-prevention/personal-safety-how-to-stay-safe/mobile-phone-advice/",
    description: "Official Met crime prevention advice on locking your phone, recording your IMEI, and what to do the moment it is taken.",
  },
  {
    name: "Metropolitan Police - phone snatching by bike and moped",
    href: "https://www.met.police.uk/phonesnatch",
    description: "Met guidance on the moped and e-bike snatches that account for much of London's phone theft. Their advice is explicit: never confront a thief for the sake of a phone.",
  },
  {
    name: "Report Fraud (formerly Action Fraud)",
    href: "https://www.reportfraud.police.uk/",
    description: "The national reporting service for fraud and cyber crime in England, Wales and Northern Ireland: use it if your accounts, cards or identity are misused after a theft. In Scotland, report via 101.",
  },
  {
    name: "Information Commissioner's Office - for the public",
    href: "https://ico.org.uk/for-the-public/",
    description: "Your data protection rights, and how to raise a concern if an organisation mishandles your personal data after a device is lost or stolen.",
  },
];
---

<Layout 
  title="Resources - Mobile Security Guides | ProtectMyMobile"
  description="Access comprehensive resources, guides, and information about mobile security, theft prevention, and recovery."
>
  <HeaderMobile client:idle />
  
  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-6xl">

      <!-- Hero Section -->
      <div class="bg-foreground text-background rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-10 mb-6 sm:mb-8">
        <div class="flex items-center gap-2 sm:gap-3 mb-2 sm:mb-3">
          <div class="bg-background/20 p-2 sm:p-3 rounded-xl">
            <Book className="size-6 sm:size-8" />
          </div>
          <h1 class="text-xl sm:text-2xl md:text-3xl font-bold">Resources</h1>
        </div>
        <p class="text-neutral-300 text-xs sm:text-sm md:text-base mb-4 sm:mb-6">
          Everything you need to protect your mobile and respond to theft.
        </p>

        <!-- Quick Navigation -->
        <div class="flex flex-wrap gap-2">
          <a href="/the-problem" class="inline-flex items-center gap-1.5 sm:gap-2 min-h-11 px-3 sm:px-4 py-1.5 sm:py-2 bg-background/20 hover:bg-background/30 rounded-lg text-xs sm:text-sm font-medium transition-colors">
            <AlertTriangle className="size-4" />
            The Problem
          </a>
          <a href="/statistics" class="inline-flex items-center gap-1.5 sm:gap-2 min-h-11 px-3 sm:px-4 py-1.5 sm:py-2 bg-background/20 hover:bg-background/30 rounded-lg text-xs sm:text-sm font-medium transition-colors">
            <TrendingUp className="size-4" />
            Statistics
          </a>
          <a href="/news" class="inline-flex items-center gap-1.5 sm:gap-2 min-h-11 px-3 sm:px-4 py-1.5 sm:py-2 bg-background/20 hover:bg-background/30 rounded-lg text-xs sm:text-sm font-medium transition-colors">
            <Newspaper className="size-4" />
            News
          </a>
          <a href="/guides/charger-photo-alert" class="inline-flex items-center gap-1.5 sm:gap-2 min-h-11 px-3 sm:px-4 py-1.5 sm:py-2 bg-background/20 hover:bg-background/30 rounded-lg text-xs sm:text-sm font-medium transition-colors">
            <Shield className="size-4" />
            Charger photo alert
          </a>
          <a href="/london-visitor-safety" class="inline-flex items-center gap-1.5 sm:gap-2 min-h-11 px-3 sm:px-4 py-1.5 sm:py-2 bg-background/20 hover:bg-background/30 rounded-lg text-xs sm:text-sm font-medium transition-colors">
            <MapPin className="size-4" />
            Visitor Safety
          </a>
          <a href="/news?category=safety_slides" class="inline-flex items-center gap-1.5 sm:gap-2 min-h-11 px-3 sm:px-4 py-1.5 sm:py-2 bg-background/20 hover:bg-background/30 rounded-lg text-xs sm:text-sm font-medium transition-colors">
            <AlertTriangle className="size-4" />
            Safety slides
          </a>
        </div>
      </div>
      
      <!-- Main Resources Grid -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <h2 class="text-lg sm:text-xl font-bold mb-4 sm:mb-6">Guides & Tools</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
          
          <!-- Prevention -->
          <a href="/prevention" class="bg-card rounded-xl sm:rounded-2xl transition-all duration-300 overflow-hidden border border-border group">
            <div class="h-1 bg-foreground"></div>
            <div class="p-4 sm:p-6">
              <div class="flex items-start gap-3 sm:gap-4">
                <div class="bg-neutral-100 rounded-xl p-2 sm:p-3 group-hover:scale-110 transition-transform">
                  <Shield className="size-5 sm:size-6 text-foreground" />
                </div>
                <div class="flex-1">
                  <h3 class="font-semibold text-sm sm:text-base mb-1 group-hover:text-primary transition-colors">Prevention Guides</h3>
                  <p class="text-muted-foreground text-xs sm:text-sm">Learn how to secure your device with PIN locks, biometrics, and app-specific security measures.</p>
                </div>
                <ArrowRight className="size-5 text-neutral-300 group-hover:text-primary group-hover:translate-x-1 transition-all flex-shrink-0" />
              </div>
            </div>
          </a>

          <!-- Charger photo alert -->
          <a href="/guides/charger-photo-alert" class="bg-card rounded-xl sm:rounded-2xl transition-all duration-300 overflow-hidden border border-border group">
            <div class="h-1 bg-foreground"></div>
            <div class="p-4 sm:p-6">
              <div class="flex items-start gap-3 sm:gap-4">
                <div class="bg-neutral-100 rounded-xl p-2 sm:p-3 group-hover:scale-110 transition-transform">
                  <Shield className="size-5 sm:size-6 text-foreground" />
                </div>
                <div class="flex-1">
                  <h3 class="font-semibold text-sm sm:text-base mb-1 group-hover:text-primary transition-colors">Charger photo alert</h3>
                  <p class="text-muted-foreground text-xs sm:text-sm">iPhone Shortcuts and Android automation to email a front-camera photo and location if a stolen phone is plugged in.</p>
                </div>
                <ArrowRight className="size-5 text-neutral-300 group-hover:text-primary group-hover:translate-x-1 transition-all flex-shrink-0" />
              </div>
            </div>
          </a>

          <!-- Visitor Safety -->
          <a href="/london-visitor-safety" class="bg-card rounded-xl sm:rounded-2xl transition-all duration-300 overflow-hidden border border-border group">
            <div class="h-1 bg-foreground"></div>
            <div class="p-4 sm:p-6">
              <div class="flex items-start gap-3 sm:gap-4">
                <div class="bg-neutral-100 rounded-xl p-2 sm:p-3 group-hover:scale-110 transition-transform">
                  <MapPin className="size-5 sm:size-6 text-foreground" />
                </div>
                <div class="flex-1">
                  <h3 class="font-semibold text-sm sm:text-base mb-1 group-hover:text-primary-hover transition-colors">Visitor Safety (London)</h3>
                  <p class="text-muted-foreground text-xs sm:text-sm">Tourist-focused guidance: pre-arrival prep, where thefts happen, and rapid steps if you're targeted.</p>
                </div>
                <ArrowRight className="size-5 text-neutral-300 group-hover:text-primary group-hover:translate-x-1 transition-all flex-shrink-0" />
              </div>
            </div>
          </a>

          <!-- Emergency -->
          <a href="/emergency" class="bg-card rounded-xl sm:rounded-2xl transition-all duration-300 overflow-hidden border border-border group">
            <div class="h-1 bg-foreground"></div>
            <div class="p-4 sm:p-6">
              <div class="flex items-start gap-3 sm:gap-4">
                <div class="bg-destructive-muted rounded-xl p-2 sm:p-3 group-hover:scale-110 transition-transform">
                  <AlertTriangle className="size-5 sm:size-6 text-destructive" />
                </div>
                <div class="flex-1">
                  <h3 class="font-semibold text-sm sm:text-base mb-1 group-hover:text-destructive transition-colors">Emergency Response</h3>
                  <p class="text-muted-foreground text-xs sm:text-sm">Step-by-step instructions for immediate action if your mobile has been stolen.</p>
                </div>
                <ArrowRight className="size-5 text-neutral-300 group-hover:text-destructive group-hover:translate-x-1 transition-all flex-shrink-0" />
              </div>
            </div>
          </a>

          <!-- Scenarios -->
          <a href="/news?category=safety_slides" class="bg-card rounded-xl sm:rounded-2xl transition-all duration-300 overflow-hidden border border-border group">
            <div class="h-1 bg-foreground"></div>
            <div class="p-4 sm:p-6">
              <div class="flex items-start gap-3 sm:gap-4">
                <div class="bg-neutral-100 rounded-xl p-2 sm:p-3 group-hover:scale-110 transition-transform">
                  <AlertTriangle className="size-5 sm:size-6 text-foreground" />
                </div>
                <div class="flex-1">
                  <h3 class="font-semibold text-sm sm:text-base mb-1 group-hover:text-foreground transition-colors">Safety slides</h3>
                  <p class="text-muted-foreground text-xs sm:text-sm">Slide-by-slide visuals for common theft setups (moped snatch, transport, nightlife) with prevention cues.</p>
                </div>
                <ArrowRight className="size-5 text-neutral-300 group-hover:text-foreground group-hover:translate-x-1 transition-all flex-shrink-0" />
              </div>
            </div>
          </a>

          <!-- Security Checkup -->
          <a href="/security-checkup" class="bg-card rounded-xl sm:rounded-2xl transition-all duration-300 overflow-hidden border border-border group">
            <div class="h-1 bg-foreground"></div>
            <div class="p-4 sm:p-6">
              <div class="flex items-start gap-3 sm:gap-4">
                <div class="bg-neutral-100 rounded-xl p-2 sm:p-3 group-hover:scale-110 transition-transform">
                  <Shield className="size-5 sm:size-6 text-foreground" />
                </div>
                <div class="flex-1">
                  <h3 class="font-semibold text-sm sm:text-base mb-1 group-hover:text-foreground transition-colors">Security Checkup</h3>
                  <p class="text-muted-foreground text-xs sm:text-sm">Take our quick assessment to identify security gaps and get personalised recommendations.</p>
                </div>
                <ArrowRight className="size-5 text-neutral-300 group-hover:text-foreground group-hover:translate-x-1 transition-all flex-shrink-0" />
              </div>
            </div>
          </a>

          <!-- Community Experiences -->
          <a href="/community-experiences" class="bg-card rounded-xl sm:rounded-2xl transition-all duration-300 overflow-hidden border border-border group">
            <div class="h-1 bg-foreground"></div>
            <div class="p-4 sm:p-6">
              <div class="flex items-start gap-3 sm:gap-4">
                <div class="bg-neutral-100 rounded-xl p-2 sm:p-3 group-hover:scale-110 transition-transform">
                  <Users className="size-5 sm:size-6 text-foreground" />
                </div>
                <div class="flex-1">
                  <h3 class="font-semibold text-sm sm:text-base mb-1 group-hover:text-primary transition-colors">Community Experiences</h3>
                  <p class="text-muted-foreground text-xs sm:text-sm">Read real stories from theft victims and share your own experience to help others.</p>
                </div>
                <ArrowRight className="size-5 text-neutral-300 group-hover:text-primary group-hover:translate-x-1 transition-all flex-shrink-0" />
              </div>
            </div>
          </a>

          <!-- Product Recommendations -->
          <a href="/products" class="bg-card rounded-xl sm:rounded-2xl transition-all duration-300 overflow-hidden border border-border group">
            <div class="h-1 bg-foreground"></div>
            <div class="p-4 sm:p-6">
              <div class="flex items-start gap-3 sm:gap-4">
                <div class="bg-neutral-100 rounded-xl p-2 sm:p-3 group-hover:scale-110 transition-transform">
                  <ShoppingBag className="size-5 sm:size-6 text-foreground" />
                </div>
                <div class="flex-1">
                  <h3 class="font-semibold text-sm sm:text-base mb-1 group-hover:text-foreground transition-colors">Product Recommendations</h3>
                  <p class="text-muted-foreground text-xs sm:text-sm">Discover products that can help protect your phone from theft.</p>
                </div>
                <ArrowRight className="size-5 text-neutral-300 group-hover:text-foreground group-hover:translate-x-1 transition-all flex-shrink-0" />
              </div>
            </div>
          </a>
          
        </div>
      </section>
      
      <!-- Directories Section -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <h2 class="text-lg sm:text-xl font-bold mb-4 sm:mb-6">Directories</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">

          <!-- Banks -->
          <a href="/banks" class="bg-card rounded-xl sm:rounded-2xl transition-all duration-300 overflow-hidden border border-border group">
            <div class="h-1 bg-foreground"></div>
            <div class="p-4 sm:p-6">
              <div class="flex items-start gap-3 sm:gap-4">
                <div class="bg-neutral-100 rounded-xl p-2 sm:p-3 group-hover:scale-110 transition-transform">
                  <Building2 className="size-5 sm:size-6 text-foreground" />
                </div>
                <div class="flex-1">
                  <h3 class="font-semibold text-sm sm:text-base mb-1 group-hover:text-primary transition-colors">UK Bank Directory</h3>
                  <p class="text-muted-foreground text-xs sm:text-sm">Emergency contact information for all major UK banks to secure your accounts.</p>
                </div>
                <ArrowRight className="size-5 text-neutral-300 group-hover:text-primary group-hover:translate-x-1 transition-all flex-shrink-0" />
              </div>
            </div>
          </a>

          <!-- Mobile Providers -->
          <a href="/mobile-providers" class="bg-card rounded-xl sm:rounded-2xl transition-all duration-300 overflow-hidden border border-border group">
            <div class="h-1 bg-foreground"></div>
            <div class="p-4 sm:p-6">
              <div class="flex items-start gap-3 sm:gap-4">
                <div class="bg-neutral-100 rounded-xl p-2 sm:p-3 group-hover:scale-110 transition-transform">
                  <Phone className="size-5 sm:size-6 text-foreground" />
                </div>
                <div class="flex-1">
                  <h3 class="font-semibold text-sm sm:text-base mb-1 group-hover:text-foreground transition-colors">Mobile Provider Directory</h3>
                  <p class="text-muted-foreground text-xs sm:text-sm">Contact details for UK mobile networks to report theft and block your SIM.</p>
                </div>
                <ArrowRight className="size-5 text-neutral-300 group-hover:text-foreground group-hover:translate-x-1 transition-all flex-shrink-0" />
              </div>
            </div>
          </a>

        </div>
      </section>
      
      <!-- Data & Insights Section -->
      <section>
        <h2 class="text-lg sm:text-xl font-bold mb-4 sm:mb-6">Data & Insights</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">

          <!-- The Problem -->
          <a href="/the-problem" class="bg-card rounded-xl sm:rounded-2xl transition-all duration-300 overflow-hidden border border-border group">
            <div class="h-1 bg-foreground"></div>
            <div class="p-4 sm:p-6">
              <div class="flex items-start gap-3 sm:gap-4">
                <div class="bg-neutral-100 rounded-xl p-2 sm:p-3 group-hover:scale-110 transition-transform">
                  <AlertTriangle className="size-5 sm:size-6 text-foreground" />
                </div>
                <div class="flex-1">
                  <h3 class="font-semibold text-sm sm:text-base mb-1 group-hover:text-primary transition-colors">The Problem</h3>
                  <p class="text-muted-foreground text-xs sm:text-sm">Understand the UK phone theft epidemic and how thieves operate.</p>
                </div>
                <ArrowRight className="size-5 text-neutral-300 group-hover:text-primary group-hover:translate-x-1 transition-all flex-shrink-0" />
              </div>
            </div>
          </a>

          <!-- Statistics -->
          <a href="/statistics" class="bg-card rounded-xl sm:rounded-2xl transition-all duration-300 overflow-hidden border border-border group">
            <div class="h-1 bg-foreground"></div>
            <div class="p-4 sm:p-6">
              <div class="flex items-start gap-3 sm:gap-4">
                <div class="bg-neutral-100 rounded-xl p-2 sm:p-3 group-hover:scale-110 transition-transform">
                  <TrendingUp className="size-5 sm:size-6 text-foreground" />
                </div>
                <div class="flex-1">
                  <h3 class="font-semibold text-sm sm:text-base mb-1 group-hover:text-primary transition-colors">Statistics & Hotspots</h3>
                  <p class="text-muted-foreground text-xs sm:text-sm">View theft data, hotspot rankings, and trends across the UK.</p>
                </div>
                <ArrowRight className="size-5 text-neutral-300 group-hover:text-primary group-hover:translate-x-1 transition-all flex-shrink-0" />
              </div>
            </div>
          </a>

        </div>
      </section>

      <!-- External UK Resources -->
      <section class="mt-6 sm:mt-8 md:mt-10">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-4 sm:mb-6">
          <h2 class="text-lg sm:text-xl font-bold">Official UK services</h2>
          <p class="text-xs text-muted-foreground">Checked {externalLinksCheckedDate}</p>
        </div>
        <p class="text-muted-foreground text-xs sm:text-sm mb-4">
          These are the organisations that can actually take a report or act on your case. We are not affiliated with any of them.
        </p>
        <div class="bg-card rounded-xl sm:rounded-2xl overflow-hidden border border-border">
          <div class="h-1 bg-foreground"></div>
          <div class="px-4 sm:px-6">
            {externalResources.map((resource) => (
              <a
                href={resource.href}
                target="_blank"
                rel="noopener noreferrer"
                class="external-resource group"
              >
                <div class="flex items-start gap-3 sm:gap-4">
                  <div class="flex-1">
                    <h3 class="font-semibold text-sm sm:text-base mb-1 group-hover:text-primary transition-colors">{resource.name}</h3>
                    <p class="text-muted-foreground text-xs sm:text-sm">{resource.description}</p>
                  </div>
                  <ExternalLink className="size-5 text-neutral-300 group-hover:text-primary transition-colors flex-shrink-0" />
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

    </div>
  </main>
  
  <Footer />
</Layout>

<style>
  /* One container, hairline rules between entries (see DirectoryEntry.astro) */
  .external-resource {
    display: block;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
  }

  .external-resource:first-child {
    border-top: 0;
  }
</style>
