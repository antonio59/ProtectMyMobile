---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { getBanks, getDirectoryLastVerified } from '../lib/convexData';
import { banks as staticBanks } from '../data/banks';
import { Building2, Search, Phone, AlertCircle, Clock, CheckCircle2, ExternalLink, Shield, ArrowRight } from 'lucide-react';

// Get last verified date from Convex (automatically updated when cron runs)
const verifiedDates = await getDirectoryLastVerified();
const lastVerifiedTimestamp = verifiedDates.banks;
const lastUpdated = lastVerifiedTimestamp 
  ? new Date(lastVerifiedTimestamp).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long', 
      year: 'numeric'
    })
  : 'Pending verification';

// Fetch banks from Convex
const banksData = await getBanks();

// Map Convex data to match old format for minimal template changes
const banks = banksData.map(bank => {
  const staticBank = staticBanks.find(b => b.id === bank._id || b.name === bank.name);
  return {
    id: bank._id,
    name: bank.name,
    colour: staticBank?.colour || staticBank?.color || '#16130F', // Use static color if available
    initial: bank.name.charAt(0).toUpperCase(),
    emergencyContact: {
      uk: bank.phone || 'In-app chat only',
      abroad: bank.fraudContact || null,
      available: 'Available 24/7',
    },
    website: bank.website,
    category: bank.category,
    // Default steps - we can enhance this later with database fields
    steps: [
      'Call the emergency number immediately',
      'Report any suspicious transactions',
      'Request to freeze your accounts/cards',
      'Change your online banking password',
      'Log out of all banking apps on the stolen device',
    ],
    additionalInfo: bank.phone ? null : 'This bank offers support primarily through in-app chat or web messaging.',
  };
});

// Sort banks alphabetically
const sortedBanks = [...banks].sort((a, b) => a.name.localeCompare(b.name));

// Group by category for filtering
const categories = {
  high_street: sortedBanks.filter(b => b.category === 'high_street'),
  online: sortedBanks.filter(b => b.category === 'online'),
  building_society: sortedBanks.filter(b => b.category === 'building_society'),
  challenger: sortedBanks.filter(b => b.category === 'challenger'),
};

const banksFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What should I do if my phone is stolen and I have banking apps?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Immediately call your bank's emergency fraud line (listed in our directory) to freeze your accounts. Then change your online banking password from a secure device, log out of all banking apps on the stolen phone, and monitor your accounts for unauthorised transactions."
      }
    },
    {
      "@type": "Question",
      "name": "Are UK bank fraud lines open 24/7?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, all major UK banks operate 24/7 emergency fraud and lost/stolen card lines. Challenger and digital banks also provide 24/7 in-app support or dedicated emergency numbers. Our directory lists the current emergency contact numbers for over 25 UK banks and building societies."
      }
    },
    {
      "@type": "Question",
      "name": "Can thieves access my bank account if my phone is stolen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If your phone lacks strong security, thieves may bypass the lock screen or use notification previews to access 2FA codes. Prevent this by enabling biometric authentication, using different PINs for banking apps, turning off notification previews on the lock screen, and contacting your bank immediately to flag the theft."
      }
    }
  ]
};
---

<Layout 
  title="UK Bank Directory - Emergency Contact Information | ProtectMyMobile"
  description="Complete directory of UK banks with emergency contact information and step-by-step procedures for securing your accounts if your mobile phone is stolen."
  schema={banksFaqSchema}
>
  <HeaderMobile client:idle />
  
  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-6xl">
      

      <!-- Hero Section -->
      <div class="bg-foreground text-background rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-8 mb-6 ">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-2">
              <Building2 class="size-6 sm:size-8" />
              <h1 class="text-xl sm:text-2xl md:text-3xl font-bold">Bank Directory</h1>
            </div>
            <p class="text-neutral-300 text-sm max-w-2xl">
              Emergency contact numbers for {sortedBanks.length > 0 ? `${sortedBanks.length} ` : ''}UK banks and building societies. 
              Use these to report fraud and secure your accounts if your phone is stolen.
            </p>
          </div>
          <div class="flex items-center gap-2 bg-background/10 px-3 py-1.5 rounded-lg text-xs shrink-0">
            <Clock class="h-3.5 w-3.5" />
            <span>Verified {lastUpdated}</span>
          </div>
        </div>

        <!-- Quick Stats -->
        <div class="mt-5 pt-5 border-t border-background/20 grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-bold">{sortedBanks.length}</div>
            <div class="text-xs text-neutral-300">Banks Listed</div>
          </div>
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-bold">24/7</div>
            <div class="text-xs text-neutral-300">Emergency Lines</div>
          </div>
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-bold">{categories.high_street.length}</div>
            <div class="text-xs text-neutral-300">High Street</div>
          </div>
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-bold">{categories.online.length + categories.challenger.length}</div>
            <div class="text-xs text-neutral-300">Digital Banks</div>
          </div>
        </div>
      </div>

      <!-- Emergency Notice -->
      <div class="mb-6 p-4 bg-destructive-subtle border border-destructive-muted rounded-xl flex items-start gap-3">
        <AlertCircle class="size-5 text-destructive mt-0.5 flex-shrink-0" />
        <div>
          <p class="text-sm text-destructive font-medium">Phone stolen? Act immediately</p>
          <p class="text-xs text-destructive-hover mt-1">
            Call your bank's emergency number below to freeze your accounts. Then follow our 
            <a href="/emergency" class="underline hover:no-underline">emergency guide</a>.
          </p>
        </div>
      </div>

      <div class="mb-6">
        
        <!-- Search Box -->
        <div class="mb-6">
          <div class="relative">
            <Search class="absolute left-3 top-1/2 transform -translate-y-1/2 text-muted-foreground size-5" />
            <label for="bank-search" class="sr-only">Search for your bank</label>
            <input
              type="search"
              id="bank-search"
              placeholder="Search for your bank..."
              class="w-full pl-10 pr-4 py-2 sm:py-3 text-sm sm:text-base border border-input rounded-lg focus:ring-2 focus:ring-primary focus:border-primary"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
            />
          </div>
        </div>

        <!-- Category Filter -->
        <div class="mb-6 flex gap-2 overflow-x-auto whitespace-nowrap">
          <button type="button" class="category-filter min-h-11 px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm rounded-lg bg-primary text-primary-foreground" data-category="all">
            All Banks ({sortedBanks.length})
          </button>
          <button type="button" class="category-filter min-h-11 px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm rounded-lg bg-neutral-200 text-foreground hover:bg-neutral-300" data-category="high_street">
            High Street ({categories.high_street.length})
          </button>
          <button type="button" class="category-filter min-h-11 px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm rounded-lg bg-neutral-200 text-foreground hover:bg-neutral-300" data-category="online">
            Online Banks ({categories.online.length})
          </button>
          <button type="button" class="category-filter min-h-11 px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm rounded-lg bg-neutral-200 text-foreground hover:bg-neutral-300" data-category="building_society">
            Building Societies ({categories.building_society.length})
          </button>
          <button type="button" class="category-filter min-h-11 px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm rounded-lg bg-neutral-200 text-foreground hover:bg-neutral-300" data-category="challenger">
            Challenger Banks ({categories.challenger.length})
          </button>
        </div>
        
        <!-- Banks List -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 sm:gap-4" id="bank-list">
          {sortedBanks.map(bank => (
            <div
              class="bank-card bg-card rounded-2xl  hover: transition-all duration-300 overflow-hidden border border-border hover:-translate-y-1"
              data-category={bank.category}
            >
              <div class="p-4 sm:p-5">
                <div class="flex items-start gap-3 sm:gap-4">
                  <!-- Bank Initial Circle -->
                  <div
                    class="w-10 h-10 sm:size-14 rounded-2xl flex items-center justify-center text-white font-bold text-base sm:text-xl flex-shrink-0 "
                    style={`background-color: ${bank.colour}`}
                  >
                    {bank.initial}
                  </div>

                  <div class="flex-1 min-w-0">
                    <div class="flex items-start justify-between gap-2 mb-2">
                      <div>
                        <h3 class="text-base sm:text-lg font-bold text-foreground truncate">{bank.name}</h3>
                        <span class="text-xs px-2 py-0.5 bg-neutral-100 text-muted-foreground rounded-full mt-1 inline-block">
                          {bank.category.replace('_', ' ')}
                        </span>
                      </div>
                      <a
                        href={bank.website}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs text-muted-foreground hover:text-primary flex items-center gap-1 flex-shrink-0"
                      >
                        <ExternalLink class="size-3" />
                        Website
                      </a>
                    </div>

                    <!-- Emergency Contacts - Prominent -->
                    <div class="mt-3 p-3 bg-destructive border border-destructive-muted rounded-xl">
                      <div class="flex items-center gap-2 mb-1">
                        <Phone class="size-4 text-destructive" />
                        <span class="text-xs font-semibold text-destructive uppercase tracking-wide">Emergency Contact</span>
                      </div>
                      {bank.emergencyContact.uk.startsWith('In-app') ? (
                        <p class="text-destructive-hover font-medium text-xs sm:text-sm">{bank.emergencyContact.uk}</p>
                      ) : (
                        <a href={`tel:${bank.emergencyContact.uk}`} data-bank-name={bank.name} class="text-destructive-hover font-bold text-base sm:text-lg hover:underline block break-all">{bank.emergencyContact.uk}</a>
                      )}
                      {bank.emergencyContact.abroad && (
                        <p class="text-xs text-muted-foreground mt-1 break-all">
                          Abroad: <a href={`tel:${bank.emergencyContact.abroad}`} class="text-destructive-hover hover:underline">{bank.emergencyContact.abroad}</a>
                        </p>
                      )}
                      <p class="text-muted-foreground text-xs mt-1">{bank.emergencyContact.available}</p>
                    </div>

                    <!-- Additional Info -->
                    {bank.additionalInfo && (
                      <div class="mt-3 p-2 bg-primary-subtle rounded-lg text-xs text-primary">
                        <strong>Note:</strong> {bank.additionalInfo}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
        
        <!-- Important Notes -->
        <div class="mt-8 p-4 sm:p-6 bg-neutral-100 border border-border rounded-lg">
          <h3 class="flex items-center font-semibold mb-3 text-foreground text-base sm:text-lg">
            <AlertCircle class="size-5 mr-2" />
            Important Notes:
          </h3>
          <ul class="list-disc pl-5 space-y-2 text-foreground text-xs sm:text-sm">
            <li>Always have your account details ready when calling your bank</li>
            <li>Report any suspicious transactions immediately</li>
            <li>Ask for a reference number for your call/report</li>
            <li>Follow up with written confirmation if required</li>
            <li>The sooner you contact your bank, the better protected you'll be</li>
          </ul>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
  
  <script>
    // Search functionality
    const searchInput = document.getElementById('bank-search') as HTMLInputElement;
    const bankList = document.getElementById('bank-list');
    const categoryButtons = document.querySelectorAll('.category-filter');
    let currentCategory = 'all';
    
    if (searchInput && bankList) {
      searchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase();
        filterBanks(query, currentCategory);
      });
    }

    // Category filter
    categoryButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const category = target.dataset.category || 'all';
        currentCategory = category;
        
        // Update button styles
        categoryButtons.forEach(btn => {
          btn.classList.remove('bg-primary', 'text-primary-foreground');
          btn.classList.add('bg-neutral-200', 'text-foreground');
        });
        target.classList.remove('bg-neutral-200', 'text-foreground');
        target.classList.add('bg-primary', 'text-primary-foreground');
        
        // Filter banks
        const searchQuery = searchInput?.value.toLowerCase() || '';
        filterBanks(searchQuery, category);
      });
    });

    function filterBanks(searchQuery: string, category: string) {
      const bankCards = document.querySelectorAll('.bank-card');
      let visibleCount = 0;

      bankCards.forEach((card) => {
        const bankName = card.textContent?.toLowerCase() || '';
        const bankCategory = (card as HTMLElement).dataset.category || '';

        const matchesSearch = bankName.includes(searchQuery);
        const matchesCategory = category === 'all' || bankCategory === category;

        if (matchesSearch && matchesCategory) {
          (card as HTMLElement).style.display = '';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      // Show/hide no results message
      let noResultsEl = document.getElementById('no-results-message');
      if (visibleCount === 0) {
        if (!noResultsEl) {
          noResultsEl = document.createElement('div');
          noResultsEl.id = 'no-results-message';
          noResultsEl.className = 'col-span-full text-center py-12';
          noResultsEl.innerHTML = `
            <div class="text-muted-foreground mb-2">
              <svg class="size-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </div>
            <p class="text-muted-foreground font-medium">No banks found</p>
            <p class="text-muted-foreground text-sm">Try different search terms or clear your filters</p>
          `;
          bankList?.appendChild(noResultsEl);
        }
        noResultsEl.style.display = '';
      } else if (noResultsEl) {
        noResultsEl.style.display = 'none';
      }
    }

    // Track bank contact clicks
    function trackBankClick(bankName: string) {
      const CONVEX_URL = (window as any).__CONVEX_URL || '';
      if (!CONVEX_URL) return;

      let sessionId = sessionStorage.getItem('pmm_session');
      if (!sessionId) {
        // Use crypto.randomUUID() for secure random ID generation
        sessionId = typeof crypto !== 'undefined' && crypto.randomUUID
          ? crypto.randomUUID()
          : Array.from(crypto.getRandomValues(new Uint8Array(16)))
              .map(b => b.toString(16).padStart(2, '0'))
              .join('');
        sessionStorage.setItem('pmm_session', sessionId);
      }

      fetch(`${CONVEX_URL}/api/mutation`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          path: 'analytics:trackEvent',
          args: {
            eventType: 'bank_contact_clicked',
            metadata: { bankName },
            sessionId,
          },
        }),
      }).catch(() => {});
    }

    // Add click listeners to bank phone links
    document.querySelectorAll('[data-bank-name]').forEach(el => {
      el.addEventListener('click', () => {
        const bankName = el.getAttribute('data-bank-name');
        if (bankName) trackBankClick(bankName);
      });
    });
  </script>
</Layout>
