        <!-- Key Stats -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
          <div class="bg-background/15 rounded-xl p-3 sm:p-4">
            <div class="text-2xl sm:text-3xl font-bold tabular-nums">{location.thefts === null ? 'No data' : location.thefts.toLocaleString()}</div>
            <div class="text-xs sm:text-sm text-background/70 mt-1">{theftsLabel}</div>
          </div>
          <div class="bg-background/15 rounded-xl p-3 sm:p-4">
            <div class="text-2xl sm:text-3xl font-bold tabular-nums">{location.change}</div>
            <div class="text-xs sm:text-sm text-background/70 mt-1">Trend</div>
          </div>
          {rankValue && (
            <div class="bg-background/15 rounded-xl p-3 sm:p-4 col-span-2 md:col-span-1">
              <div class="text-2xl sm:text-3xl font-bold tabular-nums">{ordinal(rankValue)}</div>
              <div class="text-xs sm:text-sm text-background/70 mt-1">{rankScope} ranking</div>
            </div>
          )}
        </div>

        {isBorough && (
          <p class="text-xs text-background/70 mt-4">
            Source: <a href={hotspotsSource.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline">{hotspotsSource.sourceName}</a> (theft from the person within ~1 mile of the borough centre).
          </p>
        )}
      </div>

      <!-- Quick Action Cards -->
      <section class="mb-6 sm:mb-8 grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4">
        <div class="bg-card rounded-lg sm:rounded-2xl  border border-border p-4 sm:p-5 flex gap-3">
          <div class="bg-neutral-100 text-foreground rounded-lg p-2 h-fit">
            <Shield className="size-5" />
          </div>
          <div>
            <p class="text-sm font-semibold text-foreground">Before it happens</p>
            <ul class="text-xs sm:text-sm text-muted-foreground list-disc pl-4 space-y-1 mt-1">
              <li>Enable Find My + biometrics</li>
              <li>Use cross-body phone straps</li>
              <li>Know your IMEI number</li>
            </ul>
          </div>
        </div>
        <div class="bg-card rounded-lg sm:rounded-2xl  border border-border p-4 sm:p-5 flex gap-3">
          <div class="bg-neutral-100 text-foreground rounded-lg p-2 h-fit">
            <AlertTriangle className="size-5" />
          </div>
          <div>
            <p class="text-sm font-semibold text-foreground">Stay alert</p>
            <ul class="text-xs sm:text-sm text-muted-foreground list-disc pl-4 space-y-1 mt-1">
              <li>Avoid kerbside scrolling</li>
              <li>Stay aware in crowds</li>
              <li>Keep phone secure on transport</li>
            </ul>
          </div>
        </div>
        <div class="bg-card rounded-lg sm:rounded-2xl  border border-border p-4 sm:p-5 flex gap-3">
          <div class="bg-destructive-subtle text-destructive rounded-lg p-2 h-fit">
            <Phone className="size-5" />
          </div>
          <div>
            <p class="text-sm font-semibold text-foreground">If stolen</p>
            <ul class="text-xs sm:text-sm text-muted-foreground list-disc pl-4 space-y-1 mt-1">
              <li>Lock/erase immediately</li>
              <li>Block SIM with carrier</li>
              <li>Report to {location.policeForce}</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- High-Risk Hotspots -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl  overflow-hidden border border-border">
          <div class="h-1 bg-foreground"></div>
          <div class="p-4 sm:p-6 md:p-8">
            <div class="flex items-center gap-3 mb-2">
              <Navigation className="size-6 text-destructive" />
              <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-foreground">
                High-Risk Locations in {location.name}
              </h2>
            </div>
            <p class="text-muted-foreground text-xs sm:text-sm md:text-base mb-6">
              These areas see the highest concentration of phone thefts. Be extra vigilant in these locations.
            </p>

            <div class="space-y-3">
              {location.hotspots.map((hotspot) => (
                <div class="flex items-start gap-3 sm:gap-4 p-3 sm:p-4 bg-neutral rounded-xl border border-border">
                  <div class={`px-2.5 py-1 rounded-lg text-xs font-bold flex-shrink-0 ${
                    hotspot.risk === 'Extreme' ? 'bg-destructive text-destructive-foreground' :
                    hotspot.risk === 'Very High' ? 'bg-destructive text-destructive-foreground' :
                    hotspot.risk === 'High' ? 'bg-foreground text-background' :
                    'bg-foreground text-background'
                  }`}>
                    {hotspot.risk}
                  </div>
                  <div class="flex-1 min-w-0">
                    <h3 class="font-bold text-foreground text-sm md:text-base">{hotspot.area}</h3>
                    <p class="text-xs sm:text-sm text-muted-foreground mt-1">{hotspot.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Transport-Specific Risks -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl  overflow-hidden border border-border">
          <div class="h-1 bg-foreground"></div>
          <div class="p-4 sm:p-6 md:p-8">
            <div class="flex items-center gap-3 mb-4">
              <Train className="size-6 text-primary" />
              <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-foreground">
                {location.transport.type} Safety
              </h2>
            </div>

            <div class="grid md:grid-cols-2 gap-4 sm:gap-6">
              <div>
                <h3 class="text-sm font-semibold text-foreground mb-3 flex items-center gap-2">
                  <AlertTriangle className="size-4 text-foreground" />
                  Common Theft Scenarios
                </h3>
                <ul class="space-y-2 text-xs sm:text-sm text-foreground">
                  {location.transport.risks.map((risk) => (
                    <li class="flex gap-2">
                      <span class="text-destructive flex-shrink-0">•</span>
                      <span>{risk}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <h3 class="text-sm font-semibold text-foreground mb-3 flex items-center gap-2">
                  <CheckCircle2 className="size-4 text-foreground" />
                  Protection Tips
                </h3>
                <ul class="space-y-2 text-xs sm:text-sm text-foreground">
                  {location.transport.tips.map((tip) => (
                    <li class="flex gap-2">
                      <span class="text-foreground flex-shrink-0">✓</span>
                      <span>{tip}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Local Police Reporting -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl  overflow-hidden border border-border">
          <div class="h-1 bg-foreground"></div>
          <div class="p-4 sm:p-6 md:p-8">
            <div class="flex items-center gap-3 mb-4">
              <Building2 className="size-6 text-primary" />
              <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-foreground">
                Report to {location.policeForce}
              </h2>
            </div>

            <div class="grid md:grid-cols-2 gap-4 sm:gap-6">
              <div class="p-4 bg-neutral rounded-xl border border-border">
                <h3 class="text-sm font-semibold text-foreground mb-3">Contact Numbers</h3>
                <div class="space-y-2 text-sm">
                  <div class="flex justify-between items-center">
                    <span class="text-muted-foreground">Emergency:</span>
                    <a href={`tel:${location.emergencyPhone}`} class="font-bold text-destructive">{location.emergencyPhone}</a>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-muted-foreground">Non-emergency:</span>
                    <a href={`tel:${location.policePhone}`} class="font-bold text-primary">{location.policePhone}</a>
                  </div>
                </div>
              </div>

              <div class="p-4 bg-primary/5 rounded-xl border border-primary/20">
                <h3 class="text-sm font-semibold text-foreground mb-3">Online Reporting</h3>
                <p class="text-xs sm:text-sm text-muted-foreground mb-3">
                  File a theft report online for faster processing. Keep your crime reference number for insurance claims.
                </p>
                <a
                  href={location.reportingUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-xl font-semibold text-sm  hover:bg-primary-hover transition"
                >
                  Report Online <ArrowRight className="size-4" />
                </a>
              </div>
            </div>

            <div class="mt-4 p-4 bg-primary-subtle border border-border rounded-xl">
              <p class="text-xs sm:text-sm text-primary">
                <strong>What you'll need:</strong> Device details (make/model/IMEI), time and location of theft, description of circumstances.
                Get your IMEI by dialing *#06# before theft occurs.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Prevention & Emergency CTAs -->
      <section class="mb-8 sm:mb-10 md:mb-12">
        <div class="bg-foreground text-background rounded-xl sm:rounded-2xl  p-4 sm:p-6 md:p-8">
          <h2 class="text-xl sm:text-2xl font-bold mb-2">
            {location.residents ? 'Protect Yourself' : 'Essential Guides for Visitors'}
          </h2>
          <p class="text-sm text-background/80 mb-6">
            Complete step-by-step guides to prevent theft and respond quickly if your phone is stolen in {location.name}.
          </p>

          <div class="grid md:grid-cols-3 gap-3 sm:gap-4">
            <a
              href="/prevention"
              class="p-4 sm:p-5 bg-background/10 rounded-xl border border-background/20 hover:bg-background/15 transition-colors group"
            >
              <div class="flex items-center gap-2 mb-2">
                <Shield className="size-5 text-background" />
                <h3 class="font-bold text-base sm:text-lg">Prevention Guide</h3>
              </div>
              <p class="text-xs sm:text-sm text-background/70 mb-3">
                Security settings, protective gear, and habits to avoid becoming a target.
              </p>
              <div class="flex items-center gap-2 text-sm font-semibold text-background group-hover:gap-3 transition-all">
                Read guide <ArrowRight className="size-4" />
              </div>
            </a>

            <a
              href="/emergency"
              class="p-4 sm:p-5 bg-background/10 rounded-xl border border-background/20 hover:bg-background/15 transition-colors group"
            >
              <div class="flex items-center gap-2 mb-2">
                <AlertTriangle className="size-5 text-destructive" />
                <h3 class="font-bold text-base sm:text-lg">Emergency Steps</h3>
              </div>
              <p class="text-xs sm:text-sm text-background/70 mb-3">
                Immediate actions: lock device, block SIM, secure banking, report to police.
              </p>
              <div class="flex items-center gap-2 text-sm font-semibold text-destructive group-hover:gap-3 transition-all">
                Get help now <ArrowRight className="size-4" />
              </div>
            </a>

            <a
              href="/statistics"
              class="p-4 sm:p-5 bg-background/10 rounded-xl border border-background/20 hover:bg-background/15 transition-colors group"
            >
              <div class="flex items-center gap-2 mb-2">
                <TrendingUp className="size-5 text-background" />
                <h3 class="font-bold text-base sm:text-lg">UK Statistics</h3>
              </div>
              <p class="text-xs sm:text-sm text-background/70 mb-3">
                See theft data for all UK cities, seasonal trends, and high-risk times.
              </p>
              <div class="flex items-center gap-2 text-sm font-semibold text-background group-hover:gap-3 transition-all">
                View data <ArrowRight className="size-4" />
              </div>
            </a>
          </div>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
