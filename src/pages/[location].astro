      .sort((a, b) => (b.thefts ?? 0) - (a.thefts ?? 0))
      .map((l, i) => [l.slug, i + 1] as [string, number])
  );

  return locations.map((location) => ({
    params: { location: location.slug },
    props: {
      location: {
        ...location,
        boroughRank: 'boroughRank' in location ? location.boroughRank : null,
        ukRank: ukRanks.get(location.slug) ?? null,
      }
    }
  }));
