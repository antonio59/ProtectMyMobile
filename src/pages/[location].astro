const { location } = Astro.props;

// Ordinal for any number, not just 1-3.
function ordinal(n: number): string {
  const rem100 = n % 100;
  if (rem100 >= 11 && rem100 <= 13) return `${n}th`;
  return `${n}${['th', 'st', 'nd', 'rd'][n % 10] ?? 'th'}`;
}

// One ranking value, read by both the hero badge and the ranking tile so the two
// can never contradict each other. Boroughs rank within London, cities within the UK.
const isBorough = location.boroughRank != null;
const rankValue: number | null = location.boroughRank ?? location.ukRank ?? null;
const rankScope = isBorough ? 'London borough' : 'UK city';
const theftsLabel = location.thefts === null
  ? `Not published for ${location.name}`
  : `Thefts in ${location.year}`;

const pageTitle = `Phone Theft in ${location.name} | Prevention & Emergency Guide`;
const pageDescription = `${location.description} Learn how to protect your phone in ${location.name} and what to do if it's stolen.`;

// Location-specific schema with local data
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": pageTitle,
    "description": pageDescription,
    "about": {
      "@type": "Place",
      "name": location.fullName,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": location.name,
        "addressCountry": "GB"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": `How to protect your phone in ${location.name}`,
    "description": `Practical steps to prevent phone theft in ${location.name} and respond if your device is stolen.`,
    "step": [
      {
        "@type": "HowToStep",
        "name": "Prevention",
        "text": `Enable device security features, use phone straps, avoid high-risk areas in ${location.name}, and stay alert in crowded locations.`
      },
      {
        "@type": "HowToStep",
        "name": "Immediate Response",
        "text": "If stolen, immediately lock/erase device via Find My, block SIM with carrier, contact bank, and report to police."
      },
