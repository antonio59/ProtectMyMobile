---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { getNewsPosts, getMonthlyTrends } from '../lib/convexData';
import { isUkPhoneTheftStory, sanitizeNewsExcerpt } from '../lib/news/geo';
import {
  AlertTriangle,
  ArrowRight,
  Shield,
} from "lucide-react";
import AnimatedNewsSection from '../components/AnimatedNewsSection';
import AnimatedResources from '../components/AnimatedResources';
import TheftTrendsChart from '../components/TheftTrendsChart';
import StatShareGrid from '../components/StatShareGrid';
import { londonHotspots } from '../data/hotspots';

let latestNews: any[] = [];
let trendsData: { months: string[]; locations: string[]; data: Array<{ month: string; label: string; total: number; [key: string]: string | number }> } | null = null;
try {
  const posts = await getNewsPosts(true);
  latestNews = posts
    .filter((post) =>
      isUkPhoneTheftStory({
        title: post.title,
        excerpt: post.excerpt,
        sourceUrl: post.sourceUrl,
        sourceName: post.sourceName,
      }),
    )
    .map((post) => ({
      ...post,
      excerpt: sanitizeNewsExcerpt(post.excerpt, "UK phone theft coverage."),
    }))
    .slice(0, 3);
} catch (e: unknown) {
  console.error('Error fetching news:', e);
}

try {
  trendsData = await getMonthlyTrends(6);
} catch (e: unknown) {
  console.error('Error fetching trends:', e);
}

const westminster = londonHotspots.find((h) => h.borough === 'Westminster') ?? londonHotspots[0];
---

<Layout
  title="London phone theft: data, prevention and recovery | ProtectMyMobile"
  description="A phone is stolen in London every seven minutes. Live police.uk theft data, prevention checklists, and a step-by-step emergency guide if yours is taken."
  canonicalPath="/"
  schema={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "ProtectMyMobile",
    "description": "UK phone theft data, prevention checklists, and a step-by-step emergency guide."
  }}
>
  <HeaderMobile client:idle />

  <main id="main-content" class="bg-background">
    <div class="container mx-auto px-4 py-8 max-w-7xl">

      <section class="mb-10 sm:mb-12">
        <div class="bg-foreground text-background rounded-3xl overflow-hidden">
          <div class="relative">
            <img
              src="/images/hero-london.jpg"
              alt=""
              aria-hidden="true"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full aspect-[3/4] min-[420px]:aspect-[4/5] sm:aspect-[16/9] md:aspect-[21/9] object-cover object-[70%_center]"
            />
            <div class="hero-scrim absolute inset-0"></div>
            <div class="hero-overlay absolute inset-0 flex flex-col justify-center p-4 sm:p-6 md:p-10 lg:p-12">
              <div class="max-w-3xl">
                <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-background mb-4 sm:mb-6">
                  A phone is stolen in London every seven minutes.
                </h1>
                <div class="flex flex-col sm:flex-row gap-2 sm:gap-4 mb-4 sm:mb-6">
                  <a
                    href="/prevention"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 sm:px-6 sm:py-3 text-sm sm:text-base bg-card text-foreground rounded-xl font-semibold hover:bg-neutral-100 transition-all hover-lift touch-target"
                  >
                    <Shield className="size-4 sm:size-5" />
                    <span>Protect your phone</span>
                  </a>
                  <a
                    href="/emergency"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 sm:px-6 sm:py-3 text-sm sm:text-base bg-destructive text-destructive-foreground rounded-xl font-semibold hover:bg-destructive-hover transition-all hover-lift touch-target"
                  >
                    <AlertTriangle className="size-4 sm:size-5" />
                    <span>Phone stolen? Act now</span>
                  </a>
                </div>
                <p class="text-xs sm:text-sm text-background/70 max-w-2xl">
                  <span class="font-semibold text-background">117,211</span> stolen in 2024 (Met FOI)<span class="text-background/40"> · </span><span class="font-semibold text-background">down 12.3%</span> in 2025<span class="text-background/40"> · </span><a href="/statistics" class="underline underline-offset-2 decoration-background/40 hover:text-background transition-colors">Stats and sources</a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <nav class="mb-10 sm:mb-12 flex flex-wrap gap-x-6 gap-y-2 text-sm sm:text-base border-b border-border pb-6" aria-label="Next steps">
        <a href="/the-problem" class="font-semibold text-foreground hover:text-destructive underline-offset-4 hover:underline">How thieves operate</a>
        <a href="/london-visitor-safety" class="font-semibold text-foreground hover:text-destructive underline-offset-4 hover:underline">Visitor safety</a>
        <a href="/statistics" class="font-semibold text-foreground hover:text-destructive underline-offset-4 hover:underline">Hotspots and FOI data</a>
        <a href="/press" class="font-semibold text-foreground hover:text-destructive underline-offset-4 hover:underline">For journalists</a>
      </nav>

      {latestNews.length > 0 && (
        <AnimatedNewsSection client:visible news={latestNews} />
      )}

      <StatShareGrid
        client:visible
        cards={[
          {
            kicker: "London 2025",
            body: "One phone stolen every 7 minutes.",
            source: "Source: Met Police, phones recorded stolen in London, 2025",
            variant: "ink",
          },
          {
            kicker: "One borough",
            body: `${westminster.thefts.toLocaleString("en-GB")} phones taken in Westminster alone.`,
            source: `Source: ${westminster.sourceName}`,
            variant: "paper",
          },
          {
            kicker: "Do this today",
            body: "Know your IMEI before a thief does.",
            source: "Dial *#06# and store the number somewhere that is not your phone.",
            variant: "outline",
          },
        ]}
      />

      <section class="mb-8 sm:mb-12">
        <a href="/news?category=safety_slides" class="block bg-foreground text-background overflow-hidden group rounded-2xl">
          <div class="p-5 sm:p-8 md:p-10">
            <p class="text-xs sm:text-sm font-bold uppercase tracking-[0.15em] text-background/70 mb-2 sm:mb-4">Safety slides</p>
            <h2 class="text-xl sm:text-2xl md:text-3xl leading-tight text-background mb-2">See how theft happens</h2>
            <p class="text-sm sm:text-base text-neutral-400 max-w-2xl mb-4">
              Short playbooks on moped snatches, transport grabs and nightlife.
            </p>
            <span class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wide group-hover:gap-3 transition-all">
              View the playbooks <ArrowRight className="size-4" />
            </span>
          </div>
        </a>
      </section>

      {trendsData && trendsData.data.length > 0 && (
        <section class="mb-8 sm:mb-12">
          <div class="bg-card rounded-2xl border border-border p-4 sm:p-6 md:p-8">
            <TheftTrendsChart client:visible />
          </div>
        </section>
      )}

      <AnimatedResources client:visible />

    </div>
  </main>
  
  <Footer />
</Layout>

<style>
  .hero-scrim {
    background-color: rgb(22 19 15 / 62%);
  }

  .hero-overlay {
    --color-background: #faf8f5;
    --color-foreground: #16130f;
    --color-card: #faf8f5;
    --color-card-foreground: #16130f;
    --color-neutral-100: #f2eee6;
  }
</style>
