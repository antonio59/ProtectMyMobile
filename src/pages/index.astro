---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { getNewsPosts } from '../lib/convexData';
import {
  Shield,
  AlertTriangle,
  Newspaper,
  MapPin,
  TrendingUp,
  Calendar,
  ArrowRight,
  Phone,
  Building2,
  Clock,
  Users,
} from "lucide-react";
import AnimatedHero from '../components/AnimatedHero';
import AnimatedNewsSection from '../components/AnimatedNewsSection';
import AnimatedStats from '../components/AnimatedStats';
import AnimatedResources from '../components/AnimatedResources';

// Fetch latest news posts
let latestNews = [];
try {
  const posts = await getNewsPosts(true);
  latestNews = posts.slice(0, 3); // Get 3 most recent
} catch (e) {
  console.error('Error fetching news:', e);
}

function formatDate(dateValue: string | number) {
  const date = typeof dateValue === 'number' ? new Date(dateValue) : new Date(dateValue);
  return date.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric'
  });
}

// Category border colors for visual coding
const categoryBorderColors: Record<string, string> = {
  arrest: 'border-red-500',
  law_changes: 'border-orange-500',
  statistics: 'border-teal-500',
  prevention_tip: 'border-green-500',
  news: 'border-blue-500',
}
---

<Layout 
  title="Mobile Security & Theft Prevention | ProtectMyMobile"
  description="Protect your mobile from theft with UK-specific guides, emergency response steps, and real-time theft data. Free resources for all UK residents."
>
  <HeaderMobile client:load />
  
  <main class="bg-[#f3f2f1]">
    <div class="container mx-auto px-4 py-8 max-w-7xl">
      
      <!-- Animated Hero Section -->
      <AnimatedHero client:load />

      <!-- The Problem Section -->
      <section class="mb-12">
        <div class="bg-gradient-to-br from-neutral-900 to-neutral-800 rounded-2xl shadow-2xl overflow-hidden">
          <div class="grid md:grid-cols-2 gap-0">
            <!-- Video Side -->
            <div class="relative aspect-video md:aspect-auto">
              <video 
                autoplay 
                loop 
                muted 
                playsinline
                class="w-full h-full object-cover object-[30%_center]"
              >
                <source src="/videos/phone-theft-animation.mp4" type="video/mp4" />
              </video>
              <div class="absolute inset-0 bg-gradient-to-r from-transparent to-neutral-900/50 md:block hidden"></div>
            </div>
            
            <!-- Content Side -->
            <div class="p-6 md:p-10 flex flex-col justify-center">
              <div class="inline-flex items-center gap-2 bg-red-500/20 text-red-400 rounded-full px-4 py-1.5 text-sm font-medium w-fit mb-4">
                <AlertTriangle class="h-4 w-4" />
                UK Theft Crisis
              </div>
              
              <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
                Blink and it's gone.
              </h2>
              
              <p class="text-neutral-300 mb-6">
                Phone theft has reached epidemic levels in the UK. Organised gangs use bikes, mopeds, and distraction tactics to snatch phones in seconds.
              </p>
              
              <!-- Quick Stats -->
              <div class="grid grid-cols-2 gap-4 mb-6">
                <div class="bg-white/5 rounded-xl p-4">
                  <div class="text-2xl font-bold text-red-400">78,000+</div>
                  <div class="text-xs text-neutral-400">Stolen in London (2023)</div>
                </div>
                <div class="bg-white/5 rounded-xl p-4">
                  <div class="text-2xl font-bold text-orange-400">44%</div>
                  <div class="text-xs text-neutral-400">Increase since 2022</div>
                </div>
                <div class="bg-white/5 rounded-xl p-4">
                  <div class="flex items-center gap-1 text-2xl font-bold text-yellow-400">
                    <Clock class="h-5 w-5" />
                    3 min
                  </div>
                  <div class="text-xs text-neutral-400">One stolen every</div>
                </div>
                <div class="bg-white/5 rounded-xl p-4">
                  <div class="text-2xl font-bold text-teal-400">6%</div>
                  <div class="text-xs text-neutral-400">Recovery rate</div>
                </div>
              </div>
              
              <a 
                href="/the-problem" 
                class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-red-600 hover:bg-red-700 text-white rounded-xl font-semibold transition-colors w-fit"
              >
                Learn How Thieves Operate
                <ArrowRight class="h-4 w-4" />
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Animated News Section -->
      <AnimatedNewsSection client:load news={latestNews} />

      <!-- Featured Tool: Timelapse -->
      <section class="mb-12">
        <a href="/timelapse" class="block bg-gradient-to-r from-teal-600 to-cyan-600 rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-shadow group">
          <div class="p-8 md:p-12 text-white">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <div class="inline-flex items-center gap-2 bg-white/20 rounded-full px-4 py-2 mb-4">
                  <MapPin class="h-5 w-5 mr-2 sm:mr-3 flex-shrink-0" />
                  <span class="font-medium">NEW FEATURE</span>
                </div>
                <h2 class="flex items-center text-3xl md:text-4xl font-bold mb-4">
                  UK Theft Hotspots Timelapse
                </h2>
                <p class="text-xl text-teal-100 mb-6 max-w-2xl">
                  Explore an interactive map showing where and when mobile thefts occur across the UK. 
                  See patterns emerge over time and identify high-risk areas.
                </p>
                <div class="inline-flex items-center gap-2 text-lg font-semibold group-hover:gap-4 transition-all">
                  Explore the Map <ArrowRight class="h-5 w-5 mr-2 sm:mr-3 flex-shrink-0" />
                </div>
              </div>
              <div class="hidden md:block">
                <MapPin class="h-32 w-32 text-white/30" />
              </div>
            </div>
          </div>
        </a>
      </section>

      <!-- Animated Quick Stats -->
      <AnimatedStats client:visible />

      <!-- Animated Resources -->
      <AnimatedResources client:visible />

      <!-- More Resources CTA -->
      <section class="bg-white rounded-xl shadow-md p-8 text-center">
        <h3 class="flex items-center text-2xl font-semibold mb-3">Looking for More Resources?</h3>
        <p class="text-neutral-600 mb-6 max-w-2xl mx-auto">
          Access our complete library of guides, tools, community stories, and expert advice.
        </p>
        <a 
          href="/resources" 
          class="inline-flex items-center justify-center px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary/90 transition-colors"
        >
          Browse All Resources
        </a>
      </section>

    </div>
  </main>
  
  <Footer />
</Layout>
