---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { getNewsPosts } from '../lib/convexData';
import {
  AlertTriangle,
  MapPin,
  TrendingUp,
  ArrowRight,
  Clock,
  Shield,
} from "lucide-react";
import AnimatedNewsSection from '../components/AnimatedNewsSection';
import AnimatedStats from '../components/AnimatedStats';
import AnimatedResources from '../components/AnimatedResources';

// Fetch latest news posts
let latestNews: any[] = [];
try {
  const posts = await getNewsPosts(true);
  latestNews = posts.slice(0, 3); // Get 3 most recent
} catch (e) {
  console.error('Error fetching news:', e);
}
---

<Layout
  title="Phone Stolen UK? Mobile Theft Prevention & Recovery | ProtectMyMobile"
  description="Phone stolen in London or UK? Get immediate help with our emergency guide, report theft, contact banks & providers. UK + London travel safety for tourists and locals."
  canonicalPath="/"
  schema={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "ProtectMyMobile - UK Mobile Theft Prevention",
    "description": "Phone stolen in London or UK? Get immediate help with our emergency guide, report theft, contact banks & providers.",
    "mainEntity": {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What should I do if my phone is stolen in the UK?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1. Stay calm and ensure your safety. 2. Use Find My iPhone/Android to locate or lock your device. 3. Report to police via 101 or online. 4. Contact your mobile provider to block the SIM. 5. Notify your bank to secure banking apps."
          }
        },
        {
          "@type": "Question",
          "name": "How many phones are stolen in London each year?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Over 78,000 phones were stolen in London in 2023, a 44% increase from 2022. That's approximately one phone stolen every 3 minutes."
          }
        },
        {
          "@type": "Question",
          "name": "What is the recovery rate for stolen phones in the UK?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The recovery rate for stolen phones in the UK is approximately 6%, making prevention and immediate action after theft crucial."
          }
        },
        {
          "@type": "Question",
          "name": "How can tourists keep their phones safe while visiting London?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use cross-body bags, avoid using phones near kerbs or open train doors, enable Face ID/biometrics, turn on Find My, and save local emergency and carrier contact numbers before you arrive."
          }
        }
      ]
    }
  }}
>
  <HeaderMobile client:load />
  
  <main class="bg-[#f3f2f1]">
    <div class="container mx-auto px-4 py-8 max-w-7xl">
      
      <!-- Combined Hero + Blink Section -->
      <section class="mb-12">
        <div class="grid md:grid-cols-2 gap-6 items-stretch">
          <div class="relative bg-gradient-to-br from-primary via-blue-600 to-blue-700 text-white rounded-3xl shadow-2xl p-8 md:p-12 overflow-hidden">
            <div class="absolute inset-0 overflow-hidden">
              <div class="absolute -top-20 -right-20 w-64 h-64 bg-white/5 rounded-full" />
              <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-white/5 rounded-full" />
              <div class="absolute top-1/2 left-1/3 w-32 h-32 bg-white/5 rounded-full" />
            </div>
            <div class="relative z-10 space-y-6">
              <div>
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-3">Protect Your Mobile. Secure Your Digital Life.</h1>
                <p class="text-base md:text-lg text-blue-100 max-w-2xl">Over 80,000 phones stolen in London every year. Get the tools and guidance you need to stay safe.</p>
              </div>
              <div class="flex flex-col sm:flex-row gap-4">
                <a 
                  href="/prevention" 
                  class="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3 sm:py-4 text-sm sm:text-base bg-white text-primary rounded-xl font-semibold hover:bg-blue-50 transition-colors shadow-lg"
                >
                  <Shield class="h-5 w-5" />
                  <span>Protect Your Phone</span>
                </a>
                <a 
                  href="/emergency" 
                  class="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3 sm:py-4 text-sm sm:text-base bg-red-600 text-white rounded-xl font-semibold hover:bg-red-700 transition-colors shadow-lg shadow-red-600/30"
                >
                  <AlertTriangle class="h-5 w-5" />
                  <span>Phone Stolen? Act Now</span>
                </a>
              </div>
            </div>
          </div>

          <div class="bg-gradient-to-br from-neutral-900 to-neutral-800 rounded-3xl shadow-2xl overflow-hidden flex flex-col">
            <div class="relative">
              <div class="relative aspect-video">
                <video 
                  autoplay 
                  loop 
                  muted 
                  playsinline
                  class="w-full h-full object-cover object-[70%_center]"
                >
                  <source src="/videos/phone-theft-animation.mp4" type="video/mp4" />
                </video>
                <div class="absolute inset-0 bg-gradient-to-r from-transparent to-neutral-900/50 md:block hidden"></div>
              </div>
              <div class="absolute inset-0 flex items-end">
                <div class="p-6 md:p-8 text-white">
                  <div class="inline-flex items-center gap-2 bg-red-500/20 text-red-300 rounded-full px-4 py-1.5 text-sm font-medium w-fit mb-4">
                    <AlertTriangle class="h-4 w-4" />
                    UK Theft Crisis
                  </div>
                  <h2 class="text-2xl md:text-3xl font-bold mb-3">Blink and it's gone.</h2>
                  <p class="text-neutral-200 mb-4 max-w-xl">Organised gangs use bikes, mopeds, and distraction tactics to snatch phones in seconds. Know what to do before it happens.</p>
                  <a 
                    href="/the-problem" 
                    class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white text-neutral-900 rounded-xl font-semibold hover:bg-neutral-100 transition-colors w-fit"
                  >
                    Learn How Thieves Operate
                    <ArrowRight class="h-4 w-4" />
                  </a>
                  <div class="grid grid-cols-2 gap-4 mt-6">
                    <div class="bg-white/5 rounded-xl p-4">
                      <div class="text-2xl font-bold text-red-300">78,000+</div>
                      <div class="text-xs text-neutral-300">Stolen in London (2023)</div>
                    </div>
                    <div class="bg-white/5 rounded-xl p-4">
                      <div class="text-2xl font-bold text-orange-300">44%</div>
                      <div class="text-xs text-neutral-300">Increase since 2022</div>
                    </div>
                    <div class="bg-white/5 rounded-xl p-4">
                      <div class="flex items-center gap-1 text-2xl font-bold text-yellow-300">
                        <Clock class="h-5 w-5" />
                        3 min
                      </div>
                      <div class="text-xs text-neutral-300">One stolen every</div>
                    </div>
                    <div class="bg-white/5 rounded-xl p-4">
                      <div class="text-2xl font-bold text-teal-300">6%</div>
                      <div class="text-xs text-neutral-300">Recovery rate</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- The Problem Section -->
      <section class="mb-12">
        <div class="bg-gradient-to-br from-neutral-900 to-neutral-800 rounded-2xl shadow-2xl overflow-hidden">
          <div class="grid md:grid-cols-2 gap-0">
            <!-- Video Side -->
            <div class="relative aspect-video md:aspect-auto">
              <video 
                autoplay 
                loop 
                muted 
                playsinline
                class="w-full h-full object-cover object-[70%_center]"
              >
                <source src="/videos/phone-theft-animation.mp4" type="video/mp4" />
              </video>
              <div class="absolute inset-0 bg-gradient-to-r from-transparent to-neutral-900/50 md:block hidden"></div>
            </div>
            
            <!-- Content Side -->
            <div class="p-6 md:p-10 flex flex-col justify-center">
              <div class="inline-flex items-center gap-2 bg-red-500/20 text-red-400 rounded-full px-4 py-1.5 text-sm font-medium w-fit mb-4">
                <AlertTriangle class="h-4 w-4" />
                UK Theft Crisis
              </div>
              
              <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
                Blink and it's gone.
              </h2>
              
              <p class="text-neutral-300 mb-6">
                Phone theft has reached epidemic levels in the UK. Organised gangs use bikes, mopeds, and distraction tactics to snatch phones in seconds.
              </p>
              
              <!-- Quick Stats -->
              <div class="grid grid-cols-2 gap-4 mb-6">
                <div class="bg-white/5 rounded-xl p-4">
                  <div class="text-2xl font-bold text-red-400">78,000+</div>
                  <div class="text-xs text-neutral-400">Stolen in London (2023)</div>
                </div>
                <div class="bg-white/5 rounded-xl p-4">
                  <div class="text-2xl font-bold text-orange-400">44%</div>
                  <div class="text-xs text-neutral-400">Increase since 2022</div>
                </div>
                <div class="bg-white/5 rounded-xl p-4">
                  <div class="flex items-center gap-1 text-2xl font-bold text-yellow-400">
                    <Clock class="h-5 w-5" />
                    3 min
                  </div>
                  <div class="text-xs text-neutral-400">One stolen every</div>
                </div>
                <div class="bg-white/5 rounded-xl p-4">
                  <div class="text-2xl font-bold text-teal-400">6%</div>
                  <div class="text-xs text-neutral-400">Recovery rate</div>
                </div>
              </div>
              
              <a 
                href="/the-problem" 
                class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-red-600 hover:bg-red-700 text-white rounded-xl font-semibold transition-colors w-fit"
              >
                Learn How Thieves Operate
                <ArrowRight class="h-4 w-4" />
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Visitor Safety Section (moved below "Blink and it's gone") -->
      <section class="mb-12">
        <div class="bg-white rounded-2xl shadow-md border border-neutral-100 p-6 md:p-8">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
            <div>
              <p class="text-xs uppercase tracking-wide text-primary font-semibold mb-1">London visitors</p>
              <h2 class="text-xl md:text-2xl font-bold text-neutral-900">Tourist safety: keep your phone secure in London</h2>
              <p class="text-neutral-600 text-sm md:text-base mt-2">Fast tips for travellers and students: avoid kerbside scrolling, use cross-body bags, pre-save Find My links, and know who to contact if you’re targeted.</p>
            </div>
            <a href="/emergency" class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-xl font-semibold shadow-sm hover:bg-primary/90 transition">See emergency steps<ArrowRight class="h-4 w-4" /></a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="p-4 rounded-xl bg-neutral-50 border border-neutral-100">
              <p class="text-sm font-semibold text-neutral-900 mb-1">Before you arrive</p>
              <p class="text-sm text-neutral-600">Enable Find My, turn on device passcodes and Face ID/biometrics, and store IMEI + carrier contact numbers.</p>
            </div>
            <div class="p-4 rounded-xl bg-neutral-50 border border-neutral-100">
              <p class="text-sm font-semibold text-neutral-900 mb-1">While in the city</p>
              <p class="text-sm text-neutral-600">Keep devices away from kerbs and train doors, use cross-body straps, and avoid flashing phones in crowded tourist hotspots.</p>
            </div>
            <div class="p-4 rounded-xl bg-neutral-50 border border-neutral-100">
              <p class="text-sm font-semibold text-neutral-900 mb-1">If it’s stolen</p>
              <p class="text-sm text-neutral-600">Lock the device remotely, block the SIM, call your bank, and file a report with police—follow our 5-step emergency guide.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Animated News Section -->
      <AnimatedNewsSection client:load news={latestNews} />

      <!-- Scenarios CTA -->
      <section class="mb-12">
        <a href="/scenarios" class="block bg-gradient-to-r from-amber-500 to-orange-500 rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-shadow group">
          <div class="p-8 md:p-12 text-white">
            <div class="flex items-start justify-between">
              <div class="flex-1 space-y-4">
                <div class="inline-flex items-center gap-2 bg-white/15 rounded-full px-4 py-2 text-sm font-semibold">
                  <AlertTriangle class="h-4 w-4" />
                  Real-world scenarios
                </div>
                <h2 class="text-3xl md:text-4xl font-bold leading-tight">See how theft happens—and how to stop it</h2>
                <p class="text-lg text-white/85 max-w-2xl">
                  Slide-by-slide guides for moped snatches, public transport grabs, nightlife thefts, and more. Learn positioning, habits, and rapid response.
                </p>
                <div class="inline-flex items-center gap-2 text-lg font-semibold group-hover:gap-4 transition-all">
                  View scenario slides <ArrowRight class="h-5 w-5" />
                </div>
              </div>
              <div class="hidden md:flex items-center justify-center">
                <div class="bg-white/10 rounded-2xl px-6 py-4 text-center min-w-[200px]">
                  <p class="text-4xl font-extrabold">8</p>
                  <p class="text-white/80 text-sm">visual playbooks</p>
                </div>
              </div>
            </div>
          </div>
        </a>
      </section>

      <!-- Statistics CTA -->
      <section class="mb-12">
        <a href="/statistics" class="block bg-gradient-to-r from-purple-600 to-indigo-600 rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-shadow group">
          <div class="p-8 md:p-12 text-white">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <div class="inline-flex items-center gap-2 bg-white/20 rounded-full px-4 py-2 mb-4">
                  <TrendingUp class="h-5 w-5" />
                  <span class="font-medium">UK DATA</span>
                </div>
                <h2 class="text-3xl md:text-4xl font-bold mb-4">
                  Theft Hotspots & Statistics
                </h2>
                <p class="text-xl text-purple-100 mb-6 max-w-2xl">
                  See where thefts happen most, when you're at highest risk, and how the epidemic is growing across UK cities.
                </p>
                <div class="inline-flex items-center gap-2 text-lg font-semibold group-hover:gap-4 transition-all">
                  View Statistics <ArrowRight class="h-5 w-5" />
                </div>
              </div>
              <div class="hidden md:block">
                <MapPin class="h-32 w-32 text-white/30" />
              </div>
            </div>
          </div>
        </a>
      </section>

      <!-- Animated Quick Stats -->
      <AnimatedStats client:visible />

      <!-- Animated Resources -->
      <AnimatedResources client:visible />

      <!-- More Resources CTA -->
      <section class="bg-white rounded-xl shadow-md p-8 text-center">
        <h3 class="flex items-center text-2xl font-semibold mb-3">Looking for More Resources?</h3>
        <p class="text-neutral-600 mb-6 max-w-2xl mx-auto">
          Access our complete library of guides, tools, community stories, and expert advice.
        </p>
        <a 
          href="/resources" 
          class="inline-flex items-center justify-center px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary/90 transition-colors"
        >
          Browse All Resources
        </a>
      </section>

    </div>
  </main>
  
  <Footer />
</Layout>
