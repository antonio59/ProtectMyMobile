---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { getNewsPosts, getMonthlyTrends, getTheftStats } from '../lib/convexData';
import {
  AlertTriangle,
  MapPin,
  TrendingUp,
  ArrowRight,
  Shield,
} from "lucide-react";
import AnimatedNewsSection from '../components/AnimatedNewsSection';
import AnimatedStats from '../components/AnimatedStats';
import AnimatedResources from '../components/AnimatedResources';
import TheftTrendsChart from '../components/TheftTrendsChart';

// Fetch latest news posts
let latestNews: any[] = [];
let trendsData: { months: string[]; locations: string[]; data: Array<{ month: string; label: string; total: number; [key: string]: string | number }> } | null = null;
let liveStats: { totalThefts: number; totalRecords: number; bySource: Record<string, number> } | null = null;
try {
  const posts = await getNewsPosts(true);
  latestNews = posts.slice(0, 3);
} catch (e: unknown) {
  console.error('Error fetching news:', e);
}

// Fetch trends and stats data
try {
  trendsData = await getMonthlyTrends(6);
} catch (e: unknown) {
  console.error('Error fetching trends:', e);
}
try {
  liveStats = await getTheftStats();
} catch (e: unknown) {
  console.error('Error fetching stats:', e);
}
---

<Layout
  title="Phone Stolen UK? Mobile Theft Prevention & Recovery | ProtectMyMobile"
  description="A phone is stolen in London every seven minutes. Live police.uk theft data, prevention checklists, and a step-by-step emergency guide if yours is taken."
  canonicalPath="/"
  schema={[
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "ProtectMyMobile - UK Mobile Theft Prevention",
      "description": "Phone stolen in London or UK? Get immediate help with the emergency guide, report theft, contact banks & providers."
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What should I do if my phone is stolen in the UK?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1. Stay calm and ensure your safety. 2. Use Find My iPhone/Android to locate or lock your device. 3. Report to police via 101 or online. 4. Contact your mobile provider to block the SIM. 5. Notify your bank to secure banking apps."
          }
        },
        {
          "@type": "Question",
          "name": "How many phones are stolen in London each year?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "71,391 phones were recorded stolen in London in 2025 (Met Police), roughly one every 7 minutes. Thefts peaked at 117,211 in 2024 (Met FOI data) and fell about 12% in 2025 following a major crackdown."
          }
        },
        {
          "@type": "Question",
          "name": "What is the recovery rate for stolen phones in the UK?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The vast majority of stolen phones in the UK are never recovered, making prevention and immediate action after theft crucial."
          }
        },
        {
          "@type": "Question",
          "name": "How can tourists keep their phones safe while visiting London?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use cross-body bags, avoid using phones near kerbs or open train doors, enable Face ID/biometrics, turn on Find My, and save local emergency and carrier contact numbers before you arrive."
          }
        }
      ]
    }
  ]}
>
  <HeaderMobile client:idle />

  <main id="main-content" class="bg-background">
    <div class="container mx-auto px-4 py-8 max-w-7xl">
      
      <!-- Hero Section with Prominent Video -->
      <section class="mb-12">
        <div class="bg-foreground text-background rounded-3xl  overflow-hidden">
          <!-- Cinematic London backdrop -->
          <div class="relative">
            <img
              src="/images/hero-london.jpg"
              alt=""
              aria-hidden="true"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full aspect-[3/4] min-[420px]:aspect-[4/5] sm:aspect-[16/9] md:aspect-[21/9] object-cover object-[70%_center]"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-black/10 sm:via-black/30 sm:to-transparent"></div>

            <!-- Overlay Content -->
            <div class="absolute inset-0 flex flex-col justify-center p-4 sm:p-6 md:p-10 lg:p-12">
              <div class="max-w-5xl">
                <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-white mb-4 sm:mb-6 text-shadow-hero max-w-3xl">
                  A phone is stolen in London every seven minutes.
                </h1>

                <!-- CTAs -->
                <div class="flex flex-col sm:flex-row gap-2 sm:gap-4 mb-4 sm:mb-8">
                  <a
                    href="/prevention"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 sm:px-6 sm:py-3 text-sm sm:text-base bg-card text-foreground rounded-xl font-semibold hover:bg-neutral-100 transition-all  shadow-glow-blue hover-lift touch-target"
                  >
                    <Shield className="size-4 sm:size-5" />
                    <span>Protect Your Phone</span>
                  </a>
                  <a
                    href="/emergency"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 sm:px-6 sm:py-3 text-sm sm:text-base bg-destructive text-destructive-foreground rounded-xl font-semibold hover:bg-destructive-hover transition-all shadow-glow-red animate-pulse-glow hover-lift touch-target"
                  >
                    <AlertTriangle className="size-4 sm:size-5" />
                    <span>Phone Stolen? Act Now</span>
                  </a>
                  <a
                    href="/the-problem"
                    class="hidden sm:inline-flex items-center justify-center gap-2 px-6 py-3 text-sm sm:text-base bg-white/10 text-white border border-white/20 rounded-xl font-semibold hover:bg-white/20 transition-all hover-lift touch-target"
                  >
                    <span>Learn How Thieves Operate</span>
                    <ArrowRight className="size-4" />
                  </a>
                </div>

                <!-- Slim evidence strip; full data and sources live on /statistics -->
                <p class="text-xs sm:text-sm text-white/70 max-w-2xl">
                  <span class="font-semibold text-white">117,211</span> stolen in 2024 (Met FOI)<span class="text-white/40"> · </span><span class="font-semibold text-white">down 12.3%</span> in 2025<span class="text-white/40"> · </span><a href="/statistics" class="underline underline-offset-2 decoration-white/40 hover:text-white transition-colors">Live stats &amp; sources</a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Visitor Safety Section (moved below "Blink and it's gone") -->
      <section class="mb-8 sm:mb-12">
        <div class="bg-card rounded-2xl  border border-border p-4 sm:p-6 md:p-8 lg:p-10">
          <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 lg:gap-8 mb-4 lg:mb-6">
            <div class="lg:max-w-2xl">
              <p class="text-xs uppercase tracking-wide text-primary font-semibold mb-1">London visitors</p>
              <h2 class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-bold text-foreground">Tourist safety: keep your phone secure in London</h2>
              <p class="text-muted-foreground text-xs sm:text-sm md:text-base lg:text-lg mt-2">Fast tips for travellers and students: avoid kerbside scrolling, use cross-body bags, pre-save Find My links, and know who to contact if you're targeted.</p>
            </div>
            <div class="grid grid-cols-2 sm:flex sm:flex-row gap-2 sm:gap-3 shrink-0 mt-2 lg:mt-0">
              <a href="/london-visitor-safety" class="inline-flex items-center justify-center gap-1.5 sm:gap-2 px-4 sm:px-5 py-2.5 sm:py-3 bg-primary text-primary-foreground rounded-xl font-semibold  hover:bg-primary-hover hover:scale-[1.02] transition-all text-xs sm:text-sm md:text-base">
                <Shield className="size-4 sm:size-5" />
                <span class="sm:hidden">Safety</span>
                <span class="hidden sm:inline">Visitor Safety Guide</span>
              </a>
              <a href="/emergency" class="inline-flex items-center justify-center gap-1.5 sm:gap-2 px-4 sm:px-5 py-2.5 sm:py-3 bg-destructive text-destructive-foreground rounded-xl font-semibold  hover:bg-destructive-hover hover:scale-[1.02] transition-all text-xs sm:text-sm md:text-base">
                <AlertTriangle className="size-4 sm:size-5" />
                <span class="sm:hidden">Emergency</span>
                <span class="hidden sm:inline">Emergency Steps</span>
                <ArrowRight className="size-3 sm:size-4 hidden sm:block" />
              </a>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 lg:gap-6">
            <div class="p-3 sm:p-4 lg:p-5 rounded-xl bg-neutral border border-border hover:border-primary/20 hover:bg-primary/5 transition-colors">
              <p class="text-xs sm:text-sm lg:text-base font-semibold text-foreground mb-1">Before you arrive</p>
              <p class="text-xs sm:text-sm lg:text-base text-muted-foreground">Enable Find My, turn on device passcodes and Face ID/biometrics, and store IMEI + carrier contact numbers.</p>
            </div>
            <div class="p-3 sm:p-4 lg:p-5 rounded-xl bg-neutral border border-border hover:border-primary/20 hover:bg-primary/5 transition-colors">
              <p class="text-xs sm:text-sm lg:text-base font-semibold text-foreground mb-1">While in the city</p>
              <p class="text-xs sm:text-sm lg:text-base text-muted-foreground">Keep devices away from kerbs and train doors, use cross-body straps, and avoid flashing phones in crowded tourist hotspots.</p>
            </div>
            <div class="p-3 sm:p-4 lg:p-5 rounded-xl bg-neutral border border-border hover:border-primary/20 hover:bg-primary/5 transition-colors">
              <p class="text-xs sm:text-sm lg:text-base font-semibold text-foreground mb-1">If it's stolen</p>
              <p class="text-xs sm:text-sm lg:text-base text-muted-foreground">Lock the device remotely, block the SIM, call your bank, and file a report with police: follow the 5-step emergency guide.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Animated News Section -->
      <AnimatedNewsSection client:visible news={latestNews} />

      <!-- Share a stat -->
      <section class="mb-8 sm:mb-12">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 mb-4 sm:mb-6 pb-3 border-b-[3px] border-foreground">
          <h2 class="text-foreground">Share a stat</h2>
          <p class="text-sm text-muted-foreground">Ready-made cards for Instagram, X and WhatsApp</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-5">
          <div class="bg-foreground text-background p-6 sm:p-7 flex flex-col justify-between gap-4 aspect-square rounded-xl">
            <span class="text-[11px] font-bold uppercase tracking-[0.15em] text-[#E0685F]">London 2025</span>
            <span class="font-serif text-2xl lg:text-3xl leading-tight">One phone stolen every 7 minutes.</span>
            <span class="text-xs text-neutral-400">protectmymobile.xyz</span>
          </div>
          <div class="bg-destructive text-destructive-foreground p-6 sm:p-7 flex flex-col justify-between gap-4 aspect-square rounded-xl">
            <span class="text-[11px] font-bold uppercase tracking-[0.15em]">The odds</span>
            <span class="font-serif text-2xl lg:text-3xl leading-tight">99.2% of phone thefts go unpunished.</span>
            <span class="text-xs text-destructive-foreground/70">protectmymobile.xyz</span>
          </div>
          <div class="bg-background border-2 border-foreground p-6 sm:p-7 flex flex-col justify-between gap-4 aspect-square rounded-xl">
            <span class="text-[11px] font-bold uppercase tracking-[0.15em] text-destructive">Do this today</span>
            <span class="font-serif text-2xl lg:text-3xl leading-tight text-foreground">Know your IMEI before a thief does.</span>
            <span class="text-xs text-muted-foreground">protectmymobile.xyz</span>
          </div>
        </div>
      </section>

      <!-- Scenarios CTA -->
      <section class="mb-8 sm:mb-12">
        <a href="/scenarios" class="block bg-foreground text-background overflow-hidden group rounded-2xl">
          <div class="p-5 sm:p-8 md:p-10">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1 space-y-2 sm:space-y-4">
                <div class="inline-flex items-center gap-1.5 sm:gap-2 text-xs sm:text-sm font-bold uppercase tracking-[0.15em] text-[#E0685F]">
                  <AlertTriangle className="size-3 sm:size-4" />
                  Real-world scenarios
                </div>
                <h2 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl leading-tight text-background">See how theft happens, and how to stop it</h2>
                <p class="text-sm sm:text-base md:text-lg text-neutral-400 max-w-2xl">
                  Frame-by-frame playbooks for moped snatches, public transport grabs, nightlife thefts and more.
                </p>
                <div class="inline-flex items-center gap-2 text-sm sm:text-base font-bold uppercase tracking-wide group-hover:gap-3 sm:group-hover:gap-4 transition-all">
                  View the playbooks <ArrowRight className="size-4 sm:size-5" />
                </div>
              </div>
              <div class="hidden sm:flex items-center justify-center shrink-0">
                <div class="border-2 border-background/30 px-4 sm:px-6 py-3 sm:py-4 text-center rounded-xl">
                  <p class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold">8</p>
                  <p class="text-neutral-400 text-xs sm:text-sm">visual playbooks</p>
                </div>
              </div>
            </div>
          </div>
        </a>
      </section>

      <!-- Statistics CTA -->
      <section class="mb-8 sm:mb-12">
        <a href="/statistics" class="block bg-background border-2 border-foreground overflow-hidden group hover:bg-neutral-100 transition-colors rounded-2xl">
          <div class="p-5 sm:p-8 md:p-10">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="inline-flex items-center gap-1.5 sm:gap-2 mb-2 sm:mb-4 text-xs sm:text-sm font-bold uppercase tracking-[0.15em] text-destructive">
                  <TrendingUp className="size-4 sm:size-5" />
                  <span>UK data</span>
                </div>
                <h2 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl mb-2 sm:mb-4 text-foreground">
                  Theft hotspots &amp; statistics
                </h2>
                <p class="text-sm sm:text-base md:text-xl text-muted-foreground mb-4 sm:mb-6 max-w-2xl">
                  See where thefts happen most, when you're at highest risk, and how the epidemic is growing across UK cities.
                </p>
                <div class="inline-flex items-center gap-2 text-sm sm:text-base font-bold uppercase tracking-wide text-foreground group-hover:gap-3 sm:group-hover:gap-4 transition-all">
                  View statistics <ArrowRight className="size-4 sm:size-5" />
                </div>
              </div>
              <div class="hidden sm:block shrink-0">
                <MapPin className="h-16 w-16 sm:size-20 md:size-32 text-neutral-300" />
              </div>
            </div>
          </div>
        </a>
      </section>

      {/* Theft Trends Chart */}
      {trendsData && trendsData.data.length > 0 && (
        <section class="mb-8 sm:mb-12">
          <div class="bg-card rounded-2xl  border border-border p-4 sm:p-6 md:p-8">
            <TheftTrendsChart client:visible />
          </div>
        </section>
      )}

      <!-- Animated Quick Stats -->
      <AnimatedStats client:visible />

      <!-- Animated Resources -->
      <AnimatedResources client:visible />

      <!-- More Resources CTA -->
      <section class="bg-background rounded-2xl  border border-border p-5 sm:p-8 lg:p-12 text-center">
        <h3 class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-bold mb-2 sm:mb-3 text-foreground">Looking for More Resources?</h3>
        <p class="text-muted-foreground mb-4 sm:mb-6 lg:mb-8 max-w-2xl mx-auto text-sm sm:text-base lg:text-lg">
          Access the complete library of guides, tools, community stories, and expert advice.
        </p>
        <a
          href="/resources"
          class="inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-2.5 sm:py-3 bg-primary text-primary-foreground rounded-xl font-semibold hover:bg-primary-hover hover:scale-[1.02] transition-all text-sm sm:text-base lg:text-lg  shadow-primary/20"
        >
          Browse All Resources
          <ArrowRight className="size-4 lg:size-5" />
        </a>
      </section>

    </div>
  </main>
  
  <Footer />
</Layout>
