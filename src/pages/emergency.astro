---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { AlertTriangle, Clock } from "lucide-react";
---

<Layout 
  title="Phone Stolen? 5 Steps To Take Immediately | UK Emergency Guide"
  description="Phone stolen in London or UK? Follow these 5 emergency steps NOW: lock device, block SIM, report to police, secure bank accounts. Act within 30 minutes."
  canonicalPath="/emergency"
  schema={{
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "What To Do If Your Phone Is Stolen in the UK",
    "description": "Emergency step-by-step guide for when your mobile phone is stolen in the UK. Complete these 5 steps within 30 minutes.",
    "totalTime": "PT30M",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Remotely Lock Your Device",
        "text": "Use Find My iPhone (icloud.com/find) or Google Find My Device (google.com/android/find) to remotely lock your phone and display a message.",
        "url": "https://protectmymobile.xyz/emergency#step-1"
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Change Critical Passwords",
        "text": "Immediately change passwords for your Google/Apple account, email, banking apps, and social media from a secure device.",
        "url": "https://protectmymobile.xyz/emergency#step-2"
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Contact Your Mobile Provider",
        "text": "Call your mobile provider to report the theft and block your SIM card to prevent unauthorised calls and texts.",
        "url": "https://protectmymobile.xyz/emergency#step-3"
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Report to Police",
        "text": "File a theft report at police.uk or call 101. Get a crime reference number for insurance claims.",
        "url": "https://protectmymobile.xyz/emergency#step-4"
      },
      {
        "@type": "HowToStep",
        "position": 5,
        "name": "Check Bank Accounts",
        "text": "Monitor your bank accounts for unauthorised transactions and contact your bank to flag potential fraud.",
        "url": "https://protectmymobile.xyz/emergency#step-5"
      }
    ]
  }}
>
  <HeaderMobile client:idle />
  
  <main id="main-content" class="bg-[#f3f2f1] min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-4xl">
      <!-- Emergency Hero - Bold Red -->
      <div class="bg-gradient-to-br from-red-600 to-red-700 text-white rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-10 mb-6 sm:mb-8 shadow-xl">
        <div class="flex items-center gap-3 sm:gap-4 mb-3 sm:mb-4">
          <div class="bg-white/20 p-2.5 sm:p-4 rounded-xl sm:rounded-2xl">
            <AlertTriangle class="h-7 w-7 sm:h-10 sm:w-10" />
          </div>
          <div>
            <h1 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold text-shadow-danger">Phone Stolen?</h1>
            <p class="text-red-100 text-xs sm:text-sm md:text-base">Act immediately - every minute counts</p>
          </div>
        </div>
        <div class="flex items-center gap-2 bg-white/10 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm w-fit">
          <Clock class="h-3 w-3 sm:h-4 sm:w-4" />
          <span>Complete these 5 steps within 30 minutes</span>
        </div>
      </div>

      <!-- Progress indicator -->
      <div class="mb-6 sm:mb-8 hidden sm:block">
        <div class="flex items-center justify-between">
          {[1, 2, 3, 4, 5].map((num) => (
            <div class="flex items-center">
              <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-red-600 text-white flex items-center justify-center font-bold text-sm sm:text-base">{num}</div>
              {num < 5 && <div class="w-8 sm:w-16 lg:w-24 h-1 bg-red-200 mx-1 sm:mx-2" />}
            </div>
          ))}
        </div>
      </div>

      <!-- Emergency Steps -->
      <div class="space-y-4 sm:space-y-6">
        <!-- Step 1: Lock Device -->
        <div class="bg-white rounded-lg sm:rounded-xl shadow-md p-4 sm:p-6">
          <div class="flex items-start">
            <div class="bg-[#d4351c] text-white rounded-full w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center font-bold text-sm sm:text-lg mr-3 sm:mr-4 flex-shrink-0">
              1
            </div>
            <div class="flex-1">
              <h3 class="text-base sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2">Remotely Lock Your Device</h3>
              <p class="text-neutral-700 mb-3 sm:mb-4 text-sm sm:text-base">Use another device to access your account and lock your mobile.</p>

              <div class="space-y-2">
                <a href="https://www.google.com/android/find" target="_blank" rel="noopener noreferrer"
                   class="block p-2.5 sm:p-3 border border-green-500 rounded-lg sm:rounded-xl hover:bg-green-50 transition-colors">
                  <div class="flex items-center">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 bg-green-100 rounded-full flex items-center justify-center mr-2.5 sm:mr-3 font-bold text-sm sm:text-base">A</div>
                    <div>
                      <p class="font-medium text-sm sm:text-base">Lock Android Device</p>
                      <p class="text-xs sm:text-sm text-neutral-600">Google Find My Device</p>
                    </div>
                  </div>
                </a>

                <a href="https://www.icloud.com/find" target="_blank" rel="noopener noreferrer"
                   class="block p-2.5 sm:p-3 border border-gray-400 rounded-lg sm:rounded-xl hover:bg-gray-50 transition-colors">
                  <div class="flex items-center">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 bg-gray-200 rounded-full flex items-center justify-center mr-2.5 sm:mr-3 font-bold text-sm sm:text-base">i</div>
                    <div>
                      <p class="font-medium text-sm sm:text-base">Lock Apple Device</p>
                      <p class="text-xs sm:text-sm text-neutral-600">iCloud Find My iPhone</p>
                    </div>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 2: Change Passwords -->
        <div class="bg-white rounded-lg sm:rounded-xl shadow-md p-4 sm:p-6">
          <div class="flex items-start">
            <div class="bg-[#d4351c] text-white rounded-full w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center font-bold text-sm sm:text-lg mr-3 sm:mr-4 flex-shrink-0">
              2
            </div>
            <div class="flex-1">
              <h3 class="text-base sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2">Change Critical Passwords</h3>
              <p class="text-neutral-700 mb-2 sm:mb-4 text-sm sm:text-base">Immediately change passwords for:</p>
              <ul class="list-disc pl-4 sm:pl-5 text-neutral-700 space-y-0.5 sm:space-y-1 mb-2 sm:mb-3 text-sm sm:text-base">
                <li>Google/Apple account</li>
                <li>Email accounts</li>
                <li>Banking apps and payment services</li>
                <li>Social media accounts</li>
              </ul>
              <p class="text-xs sm:text-sm text-neutral-600 italic">Use a different device and ensure you're on secure WiFi</p>
            </div>
          </div>
        </div>

        <!-- Step 3: Block SIM -->
        <div class="bg-white rounded-lg sm:rounded-xl shadow-md p-4 sm:p-6">
          <div class="flex items-start">
            <div class="bg-[#d4351c] text-white rounded-full w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center font-bold text-sm sm:text-lg mr-3 sm:mr-4 flex-shrink-0">
              3
            </div>
            <div class="flex-1">
              <h3 class="text-base sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2">Contact Your Mobile Provider</h3>
              <p class="text-neutral-700 mb-3 sm:mb-4 text-sm sm:text-base">Report the theft and block your SIM/number to prevent unauthorised use.</p>
              <a href="/mobile-providers" class="inline-flex items-center justify-center rounded-lg text-xs sm:text-sm font-medium bg-primary text-white hover:bg-primary/90 h-9 sm:h-10 px-3 sm:px-4 py-2">
                Find Your Provider
              </a>
            </div>
          </div>
        </div>

        <!-- Step 4: Report to Police -->
        <div class="bg-white rounded-lg sm:rounded-xl shadow-md p-4 sm:p-6">
          <div class="flex items-start">
            <div class="bg-[#d4351c] text-white rounded-full w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center font-bold text-sm sm:text-lg mr-3 sm:mr-4 flex-shrink-0">
              4
            </div>
            <div class="flex-1">
              <h3 class="text-base sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2">Report to the Police</h3>
              <p class="text-neutral-700 mb-3 sm:mb-4 text-sm sm:text-base">File a theft report with your local police and get a crime reference number.</p>
              <a href="https://www.police.uk/pu/contact-the-police/report-a-crime-incident/" target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center justify-center rounded-lg text-xs sm:text-sm font-medium bg-primary text-white hover:bg-primary/90 h-9 sm:h-10 px-3 sm:px-4 py-2">
                Report to UK Police Online
              </a>
              <p class="text-xs sm:text-sm text-neutral-600 mt-2">Or call 101 for non-emergency police assistance</p>
            </div>
          </div>
        </div>

        <!-- Step 5: Check Banks -->
        <div class="bg-white rounded-lg sm:rounded-xl shadow-md p-4 sm:p-6">
          <div class="flex items-start">
            <div class="bg-[#d4351c] text-white rounded-full w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center font-bold text-sm sm:text-lg mr-3 sm:mr-4 flex-shrink-0">
              5
            </div>
            <div class="flex-1">
              <h3 class="text-base sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2">Check Your Bank Accounts</h3>
              <p class="text-neutral-700 mb-3 sm:mb-4 text-sm sm:text-base">Monitor for unauthorised transactions and contact your bank immediately if you spot anything suspicious.</p>
              <a href="/banks" class="inline-flex items-center justify-center rounded-lg text-xs sm:text-sm font-medium bg-primary text-white hover:bg-primary/90 h-9 sm:h-10 px-3 sm:px-4 py-2">
                View UK Bank Emergency Contacts
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Additional Actions -->
      <div class="bg-white rounded-lg sm:rounded-xl shadow-md p-4 sm:p-6 mt-6 sm:mt-8">
        <h3 class="text-base sm:text-lg md:text-xl font-semibold mb-3 sm:mb-4">After Immediate Steps</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <div class="p-3 sm:p-4 border border-primary rounded-lg sm:rounded-xl">
            <h4 class="font-medium mb-1 sm:mb-2 text-sm sm:text-base">Report IMEI to Police</h4>
            <p class="text-neutral-700 text-xs sm:text-sm">Provide your device's IMEI number when filing the police report (find by dialing *#06#).</p>
          </div>

          <div class="p-3 sm:p-4 border border-primary rounded-lg sm:rounded-xl">
            <h4 class="font-medium mb-1 sm:mb-2 text-sm sm:text-base">Contact Insurance Provider</h4>
            <p class="text-neutral-700 text-xs sm:text-sm">If you have insurance, contact your provider with the police reference number.</p>
          </div>

          <div class="p-3 sm:p-4 border border-primary rounded-lg sm:rounded-xl">
            <h4 class="font-medium mb-1 sm:mb-2 text-sm sm:text-base">Monitor Bank Statements</h4>
            <p class="text-neutral-700 text-xs sm:text-sm">Check for suspicious activity over the next few weeks.</p>
          </div>

          <div class="p-3 sm:p-4 border border-primary rounded-lg sm:rounded-xl">
            <h4 class="font-medium mb-1 sm:mb-2 text-sm sm:text-base">Enable Theft Alerts</h4>
            <p class="text-neutral-700 text-xs sm:text-sm">Set up fraud alerts with your bank and credit reference agencies.</p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  // Track emergency guide view
  function trackEmergencyView() {
    const CONVEX_URL = (window as any).__CONVEX_URL || '';
    if (!CONVEX_URL) return;

    let sessionId = sessionStorage.getItem('pmm_session');
    if (!sessionId) {
      sessionId = Math.random().toString(36).substring(2) + Date.now().toString(36);
      sessionStorage.setItem('pmm_session', sessionId);
    }

    fetch(`${CONVEX_URL}/api/mutation`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        path: 'analytics:trackEvent',
        args: {
          eventType: 'emergency_guide_viewed',
          sessionId,
          userAgent: navigator.userAgent,
          referrer: document.referrer || undefined,
        },
      }),
    }).catch(() => {});
  }

  // Track on page load
  trackEmergencyView();
</script>
