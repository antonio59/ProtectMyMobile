---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { AlertTriangle, Clock, ThumbsUp, ThumbsDown, MapPin, Shield } from "lucide-react";
---

<Layout 
  title="Phone Stolen? 5 Steps To Take Immediately | UK Emergency Guide"
  description="Phone stolen in London or UK? Follow these 5 emergency steps NOW: lock device, block SIM, report to police, secure bank accounts. Act within 30 minutes."
  canonicalPath="/emergency"
  schema={[
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "What To Do If Your Phone Is Stolen in the UK",
      "description": "Emergency step-by-step guide for when your mobile phone is stolen in the UK. Complete these 5 steps within 30 minutes.",
      "totalTime": "PT30M",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Remotely Lock Your Device",
          "text": "Use Find My iPhone (icloud.com/find) or Google Find My Device (google.com/android/find) to remotely lock your phone and display a message.",
          "url": "https://protectmymobile.xyz/emergency#step-1"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Change Critical Passwords",
          "text": "Immediately change passwords for your Google/Apple account, email, banking apps, and social media from a secure device.",
          "url": "https://protectmymobile.xyz/emergency#step-2"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Contact Your Mobile Provider",
          "text": "Call your mobile provider to report the theft and block your SIM card to prevent unauthorised calls and texts.",
          "url": "https://protectmymobile.xyz/emergency#step-3"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Report to Police",
          "text": "File a theft report at police.uk or call 101. Get a crime reference number for insurance claims.",
          "url": "https://protectmymobile.xyz/emergency#step-4"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Check Bank Accounts",
          "text": "Monitor your bank accounts for unauthorised transactions and contact your bank to flag potential fraud.",
          "url": "https://protectmymobile.xyz/emergency#step-5"
        }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What should I do first if my phone is stolen in the UK?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Act within 30 minutes: 1) Remotely lock your device via Find My iPhone or Google Find My Device, 2) Change passwords for your email and banking apps, 3) Contact your mobile provider to block the SIM, 4) Report to police at police.uk or call 101 for a crime reference number, 5) Check bank accounts for unauthorised transactions."
          }
        },
        {
          "@type": "Question",
          "name": "Can I track my stolen phone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if you enabled Find My iPhone (icloud.com/find) or Find My Device (google.com/android/find) before the theft. Thieves often turn phones off immediately, so check the location as soon as possible. Share the tracking information with police - never attempt to recover the phone yourself."
          }
        },
        {
          "@type": "Question",
          "name": "How do I report a stolen phone to UK police?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Report online at police.uk or call 101 for non-emergencies. You will need your phone's make, model, IMEI number (dial *#06#), time and location of theft, and any tracking data. You will receive a crime reference number needed for insurance claims."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a crime reference number for a stolen phone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The crime reference number is essential for insurance claims, blocking your device with your provider, and protecting yourself legally if the phone is used for criminal activity. Always obtain and save this number when reporting theft."
          }
        }
      ]
    }
  ]}
>
  <HeaderMobile client:idle />
  
  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-4xl">
      <!-- Emergency Hero - Bold Red -->
      <div class="bg-destructive text-destructive-foreground rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-10 mb-6 sm:mb-8 ">
        <div class="flex items-center gap-3 sm:gap-4 mb-3 sm:mb-4">
          <div class="bg-background/20 p-2.5 sm:p-4 rounded-xl sm:rounded-2xl">
            <AlertTriangle className="h-7 w-7 sm:size-10" />
          </div>
          <div>
            <h1 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold text-shadow-danger">Phone Stolen?</h1>
            <p class="text-destructive-foreground/70 text-xs sm:text-sm md:text-base">Act immediately - every minute counts</p>
          </div>
        </div>
        <div class="flex items-center gap-2 bg-background/10 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm w-fit">
          <Clock className="size-3 sm:size-4" />
          <span>Complete these 5 steps within 30 minutes</span>
        </div>
      </div>

      <!-- Progress indicator -->
      <div class="mb-6 sm:mb-8">
        <div class="flex items-center justify-between">
          {[1, 2, 3, 4, 5].map((num) => (
            <div class="flex items-center">
              <div class="w-7 h-7 sm:size-10 rounded-full bg-destructive text-destructive-foreground flex items-center justify-center font-bold text-xs sm:text-base">{num}</div>
              {num < 5 && <div class="w-5 sm:w-16 lg:w-24 h-1 bg-destructive-muted mx-1 sm:mx-2" />}
            </div>
          ))}
        </div>
      </div>

      <!-- Emergency Steps -->
      <div class="space-y-4 sm:space-y-6">
        <!-- Step 1: Lock Device -->
        <div class="bg-card rounded-lg sm:rounded-xl  p-4 sm:p-6">
          <div class="flex items-start">
            <div class="bg-emergency text-emergency-foreground rounded-full size-8 sm:size-10 flex items-center justify-center font-bold text-sm sm:text-lg mr-3 sm:mr-4 flex-shrink-0">
              1
            </div>
            <div class="flex-1">
              <h3 class="text-base sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2">Remotely Lock Your Device</h3>
              <p class="text-foreground mb-3 sm:mb-4 text-sm sm:text-base">Use another device to access your account and lock your mobile.</p>

              <div class="space-y-2">
                <a href="https://www.google.com/android/find" target="_blank" rel="noopener noreferrer"
                   class="block p-2.5 sm:p-3 border border-border rounded-lg sm:rounded-xl hover:bg-neutral-100 transition-colors">
                  <div class="flex items-center">
                    <div class="w-7 h-7 sm:size-8 bg-neutral-100 rounded-full flex items-center justify-center mr-2.5 sm:mr-3 font-bold text-sm sm:text-base">A</div>
                    <div>
                      <p class="font-medium text-sm sm:text-base">Lock Android Device</p>
                      <p class="text-xs sm:text-sm text-muted-foreground">Google Find My Device</p>
                    </div>
                  </div>
                </a>

                <a href="https://www.icloud.com/find" target="_blank" rel="noopener noreferrer"
                   class="block p-2.5 sm:p-3 border border-border rounded-lg sm:rounded-xl hover:bg-neutral-100 transition-colors">
                  <div class="flex items-center">
                    <div class="w-7 h-7 sm:size-8 bg-neutral-200 rounded-full flex items-center justify-center mr-2.5 sm:mr-3 font-bold text-sm sm:text-base">i</div>
                    <div>
                      <p class="font-medium text-sm sm:text-base">Lock Apple Device</p>
                      <p class="text-xs sm:text-sm text-muted-foreground">iCloud Find My iPhone</p>
                    </div>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 2: Change Passwords -->
        <div class="bg-card rounded-lg sm:rounded-xl  p-4 sm:p-6">
          <div class="flex items-start">
            <div class="bg-emergency text-emergency-foreground rounded-full size-8 sm:size-10 flex items-center justify-center font-bold text-sm sm:text-lg mr-3 sm:mr-4 flex-shrink-0">
              2
            </div>
            <div class="flex-1">
              <h3 class="text-base sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2">Change Critical Passwords</h3>
              <p class="text-foreground mb-2 sm:mb-4 text-sm sm:text-base">Immediately change passwords for:</p>
              <ul class="list-disc pl-4 sm:pl-5 text-foreground space-y-0.5 sm:space-y-1 mb-2 sm:mb-3 text-sm sm:text-base">
                <li>Google/Apple account</li>
                <li>Email accounts</li>
                <li>Banking apps and payment services</li>
                <li>Social media accounts</li>
              </ul>
              <p class="text-xs sm:text-sm text-muted-foreground italic">Use a different device and ensure you're on secure WiFi</p>
            </div>
          </div>
        </div>

        <!-- Step 3: Block SIM -->
        <div class="bg-card rounded-lg sm:rounded-xl  p-4 sm:p-6">
          <div class="flex items-start">
            <div class="bg-emergency text-emergency-foreground rounded-full size-8 sm:size-10 flex items-center justify-center font-bold text-sm sm:text-lg mr-3 sm:mr-4 flex-shrink-0">
              3
            </div>
            <div class="flex-1">
              <h3 class="text-base sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2">Contact Your Mobile Provider</h3>
              <p class="text-foreground mb-3 sm:mb-4 text-sm sm:text-base">Report the theft and block your SIM/number to prevent unauthorised use.</p>
              <a href="/mobile-providers" class="inline-flex items-center justify-center rounded-lg text-xs sm:text-sm font-medium bg-primary text-primary-foreground hover:bg-primary-hover min-h-11 px-3 sm:px-4 py-2">
                Find Your Provider
              </a>
            </div>
          </div>
        </div>

        <!-- Step 4: Report to Police -->
        <div class="bg-card rounded-lg sm:rounded-xl  p-4 sm:p-6">
          <div class="flex items-start">
            <div class="bg-emergency text-emergency-foreground rounded-full size-8 sm:size-10 flex items-center justify-center font-bold text-sm sm:text-lg mr-3 sm:mr-4 flex-shrink-0">
              4
            </div>
            <div class="flex-1">
              <h3 class="text-base sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2">Report to the Police</h3>
              <p class="text-foreground mb-3 sm:mb-4 text-sm sm:text-base">File a theft report with your local police and get a crime reference number.</p>
              <a href="https://www.police.uk/pu/contact-the-police/report-a-crime-incident/" target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center justify-center rounded-lg text-xs sm:text-sm font-medium bg-primary text-primary-foreground hover:bg-primary-hover min-h-11 px-3 sm:px-4 py-2">
                Report to UK Police Online
              </a>
              <p class="text-xs sm:text-sm text-muted-foreground mt-2">Or call 101 for non-emergency police assistance</p>
            </div>
          </div>
        </div>

        <!-- Step 5: Check Banks -->
        <div class="bg-card rounded-lg sm:rounded-xl  p-4 sm:p-6">
          <div class="flex items-start">
            <div class="bg-emergency text-emergency-foreground rounded-full size-8 sm:size-10 flex items-center justify-center font-bold text-sm sm:text-lg mr-3 sm:mr-4 flex-shrink-0">
              5
            </div>
            <div class="flex-1">
              <h3 class="text-base sm:text-lg md:text-xl font-semibold mb-1.5 sm:mb-2">Check Your Bank Accounts</h3>
              <p class="text-foreground mb-3 sm:mb-4 text-sm sm:text-base">Monitor for unauthorised transactions and contact your bank immediately if you spot anything suspicious.</p>
              <a href="/banks" class="inline-flex items-center justify-center rounded-lg text-xs sm:text-sm font-medium bg-primary text-primary-foreground hover:bg-primary-hover min-h-11 px-3 sm:px-4 py-2">
                View UK Bank Emergency Contacts
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Additional Actions -->
      <div class="bg-card rounded-lg sm:rounded-xl  p-4 sm:p-6 mt-6 sm:mt-8">
        <h3 class="text-base sm:text-lg md:text-xl font-semibold mb-3 sm:mb-4">After Immediate Steps</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <div class="p-3 sm:p-4 border border-primary rounded-lg sm:rounded-xl">
            <h4 class="font-medium mb-1 sm:mb-2 text-sm sm:text-base">Report IMEI to Police</h4>
            <p class="text-foreground text-xs sm:text-sm">Provide your device's IMEI number when filing the police report (find by dialing *#06#).</p>
          </div>

          <div class="p-3 sm:p-4 border border-primary rounded-lg sm:rounded-xl">
            <h4 class="font-medium mb-1 sm:mb-2 text-sm sm:text-base">Contact Insurance Provider</h4>
            <p class="text-foreground text-xs sm:text-sm">If you have insurance, contact your provider with the police reference number.</p>
          </div>

          <div class="p-3 sm:p-4 border border-primary rounded-lg sm:rounded-xl">
            <h4 class="font-medium mb-1 sm:mb-2 text-sm sm:text-base">Monitor Bank Statements</h4>
            <p class="text-foreground text-xs sm:text-sm">Check for suspicious activity over the next few weeks.</p>
          </div>

          <div class="p-3 sm:p-4 border border-primary rounded-lg sm:rounded-xl">
            <h4 class="font-medium mb-1 sm:mb-2 text-sm sm:text-base">Enable Theft Alerts</h4>
            <p class="text-foreground text-xs sm:text-sm">Set up fraud alerts with your bank and credit reference agencies.</p>
          </div>
        </div>
      </div>

      {/* Was this helpful? Micro-survey */}
      <div id="helpful-survey" class="bg-card rounded-lg sm:rounded-xl  p-4 sm:p-6 mt-6 sm:mt-8 border border-border">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <h3 class="text-base sm:text-lg font-semibold text-foreground">Was this guide helpful?</h3>
            <p class="text-xs sm:text-sm text-muted-foreground mt-1">
              Your feedback helps me improve the emergency resources.
            </p>
          </div>
          <div class="flex items-center gap-2">
            <button
              id="helpful-yes"
              class="inline-flex items-center gap-2 min-h-11 px-4 py-2 bg-neutral-100 text-foreground border border-border rounded-lg font-medium hover:bg-neutral-100 transition-colors"
              aria-label="Yes, this was helpful"
            >
              <ThumbsUp className="size-4" />
              Yes
            </button>
            <button
              id="helpful-no"
              class="inline-flex items-center gap-2 min-h-11 px-4 py-2 bg-destructive-subtle text-destructive-hover border border-destructive-muted rounded-lg font-medium hover:bg-destructive-muted transition-colors"
              aria-label="No, this was not helpful"
            >
              <ThumbsDown className="size-4" />
              No
            </button>
          </div>
        </div>
      </div>

      {/* Survey thank you message (hidden by default) */}
      <div id="helpful-thanks" class="hidden bg-neutral-100 border border-border rounded-lg sm:rounded-xl p-4 sm:p-6 mt-6 sm:mt-8">
        <div class="flex items-center gap-3">
          <div class="p-2 bg-neutral-100 rounded-lg">
            <ThumbsUp className="size-5 text-foreground" />
          </div>
          <div>
            <p class="font-semibold text-foreground">Thank you for your feedback!</p>
            <p class="text-sm text-foreground">I'm always working to make the guides better.</p>
          </div>
        </div>
      </div>

      {/* Report Theft Location */}
      <div id="report-theft" class="bg-card rounded-lg sm:rounded-xl  p-4 sm:p-6 md:p-8 mt-6 sm:mt-8 border border-destructive-muted">
        <div class="flex items-start gap-3 mb-4">
          <div class="p-2 bg-destructive-muted rounded-lg flex-shrink-0">
            <MapPin className="size-5 text-destructive" />
          </div>
          <div>
            <h3 class="text-lg sm:text-xl font-bold text-foreground">Report Where Your Phone Was Stolen</h3>
            <p class="text-sm text-muted-foreground mt-1">
              Help others stay safe by marking where your phone was taken. All reports are anonymous and appear on the <a href="/theft-map" class="text-primary hover:underline">public theft map</a> after verification.
            </p>
          </div>
        </div>

        <form id="theft-report-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="tr-location" class="block text-sm font-medium text-foreground mb-1">Location *</label>
              <input 
                type="text" 
                id="tr-location" 
                name="locationName" 
                required
                placeholder="e.g. Oxford Street, London"
                class="w-full px-3 py-2 border border-input rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-primary"
              />
              <button type="button" id="tr-detect-location" class="text-xs text-primary hover:underline mt-1">
                Use my current location
              </button>
              <input type="hidden" id="tr-lat" name="latitude" />
              <input type="hidden" id="tr-lng" name="longitude" />
            </div>
            <div>
              <label for="tr-date" class="block text-sm font-medium text-foreground mb-1">Date of Theft</label>
              <input 
                type="date" 
                id="tr-date" 
                name="theftDate"
                class="w-full px-3 py-2 border border-input rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-primary"
              />
            </div>
          </div>

          <div>
            <label for="tr-description" class="block text-sm font-medium text-foreground mb-1">What happened? (optional)</label>
            <textarea 
              id="tr-description" 
              name="description"
              rows={3}
              placeholder="Brief description e.g. 'Phone snatched from hand while on bus'"
              class="w-full px-3 py-2 border border-input rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-primary resize-none"
            ></textarea>
          </div>

          <div class="flex items-center justify-between">
            <p class="text-xs text-muted-foreground">
              <Shield className="size-3 inline mr-1" />
              Anonymous. No personal data stored. Approved within 24 hours.
            </p>
            <button 
              type="submit"
              id="tr-submit"
              class="px-5 py-2 bg-destructive text-destructive-foreground text-sm font-medium rounded-lg hover:bg-destructive-hover transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Submit Report
            </button>
          </div>
        </form>

        <div id="tr-success" class="hidden mt-4 bg-neutral-100 border border-border rounded-lg p-4">
          <p class="font-semibold text-foreground">Thank you for reporting.</p>
          <p class="text-sm text-foreground">Your report will be reviewed and appear on the map within 24 hours.</p>
        </div>

        <div id="tr-error" class="hidden mt-4 bg-destructive-subtle border border-destructive-muted rounded-lg p-4">
          <p class="font-semibold text-destructive">Something went wrong.</p>
          <p class="text-sm text-destructive-hover" id="tr-error-msg">Please try again.</p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  // Track emergency guide view
  function trackEmergencyView() {
    const CONVEX_URL = (window as any).__CONVEX_URL || '';
    if (!CONVEX_URL) return;

    let sessionId = sessionStorage.getItem('pmm_session');
    if (!sessionId) {
      // Use crypto.randomUUID() for secure random ID generation
      sessionId = typeof crypto !== 'undefined' && crypto.randomUUID
        ? crypto.randomUUID()
        : Array.from(crypto.getRandomValues(new Uint8Array(16)))
            .map(b => b.toString(16).padStart(2, '0'))
            .join('');
      sessionStorage.setItem('pmm_session', sessionId);
    }

    fetch(`${CONVEX_URL}/api/mutation`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        path: 'analytics:trackEvent',
        args: {
          eventType: 'emergency_guide_viewed',
          sessionId,
          userAgent: navigator.userAgent,
          referrer: document.referrer || undefined,
        },
      }),
    }).catch(() => {});
  }

  // Track on page load
  trackEmergencyView();

  // Helpful survey
  (function() {
    const surveyKey = 'pmm_emergency_helpful';
    const alreadyVoted = localStorage.getItem(surveyKey);
    const surveyEl = document.getElementById('helpful-survey');
    const thanksEl = document.getElementById('helpful-thanks');
    const yesBtn = document.getElementById('helpful-yes');
    const noBtn = document.getElementById('helpful-no');

    if (alreadyVoted && surveyEl && thanksEl) {
      surveyEl.classList.add('hidden');
      thanksEl.classList.remove('hidden');
      return;
    }

    function submitVote(helpful: boolean) {
      localStorage.setItem(surveyKey, helpful ? 'yes' : 'no');
      if (surveyEl) surveyEl.classList.add('hidden');
      if (thanksEl) thanksEl.classList.remove('hidden');

      const CONVEX_URL = (window as any).__CONVEX_URL || '';
      if (!CONVEX_URL) return;
      let sessionId = sessionStorage.getItem('pmm_session');
      if (!sessionId) {
        sessionId = typeof crypto !== 'undefined' && crypto.randomUUID
          ? crypto.randomUUID()
          : Array.from(crypto.getRandomValues(new Uint8Array(16)))
              .map(b => b.toString(16).padStart(2, '0'))
              .join('');
        sessionStorage.setItem('pmm_session', sessionId);
      }
      fetch(`${CONVEX_URL}/api/mutation`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          path: 'analytics:trackEvent',
          args: {
            eventType: helpful ? 'emergency_guide_helpful' : 'emergency_guide_not_helpful',
            sessionId,
            userAgent: navigator.userAgent,
            referrer: document.referrer || undefined,
          },
        }),
      }).catch(() => {});
    }

    yesBtn?.addEventListener('click', () => submitVote(true));
    noBtn?.addEventListener('click', () => submitVote(false));
  })();

  // Theft Report Form
  (function() {
    const form = document.getElementById('theft-report-form') as HTMLFormElement | null;
    const detectBtn = document.getElementById('tr-detect-location');
    const latInput = document.getElementById('tr-lat') as HTMLInputElement | null;
    const lngInput = document.getElementById('tr-lng') as HTMLInputElement | null;
    const successEl = document.getElementById('tr-success');
    const errorEl = document.getElementById('tr-error');
    const errorMsg = document.getElementById('tr-error-msg');
    const submitBtn = document.getElementById('tr-submit') as HTMLButtonElement | null;

    detectBtn?.addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert('Geolocation is not supported by your browser');
        return;
      }
      detectBtn.textContent = 'Detecting...';
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          if (latInput) latInput.value = String(pos.coords.latitude);
          if (lngInput) lngInput.value = String(pos.coords.longitude);
          detectBtn.textContent = 'Location detected ✓';
          detectBtn.classList.add('text-foreground');
        },
        () => {
          detectBtn.textContent = 'Unable to detect location';
          detectBtn.classList.add('text-destructive');
        }
      );
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn) return;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';
      successEl?.classList.add('hidden');
      errorEl?.classList.add('hidden');

      const CONVEX_URL = (window as any).__CONVEX_URL || '';
      if (!CONVEX_URL) {
        errorEl?.classList.remove('hidden');
        if (errorMsg) errorMsg.textContent = 'Service temporarily unavailable';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Report';
        return;
      }

      let sessionId = sessionStorage.getItem('pmm_session');
      if (!sessionId) {
        sessionId = typeof crypto !== 'undefined' && crypto.randomUUID
          ? crypto.randomUUID()
          : Array.from(crypto.getRandomValues(new Uint8Array(16)))
              .map(b => b.toString(16).padStart(2, '0'))
              .join('');
        sessionStorage.setItem('pmm_session', sessionId);
      }

      const formData = new FormData(form);
      const payload = {
        locationName: String(formData.get('locationName') || '').trim(),
        latitude: latInput?.value ? parseFloat(latInput.value) : undefined,
        longitude: lngInput?.value ? parseFloat(lngInput.value) : undefined,
        theftDate: String(formData.get('theftDate') || '') || undefined,
        description: String(formData.get('description') || '').trim() || undefined,
        sessionId,
      };

      try {
        const res = await fetch(`${CONVEX_URL}/api/mutation`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            path: 'theftReports:create',
            args: payload,
          }),
        });
        const json = await res.json();
        if (!res.ok || json.error) {
          throw new Error(json.error || 'Request failed');
        }
        successEl?.classList.remove('hidden');
        form.reset();
        if (latInput) latInput.value = '';
        if (lngInput) lngInput.value = '';
        if (detectBtn) {
          detectBtn.textContent = 'Use my current location';
          detectBtn.classList.remove('text-foreground', 'text-destructive');
        }
      } catch (err: any) {
        errorEl?.classList.remove('hidden');
        if (errorMsg) errorMsg.textContent = err.message || 'Please try again';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Report';
      }
    });
  })();
</script>
