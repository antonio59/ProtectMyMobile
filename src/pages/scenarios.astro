---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { ScenarioCarousel } from '../components/ScenarioCarousel';
import { Shield, AlertTriangle, MapPin } from 'lucide-react';

const pageTitle = "Phone Theft Scenarios & Safety Slides";
const pageDescription = "Visual guides for common London/UK phone theft scenarios with quick prevention tips and response steps.";

const scenarios = [
  {
    id: "moped-snatch",
    title: "Moped Phone-Snatch Safety",
    folder: "Moped Phone-Snatch Safety",
    slides: 6,
    summary: "Avoid kerbside grabs from bikes/scooters with positioning, straps, and quick response steps."
  },
  {
    id: "street-safety",
    title: "Street Phone-Snatch Safety Guide",
    folder: "Street Phone-Snatch Safety Guide",
    slides: 7,
    summary: "Street-smart habits to reduce risk in busy areas and what to do immediately after a grab."
  },
  {
    id: "public-transport",
    title: "Stay Secure on Public Transport",
    folder: "Stay Secure on Public Transport",
    slides: 8,
    summary: "Protect your phone near open train doors and crowded platforms; keep cards and apps secured."
  },
  {
    id: "nightlife",
    title: "Nightlife Phone Safety",
    folder: "Nightlife Phone Safety",
    slides: 6,
    summary: "Stay alert in bars and clubs; avoid table drops and distraction thefts late at night."
  },
  {
    id: "park-safety",
    title: "Park Phone-Snatch Safety",
    folder: "Park Phone-Snatch Safety",
    slides: 6,
    summary: "Lower risk when seated outdoors; keep bags zipped and phones tethered."
  },
  {
    id: "bump-and-grab",
    title: "Beat the Bump-and-Grab",
    folder: "Beat the Bump-and-Grab",
    slides: 6,
    summary: "Spot and block shoulder bumps and crowd squeezes used to lift phones."
  },
  {
    id: "map-trick",
    title: "Spot the Lift / Map Trick",
    folder: "Spot the Lift_ Map Trick",
    slides: 6,
    summary: "Recognise map distraction tricks; keep devices off tables and in sight."
  },
  {
    id: "cafe-safety",
    title: "Cafe Phone-Safety Snapshot",
    folder: "Cafe Phone-Safety Snapshot",
    slides: 6,
    summary: "Table safety in cafes: avoid edge placement, tether devices, and watch for cover-and-lift moves."
  }
];

function slideUrls(folder: string, count: number) {
  // Use WebP format for better compression (fallback to PNG handled in ScenarioCarousel)
  return Array.from({ length: count }, (_, i) => encodeURI(`/Scenarios/${folder}/${i + 1}.webp`));
}
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/scenarios"
  ogImage="/og-image.png"
>
  <HeaderMobile client:idle />

  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 md:py-8 max-w-6xl">
      <div class="bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-10 mb-6 sm:mb-8 shadow-xl">
        <div class="flex items-center gap-3 mb-3">
          <div class="bg-white/20 p-2 sm:p-3 rounded-xl">
            <Shield class="size-6 sm:size-8" />
          </div>
          <div>
            <p class="text-xs uppercase tracking-wide text-blue-100 font-semibold">Scenarios</p>
            <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-shadow-glow">Real-world phone theft scenarios</h1>
          </div>
        </div>
        <p class="text-blue-100 text-xs sm:text-sm md:text-base max-w-3xl">
          Visual slides for London/UK risk situations: what thieves do, how to prevent it, and the first steps if targeted.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4 md:gap-6">
        {scenarios.map((scenario, index) => (
          <article
            id={scenario.id}
            class="bg-card rounded-xl sm:rounded-2xl shadow-md border border-border p-4 sm:p-5 flex flex-col gap-4 card-lift entrance-slide-up scroll-mt-24"
            style={`animation-delay: ${index * 0.1}s`}
          >
            <div class="flex items-start gap-3">
              <div class="bg-primary/10 text-primary rounded-lg p-2 sm:p-3">
                <MapPin class="size-4 sm:size-5" />
              </div>
              <div>
                <h2 class="text-sm sm:text-base font-semibold text-foreground leading-tight">{scenario.title}</h2>
                <p class="text-xs sm:text-sm text-muted-foreground mt-1">{scenario.summary}</p>
              </div>
            </div>
            <ScenarioCarousel
              client:visible
              images={slideUrls(scenario.folder, scenario.slides)}
              title={scenario.title}
              summary={scenario.summary}
              scenarioId={scenario.id}
            />
            <div class="flex items-center gap-2 text-xs sm:text-sm text-muted-foreground">
              <AlertTriangle class="size-4 sm:size-5" />
              <span>{scenario.slides} slides</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
