---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { getMobileProviders, getDirectoryLastVerified } from '../lib/convexData';
import { mobileProviders as staticProviders } from '../data/mobileProviders';
import { Phone, Search, AlertCircle, Clock, CheckCircle2, ExternalLink } from 'lucide-react';

// Get last verified date from Convex (automatically updated when cron runs)
const verifiedDates = await getDirectoryLastVerified();
const lastVerifiedTimestamp = verifiedDates.mobileProviders;
const lastUpdated = lastVerifiedTimestamp 
  ? new Date(lastVerifiedTimestamp).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long', 
      year: 'numeric'
    })
  : 'Pending verification';

// Fetch providers from Convex
const providersData = await getMobileProviders();

// Map Convex data to match old format
const mobileProviders = providersData.map(provider => {
  const staticProvider = staticProviders.find(p => p.id === provider._id || p.name === provider.name);
  return {
    id: provider._id,
    name: provider.name,
    colour: staticProvider?.colour || '#16130F', // Use static color if available
    initial: provider.name.charAt(0).toUpperCase(),
    emergencyContact: {
      uk: provider.phone || 'Online only - web chat',
      available: provider.phone ? 'Available 24/7' : 'Support via online account only',
    },
    network: provider.network,
    website: provider.website,
    is_mvno: provider.isMvno,
    // Default steps
    steps: [
      provider.phone ? 'Call customer services to report your SIM stolen' : 'Log into your account on another device',
      'Request to block your SIM card immediately',
      'Change your account PIN codes or passwords',
      'Request a replacement SIM card',
      'Ask them to note that your device was stolen',
    ],
    additionalInfo: !provider.phone ? `${provider.name} doesn't have a call centre - all support is provided online through your account or web chat.` : null,
  };
});

// Sort providers alphabetically
const sortedProviders = [...mobileProviders].sort((a, b) => a.name.localeCompare(b.name));

// Group by network for filter tabs
const networks = ['All', 'EE', 'O2', 'Three', 'Vodafone'];

const providersFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What should I do if my phone and SIM card are stolen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Contact your mobile provider immediately using their emergency number (listed in our directory) to report the theft and block your SIM. This prevents unauthorised calls, texts, and access to accounts that use SMS two-factor authentication. Then change passwords for email and banking apps from a secure device."
      }
    },
    {
      "@type": "Question",
      "name": "Can a thief use my stolen SIM card?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Thieves can remove your SIM and use it in another phone to make calls, send texts, or receive SMS verification codes for banking and email accounts. Requesting an immediate SIM block from your provider stops this. You should also contact your bank to flag the theft."
      }
    },
    {
      "@type": "Question",
      "name": "How do I get a replacement SIM after my phone is stolen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "After blocking your stolen SIM, request a replacement from your mobile provider. Most UK networks can send a replacement SIM within 1-3 working days, or you can collect one from a retail store with ID. Your phone number will be transferred to the new SIM once activated."
      }
    }
  ]
};
---

<Layout 
  title="UK Mobile Provider Directory - Emergency Contacts | ProtectMyMobile"
  description="Complete directory of UK mobile network providers with emergency contact numbers to report stolen phones and block SIM cards."
  schema={providersFaqSchema}
>
  <HeaderMobile client:idle />
  
  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-6xl">
      <!-- Hero Section -->
      <div class="bg-foreground text-background rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-10 mb-6 sm:mb-8 ">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 sm:gap-3 mb-3">
              <div class="bg-background/20 p-2 sm:p-3 rounded-xl">
                <Phone className="size-6 sm:size-8" />
              </div>
              <h1 class="text-xl sm:text-2xl md:text-3xl font-bold">Mobile Provider Directory</h1>
            </div>
            <p class="text-neutral-300 text-xs sm:text-sm md:text-base">
              Find your provider{sortedProviders.length > 0 ? ` from ${sortedProviders.length} UK networks` : ' among the UK networks'}. Report your stolen SIM and request a block on your number immediately.
            </p>
          </div>
          <div class="flex flex-col items-start md:items-end gap-2">
            <div class="flex items-center gap-2 bg-background/10 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm">
              <Clock className="size-4" />
              <span>Last verified: {lastUpdated}</span>
            </div>
            <div class="flex items-center gap-2 text-foreground-subtle text-xs">
              <CheckCircle2 className="size-4" />
              <span>All contacts independently verified</span>
            </div>
          </div>
        </div>
      </div>

      <div class="mb-6">
        
        <!-- Search Box -->
        <div class="mb-4 sm:mb-6">
          <label for="provider-search" class="sr-only">Search for your mobile provider</label>
          <div class="relative">
            <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 text-muted-foreground size-5" />
            <input
              id="provider-search"
              type="search"
              class="w-full pl-10 pr-3 py-2 sm:py-3 text-sm sm:text-base border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-primary"
              placeholder="Search for your mobile provider..."
            />
          </div>
        </div>
        
        <!-- Network Filter Tabs -->
        <div class="mb-4 sm:mb-6 overflow-x-auto">
          <div class="flex gap-2 whitespace-nowrap pb-2">
            {networks.map((network, index) => (
              <button
                type="button"
                class={`network-filter px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm rounded-lg transition-colors ${
                  index === 0
                    ? 'bg-primary text-primary-foreground'
                    : 'bg-neutral-200 text-foreground hover:bg-neutral-300'
                }`}
                data-network={network.toLowerCase()}
              >
                {network}
              </button>
            ))}
          </div>
        </div>
        
        <!-- Providers List -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 sm:gap-4" id="provider-list">
          {sortedProviders.map(provider => (
            <div
              class="provider-card bg-card rounded-2xl  hover: transition-all duration-300 overflow-hidden border border-border hover:-translate-y-1"
              data-network={provider.network.toLowerCase()}
            >
              <div class="p-4 sm:p-5">
                <div class="flex items-start justify-between gap-2 mb-3">
                  <div class="min-w-0">
                    <h3 class="text-base sm:text-lg font-bold text-foreground truncate">{provider.name}</h3>
                    <div class="flex items-center gap-2 mt-1.5">
                      <span class="text-xs px-2 py-0.5 bg-neutral-100 text-muted-foreground rounded-full">{provider.network}</span>
                      {provider.is_mvno && <span class="text-xs px-2 py-0.5 bg-primary-muted text-primary-hover rounded-full">MVNO</span>}
                    </div>
                  </div>
                  <a
                    href={provider.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs text-muted-foreground hover:text-primary flex items-center gap-1 flex-shrink-0 mt-1"
                  >
                    <ExternalLink className="size-3" />
                    Website
                  </a>
                </div>

                <!-- Emergency Contact - Prominent -->
                <div class="p-2 sm:p-3 bg-destructive-subtle border border-destructive-muted rounded-xl">
                  <div class="flex items-center gap-2 mb-1">
                    <Phone className="size-4 text-destructive" />
                    <span class="text-xs font-semibold text-destructive uppercase tracking-wide">Emergency Contact</span>
                  </div>
                  {provider.emergencyContact.uk.startsWith('Online') ? (
                    <p class="text-destructive-hover font-medium text-sm">{provider.emergencyContact.uk}</p>
                  ) : (
                    <a href={`tel:${provider.emergencyContact.uk}`} class="text-destructive-hover font-bold text-base sm:text-lg hover:underline block">{provider.emergencyContact.uk}</a>
                  )}
                  <p class="text-muted-foreground text-xs mt-1">{provider.emergencyContact.available}</p>
                </div>

                <!-- Additional Info -->
                {provider.additionalInfo && (
                  <div class="mt-3 p-2 bg-primary-subtle rounded-lg text-xs text-primary">
                    <strong>Note:</strong> {provider.additionalInfo}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
        
        <!-- Important Notes -->
        <div class="mt-6 sm:mt-8 p-4 sm:p-6 bg-neutral-100 border border-border rounded-lg">
          <h3 class="flex items-center font-semibold mb-3 text-foreground text-sm sm:text-base">
            <AlertCircle className="size-5 mr-2" />
            Important Notes:
          </h3>
          <ul class="list-disc pl-5 space-y-2 text-foreground text-xs sm:text-sm">
            <li>Report your SIM as stolen as soon as possible to prevent unauthorized use</li>
            <li>You'll need your phone number and account details when contacting your provider</li>
            <li>Ask for a reference number for your call/report</li>
            <li>Request that they note your device was stolen (not just lost)</li>
            <li>Order a replacement SIM to be sent to a safe address</li>
          </ul>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
  
  <script>
    // Search functionality
    const searchInput = document.getElementById('provider-search') as HTMLInputElement;
    const providerList = document.getElementById('provider-list');
    const networkButtons = document.querySelectorAll('.network-filter');
    let currentNetwork = 'all';
    
    if (searchInput && providerList) {
      searchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase();
        filterProviders(query, currentNetwork);
      });
    }

    // Network filter
    networkButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const network = target.dataset.network || 'all';
        currentNetwork = network;
        
        // Update button styles
        networkButtons.forEach(btn => {
          btn.classList.remove('bg-primary', 'text-primary-foreground');
          btn.classList.add('bg-neutral-200', 'text-foreground');
        });
        target.classList.remove('bg-neutral-200', 'text-foreground');
        target.classList.add('bg-primary', 'text-primary-foreground');
        
        // Filter providers
        const searchQuery = searchInput?.value.toLowerCase() || '';
        filterProviders(searchQuery, network);
      });
    });

    function filterProviders(searchQuery: string, network: string) {
      const providerCards = document.querySelectorAll('.provider-card');
      let visibleCount = 0;
      
      providerCards.forEach((card) => {
        const providerName = card.textContent?.toLowerCase() || '';
        const providerNetwork = (card as HTMLElement).dataset.network || '';
        
        const matchesSearch = providerName.includes(searchQuery);
        const matchesNetwork = network === 'all' || providerNetwork === network;
        
        if (matchesSearch && matchesNetwork) {
          (card as HTMLElement).style.display = '';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      // Show/hide no results message
      let noResultsEl = document.getElementById('no-provider-results');
      if (visibleCount === 0) {
        if (!noResultsEl) {
          noResultsEl = document.createElement('div');
          noResultsEl.id = 'no-provider-results';
          noResultsEl.className = 'col-span-full text-center py-12';
          noResultsEl.innerHTML = `
            <div class="text-muted-foreground mb-2">
              <svg class="size-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </div>
            <p class="text-muted-foreground font-medium">No providers found</p>
            <p class="text-muted-foreground text-sm">Try different search terms or clear your filters</p>
          `;
          providerList?.appendChild(noResultsEl);
        }
        noResultsEl.style.display = '';
      } else if (noResultsEl) {
        noResultsEl.style.display = 'none';
      }
    }
  </script>
</Layout>
