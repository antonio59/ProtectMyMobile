---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { ArrowRight } from 'lucide-react';

const statStrip = [
  { value: '71,391', label: 'Stolen in London in 2025, down 12.3% vs 2024 (Met Police)' },
  { value: '151,220', label: 'Theft from the person, E&W, YE March 2025 (ONS, record high)' },
  { value: '78,000', label: 'Snatch thefts in the UK (Crime Survey, YE March 2024)' },
];
---

<Layout 
  title="About | Antonio Smith | ProtectMyMobile"
  description="I built ProtectMyMobile to help UK residents protect their mobile devices. Here's the mission, how I collect data, and how you can contribute."
  canonicalPath="/about"
>
  <HeaderMobile client:idle />
  
  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-4xl">

      <!-- 1. What is ProtectMyMobile? -->
      <div class="bg-foreground text-background rounded-xl sm:rounded-2xl p-6 sm:p-8 md:p-10 mb-6 sm:mb-8">
        <h1 class="text-xl sm:text-2xl md:text-3xl font-bold mb-3">About ProtectMyMobile</h1>
        <p class="text-neutral-300 text-sm sm:text-base md:text-lg leading-relaxed mb-5">
          An independent resource, built and maintained by <strong>Antonio Smith</strong>, that brings UK phone theft prevention, emergency steps, and the data behind the problem into one place.
        </p>
        <a href="/emergency" class="inline-flex items-center gap-2 bg-destructive text-destructive-foreground font-semibold text-sm sm:text-base px-4 sm:px-5 py-2 sm:py-2.5 rounded-lg hover:opacity-90 transition-opacity">
          Phone stolen? Start here
          <ArrowRight className="size-4" />
        </a>
      </div>

      <!-- 2. Why does it exist? -->
      <section class="bg-card rounded-xl sm:rounded-2xl overflow-hidden border border-border mb-6 sm:mb-8">
        <div class="h-1 bg-foreground"></div>
        <div class="p-5 sm:p-6 md:p-8">
          <h2 class="text-base sm:text-lg font-bold mb-4">Why It Exists</h2>
          <div class="flex flex-col md:flex-row md:items-center gap-5 md:gap-8">
            <div class="md:flex-shrink-0">
              <div class="text-4xl sm:text-5xl font-bold text-primary">117,211</div>
              <p class="text-xs sm:text-sm text-muted-foreground mt-1">Phones stolen in London in 2024 (Met Police FOI)</p>
            </div>
            <p class="text-foreground text-sm sm:text-base leading-relaxed">
              After a theft, the advice people need is scattered across police websites, bank pages, provider portals, and forum threads, exactly when they're stressed and short on time. ProtectMyMobile consolidates it: prevention before it happens, emergency steps when it does, and the data to understand the scale of the problem.
            </p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-6 pt-5 border-t border-border">
            {statStrip.map((stat) => (
              <div>
                <div class="text-lg sm:text-xl font-bold text-foreground">{stat.value}</div>
                <div class="text-xs text-muted-foreground mt-0.5 leading-snug">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 3. What can I do here? -->
      <section class="mb-6 sm:mb-8">
        <h2 class="text-base sm:text-lg font-bold mb-4 sm:mb-5">What You Can Do Here</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <a href="/statistics" class="bg-card rounded-xl shadow-sm border border-border p-4 sm:p-5 hover:border-primary/20 transition-all group">
            <h3 class="font-semibold text-sm sm:text-base text-foreground group-hover:text-primary transition-colors">Theft Data & Statistics</h3>
            <p class="text-muted-foreground text-xs sm:text-sm mt-1">Interactive maps, city-level breakdowns, hotspot rankings, and seasonal trends built from FOI requests and police data.</p>
          </a>
          <a href="/news" class="bg-card rounded-xl shadow-sm border border-border p-4 sm:p-5 hover:border-primary/20 transition-all group">
            <h3 class="font-semibold text-sm sm:text-base text-foreground group-hover:text-primary transition-colors">News Monitoring</h3>
            <p class="text-muted-foreground text-xs sm:text-sm mt-1">Automated tracking of arrests, seizures, law changes, and prevention tips from UK news sources. Updated weekly.</p>
          </a>
          <a href="/prevention" class="bg-card rounded-xl shadow-sm border border-border p-4 sm:p-5 hover:border-primary/20 transition-all group">
            <h3 class="font-semibold text-sm sm:text-base text-foreground group-hover:text-primary transition-colors">Prevention Guides</h3>
            <p class="text-muted-foreground text-xs sm:text-sm mt-1">Step-by-step walkthroughs for SIM locks, biometric security, app-specific passwords, and IMEI registration.</p>
          </a>
          <a href="/emergency" class="bg-card rounded-xl shadow-sm border border-border p-4 sm:p-5 hover:border-primary/20 transition-all group">
            <h3 class="font-semibold text-sm sm:text-base text-foreground group-hover:text-primary transition-colors">Emergency Response</h3>
            <p class="text-muted-foreground text-xs sm:text-sm mt-1">What to do in the first 30 minutes: lock your device, change passwords, contact your bank and network, report to police.</p>
          </a>
        </div>
      </section>

      <!-- 4. Why trust it? -->
      <section class="bg-card rounded-xl sm:rounded-2xl overflow-hidden border border-border mb-6 sm:mb-8">
        <div class="h-1 bg-foreground"></div>
        <div class="p-5 sm:p-6 md:p-8">
          <h2 class="text-base sm:text-lg font-bold mb-4 sm:mb-5">Why Trust It</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
            <div>
              <h3 class="font-semibold text-sm mb-3">Where the data comes from</h3>
              <dl class="space-y-3">
                <div>
                  <dt class="text-sm font-medium text-foreground">Freedom of Information</dt>
                  <dd class="text-xs text-muted-foreground mt-0.5">FOI requests to UK police forces for mobile theft statistics, aggregated into the theft map and trends.</dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-foreground">News aggregation</dt>
                  <dd class="text-xs text-muted-foreground mt-0.5">Automated weekly scanning of UK news sources (Google News, Guardian, Sky News, local police reports), filtered for mobile theft relevance.</dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-foreground">Community reports</dt>
                  <dd class="text-xs text-muted-foreground mt-0.5">Anonymous theft reports from visitors, which surface emerging hotspots before official statistics capture them.</dd>
                </div>
              </dl>
            </div>
            <div class="bg-neutral-100 rounded-xl p-4 sm:p-5">
              <h3 class="font-semibold text-sm mb-3">Built differently</h3>
              <ul class="space-y-2.5 text-xs sm:text-sm text-foreground">
                <li><strong>Free, forever.</strong> No ads, no signups, no paywalls, no premium tiers. Phone theft advice belongs in the public domain.</li>
                <li><strong>Privacy first.</strong> I don't store IMEI numbers, require accounts, or track individual users. Theft reports are anonymous. I use <a href="/privacy" class="text-primary hover:underline">minimal analytics</a>, just enough to know which pages help.</li>
                <li><strong>Shaped by reality.</strong> <a href="/community-experiences" class="text-primary hover:underline">Real experiences</a> shape my guidance. If a prevention tip doesn't match how thefts actually happen, I want to know.</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- 5. How can I help? -->
      <section class="bg-card rounded-xl sm:rounded-2xl overflow-hidden border border-border mb-6 sm:mb-8">
        <div class="h-1 bg-foreground"></div>
        <div class="p-5 sm:p-6 md:p-8">
          <h2 class="text-base sm:text-lg font-bold mb-2">How You Can Help</h2>
          <p class="text-muted-foreground text-sm mb-4">This site improves when people contribute. Three things make a difference:</p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-foreground">
            <li><strong>Report thefts.</strong> If your phone was stolen, <a href="/emergency#report" class="text-primary hover:underline">tell me where and when</a>. Each report improves the hotspot data for everyone.</li>
            <li><strong>Share your experience.</strong> Your story helps others know what to expect. <a href="/community-experiences" class="text-primary hover:underline">Submit your account</a>; it stays anonymous.</li>
            <li><strong>Spread the word.</strong> Share the <a href="/london-visitor-safety" class="text-primary hover:underline">London visitor guide</a> with tourists, or tell colleagues about the <a href="/security-checkup" class="text-primary hover:underline">quick security checkup</a>.</li>
          </ul>
        </div>
      </section>

    </div>
  </main>
  
  <Footer />
</Layout>
