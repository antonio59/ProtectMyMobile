---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { AlertTriangle, TrendingUp, MapPin, Clock, Shield, ArrowRight, ExternalLink, Bike, Users, Coffee, Camera, Train, Moon, Briefcase, Map, TreePine } from 'lucide-react';

const theftMethods = [
  {
    title: "Cyclist Snatch",
    description: "Thieves on bikes ride past pedestrians and grab phones from their hands while they're distracted or texting.",
    icon: Bike,
    color: "red",
    tip: "Keep your phone in your pocket when walking on busy streets."
  },
  {
    title: "Moped Drive-By",
    description: "Riders mount pavements at speed to snatch phones, often working in pairs with a driver and grabber.",
    icon: Bike,
    color: "orange",
    tip: "Stand away from the kerb and face oncoming traffic when using your phone."
  },
  {
    title: "Bump and Grab",
    description: "In crowded areas, someone bumps into you as a distraction while an accomplice steals your phone.",
    icon: Users,
    color: "yellow",
    tip: "Be extra vigilant in tourist hotspots and busy shopping areas."
  },
  {
    title: "Public Transport Pickpocket",
    description: "Phones are lifted from pockets or bags on busy tubes, buses, and trains, especially during rush hour.",
    icon: Train,
    color: "green",
    tip: "Use inside pockets with zips and keep bags in front of you."
  },
  {
    title: "Café Tabletop Grab",
    description: "Phones left on tables at cafés and restaurants are swiped by thieves walking past or pretending to be customers.",
    icon: Coffee,
    color: "teal",
    tip: "Never leave your phone unattended on a table, even briefly."
  },
  {
    title: "Map Distraction",
    description: "A stranger asks for directions with a map or paper, covering your phone on a table while they or an accomplice takes it.",
    icon: Map,
    color: "blue",
    tip: "Pick up your belongings before helping anyone with directions."
  },
  {
    title: "Park Grab-and-Run",
    description: "While relaxing in a park, thieves snatch phones from hands or blankets and sprint away.",
    icon: TreePine,
    color: "emerald",
    tip: "Stay alert in open spaces and keep valuables secured."
  },
  {
    title: "Photo Opportunity Theft",
    description: "Someone offers to take your photo, then runs off with your phone, or snatches it while you're taking selfies.",
    icon: Camera,
    color: "purple",
    tip: "Only hand your phone to people you trust, or use a selfie stick."
  },
  {
    title: "Bag Pocket Theft",
    description: "Phones in external bag pockets or backpacks are easy targets for skilled pickpockets in crowded places.",
    icon: Briefcase,
    color: "slate",
    tip: "Use internal compartments and anti-theft bags with hidden zips."
  },
  {
    title: "Night Out Theft",
    description: "Bars and clubs are prime locations where phones are taken from tables, pockets, or while victims are intoxicated.",
    icon: Moon,
    color: "indigo",
    tip: "Keep your phone secure and avoid leaving it on bar tops."
  }
];

const colorClasses: Record<string, { bg: string; border: string; icon: string; badge: string }> = {
  red: { bg: 'bg-destructive-subtle', border: 'border-destructive-muted', icon: 'text-destructive', badge: 'bg-destructive-muted text-destructive-hover' },
  orange: { bg: 'bg-warning-subtle', border: 'border-border', icon: 'text-warning', badge: 'bg-warning-subtle text-warning' },
  yellow: { bg: 'bg-warning-subtle', border: 'border-border', icon: 'text-warning', badge: 'bg-warning-subtle text-warning' },
  green: { bg: 'bg-success-subtle', border: 'border-border', icon: 'text-success', badge: 'bg-success-subtle text-success' },
  teal: { bg: 'bg-success-subtle', border: 'border-border', icon: 'text-success', badge: 'bg-success-subtle text-success' },
  blue: { bg: 'bg-primary-subtle', border: 'border-border', icon: 'text-primary', badge: 'bg-primary-muted text-primary-hover' },
  emerald: { bg: 'bg-success-subtle', border: 'border-border', icon: 'text-success', badge: 'bg-success-subtle text-success' },
  purple: { bg: 'bg-primary-subtle', border: 'border-border', icon: 'text-primary', badge: 'bg-primary-muted text-primary' },
  slate: { bg: 'bg-neutral-100', border: 'border-border', icon: 'text-muted-foreground', badge: 'bg-neutral-100 text-neutral-700' },
  indigo: { bg: 'bg-primary-subtle', border: 'border-border', icon: 'text-primary', badge: 'bg-primary-muted text-primary' },
};

const stats = [
  { value: '116,000+', label: 'Phones stolen in London (2024)', color: 'text-destructive' },
  { value: '230,000+', label: 'UK mobile thefts per year', color: 'text-warning' },
  { value: '150%', label: 'Increase since 2022', color: 'text-warning' },
  { value: '<5%', label: 'Recovery rate', color: 'text-success' },
];

const hotspots = [
  { area: 'Westminster', thefts: '12,000+', risk: 'Extreme' },
  { area: 'Camden', thefts: '8,500+', risk: 'Very High' },
  { area: 'Tower Hamlets', thefts: '6,200+', risk: 'High' },
  { area: 'Hackney', thefts: '5,800+', risk: 'High' },
  { area: 'Lambeth', thefts: '5,100+', risk: 'High' },
  { area: 'Southwark', thefts: '4,900+', risk: 'High' },
];
---

<Layout 
  title="Phone Theft Epidemic UK | How Thieves Steal Phones in London"
  description="Discover how phone thieves operate in London and UK: moped gangs, snatch thefts, distraction tactics. Understand the crisis to protect yourself."
  canonicalPath="/the-problem"
  schema={{
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "The UK Mobile Phone Theft Epidemic",
    "description": "Understanding how phone thieves operate in the UK - from moped gangs to distraction tactics.",
    "author": { "@type": "Organization", "name": "ProtectMyMobile" },
    "publisher": { "@type": "Organization", "name": "ProtectMyMobile" }
  }}
>
  <HeaderMobile client:idle />
  
  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-6xl">
      
      <!-- Hero Section -->
      <div class="bg-gradient-to-br from-destructive to-destructive-hover text-white rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-10 mb-6 sm:mb-8 shadow-xl relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
        <div class="relative">
          <div class="flex items-center gap-3 mb-3">
            <div class="bg-white/20 p-2 sm:p-3 rounded-xl">
              <AlertTriangle class="size-6 sm:size-8" />
            </div>
            <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-shadow-danger">The Mobile Theft Epidemic</h1>
          </div>
          <p class="text-destructive-muted text-xs sm:text-sm md:text-base mb-6">
            Phone theft in the UK has reached crisis levels. Understanding how thieves operate is the first step to protecting yourself.
          </p>
          <div class="flex flex-wrap gap-3">
            <div class="flex items-center gap-2 bg-white/10 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm">
              <TrendingUp class="size-4" />
              <span>150% increase since 2022</span>
            </div>
            <div class="flex items-center gap-2 bg-white/10 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm">
              <Clock class="size-4" />
              <span>One stolen every 5 minutes</span>
            </div>
            <a href="/scenarios" class="inline-flex items-center gap-2 bg-card text-destructive-hover px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm font-semibold shadow-md hover:bg-card/90 transition">
              <AlertTriangle class="size-4" />
              View scenario slides
            </a>
          </div>
        </div>
      </div>
      
      <!-- Stats Section -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <h2 class="text-lg sm:text-xl font-bold mb-6 flex items-center gap-2">
          <TrendingUp class="size-4 sm:size-5 text-destructive" />
          The Numbers
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
          {stats.map((stat) => (
            <div class="bg-card rounded-lg sm:rounded-2xl p-3 sm:p-4 md:p-5 shadow-md border border-border text-center">
              <div class={`text-xl sm:text-2xl md:text-3xl font-bold ${stat.color}`}>{stat.value}</div>
              <p class="text-[10px] sm:text-xs text-muted-foreground mt-2">{stat.label}</p>
            </div>
          ))}
        </div>
      </section>
      
      <!-- How Thieves Operate -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-xl sm:rounded-2xl shadow-md overflow-hidden border border-border">
          <div class="h-2 bg-gradient-to-r from-destructive to-warning"></div>
          <div class="p-4 sm:p-6 md:p-8">
            <h2 class="text-lg sm:text-xl font-bold mb-2">How Thieves Operate</h2>
            <p class="text-muted-foreground text-sm mb-6">
              Phone thieves use various methods. Learn these tactics to stay alert and protect yourself.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
              {theftMethods.map((method) => {
                const colors = colorClasses[method.color];
                return (
                  <div class={`${colors.bg} ${colors.border} border rounded-lg sm:rounded-xl p-3 sm:p-4 md:p-5 hover:shadow-md transition-shadow`}>
                    <div class="flex items-start gap-3 sm:gap-4">
                      <div class={`${colors.icon} mt-1`}>
                        <method.icon class="size-5 sm:size-6" />
                      </div>
                      <div class="flex-1">
                        <h3 class="font-bold text-foreground mb-1">{method.title}</h3>
                        <p class="text-sm text-foreground mb-3">{method.description}</p>
                        <div class={`${colors.badge} text-xs sm:text-sm px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg inline-flex items-center gap-1`}>
                          <Shield class="size-3" />
                          {method.tip}
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </section>
      
      <!-- Hotspots -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <h2 class="text-lg sm:text-xl font-bold mb-6 flex items-center gap-2">
          <MapPin class="size-4 sm:size-5 text-destructive" />
          London Theft Hotspots
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-2 sm:gap-3">
          {hotspots.map((spot) => (
            <div class="bg-card rounded-lg sm:rounded-xl p-3 sm:p-4 shadow-md border border-border">
              <div class="flex items-center gap-2 mb-1">
                <MapPin class="size-4 text-destructive" />
                <span class="font-semibold text-xs sm:text-sm">{spot.area}</span>
              </div>
              <p class="text-lg font-bold text-destructive">{spot.thefts}</p>
              <span class={`text-xs sm:text-sm px-2 py-0.5 rounded-full ${
                spot.risk === 'Extreme' ? 'bg-destructive-muted text-destructive-hover' :
                spot.risk === 'Very High' ? 'bg-warning-subtle text-warning' :
                'bg-warning-subtle text-warning'
              }`}>
                {spot.risk} Risk
              </span>
            </div>
          ))}
        </div>
        <p class="text-xs text-muted-foreground mt-4">
          Source: Metropolitan Police & police.uk recorded crime data (2024–2025). Other major UK cities also experiencing significant increases.
        </p>
      </section>
      
      <!-- Why It Matters -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-gradient-to-r from-warning to-warning rounded-2xl p-4 sm:p-6 md:p-8 border border-border">
          <h2 class="text-lg sm:text-xl font-bold mb-4 flex items-center gap-2">
            <AlertTriangle class="size-4 sm:size-5 text-warning" />
            Why It Matters
          </h2>
          <div class="grid md:grid-cols-2 gap-4">
            <div class="bg-card rounded-xl p-3 sm:p-4 shadow-md">
              <h3 class="font-semibold mb-2">Beyond the Device Cost</h3>
              <ul class="text-sm text-foreground space-y-2">
                <li>• Access to banking apps and financial data</li>
                <li>• Personal photos and private messages</li>
                <li>• Email and social media accounts</li>
                <li>• Two-factor authentication codes</li>
              </ul>
            </div>
            <div class="bg-card rounded-xl p-3 sm:p-4 shadow-md">
              <h3 class="font-semibold mb-2">Identity Theft Risk</h3>
              <ul class="text-sm text-foreground space-y-2">
                <li>• Fraudulent loans taken in your name</li>
                <li>• Bank accounts emptied</li>
                <li>• Credit cards maxed out</li>
                <li>• Recovery can take months</li>
              </ul>
            </div>
          </div>
        </div>
      </section>
      
      <!-- Government Response -->
      <section class="mb-6 sm:mb-8 md:mb-10">
        <div class="bg-card rounded-2xl shadow-md p-4 sm:p-6 md:p-8 border border-border">
          <h2 class="text-lg sm:text-xl font-bold mb-4">Government Response</h2>
          <p class="text-foreground text-sm mb-4">
            The UK government has announced plans to tackle the phone theft epidemic, including:
          </p>
          <ul class="space-y-2 text-sm text-foreground">
            <li class="flex items-start gap-2">
              <Shield class="size-4 text-success mt-0.5 flex-shrink-0" />
              <span>Factory reset blocks - making stolen phones unusable</span>
            </li>
            <li class="flex items-start gap-2">
              <Shield class="size-4 text-success mt-0.5 flex-shrink-0" />
              <span>Working with manufacturers on kill switch technology</span>
            </li>
            <li class="flex items-start gap-2">
              <Shield class="size-4 text-success mt-0.5 flex-shrink-0" />
              <span>Increased police focus on organised theft gangs</span>
            </li>
            <li class="flex items-start gap-2">
              <Shield class="size-4 text-success mt-0.5 flex-shrink-0" />
              <span>National database improvements for stolen devices</span>
            </li>
          </ul>
          <a href="https://www.gov.uk/government/news/crackdown-to-halt-rise-in-phone-thefts" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-primary text-sm mt-4 hover:underline">
            Read the government announcement
            <ExternalLink class="size-4" />
          </a>
        </div>
      </section>
      
      <!-- CTA Section -->
      <section class="bg-gradient-to-r from-primary to-primary rounded-2xl p-4 sm:p-6 md:p-8 text-white">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div>
            <h2 class="text-lg sm:text-xl font-bold mb-2">Don't become a statistic</h2>
            <p class="text-neutral-300 text-sm">
              Take action now to protect your device and know what to do if the worst happens.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/prevention" class="inline-flex items-center justify-center gap-2 px-4 sm:px-6 py-2.5 sm:py-3 bg-background text-primary rounded-xl font-semibold text-xs sm:text-sm hover:bg-primary-subtle transition-colors">
              <Shield class="size-4" />
              Prevention Guide
            </a>
            <a href="/emergency" class="inline-flex items-center justify-center gap-2 px-4 sm:px-6 py-2.5 sm:py-3 bg-destructive text-white rounded-xl font-semibold text-xs sm:text-sm hover:bg-destructive transition-colors">
              Emergency Steps
              <ArrowRight class="size-4" />
            </a>
          </div>
        </div>
      </section>
      
    </div>
  </main>
  
  <Footer />
</Layout>
