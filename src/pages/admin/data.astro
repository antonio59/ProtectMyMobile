---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout
  title="Data Manager | ProtectMyMobile Admin"
  description="Import and manage theft statistics data."
  currentPage="data"
>
  <div class="p-3 sm:p-4 lg:p-8">
    <!-- Header -->
    <div class="mb-6 sm:mb-8">
      <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-foreground">Theft Data Manager</h1>
      <p class="text-neutral-600 text-xs sm:text-sm mt-1 sm:mt-2">Import data from WhatDoTheyKnow FOI responses and manage theft statistics.</p>
    </div>

    <!-- Stats Overview -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 sm:gap-4 mb-6 sm:mb-8">
      <div class="bg-card rounded-lg p-3 sm:p-4 ">
        <div class="text-xl sm:text-2xl font-bold text-foreground" id="stat-total-records">-</div>
        <div class="text-xs text-neutral-500">Total Records</div>
      </div>
      <div class="bg-card rounded-lg p-3 sm:p-4 ">
        <div class="text-xl sm:text-2xl font-bold text-primary" id="stat-total-thefts">-</div>
        <div class="text-xs text-neutral-500">Total Thefts</div>
      </div>
      <div class="bg-card rounded-lg p-3 sm:p-4 ">
        <div class="text-xl sm:text-2xl font-bold text-success" id="stat-wdtk-entries">-</div>
        <div class="text-xs text-neutral-500">WDTK Entries</div>
      </div>
      <div class="bg-card rounded-lg p-3 sm:p-4 ">
        <div class="text-xl sm:text-2xl font-bold text-warning" id="stat-pending-import">-</div>
        <div class="text-xs text-neutral-500">Pending Import</div>
      </div>
      <div class="bg-card rounded-lg p-3 sm:p-4 ">
        <div class="text-xl sm:text-2xl font-bold text-success" id="stat-locations">-</div>
        <div class="text-xs text-neutral-500">Locations</div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap gap-2 sm:gap-3 mb-6">
      <button id="seed-btn" class="px-3 sm:px-4 py-1.5 sm:py-2 bg-success text-white rounded-lg hover:bg-success text-xs sm:text-sm">
        Seed Verified Data
      </button>
      <button id="fetch-police-uk-btn" class="px-3 sm:px-4 py-1.5 sm:py-2 bg-primary text-white rounded-lg hover:bg-primary text-xs sm:text-sm">
        Fetch Police.uk Data
      </button>
      <button id="scan-btn" class="px-3 sm:px-4 py-1.5 sm:py-2 bg-primary text-white rounded-lg hover:bg-primary-hover text-xs sm:text-sm">
        Scan WhatDoTheyKnow
      </button>
      <button id="scrape-btn" class="px-3 sm:px-4 py-1.5 sm:py-2 bg-success text-white rounded-lg hover:bg-success text-xs sm:text-sm">
        Deep Scrape WDTK
      </button>
      <button id="test-email-btn" class="px-3 sm:px-4 py-1.5 sm:py-2 bg-warning text-white rounded-lg hover:bg-warning text-xs sm:text-sm">
        Test Email
      </button>
      <button id="refresh-btn" class="px-3 sm:px-4 py-1.5 sm:py-2 bg-neutral-200 rounded-lg hover:bg-neutral-300 text-xs sm:text-sm">
        Refresh
      </button>
    </div>

    <!-- Email Configuration Notice -->
    <div class="bg-neutral-100 border border-border rounded-lg p-3 sm:p-4 mb-6">
      <p class="text-xs sm:text-sm text-foreground">
        <strong>Email Notifications:</strong> Notifications will be sent to protectmymobile.xyz.overlabor129@passmail.com
      </p>
    </div>

    <!-- WDTK Entries with Data -->
    <div class="bg-card rounded-xl  overflow-hidden mb-6 sm:mb-8">
      <div class="p-3 sm:p-4 border-b bg-neutral-50">
        <h2 class="font-bold text-sm sm:text-base">WhatDoTheyKnow FOI Responses (with Data)</h2>
        <p class="text-xs sm:text-sm text-neutral-600 mt-1">Successful FOI responses that can be imported</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-neutral-50 border-b">
            <tr>
              <th class="text-left px-2 sm:px-4 py-2 sm:py-3 text-xs font-semibold">Police Force</th>
              <th class="text-left px-2 sm:px-4 py-2 sm:py-3 text-xs font-semibold">Title</th>
              <th class="text-left px-2 sm:px-4 py-2 sm:py-3 text-xs font-semibold">Date</th>
              <th class="text-left px-2 sm:px-4 py-2 sm:py-3 text-xs font-semibold">Status</th>
              <th class="text-left px-2 sm:px-4 py-2 sm:py-3 text-xs font-semibold">Actions</th>
            </tr>
          </thead>
          <tbody id="wdtk-table">
            <tr><td colspan="5" class="text-center py-6 sm:py-8 text-neutral-500 text-xs sm:text-sm">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Manual Import -->
    <div class="bg-card rounded-xl  p-4 sm:p-6">
      <h2 class="font-bold mb-3 sm:mb-4 text-sm sm:text-base">Manual Data Import</h2>
      <p class="text-xs sm:text-sm text-neutral-600 mb-4">Upload a CSV file with theft data. Required columns: date, location_name, latitude, longitude, theft_count</p>

      <form id="import-form" class="space-y-4">
        <div>
          <label class="block text-xs sm:text-sm font-medium mb-1">Data Source Name</label>
          <input type="text" id="source-name" class="w-full border rounded-lg px-3 py-2 text-sm" placeholder="e.g., Met Police FOI 2024" required />
        </div>
        <div>
          <label class="block text-xs sm:text-sm font-medium mb-1">CSV File</label>
          <input type="file" id="csv-file" accept=".csv" class="w-full border rounded-lg px-3 py-2 text-sm" required />
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" id="preview-btn" class="px-3 sm:px-4 py-1.5 sm:py-2 bg-neutral-200 rounded-lg hover:bg-neutral-300 text-xs sm:text-sm">
            Preview Data
          </button>
          <button type="submit" class="px-3 sm:px-4 py-1.5 sm:py-2 bg-primary text-white rounded-lg hover:bg-primary-hover text-xs sm:text-sm">
            Import Data
          </button>
        </div>
      </form>

      <!-- Preview Area -->
      <div id="preview-area" class="mt-4 hidden">
        <h3 class="font-medium mb-2 text-sm">Preview (first 5 rows)</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-xs sm:text-sm border">
            <thead id="preview-head" class="bg-neutral-100"></thead>
            <tbody id="preview-body"></tbody>
          </table>
        </div>
        <p id="preview-count" class="text-xs sm:text-sm text-neutral-600 mt-2"></p>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  function escapeHtml(str: string | null | undefined): string {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#x27;');
  }

  async function adminConvex(method: 'query' | 'mutation', path: string, args: any = {}) {
    const res = await fetch('/api/admin/convex', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ method, path, args }),
    });
    const json = await res.json();
    if (!res.ok) throw new Error(json.error || 'Request failed');
    return json.value;
  }

  let parsedData: any[] = [];

  async function loadStats() {
    try {
      const [dataStats, wdtkStats] = await Promise.all([
        adminConvex('query', 'theftDataPoints:getStats'),
        adminConvex('query', 'wdtkEntries:getStats'),
      ]);

      document.getElementById('stat-total-records')!.textContent = dataStats?.totalRecords?.toLocaleString() || '0';
      document.getElementById('stat-total-thefts')!.textContent = dataStats?.totalThefts?.toLocaleString() || '0';
      document.getElementById('stat-locations')!.textContent = dataStats?.uniqueLocations?.toLocaleString() || '0';
      document.getElementById('stat-wdtk-entries')!.textContent = wdtkStats?.total || '0';
      document.getElementById('stat-pending-import')!.textContent = wdtkStats?.pendingImport || '0';
    } catch (err) {
      console.error('Failed to load stats:', err);
    }
  }

  async function loadWdtkEntries() {
    const tbody = document.getElementById('wdtk-table')!;
    try {
      const entries = await adminConvex('query', 'wdtkEntries:list', { hasData: true }) || [];

      if (entries.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center py-6 sm:py-8 text-neutral-500 text-xs sm:text-sm">No WDTK entries with data found. Click "Scan WhatDoTheyKnow" to fetch.</td></tr>';
        return;
      }

      tbody.innerHTML = entries.map((e: any) => {
        const date = new Date(e.publishedAt).toLocaleDateString('en-GB');
        const statusColors: Record<string, string> = {
          successful: 'bg-success-subtle text-success',
          partial: 'bg-warning-subtle text-warning',
        };
        const statusClass = statusColors[e.status] || 'bg-neutral-100';

        return `
          <tr class="border-b hover:bg-neutral-50">
            <td class="px-2 sm:px-4 py-2 sm:py-3 text-xs sm:text-sm font-medium">${escapeHtml(e.policeForce || 'Unknown')}</td>
            <td class="px-2 sm:px-4 py-2 sm:py-3 text-xs sm:text-sm">
              <a href="${escapeHtml(e.url)}" target="_blank" class="text-primary hover:underline">${escapeHtml(e.title)}</a>
            </td>
            <td class="px-2 sm:px-4 py-2 sm:py-3 text-xs sm:text-sm text-neutral-600">${date}</td>
            <td class="px-2 sm:px-4 py-2 sm:py-3">
              <span class="px-2 py-1 rounded-full text-xs font-medium ${statusClass}">
                ${e.dataImported ? 'Imported' : escapeHtml(e.status)}
              </span>
              ${e.recordsImported ? `<span class="text-xs text-neutral-500 ml-1">(${e.recordsImported} records)</span>` : ''}
            </td>
            <td class="px-2 sm:px-4 py-2 sm:py-3">
              <a href="${escapeHtml(e.url)}" target="_blank" class="text-xs sm:text-sm text-primary hover:underline">View Response</a>
            </td>
          </tr>
        `;
      }).join('');
    } catch (err) {
      console.error('Failed to load WDTK entries:', err);
      tbody.innerHTML = '<tr><td colspan="5" class="text-center py-6 sm:py-8 text-destructive text-xs sm:text-sm">Failed to load entries</td></tr>';
    }
  }

  function parseCSV(text: string): any[] {
    const lines = text.trim().split('\n');
    if (lines.length < 2) return [];

    const headers = lines[0].split(',').map(h => h.trim().toLowerCase().replace(/['"]/g, ''));
    const records = [];

    for (let i = 1; i < lines.length; i++) {
      const values = lines[i].split(',').map(v => v.trim().replace(/['"]/g, ''));
      const record: any = {};
      headers.forEach((h, idx) => record[h] = values[idx]);

      if (record.date && record.location_name && record.theft_count) {
        records.push(record);
      }
    }
    return records;
  }

  function showPreview() {
    const fileInput = document.getElementById('csv-file') as HTMLInputElement;
    if (!fileInput.files?.[0]) {
      alert('Please select a CSV file first');
      return;
    }

    const reader = new FileReader();
    reader.onload = (e) => {
      const text = e.target?.result as string;
      parsedData = parseCSV(text);

      if (parsedData.length === 0) {
        alert('No valid data found in CSV. Check column names.');
        return;
      }

      const preview = document.getElementById('preview-area')!;
      const thead = document.getElementById('preview-head')!;
      const tbody = document.getElementById('preview-body')!;
      const count = document.getElementById('preview-count')!;

      const headers = Object.keys(parsedData[0]);
      thead.innerHTML = `<tr>${headers.map(h => `<th class="px-2 py-1 text-left">${escapeHtml(h)}</th>`).join('')}</tr>`;
      tbody.innerHTML = parsedData.slice(0, 5).map(row =>
        `<tr>${headers.map(h => `<td class="px-2 py-1 border-t">${escapeHtml(row[h] || '')}</td>`).join('')}</tr>`
      ).join('');
      count.textContent = `Total rows: ${parsedData.length}`;
      preview.classList.remove('hidden');
    };
    reader.readAsText(fileInput.files[0]);
  }

  async function importData(e: Event) {
    e.preventDefault();

    if (parsedData.length === 0) {
      alert('Please preview the data first');
      return;
    }

    const sourceName = (document.getElementById('source-name') as HTMLInputElement).value;
    if (!sourceName) {
      alert('Please enter a data source name');
      return;
    }

    try {
      const dataPoints = parsedData.map(row => ({
        date: row.date,
        locationName: row.location_name,
        latitude: parseFloat(row.latitude) || 0,
        longitude: parseFloat(row.longitude) || 0,
        theftCount: parseInt(row.theft_count) || 0,
        dataSource: sourceName,
      }));

      await adminConvex('mutation', 'theftDataPoints:createBatch', { dataPoints });

      alert(`Successfully imported ${dataPoints.length} records!`);
      parsedData = [];
      document.getElementById('preview-area')!.classList.add('hidden');
      (document.getElementById('import-form') as HTMLFormElement).reset();
      await loadStats();
    } catch (err) {
      console.error('Import failed:', err);
      alert('Import failed. Check console for details.');
    }
  }

  async function seedData() {
    if (!confirm('This will seed the database with verified UK theft statistics. Continue?')) return;

    try {
      const response = await fetch('/api/admin/proxy?path=/api/admin/seed-theft-data');
      const data = await response.json();

      if (data.success) {
        alert(`Data seeded!\n\n${data.message}\nLocations: ${data.locations}\nMonths: ${data.months}`);
        await loadStats();
      } else {
        alert('Seed failed: ' + (data.message || data.error));
      }
    } catch (err) {
      console.error('Seed failed:', err);
      alert('Seed failed. Check console for details.');
    }
  }

  async function scanWdtk() {
    try {
      const response = await fetch('/api/admin/proxy?path=/api/cron/monitor-wdtk');
      const data = await response.json();

      if (data.success) {
        alert(`Scan complete!\n\nNew entries: ${data.new_entries}\nSuccessful responses: ${data.successful_responses}`);
        await loadWdtkEntries();
        await loadStats();
      } else {
        alert('Scan failed: ' + data.error);
      }
    } catch (err) {
      console.error('Scan failed:', err);
      alert('Scan failed. Check console for details.');
    }
  }

  async function deepScrapeWdtk() {
    if (!confirm('This will scrape multiple pages of WDTK for FOI requests. This may take a minute. Continue?')) return;

    try {
      const response = await fetch('/api/admin/proxy?path=/api/admin/scrape-wdtk&pages=10');
      const data = await response.json();

      if (data.success) {
        alert(`Deep scrape complete!\n\nTotal found: ${data.totalFound}\nRelevant: ${data.relevant}\nNew saved: ${data.saved}\nSkipped (existing): ${data.skipped}`);
        await loadWdtkEntries();
        await loadStats();
      } else {
        alert('Scrape failed: ' + data.error);
      }
    } catch (err) {
      console.error('Scrape failed:', err);
      alert('Scrape failed. Check console for details.');
    }
  }

  // Event listeners
  document.addEventListener('DOMContentLoaded', () => {
    loadStats();
    loadWdtkEntries();
  });

  async function fetchPoliceUK() {
    // Prompt for date range
    const startMonth = prompt('Enter start month (YYYY-MM):', '2024-01');
    if (!startMonth) return;

    const endMonth = prompt('Enter end month (YYYY-MM):', '2024-12');
    if (!endMonth) return;

    if (!confirm(`This will fetch theft data from police.uk API for ${startMonth} to ${endMonth}.\n\nThis may take several minutes (24 locations × months). Continue?`)) {
      return;
    }

    const btn = document.getElementById('fetch-police-uk-btn') as HTMLButtonElement;
    const originalText = btn.textContent;
    btn.textContent = 'Fetching... Please wait';
    btn.disabled = true;

    try {
      const response = await fetch(`/api/admin/proxy?path=/api/admin/fetch-police-uk&startMonth=${startMonth}&endMonth=${endMonth}`);
      const data = await response.json();

      if (data.success) {
        const summary = [
          `Police.uk Data Fetch Complete!`,
          ``,
          `Date Range: ${data.dateRange.start} to ${data.dateRange.end} (${data.dateRange.months} months)`,
          `Locations: ${data.locations}`,
          ``,
          `API Requests:`,
          `- Total: ${data.apiStats.totalRequests}`,
          `- Successful: ${data.apiStats.successful}`,
          `- Failed: ${data.apiStats.failed}`,
          `- Success Rate: ${data.apiStats.successRate}`,
          ``,
          `Crime Data:`,
          `- Total Crimes Found: ${data.crimeData.totalCrimes}`,
          `- New Records Created: ${data.crimeData.recordsCreated}`,
          `- Duplicates Skipped: ${data.crimeData.duplicatesSkipped}`,
          `- Existing Records: ${data.crimeData.existingRecords}`,
          ``,
          `Top Locations:`,
          ...data.topLocations.map((loc: any) => `- ${loc.name}: ${loc.crimes} crimes`),
        ];

        if (data.errors && data.errors.length > 0) {
          summary.push(``, `Errors (${data.errors.length}):`);
          summary.push(...data.errors.slice(0, 5).map((e: string) => `- ${e}`));
        }

        alert(summary.join('\n'));
        await loadStats();
      } else {
        alert('Fetch failed: ' + (data.error || 'Unknown error'));
      }
    } catch (err) {
      console.error('Police.uk fetch failed:', err);
      alert('Fetch failed. Check console for details.');
    } finally {
      btn.textContent = originalText;
      btn.disabled = false;
    }
  }

  async function testEmail() {
    const email = prompt('Enter your email address to receive a test notification:', '');
    if (!email) return;

    try {
      const response = await fetch(`/api/admin/proxy?path=/api/admin/test-email&email=${encodeURIComponent(email)}`);
      const data = await response.json();

      if (data.success) {
        alert(`Test email sent to ${email}!\n\nCheck your inbox (and spam folder).`);
      } else {
        alert('Email failed: ' + data.error);
      }
    } catch (err) {
      console.error('Email test failed:', err);
      alert('Email test failed. Check console for details.');
    }
  }

  document.getElementById('seed-btn')?.addEventListener('click', seedData);
  document.getElementById('fetch-police-uk-btn')?.addEventListener('click', fetchPoliceUK);
  document.getElementById('scan-btn')?.addEventListener('click', scanWdtk);
  document.getElementById('scrape-btn')?.addEventListener('click', deepScrapeWdtk);
  document.getElementById('test-email-btn')?.addEventListener('click', testEmail);
  document.getElementById('refresh-btn')?.addEventListener('click', () => {
    loadStats();
    loadWdtkEntries();
  });
  document.getElementById('preview-btn')?.addEventListener('click', showPreview);
  document.getElementById('import-form')?.addEventListener('submit', importData);
</script>
