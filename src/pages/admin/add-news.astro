---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout
  title="Add News Article | ProtectMyMobile Admin"
  description="Manually add news articles."
  currentPage="news"
>
  <div class="p-3 sm:p-4 lg:p-8">
    <!-- Header -->
    <div class="mb-6 sm:mb-8">
      <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-foreground">Add News Article</h1>
      <p class="text-neutral-600 text-xs sm:text-sm mt-1 sm:mt-2">Manually add articles that aren't picked up by automated scraping.</p>
    </div>

    <div class="bg-card rounded-xl shadow-md p-4 sm:p-6">
      <form id="add-news-form" class="space-y-4 sm:space-y-6">
        <div>
          <label class="block text-xs sm:text-sm font-medium mb-1">Article Title *</label>
          <input type="text" id="title" required class="w-full border rounded-lg px-3 py-2 text-sm"
            placeholder="e.g., Revolut Unveils Street Mode to Fight Transfer Muggings">
        </div>

        <div>
          <label class="block text-xs sm:text-sm font-medium mb-1">Source URL *</label>
          <input type="url" id="sourceUrl" required class="w-full border rounded-lg px-3 py-2 text-sm"
            placeholder="https://example.com/article">
        </div>

        <div>
          <label class="block text-xs sm:text-sm font-medium mb-1">Source Name *</label>
          <input type="text" id="sourceName" required class="w-full border rounded-lg px-3 py-2 text-sm"
            placeholder="e.g., Fintech Global">
        </div>

        <div>
          <label class="block text-xs sm:text-sm font-medium mb-1">Excerpt / Summary *</label>
          <textarea id="excerpt" required rows="3" class="w-full border rounded-lg px-3 py-2 text-sm"
            placeholder="Brief summary of the article (1-2 sentences)"></textarea>
        </div>

        <div>
          <label class="block text-xs sm:text-sm font-medium mb-1">Full Content (optional)</label>
          <textarea id="content" rows="6" class="w-full border rounded-lg px-3 py-2 text-sm"
            placeholder="Full article content or leave blank to use excerpt"></textarea>
        </div>

        <div>
          <label class="block text-xs sm:text-sm font-medium mb-1">Category *</label>
          <select id="category" required class="w-full border rounded-lg px-3 py-2 text-sm">
            <option value="prevention_tip">Prevention Tip</option>
            <option value="statistics">Statistics</option>
            <option value="arrest">Arrest / Charges</option>
            <option value="seizure">Seizure / Recovery</option>
            <option value="law_change">Law / Policy Change</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div>
          <label class="block text-xs sm:text-sm font-medium mb-1">Featured Image URL (optional)</label>
          <input type="url" id="imageUrl" class="w-full border rounded-lg px-3 py-2 text-sm"
            placeholder="https://example.com/image.jpg">
        </div>

        <div class="flex items-center gap-2">
          <input type="checkbox" id="published" checked class="rounded">
          <label for="published" class="text-xs sm:text-sm">Publish immediately</label>
        </div>

        <div class="flex flex-wrap gap-2 sm:gap-3">
          <button type="submit" class="px-4 sm:px-6 py-2 bg-primary text-white rounded-lg hover:bg-primary-hover text-xs sm:text-sm">
            Add Article
          </button>
          <a href="/admin/news" class="px-4 sm:px-6 py-2 bg-neutral-200 rounded-lg hover:bg-neutral-300 text-xs sm:text-sm inline-flex items-center">
            Back to News
          </a>
        </div>
      </form>

      <div id="result" class="mt-4 hidden"></div>
    </div>

    <!-- Quick Add from URL -->
    <div class="bg-card rounded-xl shadow-md p-4 sm:p-6 mt-6">
      <h2 class="text-base sm:text-xl font-bold mb-3 sm:mb-4">Quick Add from URL</h2>
      <p class="text-xs sm:text-sm text-neutral-600 mb-4">Paste an article URL and we'll try to extract the details automatically.</p>

      <div class="flex flex-col sm:flex-row gap-2">
        <input type="url" id="quick-url" class="flex-1 border rounded-lg px-3 py-2 text-sm"
          placeholder="https://example.com/article">
        <button id="fetch-btn" class="px-3 sm:px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-hover text-xs sm:text-sm whitespace-nowrap">
          Fetch Details
        </button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  function generateSlug(title: string): string {
    return title
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)+/g, '')
      .substring(0, 100);
  }

  async function adminConvex(method: 'query' | 'mutation', path: string, args: any = {}) {
    const res = await fetch('/api/admin/convex', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ method, path, args }),
    });
    const json = await res.json();
    if (!res.ok) throw new Error(json.error || 'Request failed');
    return json.value;
  }

  document.getElementById('add-news-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const title = (document.getElementById('title') as HTMLInputElement).value;
    const sourceUrl = (document.getElementById('sourceUrl') as HTMLInputElement).value;
    const sourceName = (document.getElementById('sourceName') as HTMLInputElement).value;
    const excerpt = (document.getElementById('excerpt') as HTMLTextAreaElement).value;
    const content = (document.getElementById('content') as HTMLTextAreaElement).value;
    const category = (document.getElementById('category') as HTMLSelectElement).value;
    const imageUrl = (document.getElementById('imageUrl') as HTMLInputElement).value;
    const published = (document.getElementById('published') as HTMLInputElement).checked;

    const resultDiv = document.getElementById('result')!;
    resultDiv.className = 'mt-4 p-4 rounded-lg';
    resultDiv.textContent = 'Adding article...';
    resultDiv.classList.remove('hidden');

    try {
      await adminConvex('mutation', 'newsPosts:create', {
        title,
        slug: generateSlug(title),
        excerpt: excerpt.substring(0, 200) + (excerpt.length > 200 ? '...' : ''),
        content: content || excerpt,
        authorName: 'Admin',
        category,
        sourceUrl,
        sourceName,
        featuredImageUrl: imageUrl || undefined,
        published,
      });

      resultDiv.className = 'mt-4 p-4 rounded-lg bg-green-100 text-green-800 text-sm';
      resultDiv.innerHTML = `Article added successfully! <a href="/admin/news" class="underline font-medium">View news page</a>`;

      // Clear form
      (document.getElementById('add-news-form') as HTMLFormElement).reset();

    } catch (err: any) {
      resultDiv.className = 'mt-4 p-4 rounded-lg bg-destructive-muted text-red-800 text-sm';
      resultDiv.textContent = 'Error: ' + err.message;
    }
  });

  document.getElementById('fetch-btn')?.addEventListener('click', async () => {
    const url = (document.getElementById('quick-url') as HTMLInputElement).value;
    if (!url) {
      alert('Please enter a URL');
      return;
    }

    // Extract domain as source name
    try {
      const domain = new URL(url).hostname.replace('www.', '');
      const sourceName = domain.split('.')[0].charAt(0).toUpperCase() + domain.split('.')[0].slice(1);

      (document.getElementById('sourceUrl') as HTMLInputElement).value = url;
      (document.getElementById('sourceName') as HTMLInputElement).value = sourceName;

      alert('URL filled in. Please manually add the title and excerpt from the article.');
    } catch {
      alert('Invalid URL');
    }
  });
</script>
