---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { Shield, Eye, Lock, Database, Mail, Cookie } from 'lucide-react';
---

<Layout 
  title="Privacy Policy | ProtectMyMobile"
  description="Learn how ProtectMyMobile protects your privacy and handles your data."
>
  <HeaderMobile client:idle />
  
  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-4xl">
      <!-- Hero Section -->
      <div class="bg-foreground text-background rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-10 mb-6 sm:mb-8 ">
        <div class="flex items-center gap-3 mb-3">
          <div class="bg-white/20 p-2 sm:p-3 rounded-xl">
            <Shield class="size-6 sm:size-8" />
          </div>
          <h1 class="text-xl sm:text-2xl md:text-3xl font-bold">Privacy Policy</h1>
        </div>
        <p class="text-neutral-300 text-sm md:text-base">
          Last updated: December 2024
        </p>
      </div>
      
      <!-- Content -->
      <div class="bg-card rounded-xl sm:rounded-2xl  overflow-hidden border border-border">
        <div class="p-4 sm:p-6 md:p-8 space-y-6 sm:space-y-8">
          
          <!-- Introduction -->
          <section>
            <p class="text-foreground text-xs sm:text-sm">
              At ProtectMyMobile, I take your privacy seriously. This policy explains what information I collect, how I use it, and your rights regarding your data.
            </p>
          </section>
          
          <!-- What We Collect -->
          <section>
            <div class="flex items-center gap-3 mb-4">
              <div class="bg-neutral-100 rounded-lg sm:rounded-xl p-1.5 sm:p-2">
                <Database class="size-4 sm:size-5 text-foreground" />
              </div>
              <h2 class="text-base sm:text-lg font-bold">What I Collect</h2>
            </div>
            <div class="space-y-4 text-foreground">
              <div>
                <h3 class="font-semibold mb-2 text-xs sm:text-sm">Information you provide:</h3>
                <ul class="list-disc pl-6 space-y-1 text-xs sm:text-sm">
                  <li>Contact form submissions (name, email, message)</li>
                  <li>Community survey responses (anonymised)</li>
                  <li>Newsletter subscriptions (email only)</li>
                </ul>
              </div>
              <div>
                <h3 class="font-semibold mb-2 text-xs sm:text-sm">Automatically collected:</h3>
                <ul class="list-disc pl-6 space-y-1 text-xs sm:text-sm">
                  <li>Anonymous page view analytics <em>(self-hosted via Convex, no third parties)</em></li>
                  <li>Browser type and device category</li>
                  <li>Referring website</li>
                </ul>
              </div>
            </div>
          </section>
          
          <!-- What We DON'T Collect -->
          <section class="bg-neutral-100 border border-border rounded-lg sm:rounded-xl p-4 sm:p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="bg-neutral-100 rounded-lg sm:rounded-xl p-1.5 sm:p-2">
                <Eye class="size-4 sm:size-5 text-foreground" />
              </div>
              <h2 class="text-base sm:text-lg font-bold text-foreground">What I DON'T Collect</h2>
            </div>
            <ul class="space-y-2 text-foreground">
              <li class="flex items-center gap-2 text-xs sm:text-sm">
                <Lock class="size-4" />
                <span>Your IMEI number or device identifiers</span>
              </li>
              <li class="flex items-center gap-2 text-xs sm:text-sm">
                <Lock class="size-4" />
                <span>Your banking or financial information</span>
              </li>
              <li class="flex items-center gap-2 text-xs sm:text-sm">
                <Lock class="size-4" />
                <span>Your precise location</span>
              </li>
              <li class="flex items-center gap-2 text-xs sm:text-sm">
                <Lock class="size-4" />
                <span>Personal identification documents</span>
              </li>
            </ul>
          </section>
          
          <!-- How We Use Data -->
          <section>
            <div class="flex items-center gap-3 mb-4">
              <div class="bg-neutral-100/10 rounded-lg sm:rounded-xl p-1.5 sm:p-2">
                <Lock class="size-4 sm:size-5 text-foreground" />
              </div>
              <h2 class="text-base sm:text-lg font-bold">How I Use Your Data</h2>
            </div>
            <ul class="list-disc pl-6 space-y-2 text-foreground text-xs sm:text-sm">
              <li>To respond to your contact form inquiries</li>
              <li>To improve my guides and resources based on community feedback</li>
              <li>To understand how the site is used and make improvements</li>
              <li>To send newsletters (only if you've subscribed)</li>
            </ul>
          </section>
          
          <!-- Cookies -->
          <section>
            <div class="flex items-center gap-3 mb-4">
              <div class="bg-neutral-100 rounded-lg sm:rounded-xl p-1.5 sm:p-2">
                <Cookie class="size-4 sm:size-5 text-foreground" />
              </div>
              <h2 class="text-base sm:text-lg font-bold">Cookies</h2>
            </div>
            <p class="text-foreground text-xs sm:text-sm mb-3">
              This site uses only essential cookies required for the website to function. No advertising or third-party tracking cookies are set.
            </p>
          </section>
          
          <!-- Third Parties -->
          <section>
            <h2 class="text-base sm:text-lg font-bold mb-3">Third-Party Services</h2>
            <p class="text-foreground text-xs sm:text-sm mb-3">I use the following services:</p>
            <ul class="list-disc pl-6 space-y-1 text-foreground text-xs sm:text-sm">
              <li><strong>Convex</strong> - Database hosting (EU servers)</li>
              <li><strong>Netlify</strong> - Website hosting</li>
              <li><strong>Resend</strong> - Email delivery</li>
            </ul>
          </section>
          
          <!-- Your Rights -->
          <section>
            <h2 class="text-base sm:text-lg font-bold mb-3">Your Rights</h2>
            <p class="text-foreground text-xs sm:text-sm mb-3">Under UK GDPR, you have the right to:</p>
            <ul class="list-disc pl-6 space-y-1 text-foreground text-xs sm:text-sm">
              <li>Access the personal data I hold about you</li>
              <li>Request correction of inaccurate data</li>
              <li>Request deletion of your data</li>
              <li>Withdraw consent at any time</li>
            </ul>
          </section>
          
          <!-- Contact -->
          <section class="bg-neutral-100 rounded-lg sm:rounded-xl p-4 sm:p-6">
            <div class="flex items-center gap-3 mb-3">
              <Mail class="size-4 sm:size-5 text-muted-foreground" />
              <h2 class="text-base sm:text-lg font-bold">Contact Us</h2>
            </div>
            <p class="text-foreground text-xs sm:text-sm">
              For privacy-related inquiries, please use my <a href="/contact-us" class="text-primary hover:underline">contact form</a>.
            </p>
          </section>
          
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
