---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { Shield, Eye, Lock, Database, Mail, Cookie } from 'lucide-react';
---

<Layout 
  title="Privacy Policy | ProtectMyMobile"
  description="Learn how ProtectMyMobile protects your privacy and handles your data."
>
  <HeaderMobile client:idle />
  
  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-4xl">
      <!-- Hero Section -->
      <div class="bg-gradient-to-br from-teal-600 to-cyan-700 text-white rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-10 mb-6 sm:mb-8 shadow-xl">
        <div class="flex items-center gap-3 mb-3">
          <div class="bg-white/20 p-2 sm:p-3 rounded-xl">
            <Shield class="size-6 sm:size-8" />
          </div>
          <h1 class="text-xl sm:text-2xl md:text-3xl font-bold">Privacy Policy</h1>
        </div>
        <p class="text-teal-100 text-sm md:text-base">
          Last updated: December 2024
        </p>
      </div>
      
      <!-- Content -->
      <div class="bg-card rounded-xl sm:rounded-2xl shadow-md overflow-hidden border border-border">
        <div class="p-4 sm:p-6 md:p-8 space-y-6 sm:space-y-8">
          
          <!-- Introduction -->
          <section>
            <p class="text-foreground text-xs sm:text-sm">
              At ProtectMyMobile, we take your privacy seriously. This policy explains what information we collect, how we use it, and your rights regarding your data.
            </p>
          </section>
          
          <!-- What We Collect -->
          <section>
            <div class="flex items-center gap-3 mb-4">
              <div class="bg-primary-muted rounded-lg sm:rounded-xl p-1.5 sm:p-2">
                <Database class="size-4 sm:size-5 text-primary" />
              </div>
              <h2 class="text-base sm:text-lg font-bold">What We Collect</h2>
            </div>
            <div class="space-y-4 text-foreground">
              <div>
                <h3 class="font-semibold mb-2 text-xs sm:text-sm">Information you provide:</h3>
                <ul class="list-disc pl-6 space-y-1 text-xs sm:text-sm">
                  <li>Contact form submissions (name, email, message)</li>
                  <li>Community survey responses (anonymised)</li>
                  <li>Newsletter subscriptions (email only)</li>
                </ul>
              </div>
              <div>
                <h3 class="font-semibold mb-2 text-xs sm:text-sm">Automatically collected:</h3>
                <ul class="list-disc pl-6 space-y-1 text-xs sm:text-sm">
                  <li>Anonymous page view analytics</li>
                  <li>Browser type and device category</li>
                  <li>Referring website</li>
                </ul>
              </div>
            </div>
          </section>
          
          <!-- What We DON'T Collect -->
          <section class="bg-green-50 border border-green-200 rounded-lg sm:rounded-xl p-4 sm:p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="bg-green-100 rounded-lg sm:rounded-xl p-1.5 sm:p-2">
                <Eye class="size-4 sm:size-5 text-green-600" />
              </div>
              <h2 class="text-base sm:text-lg font-bold text-green-800">What We DON'T Collect</h2>
            </div>
            <ul class="space-y-2 text-green-800">
              <li class="flex items-center gap-2 text-xs sm:text-sm">
                <Lock class="size-4" />
                <span>Your IMEI number or device identifiers</span>
              </li>
              <li class="flex items-center gap-2 text-xs sm:text-sm">
                <Lock class="size-4" />
                <span>Your banking or financial information</span>
              </li>
              <li class="flex items-center gap-2 text-xs sm:text-sm">
                <Lock class="size-4" />
                <span>Your precise location</span>
              </li>
              <li class="flex items-center gap-2 text-xs sm:text-sm">
                <Lock class="size-4" />
                <span>Personal identification documents</span>
              </li>
            </ul>
          </section>
          
          <!-- How We Use Data -->
          <section>
            <div class="flex items-center gap-3 mb-4">
              <div class="bg-primary/10 rounded-lg sm:rounded-xl p-1.5 sm:p-2">
                <Lock class="size-4 sm:size-5 text-primary" />
              </div>
              <h2 class="text-base sm:text-lg font-bold">How We Use Your Data</h2>
            </div>
            <ul class="list-disc pl-6 space-y-2 text-foreground text-xs sm:text-sm">
              <li>To respond to your contact form inquiries</li>
              <li>To improve our guides and resources based on community feedback</li>
              <li>To understand how our site is used and make improvements</li>
              <li>To send newsletters (only if you've subscribed)</li>
            </ul>
          </section>
          
          <!-- Cookies -->
          <section>
            <div class="flex items-center gap-3 mb-4">
              <div class="bg-orange-100 rounded-lg sm:rounded-xl p-1.5 sm:p-2">
                <Cookie class="size-4 sm:size-5 text-orange-600" />
              </div>
              <h2 class="text-base sm:text-lg font-bold">Cookies</h2>
            </div>
            <p class="text-foreground text-xs sm:text-sm mb-3">
              We use essential cookies to ensure the website functions properly. We also use analytics cookies to understand site usage. You can disable non-essential cookies in your browser settings.
            </p>
          </section>
          
          <!-- Third Parties -->
          <section>
            <h2 class="text-base sm:text-lg font-bold mb-3">Third-Party Services</h2>
            <p class="text-foreground text-xs sm:text-sm mb-3">We use the following services:</p>
            <ul class="list-disc pl-6 space-y-1 text-foreground text-xs sm:text-sm">
              <li><strong>Convex</strong> - Database hosting (EU servers)</li>
              <li><strong>Netlify</strong> - Website hosting</li>
              <li><strong>Resend</strong> - Email delivery</li>
            </ul>
          </section>
          
          <!-- Your Rights -->
          <section>
            <h2 class="text-base sm:text-lg font-bold mb-3">Your Rights</h2>
            <p class="text-foreground text-xs sm:text-sm mb-3">Under UK GDPR, you have the right to:</p>
            <ul class="list-disc pl-6 space-y-1 text-foreground text-xs sm:text-sm">
              <li>Access the personal data we hold about you</li>
              <li>Request correction of inaccurate data</li>
              <li>Request deletion of your data</li>
              <li>Withdraw consent at any time</li>
            </ul>
          </section>
          
          <!-- Contact -->
          <section class="bg-neutral-100 rounded-lg sm:rounded-xl p-4 sm:p-6">
            <div class="flex items-center gap-3 mb-3">
              <Mail class="size-4 sm:size-5 text-muted-foreground" />
              <h2 class="text-base sm:text-lg font-bold">Contact Us</h2>
            </div>
            <p class="text-foreground text-xs sm:text-sm">
              For privacy-related inquiries, please use our <a href="/contact" class="text-primary hover:underline">contact form</a>.
            </p>
          </section>
          
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
