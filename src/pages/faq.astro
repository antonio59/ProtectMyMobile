---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { Search, ChevronRight, X } from "lucide-react";

const faqCategories = [
  {
    id: "emergency",
    title: "My Phone Was Just Stolen",
    description: "What to do in the first 30 minutes",
    questions: [
      {
        question: "What should I do immediately if my phone is stolen?",
        answer: "Act within 30 minutes: 1) Remotely lock your device using Find My iPhone (icloud.com/find) or Google Find My Device (google.com/android/find), 2) Change passwords for Google/Apple account, email, banking, and social media from a secure device, 3) Contact your mobile provider to block your SIM card, 4) Report to police online at police.uk or call 101 for a crime reference number, 5) Check your bank accounts for unauthorized transactions and notify your bank.",
        keywords: ["immediately", "emergency", "steps", "urgent"]
      },
      {
        question: "How do I remotely lock my stolen phone?",
        answer: "For iPhone: Go to icloud.com/find on another device, sign in with your Apple ID, select your device, and tap 'Lost Mode' to lock it and display a custom message. For Android: Go to google.com/android/find, sign in with your Google account, select your device, and click 'Secure device' to lock it with a new password and display a message. Both services also show your phone's last known location.",
        keywords: ["lock", "remote", "find my", "lost mode"]
      },
      {
        question: "Can I track my phone after it's been stolen?",
        answer: "Yes, if you enabled Find My iPhone or Find My Device before the theft. Visit icloud.com/find (iPhone) or google.com/android/find (Android) to see your phone's location. However, thieves often turn phones off immediately or disable location services. Check the location as soon as possible and share it with police. Never attempt to recover the phone yourself.",
        keywords: ["track", "location", "find", "gps"]
      },
      {
        question: "Should I try to recover my phone myself?",
        answer: "No, never attempt to recover your stolen phone yourself. This can be dangerous as thieves may be armed or violent. Instead, provide the location information from Find My iPhone/Android to the police with your crime reference number. Let law enforcement handle the recovery. Your safety is more important than your device.",
        keywords: ["recover", "myself", "dangerous", "safety"]
      },
      {
        question: "What if I can't access Find My iPhone or Find My Device?",
        answer: "If you didn't enable these services before the theft, you won't be able to track or remotely lock your device. Instead, immediately: change all account passwords from another device, contact your mobile provider to block your SIM and IMEI, notify your bank about potential fraud, report to police with your IMEI number (found on your phone box or purchase receipt), and monitor your accounts for suspicious activity.",
        keywords: ["can't access", "disabled", "not enabled"]
      }
    ]
  },
  {
    id: "reporting",
    title: "Reporting to Police",
    description: "How to report theft and what to expect",
    questions: [
      {
        question: "How do I report phone theft to UK police?",
        answer: "Report online at police.uk/pu/contact-the-police/report-a-crime-incident/ or call 101 (non-emergency). Have this ready before you start: the exact date, time and location of the theft, a description of how it happened, your phone's make, model and colour, the IMEI number (dial *#06# or check the phone box or receipt), the serial number if available, your phone number and network provider, the current location if tracking shows it, a description of the suspect if you saw them, and any witnesses' contact details. You'll receive a crime reference number - keep this for insurance claims and provider notifications.",
        keywords: ["report", "police", "101", "crime reference", "information", "details", "what do I need"]
      },
      {
        question: "Do I need a crime reference number?",
        answer: "Yes, a crime reference number is essential for: making insurance claims for device replacement, providing proof of theft to your mobile provider when blocking your device, potentially recovering your phone if police find it, and protecting yourself legally if your phone is used for criminal activity. Always obtain and save this number when reporting theft.",
        keywords: ["crime reference", "number", "insurance"]
      },
      {
        question: "Will police actually investigate phone theft?",
        answer: "Most phone thefts are not individually investigated due to resource constraints and the high volume of cases. However, reporting is still crucial for: obtaining a crime reference number for insurance, contributing to crime statistics that inform police strategy, potentially recovering your phone if found in a larger operation, and protecting yourself if the phone is used criminally. Some police forces run targeted operations against organized phone theft gangs.",
        keywords: ["investigate", "will they", "police response"]
      },
      {
        question: "Can I report phone theft if I'm a tourist?",
        answer: "Yes, tourists can and should report phone theft to UK police. Use the online reporting system at police.uk or call 101. You'll receive a crime reference number needed for insurance claims. If you need to leave the UK before the investigation concludes, ensure you have: the crime reference number, contact details for the investigating police force, a copy of your report, and all relevant documentation for your insurance company.",
        keywords: ["tourist", "visitor", "foreign", "report"]
      }
    ]
  },
  {
    id: "providers",
    title: "Blocking Your SIM & Number",
    description: "Contacting your network and blocking your SIM",
    questions: [
      {
        question: "How quickly should I contact my mobile provider?",
        answer: "Contact your mobile provider immediately after securing your device remotely - ideally within the first 30 minutes. They can block your SIM card to prevent unauthorized calls, texts, and data usage. This is crucial as thieves may attempt to rack up charges or use your number for fraud. Most providers offer 24/7 support lines for theft reporting.",
        keywords: ["contact", "provider", "network", "urgent"]
      },
      {
        question: "What will my mobile provider do when I report theft?",
        answer: "Your provider will: block your SIM card immediately to prevent unauthorized use, add your phone's IMEI to a national blacklist preventing it from being used on any UK network, discuss replacement SIM options (often free for theft), review your account for suspicious activity, provide advice on next steps, and may offer insurance claim support if you have device coverage through them.",
        keywords: ["provider", "network", "block", "blacklist", "imei"]
      },
      {
        question: "Can I keep my phone number after theft?",
        answer: "Yes, your phone number can be transferred to a new SIM card. Contact your mobile provider - they'll block the stolen SIM while preserving your number. You can usually get a replacement SIM posted to you or collect one from a store. Your number will be activated on the new SIM once you receive it. Keep your account details and proof of identity ready when requesting this.",
        keywords: ["keep number", "same number", "transfer"]
      },
      {
        question: "What is IMEI blacklisting?",
        answer: "IMEI blacklisting adds your phone's unique 15-digit identifier to a national database of stolen devices. Once blacklisted, the phone cannot be used on any UK network, making it worthless to thieves. Your provider does this when you report theft. The IMEI blacklist is shared across all UK carriers. Find your IMEI by dialing *#06# or checking your phone box/purchase receipt.",
        keywords: ["imei", "blacklist", "blocked", "barred"]
      },
      {
        question: "Will I still be charged if someone uses my stolen phone?",
        answer: "Contact your provider immediately to block services and avoid charges. Most UK providers have a policy that you're not liable for unauthorized usage after reporting theft, but this varies by provider. Report the theft as soon as possible and keep your crime reference number. Review your next bill carefully and dispute any fraudulent charges with your provider.",
        keywords: ["charged", "bill", "charges", "cost"]
      }
    ]
  },
  {
    id: "recovery",
    title: "Recovery & Insurance",
    description: "Getting your phone back and insurance claims",
    questions: [
      {
        question: "What are the chances of recovering my stolen phone?",
        answer: "Unfortunately, recovery rates are very low - the vast majority of stolen phones in the UK are never recovered, especially in London where organized theft operations quickly move devices abroad. This is why prevention and immediate action (remote locking, SIM blocking, IMEI blacklisting) are crucial. If you have tracking information, provide it to police, but don't attempt recovery yourself.",
        keywords: ["recover", "chances", "success rate", "get back"]
      },
      {
        question: "Does phone insurance cover theft?",
        answer: "This depends on your specific insurance policy. Check if you have: device insurance through your mobile provider, coverage through home contents insurance, travel insurance (for tourists), or credit card purchase protection. Review your policy for theft coverage, excess fees, claim procedures, and proof requirements. You'll typically need a crime reference number to make a claim.",
        keywords: ["insurance", "cover", "policy", "claim"]
      },
      {
        question: "How do I make an insurance claim for a stolen phone?",
        answer: "To claim: 1) Report theft to police and obtain a crime reference number, 2) Contact your insurance provider as soon as possible (many have time limits), 3) Provide required documentation: crime reference number, proof of purchase, IMEI number, phone details, and your insurance policy number, 4) Complete claim forms accurately, 5) Pay any excess fee, 6) Keep copies of all correspondence and documentation.",
        keywords: ["insurance claim", "how to claim", "documents"]
      },
      {
        question: "What if I don't have insurance?",
        answer: "Without insurance, you'll need to: purchase a replacement phone yourself (consider refurbished or budget options), transfer your number to a new SIM card (usually free), review your contract - you may still owe payments on the stolen phone, consider switching to a SIM-only contract for savings, and ensure your new phone has Find My enabled and all security features activated to prevent repeat theft.",
        keywords: ["no insurance", "uninsured", "no cover"]
      },
      {
        question: "Can I buy a phone that was previously reported stolen?",
        answer: "Avoid buying second-hand phones without checking their status. Use free IMEI checking services to verify a phone isn't blacklisted before purchase. Buying a stolen phone is illegal and it won't work on UK networks if the IMEI is blacklisted. Always buy from reputable retailers, ask for proof of purchase, and check the IMEI (dial *#06#) against online blacklist databases.",
        keywords: ["buy", "second hand", "used", "blacklist"]
      }
    ]
  },
  {
    id: "prevention",
    title: "Protecting Your Next Phone",
    description: "How to secure your phone and prevent theft",
    questions: [
      {
        question: "How can I prevent my phone from being stolen?",
        answer: "Enable multiple layers of security: set a SIM card PIN (Settings > Security > SIM card lock), use biometric authentication with a strong 6+ digit backup passcode, enable app-specific security for banking apps with additional PINs and 2FA, and know your IMEI number (dial *#06#) - store it in a password manager. Then change how you carry it: stay aware of your surroundings and keep the phone out of sight when you don't need it, especially on the London Underground, at tourist attractions, and on crowded streets. If someone does grab it, let go rather than be pulled after it - a phone is replaceable.",
        keywords: ["prevent", "security", "pin", "biometric", "imei", "london", "secure", "tube", "tourist"]
      },
      {
        question: "Should I use a phone lanyard to prevent theft?",
        answer: "Phone lanyards can help prevent accidental drops and keep your phone accessible, but they should complement, not replace, proper security measures. Enable SIM card locks, biometric security, and app-specific passwords. Lanyards won't prevent theft if someone forcibly grabs your phone. The most effective prevention combines physical awareness with strong digital security settings.",
        keywords: ["lanyard", "strap", "physical"]
      },
      {
        question: "How do thieves steal phones on the tube?",
        answer: "Thieves on the London Underground typically use distraction techniques and target people using phones near doors. Common tactics include snatching phones as train doors close, targeting distracted passengers with phones visible in pockets, and working in teams to create diversions. Protect yourself by keeping your phone secured when not in use, being extra vigilant near doors, avoiding displaying expensive devices, and positioning yourself away from doors when using your phone.",
        keywords: ["tube", "underground", "steal", "metro"]
      },
      {
        question: "What security features should I enable on my phone?",
        answer: "Enable these essential security features: SIM card PIN lock to prevent unauthorized use if the SIM is removed, biometric authentication (Face ID or fingerprint) with a strong alphanumeric backup passcode, Find My iPhone (iOS) or Find My Device (Android) for remote tracking and locking, app-specific PINs for banking and payment apps, automatic screen lock after 30 seconds of inactivity, and two-factor authentication on all important accounts.",
        keywords: ["security", "features", "find my", "2fa"]
      },
      {
        question: "Should I keep my phone in my pocket or bag?",
        answer: "Both have risks. Front pockets are safer than back pockets, which are easy targets for pickpockets. Bags should have zippers and be worn across your body with the opening facing inward. Never place your phone in an outside pocket of a bag. In very crowded areas, consider keeping your phone in an inner jacket pocket or front trouser pocket with your hand over it.",
        keywords: ["pocket", "bag", "carry"]
      }
    ]
  }
];

// Build FAQ schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqCategories.flatMap(category =>
    category.questions.map(q => ({
      "@type": "Question",
      "name": q.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": q.answer
      }
    }))
  )
};
---

<Layout
  title="FAQ - Mobile Phone Theft UK | Common Questions Answered"
  description="Frequently asked questions about phone theft prevention, emergency response, reporting to police, and recovery in the UK. Get expert answers to protect your mobile."
  canonicalPath="/faq"
  schema={faqSchema}
>
  <HeaderMobile client:idle />

  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-4xl">
      

      <!-- Hero Section -->
      <div class="bg-foreground text-background rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-8 mb-6 sm:mb-8">
        <h1 class="text-xl sm:text-2xl md:text-3xl font-bold mb-2">Frequently Asked Questions</h1>
        <p class="text-neutral-300 text-sm md:text-base">
          Just had your phone stolen? Start with the first section. Otherwise search below or browse by topic.
        </p>
      </div>

      <!-- Search & Filter -->
      <div class="bg-card rounded-xl p-4 mb-6 sticky top-20 z-30 border border-border">
        <div class="relative mb-4">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground size-5" />
          <input
            type="search"
            id="faq-search"
            placeholder="Search questions... (e.g., 'lock phone', 'police report', 'insurance')"
            class="w-full pl-10 pr-10 py-3 text-sm border border-border rounded-lg focus:ring-2 focus:ring-primary focus:border-primary"
          />
          <button 
            id="clear-search" 
            type="button"
            aria-label="Clear search"
            class="absolute right-1 top-1/2 -translate-y-1/2 min-h-11 min-w-11 text-muted-foreground hover:text-muted-foreground hidden"
          >
            <X className="size-4" />
          </button>
        </div>
        
        <!-- Category Pills -->
        <div class="flex gap-2 overflow-x-auto pb-1 -mx-1 px-1 scrollbar-hide">
          <button class="category-pill active min-h-11 px-3 py-1.5 rounded-full bg-primary text-primary-foreground text-xs sm:text-sm font-medium whitespace-nowrap transition-colors" data-category="all">
            All Questions
          </button>
          {faqCategories.map(cat => (
            <button 
              class="category-pill min-h-11 px-3 py-1.5 rounded-full bg-neutral-100 text-muted-foreground text-xs sm:text-sm font-medium whitespace-nowrap hover:bg-neutral-200 transition-colors" 
              data-category={cat.id}
            >
              {cat.title}
            </button>
          ))}
        </div>
        
        <div id="search-results-count" class="mt-3 text-xs text-muted-foreground hidden"></div>
      </div>

      <!-- FAQ Content -->
      <div id="faq-content" class="space-y-6">
        {faqCategories.map((category) => (
          <section class="faq-category bg-card rounded-xl overflow-hidden border border-border" data-category={category.id}>
            <div class="bg-neutral-100 p-4 sm:p-5 border-b border-border">
              <h2 class="font-bold text-foreground">{category.title}</h2>
              <p class="text-xs text-muted-foreground mt-0.5">{category.description}</p>
            </div>
            
            <div class="divide-y divide-neutral-100">
              {category.questions.map((q, idx) => (
                <details class="faq-item group" data-keywords={q.keywords?.join(',')}>
                  <summary class="flex items-start justify-between gap-4 p-4 sm:p-5 cursor-pointer hover:bg-neutral transition-colors list-none">
                    <span class="font-medium text-foreground text-sm sm:text-base pr-4">{q.question}</span>
                    <ChevronRight className="size-5 text-muted-foreground group-open:rotate-90 transition-transform flex-shrink-0 mt-0.5" />
                  </summary>
                  <div class="px-4 sm:px-5 pb-4 sm:pb-5 text-muted-foreground text-sm leading-relaxed">
                    {q.answer}
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>

      <!-- No Results State -->
      <div id="no-results" class="hidden text-center py-12">
        <div class="inline-flex items-center justify-center size-12 bg-neutral-100 rounded-full mb-3">
          <Search className="size-5 text-muted-foreground" />
        </div>
        <h3 class="font-semibold text-foreground mb-1">No questions found</h3>
        <p class="text-sm text-muted-foreground">Try different keywords or browse by category above.</p>
      </div>

      <!-- Still Need Help -->
      <div class="mt-8 bg-neutral-100 rounded-xl p-5 border border-primary/20">
        <h3 class="font-semibold text-foreground mb-2">Still need help?</h3>
        <p class="text-sm text-muted-foreground mb-3">
          If you can't find the answer you're looking for, check the guides below or contact me.
        </p>
        <div class="flex flex-wrap gap-2">
          <a href="/emergency" class="inline-flex items-center gap-1.5 min-h-11 px-3 py-1.5 bg-destructive text-destructive-foreground rounded-lg text-xs font-medium hover:bg-destructive-hover transition-colors">
            Emergency Guide
          </a>
          <a href="/prevention" class="inline-flex items-center gap-1.5 min-h-11 px-3 py-1.5 bg-primary text-primary-foreground rounded-lg text-xs font-medium hover:bg-primary-hover transition-colors">
            Prevention Guide
          </a>
          <a href="/contact-us" class="inline-flex items-center gap-1.5 min-h-11 px-3 py-1.5 bg-card border border-border text-foreground rounded-lg text-xs font-medium hover:bg-neutral transition-colors">
            Contact Me
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    // FAQ Search and Filter functionality
    const searchInput = document.getElementById('faq-search') as HTMLInputElement;
    const clearBtn = document.getElementById('clear-search');
    const categoryPills = document.querySelectorAll('.category-pill');
    const faqCategories = document.querySelectorAll('.faq-category');
    const faqItems = document.querySelectorAll('.faq-item');
    const noResults = document.getElementById('no-results');
    const resultsCount = document.getElementById('search-results-count');

    let currentCategory = 'all';

    function filterFAQs() {
      const query = searchInput.value.toLowerCase().trim();
      let visibleCount = 0;

      // Show/hide clear button
      if (clearBtn) {
        clearBtn.classList.toggle('hidden', !query);
      }

      faqItems.forEach(item => {
        const question = item.querySelector('summary span')?.textContent?.toLowerCase() || '';
        const answer = item.querySelector('div')?.textContent?.toLowerCase() || '';
        const keywords = item.getAttribute('data-keywords')?.toLowerCase() || '';
        const parentCategory = item.closest('.faq-category')?.getAttribute('data-category');

        const matchesSearch = !query || question.includes(query) || answer.includes(query) || keywords.includes(query);
        const matchesCategory = currentCategory === 'all' || parentCategory === currentCategory;

        if (matchesSearch && matchesCategory) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      // Hide empty categories
      faqCategories.forEach(cat => {
        const visibleItems = cat.querySelectorAll('.faq-item:not(.hidden)');
        cat.classList.toggle('hidden', visibleItems.length === 0);
      });

      // Show no results state
      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }

      // Update count
      if (resultsCount) {
        if (query || currentCategory !== 'all') {
          resultsCount.textContent = `${visibleCount} question${visibleCount !== 1 ? 's' : ''} found`;
          resultsCount.classList.remove('hidden');
        } else {
          resultsCount.classList.add('hidden');
        }
      }
    }

    // Search input
    searchInput?.addEventListener('input', filterFAQs);

    // Clear button
    clearBtn?.addEventListener('click', () => {
      searchInput.value = '';
      filterFAQs();
      searchInput.focus();
    });

    // Category pills
    categoryPills.forEach(pill => {
      pill.addEventListener('click', () => {
        // Update active state
        categoryPills.forEach(p => {
          p.classList.remove('active', 'bg-primary', 'text-primary-foreground');
          p.classList.add('bg-neutral-100', 'text-muted-foreground');
        });
        pill.classList.remove('bg-neutral-100', 'text-muted-foreground');
        pill.classList.add('active', 'bg-primary', 'text-primary-foreground');

        // Update filter
        currentCategory = pill.getAttribute('data-category') || 'all';
        filterFAQs();
      });
    });
  </script>
</Layout>
