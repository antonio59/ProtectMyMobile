---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { ShoppingBag, Shield, Smartphone, Watch, Backpack, Lock, Eye, CreditCard, Tag, ChevronRight, AlertTriangle, CheckCircle2, ExternalLink } from 'lucide-react';

type ProductCategory = {
  title: string;
  description: string;
  icon: typeof Shield;
  affiliateLink?: string;
  safety?: string;
  benefits: string[];
  lookFor: string[];
};

const productCategories: ProductCategory[] = [
  {
    title: "Phone Lanyards & Wrist Straps",
    description: "Attach your phone to your wrist or around your neck to prevent snatch theft. Essential for busy streets and public transport.",
    icon: Watch,
    affiliateLink: "https://amzn.to/4pSVcfm",
    benefits: [
      "Prevents grab-and-run theft",
      "Keeps phone secure while in use",
      "Quick access without fumbling in pockets"
    ],
    lookFor: [
      "Strong, durable cord material",
      "Secure phone attachment point",
      "Adjustable length",
      "Compatible with your phone case"
    ]
  },
  {
    title: "Anti-Theft Crossbody Bags",
    description: "Specially designed bags with hidden zips, slash-proof material, and RFID blocking. Wear across your body for maximum security.",
    icon: Backpack,
    affiliateLink: "https://amzn.to/4ovAOzD",
    benefits: [
      "Hidden zippers deter pickpockets",
      "Slash-proof straps and fabric",
      "RFID protection for cards",
      "Keeps valuables close to body"
    ],
    lookFor: [
      "Lockable zippers",
      "Cut-resistant straps",
      "RFID-blocking pocket",
      "Comfortable crossbody design"
    ]
  },
  {
    title: "Phone Tracking Devices",
    description: "Small Bluetooth trackers that attach to your phone case or sit in your bag. Help locate your device if stolen.",
    icon: Tag,
    affiliateLink: "https://amzn.to/4pMUKiv",
    benefits: [
      "Track phone location remotely",
      "Crowd-sourced finding network",
      "Separation alerts",
      "Long battery life"
    ],
    safety: "If a tracker shows where your stolen phone is, give that location to the police on 101 or through your crime report. Never go to the address yourself: people have been seriously hurt confronting thieves to recover a phone.",
    lookFor: [
      "Compatibility with your phone (Apple/Android)",
      "Range and accuracy",
      "Battery life (rechargeable vs replaceable)",
      "Size and attachment options"
    ]
  },
  {
    title: "Phone Grips & Holders",
    description: "Attachable grips that make your phone harder to knock out of your hand. Reduces accidental drops and opportunistic grabs.",
    icon: Smartphone,
    affiliateLink: "https://amzn.to/3MaQtqR",
    benefits: [
      "Secure one-handed grip",
      "Harder for thieves to snatch",
      "Doubles as a stand",
      "Reduces drops"
    ],
    lookFor: [
      "Strong adhesive or MagSafe compatible",
      "Comfortable grip design",
      "Doesn't interfere with wireless charging",
      "Collapsible for pocket storage"
    ]
  },
  {
    title: "Privacy Screen Protectors",
    description: "Screen films that prevent others from viewing your screen from the side. Stops shoulder surfing for passwords and PINs.",
    icon: Eye,
    affiliateLink: "https://amzn.to/3MFlaEt",
    benefits: [
      "Blocks side-angle viewing",
      "Protects passwords and banking apps",
      "Still protects against scratches",
      "Deters opportunistic thieves"
    ],
    lookFor: [
      "Quality of privacy angle",
      "Screen clarity when viewed straight-on",
      "Scratch and impact resistance",
      "Easy installation"
    ]
  },
  {
    title: "RFID Blocking Wallets & Cases",
    description: "Protect your contactless cards from electronic pickpocketing. Essential as many thieves now target digital theft too.",
    icon: CreditCard,
    affiliateLink: "https://amzn.to/4pq3r2G",
    benefits: [
      "Blocks contactless card skimming",
      "Protects against electronic pickpocketing",
      "Peace of mind in crowded areas",
      "Often includes phone pocket"
    ],
    lookFor: [
      "Tested RFID/NFC blocking",
      "Quality construction",
      "Adequate card capacity",
      "Phone-compatible options available"
    ]
  },
  {
    title: "Secure Phone Cases",
    description: "Heavy-duty cases with lanyard attachment points, card holders, and enhanced grip surfaces.",
    icon: Shield,
    affiliateLink: "https://amzn.to/4izJBiy",
    benefits: [
      "Built-in lanyard attachment",
      "Enhanced grip texture",
      "Drop protection",
      "Some include card storage"
    ],
    lookFor: [
      "Lanyard loop or attachment point",
      "Textured or grippy surface",
      "Military-grade drop protection",
      "Doesn't add too much bulk"
    ]
  },
  {
    title: "Phone Insurance",
    description: "While not a physical product, comprehensive phone insurance can cover theft, giving you peace of mind and financial protection.",
    icon: Lock,
    benefits: [
      "Financial protection if stolen",
      "Often covers accidental damage too",
      "Quick replacement process",
      "Worldwide coverage options"
    ],
    lookFor: [
      "Theft specifically covered (not just loss)",
      "Excess/deductible amount",
      "Claim process simplicity",
      "Coverage limits and exclusions"
    ]
  }
];

// Affiliate destinations last opened and confirmed working on this date.
const linksCheckedDate = "26 August 2026";
---

<Layout 
  title="Product Recommendations - Protect Your Phone | ProtectMyMobile"
  description="Discover products that can help protect your mobile phone from theft, including lanyards, anti-theft bags, tracking devices, and more."
>
  <HeaderMobile client:idle />
  
  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-6xl">
      
      <!-- Hero Section -->
      <div class="bg-foreground text-background rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-10 mb-6 sm:mb-8">
        <div class="flex items-center gap-3 mb-3">
          <div class="bg-background/20 p-2 sm:p-3 rounded-xl">
            <ShoppingBag className="size-6 sm:size-8" />
          </div>
          <h1 class="text-xl sm:text-2xl md:text-3xl font-bold">Product Recommendations</h1>
        </div>
        <p class="text-neutral-300 text-xs sm:text-sm md:text-base mb-4">
          Products and accessories that can help protect your phone from theft. Click through to browse options and read reviews.
        </p>
        <div class="flex items-start gap-2 bg-background/10 rounded-xl p-4 text-sm">
          <AlertTriangle className="size-5 flex-shrink-0 mt-0.5" />
          <div>
            <p class="text-neutral-300">
              <strong class="text-background">Affiliate Disclosure:</strong> As an Amazon Associate, I earn from qualifying purchases. This helps support the site at no extra cost to you.
            </p>
            <p class="text-neutral-300 text-xs mt-2">Links checked: {linksCheckedDate}</p>
          </div>
        </div>
      </div>
      
      <!-- Product Categories -->
      <div class="space-y-6">
        {productCategories.map((product) => (
          <div class="bg-card rounded-lg sm:rounded-2xl overflow-hidden border border-border">
            <div class="h-1 bg-foreground"></div>
            <div class="p-4 sm:p-6">
              <div class="flex flex-col md:flex-row md:items-start gap-4 sm:gap-6">
                <!-- Icon and Title -->
                <div class="flex items-start gap-4 md:w-1/3">
                  <div class="bg-neutral-100 rounded-xl p-2 sm:p-3 flex-shrink-0">
                    <product.icon class="size-5 sm:size-6 text-foreground" />
                  </div>
                  <div>
                    <h2 class="text-base sm:text-lg font-bold text-foreground">{product.title}</h2>
                    <p class="text-sm text-muted-foreground mt-1 mb-3">{product.description}</p>
                    {product.affiliateLink && (
                      <a
                        href={product.affiliateLink}
                        target="_blank"
                        rel="noopener noreferrer sponsored"
                        class="inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 sm:py-2 bg-foreground text-background text-xs sm:text-sm font-semibold rounded-lg hover:opacity-90 transition-opacity"
                      >
                        {product.title}
                        <ExternalLink className="size-3 sm:size-4" />
                      </a>
                    )}
                  </div>
                </div>

                <!-- Benefits and What to Look For: one container, hairline rules -->
                <div class="flex-1 product-panels">
                  <div class="product-panel">
                    <h3 class="font-semibold text-sm text-foreground mb-2">Benefits</h3>
                    <ul class="space-y-1.5">
                      {product.benefits.map((benefit) => (
                        <li class="flex items-start gap-2 text-sm text-foreground">
                          <CheckCircle2 className="size-4 text-foreground flex-shrink-0 mt-0.5" />
                          <span>{benefit}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="product-panel">
                    <h3 class="font-semibold text-sm text-foreground mb-2">What to Look For</h3>
                    <ul class="space-y-1.5">
                      {product.lookFor.map((item) => (
                        <li class="flex items-start gap-2 text-sm text-muted-foreground">
                          <ChevronRight className="size-4 text-muted-foreground flex-shrink-0 mt-0.5" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  {product.safety && (
                    <div class="product-panel">
                      <h3 class="font-semibold text-sm text-foreground mb-2 flex items-center gap-2">
                        <AlertTriangle className="size-4 text-destructive flex-shrink-0" />
                        Safety first
                      </h3>
                      <p class="text-sm text-foreground">{product.safety}</p>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      
      <!-- Tips Section -->
      <section class="mt-6 sm:mt-8 md:mt-10 bg-neutral-100 rounded-2xl p-4 sm:p-6 md:p-8 border border-border">
        <h2 class="text-lg sm:text-xl font-bold mb-4 flex items-center gap-2">
          <Shield className="size-4 sm:size-5 text-foreground" />
          General Buying Tips
        </h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div class="bg-card rounded-xl p-3 sm:p-4">
            <h3 class="font-semibold mb-2">Before You Buy</h3>
            <ul class="text-sm text-foreground space-y-2">
              <li>• Read multiple reviews from verified purchasers</li>
              <li>• Check compatibility with your specific phone model</li>
              <li>• Compare prices across multiple retailers</li>
              <li>• Look for products with warranties or guarantees</li>
            </ul>
          </div>
          <div class="bg-card rounded-xl p-3 sm:p-4">
            <h3 class="font-semibold mb-2">Remember</h3>
            <ul class="text-sm text-foreground space-y-2">
              <li>• No product guarantees complete protection</li>
              <li>• Combine products with good security habits</li>
              <li>• Stay aware of your surroundings</li>
              <li>• Keep phone software and security up to date</li>
            </ul>
          </div>
        </div>
      </section>
      
      <!-- CTA -->
      <section class="mt-6 sm:mt-8 md:mt-10 bg-foreground rounded-2xl p-4 sm:p-6 md:p-8 text-background">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div>
            <h2 class="text-lg sm:text-xl font-bold mb-2">Products are just one part of protection</h2>
            <p class="text-neutral-300 text-sm">
              Learn essential security practices and what to do if the worst happens.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/prevention" class="inline-flex items-center justify-center gap-2 px-4 sm:px-5 py-2.5 bg-background text-primary rounded-xl font-semibold text-xs sm:text-sm hover:bg-primary-subtle transition-colors">
              <Shield className="size-3 sm:size-4" />
              Prevention Guide
            </a>
            <a href="/security-checkup" class="inline-flex items-center justify-center gap-2 px-4 sm:px-5 py-2.5 bg-background/20 text-background rounded-xl font-semibold text-xs sm:text-sm hover:bg-background/30 transition-colors">
              Security Checkup
            </a>
          </div>
        </div>
      </section>
      
    </div>
  </main>
  
  <Footer />
</Layout>

<style>
  /* One card, hairline rules between sections (see DirectoryEntry.astro) */
  .product-panels {
    border-top: 1px solid var(--color-border);
  }

  .product-panel {
    padding: 0.875rem 0;
  }

  .product-panel + .product-panel {
    border-top: 1px solid var(--color-border);
  }
</style>
