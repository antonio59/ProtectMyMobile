---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { getNewsPosts } from '../lib/convexData';
import type { NewsPost } from '../types/news';
import { Newspaper, ArrowRight, Gavel, Siren, ShieldAlert, TrendingUp, Lightbulb, FileText, Rss, Clock, Filter } from 'lucide-react';

let posts: NewsPost[] = [];
let error: unknown = null;
let lastUpdated: string | null = null;

try {
  posts = await getNewsPosts(true);
  if (posts.length > 0 && posts[0].publishedAt) {
    lastUpdated = new Date(posts[0].publishedAt).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    });
  }
} catch (e: unknown) {
  error = e;
  console.error('Error fetching news posts:', e);
}

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

const categoryCounts: Record<string, number> = {};
for (const post of posts) {
  categoryCounts[post.category] = (categoryCounts[post.category] || 0) + 1;
}

const categoryConfig: Record<string, { color: string; bg: string; icon: any; label: string }> = {
  arrest:        { color: "text-destructive-hover", bg: "bg-destructive-subtle", icon: Siren,        label: "Arrests" },
  seizure:       { color: "text-warning",          bg: "bg-warning-subtle",     icon: ShieldAlert, label: "Seizures" },
  law_change:    { color: "text-teal-600",         bg: "bg-teal-50",            icon: Gavel,       label: "Law Changes" },
  statistics:    { color: "text-primary-hover",    bg: "bg-primary-subtle",     icon: TrendingUp,   label: "Statistics" },
  prevention_tip:{ color: "text-emerald-600",      bg: "bg-emerald-50",         icon: Lightbulb,    label: "Tips" },
  other:         { color: "text-muted-foreground", bg: "bg-neutral",            icon: FileText,     label: "News" },
};

function formatDate(dateValue: string | number) {
  const date = typeof dateValue === 'number' ? new Date(dateValue) : new Date(dateValue);
  const now = new Date();
  const diffDays = Math.floor((now.getTime() - date.getTime()) / (1000 * 60 * 60 * 24));
  if (diffDays === 0) return 'Today';
  if (diffDays === 1) return 'Yesterday';
  if (diffDays < 7) return `${diffDays} days ago`;
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
}

const newsSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "UK Mobile Theft News",
  "description": "Latest news on phone theft arrests, seizures, law changes, and prevention tips across the UK.",
  "url": "https://protectmymobile.xyz/news",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": posts.length,
    "itemListElement": posts.slice(0, 10).map((post, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": `https://protectmymobile.xyz/news/${post.slug}`,
      "name": post.title,
    }))
  }
};
---

<Layout
  title="Latest News & Updates — UK Mobile Theft | ProtectMyMobile"
  description={`Stay informed about mobile theft arrests, seizures, law changes, and prevention tips across the UK. ${posts.length} articles tracked.`}
  schema={newsSchema}
>
  <HeaderMobile client:idle />

  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-6xl">

      <!-- Page header -->
      <div class="mb-6 sm:mb-8">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-foreground">News & Updates</h1>
            <p class="text-muted-foreground text-sm sm:text-base mt-1 max-w-xl">
              The latest on mobile theft arrests, seizures, policy changes, and prevention tips from across the UK.
            </p>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <a href="/rss.xml" class="inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-full bg-neutral hover:text-primary border border-border transition-colors">
              <Rss class="size-3.5" />
              <span class="hidden sm:inline">RSS</span>
            </a>
            {lastUpdated && (
              <span class="hidden sm:inline-flex items-center gap-1.5 text-xs text-muted-foreground">
                <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>
                Updated {lastUpdated}
              </span>
            )}
          </div>
        </div>
      </div>

      {error ? (
        <div class="bg-destructive-subtle border border-destructive-muted rounded-xl p-6 text-center">
          <p class="text-destructive-hover text-sm">Unable to load news posts. Please try again later.</p>
        </div>
      ) : posts.length === 0 ? (
        <div class="bg-card rounded-2xl shadow-sm border border-border p-12 text-center">
          <Newspaper class="size-12 mx-auto mb-3 text-muted-foreground" />
          <h3 class="text-lg font-semibold mb-2 text-foreground">No News Posts Yet</h3>
          <p class="text-muted-foreground text-sm">
            Check back soon or subscribe to our <a href="/rss.xml" class="text-primary hover:underline">RSS feed</a>.
          </p>
        </div>
      ) : (
        <>
          <!-- Featured Article -->
          {featuredPost && (
            <section class="mb-8 sm:mb-10">
              <a
                href={`/news/${featuredPost.slug}`}
                class="group block bg-card rounded-2xl shadow-sm border border-border hover:shadow-md hover:border-primary/20 transition-all overflow-hidden"
              >
                <div class="md:flex">
                  {featuredPost.featuredImageUrl && (
                    <div class="md:w-80 lg:w-96 shrink-0">
                      <div class="aspect-[16/10] md:aspect-auto md:h-full bg-neutral overflow-hidden">
                        <img
                          src={featuredPost.featuredImageUrl}
                          alt={featuredPost.title}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                          loading="eager"
                        />
                      </div>
                    </div>
                  )}
                  <div class="p-5 sm:p-6 md:p-8 flex flex-col justify-center">
                    <div class="flex items-center gap-2 mb-3 flex-wrap">
                      <span class={`inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-md font-semibold ${categoryConfig[featuredPost.category]?.bg || 'bg-neutral'} ${categoryConfig[featuredPost.category]?.color || 'text-foreground'}`}>
                        {categoryConfig[featuredPost.category]?.icon && (
                          <span class="flex items-center">
                            {(() => {
                              const IconComponent = categoryConfig[featuredPost.category].icon;
                              return <IconComponent class="size-3.5" />;
                            })()}
                          </span>
                        )}
                        {categoryConfig[featuredPost.category]?.label || featuredPost.category.replace('_', ' ')}
                      </span>
                      <span class="text-xs text-muted-foreground flex items-center gap-1">
                        <Clock class="size-3" />
                        {formatDate(featuredPost.publishedAt || featuredPost._creationTime)}
                      </span>
                      {featuredPost.sourceName && (
                        <span class="text-xs text-muted-foreground">via {featuredPost.sourceName}</span>
                      )}
                    </div>
                    <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold text-foreground group-hover:text-primary transition-colors leading-tight mb-3">
                      {featuredPost.title}
                    </h2>
                    <p class="text-muted-foreground text-sm sm:text-base leading-relaxed mb-4">
                      {featuredPost.excerpt}
                    </p>
                    <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary">
                      Read full article
                      <ArrowRight class="size-4 group-hover:translate-x-1 transition-transform" />
                    </span>
                  </div>
                </div>
              </a>
            </section>
          )}

          <!-- Category Quick Filters -->
          <section class="mb-6 sm:mb-8">
            <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-hide">
              <button class="category-btn active px-3.5 py-2 rounded-lg bg-primary text-white text-xs sm:text-sm font-medium transition-all whitespace-nowrap flex items-center gap-1.5 shadow-sm" data-category="all">
                <Filter class="size-3.5" />
                All
                <span class="bg-white/20 px-1.5 py-0.5 rounded-full text-[10px]">{posts.length}</span>
              </button>
              {Object.entries(categoryConfig).map(([key, config]) => {
                if (!categoryCounts[key]) return null;
                const Icon = config.icon;
                return (
                  <button 
                    class="category-btn px-3.5 py-2 rounded-lg bg-card text-muted-foreground border border-border text-xs sm:text-sm font-medium hover:border-primary/30 hover:text-primary transition-all whitespace-nowrap flex items-center gap-1.5" 
                    data-category={key}
                  >
                    <Icon class="size-3.5" />
                    {config.label}
                    <span class="bg-neutral px-1.5 py-0.5 rounded-full text-[10px] text-muted-foreground">{categoryCounts[key]}</span>
                  </button>
                );
              })}
            </div>
          </section>

          <!-- Article Grid -->
          <section>
            <div class="flex items-center justify-between mb-4 sm:mb-5">
              <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wide">Latest Articles</h2>
              <span class="text-xs text-muted-foreground" id="article-count">{remainingPosts.length} articles</span>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5" id="news-grid">
              {remainingPosts.map((post) => {
                const config = categoryConfig[post.category] || categoryConfig.other;
                const Icon = config.icon;

                return (
                  <a
                    href={`/news/${post.slug}`}
                    class="news-card group flex flex-col bg-card rounded-xl shadow-sm border border-border hover:shadow-md hover:border-primary/20 transition-all overflow-hidden"
                    data-category={post.category}
                  >
                    {post.featuredImageUrl ? (
                      <div class="aspect-[16/10] bg-neutral overflow-hidden">
                        <img
                          src={post.featuredImageUrl}
                          alt={post.title}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                          loading="lazy"
                        />
                      </div>
                    ) : (
                      <div class={`aspect-[16/10] ${config.bg} flex items-center justify-center`}>
                        <Icon class="size-8 sm:size-10 opacity-20" />
                      </div>
                    )}
                    <div class="p-4 flex flex-col flex-1">
                      <div class="flex items-center gap-2 mb-2 flex-wrap">
                        <span class={`inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded font-semibold ${config.bg} ${config.color}`}>
                          <Icon class="size-3" />
                          {config.label}
                        </span>
                        <span class="text-[10px] text-muted-foreground flex items-center gap-1">
                          <Clock class="size-3" />
                          {formatDate(post.publishedAt || post._creationTime)}
                        </span>
                      </div>

                      <h3 class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors leading-snug mb-1.5 line-clamp-2">
                        {post.title}
                      </h3>

                      {post.excerpt && (
                        <p class="text-muted-foreground text-xs sm:text-sm leading-relaxed line-clamp-2 mb-3">
                          {post.excerpt}
                        </p>
                      )}

                      <div class="mt-auto flex items-center gap-1.5 text-xs font-semibold text-primary opacity-0 group-hover:opacity-100 transition-opacity">
                        Read more
                        <ArrowRight class="size-3 transition-transform group-hover:translate-x-0.5" />
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>

          <!-- About Feed -->
          <section class="mt-8 sm:mt-10 bg-card rounded-xl shadow-sm border border-border p-5 sm:p-6">
            <div class="flex items-center gap-2 mb-3">
              <Filter class="size-4 text-muted-foreground" />
              <h3 class="text-sm font-semibold text-foreground">About This Feed</h3>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Articles are automatically collected weekly from UK news sources including Google News, Guardian, Sky News, and local police reports.
              Each article is filtered for relevance, summarized on this site, and categorized by type. Full original sources are linked within each article.
            </p>
            <div class="mt-4 flex items-center gap-4 text-xs text-muted-foreground">
              <a href="/rss.xml" class="flex items-center gap-1.5 hover:text-primary transition-colors">
                <Rss class="size-3.5" />
                Subscribe via RSS
              </a>
              <span>&bull;</span>
              <span>{posts.length} total articles</span>
            </div>
          </section>
        </>
      )}
    </div>
  </main>

  <Footer />

  <script>
    const categoryBtns = document.querySelectorAll('.category-btn');
    const newsCards = document.querySelectorAll('.news-card');
    const articleCount = document.getElementById('article-count');

    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');

        categoryBtns.forEach(b => {
          b.classList.remove('active', 'bg-primary', 'text-white', 'shadow-sm');
          b.classList.add('bg-card', 'text-muted-foreground', 'border', 'border-border');
        });
        btn.classList.remove('bg-card', 'text-muted-foreground', 'border', 'border-border');
        btn.classList.add('active', 'bg-primary', 'text-white', 'shadow-sm');

        let visibleCount = 0;
        newsCards.forEach(card => {
          const cardCategory = card.getAttribute('data-category');
          if (category === 'all' || cardCategory === category) {
            (card as HTMLElement).style.display = '';
            visibleCount++;
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });

        if (articleCount) {
          articleCount.textContent = `${visibleCount} article${visibleCount !== 1 ? 's' : ''}`;
        }
      });
    });
  </script>
</Layout>
