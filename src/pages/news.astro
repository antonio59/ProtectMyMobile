---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import { getNewsPosts } from '../lib/convexData';
import type { NewsPost } from '../types/news';
import { Newspaper, ArrowRight, Gavel, Siren, ShieldAlert, TrendingUp, Lightbulb, FileText, Rss, Clock, Filter, Images } from 'lucide-react';
import { safetySlideSets } from '../data/scenarios';

let posts: NewsPost[] = [];
let error: unknown = null;
let lastUpdated: string | null = null;

try {
  posts = await getNewsPosts(true);
  if (posts.length > 0 && posts[0].publishedAt) {
    lastUpdated = new Date(posts[0].publishedAt).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    });
  }
} catch (e: unknown) {
  error = e;
  console.error('Error fetching news posts:', e);
}


// The feed carries two kinds of thing: syndicated news summaries, and our own
// safety slide sets. Both are entries, sorted by date, filterable by category.
type FeedEntry = {
  key: string;
  href: string;
  title: string;
  excerpt: string;
  category: string;
  date: string | number;
  sourceName?: string;
  isSlides: boolean;
  slideCount?: number;
};

const newsEntries: FeedEntry[] = posts.map((post) => ({
  key: `news-${post.slug}`,
  href: `/news/${post.slug}`,
  title: post.title,
  excerpt: post.excerpt || '',
  category: post.category,
  date: post.publishedAt || post._creationTime,
  sourceName: post.sourceName,
  isSlides: false,
}));

const slideEntries: FeedEntry[] = safetySlideSets.map((set) => ({
  key: `slides-${set.id}`,
  href: `/slides/${set.id}`,
  title: set.title,
  excerpt: set.summary,
  category: 'safety_slides',
  date: set.published,
  isSlides: true,
  slideCount: set.slides,
}));

const entries: FeedEntry[] = [...newsEntries, ...slideEntries].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);

const featuredPost = posts[0];
const remainingEntries = entries.filter((entry) => entry.key !== `news-${featuredPost?.slug}`);

const categoryCounts: Record<string, number> = {};
for (const entry of entries) {
  categoryCounts[entry.category] = (categoryCounts[entry.category] || 0) + 1;
}

const categoryConfig: Record<string, { color: string; bg: string; icon: any; label: string }> = {
  arrest:        { color: "text-destructive-hover", bg: "bg-destructive-subtle", icon: Siren,        label: "Arrests" },
  seizure:       { color: "text-foreground",          bg: "bg-neutral-100",     icon: ShieldAlert, label: "Seizures" },
  law_change:    { color: "text-foreground",         bg: "bg-neutral-100",            icon: Gavel,       label: "Law Changes" },
  statistics:    { color: "text-primary-hover",    bg: "bg-primary-subtle",     icon: TrendingUp,   label: "Statistics" },
  prevention_tip:{ color: "text-foreground",      bg: "bg-neutral-100",         icon: Lightbulb,    label: "Tips" },
  other:         { color: "text-muted-foreground", bg: "bg-neutral",            icon: FileText,     label: "News" },
  safety_slides: { color: "text-foreground",        bg: "bg-neutral-100",       icon: Images,       label: "Safety slides" },
};

function formatDate(dateValue: string | number) {
  const date = typeof dateValue === 'number' ? new Date(dateValue) : new Date(dateValue);
  const now = new Date();
  const diffDays = Math.floor((now.getTime() - date.getTime()) / (1000 * 60 * 60 * 24));
  if (diffDays === 0) return 'Today';
  if (diffDays === 1) return 'Yesterday';
  if (diffDays < 7) return `${diffDays} days ago`;
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
}

// Some scraped excerpts begin by repeating the article title; strip that prefix.
// Tries both the full title and the title without its " - Source" suffix.
function cleanExcerpt(excerpt?: string, title?: string): string {
  if (!excerpt) return '';
  if (!title) return excerpt;
  const variants = [title, title.replace(/\s[-|–—]\s[^-|–—]{1,40}$/, '')];
  for (const v of variants) {
    if (v && excerpt.toLowerCase().startsWith(v.toLowerCase())) {
      const rest = excerpt.slice(v.length).replace(/^[\s\-–—.:|]+/, '');
      // If what remains is just a truncated re-repeat of the title, drop it.
      if (rest && rest.length >= 20 && title.toLowerCase().startsWith(rest.replace(/…|\./g, '').trim().toLowerCase())) {
        return '';
      }
      return rest;
    }
  }
  return excerpt;
}

const newsSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "UK Mobile Theft News",
  "description": "Latest news on phone theft arrests, seizures, law changes, and prevention tips across the UK.",
  "url": "https://protectmymobile.xyz/news",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": posts.length,
    "itemListElement": posts.slice(0, 10).map((post, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": `https://protectmymobile.xyz/news/${post.slug}`,
      "name": post.title,
    }))
  }
};
---

<Layout
  title="Latest News & Updates | UK Mobile Theft | ProtectMyMobile"
  description={`Stay informed about mobile theft arrests, seizures, law changes, and prevention tips across the UK. ${posts.length} articles tracked.`}
  schema={newsSchema}
>
  <HeaderMobile client:idle />

  <main id="main-content" class="bg-background min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-6xl">

      <!-- Masthead -->
      <header class="border-b-[3px] border-foreground pb-4 mb-6 sm:mb-8">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-destructive mb-1">The wire</p>
            <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl text-foreground leading-none">News &amp; analysis</h1>
            <p class="text-muted-foreground text-sm sm:text-base mt-2 max-w-xl">
              UK phone theft in the news: arrests, seizures, policy moves and prevention advice, gathered from the national and local press.
            </p>
          </div>
          <div class="flex items-center gap-4 shrink-0 text-xs">
            {lastUpdated && (
              <span class="text-muted-foreground uppercase tracking-wide font-semibold">Updated {lastUpdated}</span>
            )}
            <a href="/rss.xml" class="inline-flex items-center gap-1.5 min-h-11 border-2 border-foreground rounded-lg px-3 py-1.5 font-bold uppercase tracking-wide hover:bg-foreground hover:text-background transition-colors">
              <Rss className="size-3.5" />
              RSS
            </a>
          </div>
        </div>
      </header>

      {error ? (
        <div class="border-2 border-destructive-muted bg-destructive-subtle p-6 rounded-xl">
          <p class="text-destructive-hover text-sm">Unable to load news right now. Please try again later.</p>
        </div>
      ) : entries.length === 0 ? (
        <div class="border-2 border-border p-10 sm:p-12 text-center rounded-xl">
          <h2 class="font-serif text-2xl text-foreground mb-2">Nothing on the wire yet</h2>
          <p class="text-muted-foreground text-sm max-w-md mx-auto">
            The feed is gathered weekly from UK news sources. Check back shortly, or
            <a href="/rss.xml" class="underline hover:text-destructive">subscribe by RSS</a> to get it as it lands.
          </p>
        </div>
      ) : (
        <>
          <!-- Filters -->
          <section class="mb-6 sm:mb-8">
            <div class="flex items-center gap-2 overflow-x-auto pb-1">
              <button class="category-btn active min-h-11 border-2 border-foreground bg-foreground text-background px-3 py-1.5 text-xs font-bold uppercase tracking-wide whitespace-nowrap transition-colors rounded-full" data-category="all">
                All <span class="opacity-60">{entries.length}</span>
              </button>
              {Object.entries(categoryConfig).map(([key, config]) => {
                if (!categoryCounts[key]) return null;
                return (
                  <button
                    class="category-btn min-h-11 border-2 border-foreground bg-background text-foreground px-3 py-1.5 text-xs font-bold uppercase tracking-wide whitespace-nowrap hover:bg-neutral-100 transition-colors rounded-full"
                    data-category={key}
                  >
                    {config.label} <span class="opacity-60">{categoryCounts[key]}</span>
                  </button>
                );
              })}
            </div>
          </section>

          <!-- Lead story -->
          {featuredPost && (
            <section class="mb-8 sm:mb-10 news-card" data-category={featuredPost.category}>
              <a href={`/news/${featuredPost.slug}`} class="group block border-b border-border pb-8">
                <div class="max-w-3xl">
                  <p class={`text-[11px] font-bold uppercase tracking-[0.18em] mb-2 ${featuredPost.category === 'arrest' ? 'text-destructive' : 'text-muted-foreground'}`}>
                    Lead &middot; {categoryConfig[featuredPost.category]?.label || 'News'}
                  </p>
                  <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl text-foreground leading-[1.12] group-hover:underline">
                    {featuredPost.title}
                  </h2>
                  {cleanExcerpt(featuredPost.excerpt, featuredPost.title) && (
                    <p class="text-base sm:text-lg text-neutral-700 leading-relaxed mt-3 max-w-2xl">
                      {cleanExcerpt(featuredPost.excerpt, featuredPost.title)}
                    </p>
                  )}
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mt-4 text-xs text-muted-foreground uppercase tracking-wide font-semibold">
                    <span>{formatDate(featuredPost.publishedAt || featuredPost._creationTime)}</span>
                    {featuredPost.sourceName && (<><span aria-hidden="true">&middot;</span><span>{featuredPost.sourceName}</span></>)}
                    <span aria-hidden="true">&middot;</span>
                    <span class="inline-flex items-center gap-1.5 text-foreground group-hover:gap-2.5 transition-all">
                      Read the story <ArrowRight className="size-3.5" />
                    </span>
                  </div>
                </div>
              </a>
            </section>
          )}

          <!-- The list -->
          <section>
            <div class="flex items-baseline justify-between border-b-[3px] border-foreground pb-2 mb-6">
              <h2 class="font-serif text-xl sm:text-2xl text-foreground">More stories and slides</h2>
              <span class="text-xs text-muted-foreground uppercase tracking-wide font-semibold" id="article-count">{remainingEntries.length} entries</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10" id="news-grid">
              {remainingEntries.map((entry) => {
                const config = categoryConfig[entry.category] || categoryConfig.other;
                const isUrgent = entry.category === 'arrest';
                return (
                  <a
                    href={entry.href}
                    class="news-card group block border-b border-border py-5 hover:bg-neutral-100 transition-colors"
                    data-category={entry.category}
                  >
                    <p class={`text-[10px] font-bold uppercase tracking-[0.16em] mb-1.5 ${isUrgent ? 'text-destructive' : 'text-muted-foreground'}`}>
                      {config.label}
                    </p>
                    <h3 class="font-serif text-lg sm:text-xl text-foreground leading-snug group-hover:underline">
                      {entry.title}
                    </h3>
                    {cleanExcerpt(entry.excerpt, entry.title) && (
                      <p class="text-sm text-muted-foreground leading-relaxed mt-1.5 line-clamp-2">{cleanExcerpt(entry.excerpt, entry.title)}</p>
                    )}
                    <div class="flex items-center gap-2 mt-2.5 text-[11px] text-muted-foreground uppercase tracking-wide font-semibold">
                      <span>{formatDate(entry.date)}</span>
                      {entry.sourceName && (<><span aria-hidden="true">&middot;</span><span>{entry.sourceName}</span></>)}
                      {entry.isSlides && (<><span aria-hidden="true">&middot;</span><span>{entry.slideCount} slides</span></>)}
                    </div>
                  </a>
                );
              })}
            </div>
          </section>

          <!-- Colophon -->
          <section class="mt-10 border-t-[3px] border-foreground pt-5">
            <h3 class="font-sans text-[11px] font-bold uppercase tracking-[0.18em] text-muted-foreground mb-2">About this feed</h3>
            <p class="text-sm text-neutral-700 leading-relaxed max-w-3xl">
              Stories are gathered weekly from UK news sources, filtered for relevance and summarised here.
              We do not republish other outlets' reporting in full: each entry is capped at a short summary, credits its source and links back to the original article.
              Safety slides are our own work, free to share.
            </p>
            <div class="mt-3 flex items-center gap-4 text-xs text-muted-foreground">
              <a href="/rss.xml" class="inline-flex items-center gap-1.5 font-semibold hover:text-destructive transition-colors">
                <Rss className="size-3.5" /> Subscribe by RSS
              </a>
              <span aria-hidden="true">&bull;</span>
              <span>{posts.length} articles tracked &middot; {safetySlideSets.length} slide sets</span>
            </div>
          </section>
        </>
      )}
    </div>
  </main>

  <Footer />

  <script>
    const categoryBtns = document.querySelectorAll('.category-btn');
    const newsCards = document.querySelectorAll('.news-card');
    const articleCount = document.getElementById('article-count');

    function applyCategory(category: string) {
      categoryBtns.forEach(b => {
        const isActive = b.getAttribute('data-category') === category;
        b.classList.toggle('active', isActive);
        b.classList.toggle('bg-foreground', isActive);
        b.classList.toggle('text-background', isActive);
        b.classList.toggle('bg-background', !isActive);
        b.classList.toggle('text-foreground', !isActive);
        b.setAttribute('aria-pressed', String(isActive));
      });

      let visibleCount = 0;
      newsCards.forEach(card => {
        const cardCategory = card.getAttribute('data-category');
        const show = category === 'all' || cardCategory === category;
        (card as HTMLElement).style.display = show ? '' : 'none';
        if (show) visibleCount++;
      });

      if (articleCount) {
        articleCount.textContent = `${visibleCount} entr${visibleCount !== 1 ? 'ies' : 'y'}`;
      }
    }

    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category') || 'all';
        applyCategory(category);
        const url = new URL(window.location.href);
        if (category === 'all') url.searchParams.delete('category');
        else url.searchParams.set('category', category);
        history.replaceState(null, '', url);
      });
    });

    // Honour ?category=... so /scenarios can redirect straight to the slides.
    const requested = new URLSearchParams(window.location.search).get('category');
    if (requested && document.querySelector(`.category-btn[data-category="${requested}"]`)) {
      applyCategory(requested);
    }
  </script>
</Layout>
