---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getNewsPosts } from '../lib/convexData';
import { Newspaper, Filter, AlertTriangle, ArrowRight, Calendar, Gavel, Siren, ShieldAlert, TrendingUp, Lightbulb, FileText, Rss, Clock, ExternalLink } from 'lucide-react';

interface NewsPost {
  _id: string;
  _creationTime: number;
  title: string;
  slug: string;
  excerpt?: string;
  content?: string;
  publishedAt?: number;
  category: string;
  sourceUrl?: string;
  sourceName?: string;
  imageUrl?: string;
  featuredImageUrl?: string;
  authorName?: string;
}

let posts: NewsPost[] = [];
let error: unknown = null;
let lastUpdated: string | null = null;

try {
  posts = await getNewsPosts(true);
  if (posts.length > 0 && posts[0].publishedAt) {
    lastUpdated = new Date(posts[0].publishedAt).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    });
  }
} catch (e: unknown) {
  error = e;
  console.error('Error fetching news posts:', e);
}

// Get featured post (most recent)
const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

// Count by category for stats
const categoryCounts: Record<string, number> = {};
for (const post of posts) {
  categoryCounts[post.category] = (categoryCounts[post.category] || 0) + 1;
}

const categoryConfig: Record<string, { color: string; bg: string; icon: any; gradient: string; label: string }> = {
  arrest: {
    color: "text-red-700",
    bg: "bg-red-50",
    icon: Siren,
    gradient: "from-red-500 to-red-600",
    label: "Arrests"
  },
  seizure: {
    color: "text-orange-700",
    bg: "bg-orange-50",
    icon: ShieldAlert,
    gradient: "from-orange-500 to-orange-600",
    label: "Seizures"
  },
  law_change: {
    color: "text-teal-700",
    bg: "bg-teal-50",
    icon: Gavel,
    gradient: "from-teal-500 to-teal-600",
    label: "Law Changes"
  },
  statistics: {
    color: "text-blue-700",
    bg: "bg-blue-50",
    icon: TrendingUp,
    gradient: "from-blue-500 to-blue-600",
    label: "Statistics"
  },
  prevention_tip: {
    color: "text-green-700",
    bg: "bg-green-50",
    icon: Lightbulb,
    gradient: "from-green-500 to-green-600",
    label: "Tips"
  },
  other: {
    color: "text-neutral-700",
    bg: "bg-neutral-50",
    icon: FileText,
    gradient: "from-neutral-500 to-neutral-600",
    label: "News"
  },
};

function formatDate(dateValue: string | number) {
  const date = typeof dateValue === 'number' ? new Date(dateValue) : new Date(dateValue);
  const now = new Date();
  const diffDays = Math.floor((now.getTime() - date.getTime()) / (1000 * 60 * 60 * 24));
  
  if (diffDays === 0) return 'Today';
  if (diffDays === 1) return 'Yesterday';
  if (diffDays < 7) return `${diffDays} days ago`;
  
  return date.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short'
  });
}

const newsSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "UK Mobile Theft News",
  "description": "Latest news on phone theft arrests, seizures, law changes, and prevention tips across the UK.",
  "url": "https://protectmymobile.xyz/news",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": posts.length,
    "itemListElement": posts.slice(0, 10).map((post, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": `https://protectmymobile.xyz/news/${post.slug}`,
      "name": post.title,
    }))
  }
};
---

<Layout
  title="Latest News & Updates - UK Mobile Theft | ProtectMyMobile"
  description={`Stay informed about mobile theft arrests, seizures, law changes, and prevention tips across the UK. ${posts.length} articles tracked.`}
  schema={newsSchema}
>
  <HeaderMobile client:idle />

  <main id="main-content" class="bg-[#f3f2f1] min-h-screen">
    <div class="container mx-auto px-4 py-4 sm:py-6 max-w-6xl">
      
      <Breadcrumb items={[{ label: 'News' }]} />

      <!-- Hero Section -->
      <div class="bg-gradient-to-br from-primary to-blue-700 text-white rounded-xl sm:rounded-2xl p-4 sm:p-6 md:p-8 mb-6 sm:mb-8 shadow-xl">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <Newspaper class="h-5 w-5 sm:h-6 sm:w-6" />
              <h1 class="text-xl sm:text-2xl md:text-3xl font-bold">News & Updates</h1>
            </div>
            <p class="text-blue-100 text-sm max-w-xl">
              The latest on mobile theft arrests, seizures, policy changes, and prevention tips from across the UK.
            </p>
          </div>
          <a href="/rss.xml" class="flex items-center gap-1.5 text-xs bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-full transition-colors shrink-0">
            <Rss class="h-3.5 w-3.5" />
            <span class="hidden sm:inline">RSS</span>
          </a>
        </div>
        
        {lastUpdated && (
          <div class="mt-4 pt-4 border-t border-white/20 flex items-center gap-2 text-xs text-blue-200">
            <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
            Last updated {lastUpdated}
          </div>
        )}
      </div>

      {error ? (
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 sm:p-6">
          <p class="text-yellow-800 text-sm sm:text-base">Unable to load news posts. Please try again later.</p>
        </div>
      ) : posts.length === 0 ? (
        <div class="bg-white rounded-xl sm:rounded-2xl shadow-md p-8 sm:p-12 text-center">
          <Newspaper class="h-12 w-12 mx-auto mb-3 text-neutral-400" />
          <h3 class="text-lg font-semibold mb-2">No News Posts Yet</h3>
          <p class="text-neutral-600 text-sm">
            Check back soon or subscribe to our <a href="/rss.xml" class="text-primary hover:underline">RSS feed</a>.
          </p>
        </div>
      ) : (
        <>
          {/* Featured Article */}
          {featuredPost && (
            <section class="mb-6 sm:mb-8">
              <h2 class="text-sm font-semibold text-neutral-500 uppercase tracking-wide mb-3">Featured</h2>
              <a
                href={featuredPost.sourceUrl || `/news/${featuredPost.slug}`}
                target={featuredPost.sourceUrl ? "_blank" : undefined}
                rel={featuredPost.sourceUrl ? "noopener noreferrer" : undefined}
                class="group block bg-white rounded-xl sm:rounded-2xl shadow-lg overflow-hidden border border-neutral-200 hover:border-primary/30 transition-all"
              >
                <div class={`h-1.5 w-full bg-gradient-to-r ${categoryConfig[featuredPost.category]?.gradient || 'from-primary to-blue-600'}`} />
                <div class="p-4 sm:p-6">
                  <div class="flex flex-col lg:flex-row lg:items-start gap-4 lg:gap-6">
                    <div class="flex-1">
                      <div class="flex items-center gap-2 mb-2">
                        <span class={`inline-flex items-center gap-1 text-[10px] sm:text-xs px-2 py-0.5 rounded-full font-medium ${categoryConfig[featuredPost.category]?.bg || 'bg-neutral-100'} ${categoryConfig[featuredPost.category]?.color || 'text-neutral-700'}`}>
                          {(categoryConfig[featuredPost.category]?.icon && <categoryConfig[featuredPost.category].icon className="h-3 w-3" />)}
                          {featuredPost.category.replace('_', ' ')}
                        </span>
                        <span class="text-xs text-neutral-400">{formatDate(featuredPost.publishedAt || featuredPost._creationTime)}</span>
                        {featuredPost.sourceName && (
                          <span class="text-xs text-neutral-400 flex items-center gap-1">
                            <ExternalLink class="h-3 w-3" />
                            {featuredPost.sourceName}
                          </span>
                        )}
                      </div>
                      <h3 class="text-lg sm:text-xl lg:text-2xl font-bold text-neutral-900 group-hover:text-primary transition-colors leading-tight mb-2">
                        {featuredPost.title}
                      </h3>
                      <p class="text-neutral-600 text-sm leading-relaxed line-clamp-2">
                        {featuredPost.excerpt}
                      </p>
                    </div>
                    <div class="flex items-center gap-1 text-sm font-semibold text-primary shrink-0 lg:pt-8">
                      {featuredPost.sourceUrl ? 'Read article' : 'Read more'}
                      <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" />
                    </div>
                  </div>
                </div>
              </a>
            </section>
          )}

          {/* Category Quick Filters */}
          <section class="mb-6">
            <div class="flex items-center gap-2 overflow-x-auto pb-2 -mx-1 px-1 sm:mx-0 sm:px-0 sm:flex-wrap scrollbar-hide">
              <button class="category-btn active px-3 py-1.5 rounded-full bg-primary text-white text-xs sm:text-sm font-medium transition-all whitespace-nowrap flex items-center gap-1.5" data-category="all">
                All <span class="bg-white/20 px-1.5 py-0.5 rounded-full text-[10px]">{posts.length}</span>
              </button>
              {Object.entries(categoryConfig).map(([key, config]) => {
                if (!categoryCounts[key]) return null;
                const Icon = config.icon;
                return (
                  <button 
                    class="category-btn px-3 py-1.5 rounded-full bg-white text-neutral-600 border border-neutral-200 text-xs sm:text-sm font-medium hover:border-primary/30 hover:text-primary transition-all whitespace-nowrap flex items-center gap-1.5" 
                    data-category={key}
                  >
                    <Icon className="h-3.5 w-3.5" />
                    {config.label}
                    <span class="bg-neutral-100 px-1.5 py-0.5 rounded-full text-[10px] text-neutral-500">{categoryCounts[key]}</span>
                  </button>
                );
              })}
            </div>
          </section>

          {/* Article Grid */}
          <section>
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-sm font-semibold text-neutral-500 uppercase tracking-wide">Latest Articles</h2>
              <span class="text-xs text-neutral-400" id="article-count">Showing {remainingPosts.length} articles</span>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="news-grid">
              {remainingPosts.map((post) => {
                const config = categoryConfig[post.category] || categoryConfig.other;
                const Icon = config.icon;
                const isExternal = !!post.sourceUrl;

                return (
                  <a
                    href={post.sourceUrl || `/news/${post.slug}`}
                    target={isExternal ? "_blank" : undefined}
                    rel={isExternal ? "noopener noreferrer" : undefined}
                    class="news-card group flex flex-col bg-white rounded-xl shadow-sm hover:shadow-md transition-all duration-200 border border-neutral-200 hover:border-primary/20 h-full"
                    data-category={post.category}
                  >
                    <div class="p-4 sm:p-5">
                      <div class="flex items-start justify-between gap-3 mb-2">
                        <span class={`inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-full font-medium ${config.bg} ${config.color}`}>
                          <Icon className="h-3 w-3" />
                          {config.label}
                        </span>
                        <div class="flex items-center gap-1 text-[10px] text-neutral-400">
                          <Clock class="h-3 w-3" />
                          {formatDate(post.publishedAt || post._creationTime)}
                        </div>
                      </div>

                      <h3 class="text-base sm:text-lg font-semibold text-neutral-900 group-hover:text-primary transition-colors leading-snug mb-2 line-clamp-2">
                        {post.title}
                      </h3>

                      <p class="text-neutral-600 text-sm leading-relaxed line-clamp-2 mb-3">
                        {post.excerpt}
                      </p>

                      <div class="flex items-center justify-between mt-auto pt-3 border-t border-neutral-100">
                        {post.sourceName ? (
                          <span class="text-xs text-neutral-400 flex items-center gap-1">
                            <ExternalLink class="h-3 w-3" />
                            {post.sourceName}
                          </span>
                        ) : (
                          <span class="text-xs text-primary font-medium">ProtectMyMobile</span>
                        )}
                        <ArrowRight class="h-4 w-4 text-neutral-300 group-hover:text-primary transition-colors" />
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>

          {/* About Feed */}
          <section class="mt-8 sm:mt-10 bg-white rounded-xl shadow-sm p-4 sm:p-6 border border-neutral-200">
            <div class="flex items-center gap-2 mb-3">
              <Filter class="h-4 w-4 text-neutral-400" />
              <h3 class="text-sm font-semibold text-neutral-700">About This Feed</h3>
            </div>
            <p class="text-sm text-neutral-600 leading-relaxed">
              Articles are automatically collected twice daily from 12+ UK news sources including BBC, Guardian, Sky News, and local police reports. 
              Each article is filtered for relevance and categorized by type. External articles link to their original source.
            </p>
            <div class="mt-4 flex items-center gap-4 text-xs text-neutral-500">
              <a href="/rss.xml" class="flex items-center gap-1.5 hover:text-primary transition-colors">
                <Rss class="h-3.5 w-3.5" />
                Subscribe via RSS
              </a>
              <span>&bull;</span>
              <span>{posts.length} total articles</span>
            </div>
          </section>
        </>
      )}
    </div>
  </main>

  <Footer />

  <script>
    // Category filter functionality
    const categoryBtns = document.querySelectorAll('.category-btn');
    const newsCards = document.querySelectorAll('.news-card');
    const articleCount = document.getElementById('article-count');

    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');

        // Update button styles
        categoryBtns.forEach(b => {
          b.classList.remove('active', 'bg-primary', 'text-white');
          b.classList.add('bg-white', 'text-neutral-600', 'border-neutral-200');
        });
        btn.classList.remove('bg-white', 'text-neutral-600', 'border-neutral-200');
        btn.classList.add('active', 'bg-primary', 'text-white');

        // Filter cards
        let visibleCount = 0;
        newsCards.forEach(card => {
          const cardCategory = card.getAttribute('data-category');
          if (category === 'all' || cardCategory === category) {
            (card as HTMLElement).style.display = '';
            visibleCount++;
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });

        if (articleCount) {
          articleCount.textContent = `Showing ${visibleCount} article${visibleCount !== 1 ? 's' : ''}`;
        }
      });
    });
  </script>
</Layout>
