---
import Layout from '../layouts/Layout.astro';
import HeaderMobile from '../components/HeaderMobile';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { MapPin, Shield, Info } from "lucide-react";
---

<Layout 
  title="UK Phone Theft Map | Report & View Stolen Phone Locations"
  description="See where phones are being stolen across the UK. Report your own theft anonymously to help others stay safe. Crowdsourced phone theft data with interactive map."
  canonicalPath="/theft-map"
>
  <HeaderMobile client:idle />
  <Breadcrumb items={[{ label: 'Theft Map' }]} />
  
  <main id="main-content" class="bg-neutral-100">
    <div class="container mx-auto px-4 py-4 sm:py-6 md:py-8">
      <div class="max-w-7xl mx-auto">
        
        <!-- Hero -->
        <div class="text-center mb-6 sm:mb-8">
          <h1 class="flex items-center justify-center text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold mb-4">
            <MapPin class="h-8 w-8 sm:h-10 sm:w-10 mr-3 text-destructive" />
            UK Phone Theft Map
          </h1>
          <p class="text-sm sm:text-base md:text-lg text-neutral-600 max-w-2xl mx-auto">
            See where phones are being stolen across the UK. Help others by 
            <a href="/emergency#report-theft" class="text-primary hover:underline font-medium">reporting your theft</a>.
          </p>
        </div>

        <!-- Stats Bar -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 mb-6 sm:mb-8">
          <div class="bg-card rounded-xl p-4 shadow-sm text-center">
            <div class="text-2xl sm:text-3xl font-bold text-destructive" id="stat-reported">-</div>
            <div class="text-xs sm:text-sm text-neutral-500">Reports</div>
          </div>
          <div class="bg-card rounded-xl p-4 shadow-sm text-center">
            <div class="text-2xl sm:text-3xl font-bold text-primary" id="stat-this-month">-</div>
            <div class="text-xs sm:text-sm text-neutral-500">This Month</div>
          </div>
          <div class="bg-card rounded-xl p-4 shadow-sm text-center">
            <div class="text-2xl sm:text-3xl font-bold text-warning" id="stat-london">-</div>
            <div class="text-xs sm:text-sm text-neutral-500">London Reports</div>
          </div>
          <div class="bg-card rounded-xl p-4 shadow-sm text-center">
            <div class="text-2xl sm:text-3xl font-bold text-green-600" id="stat-last-7">-</div>
            <div class="text-xs sm:text-sm text-neutral-500">Last 7 Days</div>
          </div>
        </div>

        <!-- Map Container -->
        <div class="bg-card rounded-xl shadow-md overflow-hidden mb-6 sm:mb-8 relative">
          <div id="theft-map" class="w-full h-[400px] sm:h-[500px] md:h-[600px]"></div>
          <div id="map-overlay" class="absolute inset-0 bg-white/90 flex items-center justify-center hidden z-[1000]">
            <div class="text-center px-4">
              <p class="text-neutral-600 font-medium">No reports yet.</p>
              <p class="text-sm text-neutral-500 mt-1">Be the first to <a href="/emergency#report-theft" class="text-primary underline">report a theft</a>.</p>
            </div>
          </div>
        </div>

        <!-- Info Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
          <div class="bg-primary-subtle rounded-xl p-4 sm:p-6 border border-blue-100">
            <h3 class="text-base sm:text-lg font-bold text-blue-900 mb-3 flex items-center">
              <Shield class="h-5 w-5 mr-2" />
              How This Helps
            </h3>
            <ul class="space-y-2 text-sm text-blue-800">
              <li class="flex items-start">
                <span class="mr-2">•</span>
                Identifies high-risk areas for phone theft
              </li>
              <li class="flex items-start">
                <span class="mr-2">•</span>
                Helps police allocate resources effectively
              </li>
              <li class="flex items-start">
                <span class="mr-2">•</span>
                Warns visitors and residents about local risks
              </li>
              <li class="flex items-start">
                <span class="mr-2">•</span>
                All reports are anonymous and manually verified
              </li>
            </ul>
          </div>

          <div class="bg-warning-subtle rounded-xl p-4 sm:p-6 border border-amber-100">
            <h3 class="text-base sm:text-lg font-bold text-amber-900 mb-3 flex items-center">
              <Info class="h-5 w-5 mr-2" />
              Data Notes
            </h3>
            <ul class="space-y-2 text-sm text-amber-800">
              <li class="flex items-start">
                <span class="mr-2">•</span>
                Reports appear after admin approval (within 24 hours)
              </li>
              <li class="flex items-start">
                <span class="mr-2">•</span>
                Locations are approximate to protect privacy
              </li>
              <li class="flex items-start">
                <span class="mr-2">•</span>
                Cross-referenced with police FOI response data where available
              </li>
              <li class="flex items-start">
                <span class="mr-2">•</span>
                <a href="/privacy" class="underline">Read our privacy policy</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin="" />

  <script>
    function loadScript(src: string): Promise<void> {
      return new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = src;
        s.onload = () => resolve();
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }

    async function initMap() {
      await loadScript('https://unpkg.com/leaflet@1.9.4/dist/leaflet.js');
      const L = (window as any).L;

      const map = L.map('theft-map').setView([54.5, -2.5], 6);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 18,
      }).addTo(map);

      const CONVEX_URL = (window as any).__CONVEX_URL || '';
      if (!CONVEX_URL) {
        document.getElementById('map-overlay')!.classList.remove('hidden');
        document.getElementById('map-overlay')!.innerHTML = 
          '<div class="text-center px-4"><p class="text-neutral-600 font-medium">Map data unavailable</p></div>';
        return;
      }

      try {
        // Load both crowdsourced reports and official FOI data points
        const [reportsRes, foiRes] = await Promise.all([
          fetch(`${CONVEX_URL}/api/query`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              path: 'theftReports:list',
              args: { approvedOnly: true },
            }),
          }),
          fetch(`${CONVEX_URL}/api/query`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              path: 'theftDataPoints:list',
              args: {},
            }),
          }),
        ]);

        const reportsJson = await reportsRes.json();
        const reports = reportsJson.value || [];

        const foiJson = await foiRes.json();
        const foiPoints = foiJson.value || [];

        // Update stats
        const now = new Date();
        const thisMonth = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0');
        const sevenDaysAgo = Date.now() - 7 * 24 * 60 * 60 * 1000;

        document.getElementById('stat-reported')!.textContent = String(reports.length);
        document.getElementById('stat-this-month')!.textContent = String(
          reports.filter((r: any) => r.theftDate?.startsWith(thisMonth)).length
        );
        document.getElementById('stat-london')!.textContent = String(
          reports.filter((r: any) => r.locationName?.toLowerCase().includes('london')).length
        );
        document.getElementById('stat-last-7')!.textContent = String(
          reports.filter((r: any) => r.createdAt > sevenDaysAgo).length
        );

        const markers: any[] = [];

        // Add FOI data points (blue, larger, lower opacity)
        foiPoints.forEach((p: any) => {
          if (p.latitude && p.longitude && p.theftCount > 0) {
            const radius = Math.min(20, Math.max(6, Math.sqrt(p.theftCount) * 1.5));
            const marker = L.circleMarker([p.latitude, p.longitude], {
              radius,
              fillColor: '#2563eb',
              color: '#fff',
              weight: 1,
              opacity: 0.6,
              fillOpacity: 0.35,
            }).addTo(map);

            marker.bindPopup(`
              <div class="font-sans">
                <p class="font-semibold text-sm">${p.locationName || 'Unknown'}</p>
                <p class="text-xs text-neutral-500">${p.date || ''}</p>
                <p class="text-xs text-primary mt-1 font-medium">${p.theftCount} thefts (police data)</p>
              </div>
            `);
            markers.push(marker);
          }
        });

        // Add crowdsourced reports (red, smaller, higher opacity)
        reports.forEach((r: any) => {
          if (r.latitude && r.longitude) {
            const marker = L.circleMarker([r.latitude, r.longitude], {
              radius: 8,
              fillColor: '#dc2626',
              color: '#fff',
              weight: 2,
              opacity: 1,
              fillOpacity: 0.7,
            }).addTo(map);

            const dateStr = r.theftDate 
              ? new Date(r.theftDate).toLocaleDateString('en-GB')
              : 'Date unknown';

            marker.bindPopup(`
              <div class="font-sans">
                <p class="font-semibold text-sm">${r.locationName || 'Unknown location'}</p>
                <p class="text-xs text-neutral-500">${dateStr}</p>
                ${r.description ? `<p class="text-xs mt-1">${r.description}</p>` : ''}
                <p class="text-xs text-destructive mt-1 font-medium">Crowdsourced report</p>
              </div>
            `);
            markers.push(marker);
          }
        });

        if (markers.length === 0) {
          document.getElementById('map-overlay')!.classList.remove('hidden');
          return;
        }

        const group = new L.featureGroup(markers);
        map.fitBounds(group.getBounds().pad(0.1));
      } catch (err) {
        console.error('Failed to load map data:', err);
        document.getElementById('map-overlay')!.classList.remove('hidden');
        document.getElementById('map-overlay')!.innerHTML = 
          '<div class="text-center px-4"><p class="text-neutral-600 font-medium">Unable to load map data</p><p class="text-sm text-neutral-500">Please try again later</p></div>';
      }
    }

    initMap();
  </script>
</Layout>
