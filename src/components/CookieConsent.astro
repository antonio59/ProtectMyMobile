<!-- Cookie consent — notice only (no analytics tracking) -->
<div id="cookie-consent" class="hidden fixed bottom-0 left-0 right-0 z-[100] bg-card border-t border-border shadow-2xl">
  <div class="container mx-auto max-w-6xl px-4 py-3">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <p class="text-sm text-muted-foreground">
        This site uses essential cookies to function. <a href="/privacy" class="text-primary hover:underline font-medium">Privacy policy</a>.
      </p>
      <button id="cookie-dismiss" class="min-h-11 px-4 py-1.5 text-sm font-medium text-foreground border border-border rounded-lg hover:bg-neutral transition-colors shrink-0">
        Got it
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const banner = document.getElementById('cookie-consent');
    const btn = document.getElementById('cookie-dismiss');
    if (!banner || !btn) return;

    if (localStorage.getItem('pmm_cookie_notice')) return;
    banner.classList.remove('hidden');

    btn.addEventListener('click', () => {
      localStorage.setItem('pmm_cookie_notice', '1');
      banner.classList.add('hidden');
    });
  })();
</script>
