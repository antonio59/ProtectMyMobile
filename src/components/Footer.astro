---
import { Heart, Shield, Smartphone, ChevronRight, Mail } from "lucide-react";
---

<footer class="bg-background border-t-[3px] border-foreground pt-8 sm:pt-12 pb-6" role="contentinfo">
  <div class="container mx-auto px-4">
    <!-- Top section with wordmark and tagline -->
    <div class="flex flex-col sm:flex-row justify-between items-center mb-6 sm:mb-10 gap-4">
      <div>
        <h2 class="font-serif text-xl sm:text-2xl font-bold text-foreground">ProtectMyMobile</h2>
        <p class="text-muted-foreground text-xs sm:text-sm uppercase tracking-[0.12em] font-semibold">Track the theft. Protect your phone.</p>
      </div>
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Ko-fi -->
        <a
          href="https://ko-fi.com/Z8Z21E3RHF"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-3 sm:px-4 py-2 border-2 border-foreground text-foreground font-bold uppercase tracking-wide hover:bg-foreground hover:text-background transition-colors text-xs sm:text-sm rounded-lg"
        >
          Buy me a coffee
        </a>
      </div>
    </div>

    <!-- Main footer content grid -->
    <nav class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 md:gap-8 py-6 sm:py-8 border-t border-b border-border" aria-label="Footer navigation">
      <div>
        <h4 class="font-bold text-base md:text-lg mb-3 flex items-center text-foreground">
          <Shield className="mr-2 size-4 md:size-5 text-primary" />
          Protection
        </h4>
        <ul class="space-y-2 md:space-y-3">
          <li>
            <a href="/prevention" class="text-muted-foreground hover:text-foreground transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="size-3 md:size-4 mr-1 text-primary" />
              Prevention Guide
            </a>
          </li>
          <li>
            <a href="/emergency" class="text-muted-foreground hover:text-foreground transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="size-3 md:size-4 mr-1 text-primary" />
              Emergency Actions
            </a>
          </li>
          <li>
            <a href="/security-checkup" class="text-muted-foreground hover:text-foreground transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="size-3 md:size-4 mr-1 text-primary" />
              Security Checkup
            </a>
          </li>
          <li>
            <a href="/products" class="text-muted-foreground hover:text-foreground transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="size-3 md:size-4 mr-1 text-primary" />
              Product Recommendations
            </a>
          </li>
        </ul>
      </div>
      
      <div>
        <h4 class="font-bold text-base md:text-lg mb-3 flex items-center text-foreground">
          <Smartphone className="mr-2 size-4 md:size-5 text-primary" />
          Directories
        </h4>
        <ul class="space-y-2 md:space-y-3">
          <li>
            <a href="/banks" class="text-muted-foreground hover:text-foreground transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="size-3 md:size-4 mr-1 text-primary" />
              Bank Directory
            </a>
          </li>
          <li>
            <a href="/mobile-providers" class="text-muted-foreground hover:text-foreground transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="size-3 md:size-4 mr-1 text-primary" />
              Mobile Providers
            </a>
          </li>
          <li>
            <a href="/statistics" class="text-muted-foreground hover:text-foreground transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="size-3 md:size-4 mr-1 text-primary" />
              Statistics
            </a>
          </li>
        </ul>
      </div>
      
      <div>
        <h4 class="font-bold text-base md:text-lg mb-3 flex items-center text-foreground">
          <Heart className="mr-2 size-4 md:size-5 text-primary" />
          Resources
        </h4>
        <ul class="space-y-2 md:space-y-3">
          <li>
            <a href="/the-problem" class="text-muted-foreground hover:text-foreground transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="size-3 md:size-4 mr-1 text-primary" />
              The Problem
            </a>
          </li>
          <li>
            <a href="/news?category=safety_slides" class="text-muted-foreground hover:text-foreground transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="size-3 md:size-4 mr-1 text-primary" />
              Safety slides
            </a>
          </li>
          <li>
            <a href="/resources" class="text-muted-foreground hover:text-foreground transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="size-3 md:size-4 mr-1 text-primary" />
              All Resources
            </a>
          </li>
          <li>
            <a href="/news" class="text-muted-foreground hover:text-foreground transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="size-3 md:size-4 mr-1 text-primary" />
              Latest News
            </a>
          </li>
          <li>
            <a href="/community-experiences" class="text-muted-foreground hover:text-foreground transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="size-3 md:size-4 mr-1 text-primary" />
              Community Experiences
            </a>
          </li>
          <li>
            <a href="/community-experiences#share" class="text-primary bg-primary-subtle hover:bg-primary-muted transition-colors duration-200 flex items-center text-sm md:text-base rounded-lg px-2 py-1 -ml-2">
              <ChevronRight className="size-3 md:size-4 mr-1" />
              Share Your Experience
            </a>
          </li>
        </ul>
      </div>
      
      <div>
        <h4 class="font-bold text-base md:text-lg mb-3 flex items-center text-foreground">
          <Mail className="mr-2 size-4 md:size-5 text-primary" />
          Contact
        </h4>
        <ul class="space-y-2 md:space-y-3">
          <li>
            <a href="/about" class="text-muted-foreground hover:text-foreground transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="size-3 md:size-4 mr-1 text-primary" />
              About
            </a>
          </li>
          <li>
            <a href="/contact-us" class="text-muted-foreground hover:text-foreground transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="size-3 md:size-4 mr-1 text-primary" />
              Contact Us
            </a>
          </li>
          <li>
            <a href="/privacy" class="text-muted-foreground hover:text-foreground transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="size-3 md:size-4 mr-1 text-primary" />
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms" class="text-muted-foreground hover:text-foreground transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="size-3 md:size-4 mr-1 text-primary" />
              Terms of Service
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <!-- Bottom section with copyright -->
    <div class="mt-8 text-center text-muted-foreground text-sm">
      <p>&copy; {new Date().getFullYear()} ProtectMyMobile. All rights reserved.</p>
    </div>
  </div>
</footer>
