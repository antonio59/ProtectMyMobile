---
import { Heart, Shield, Smartphone, ChevronRight, Mail } from "lucide-react";
---

<footer class="bg-gradient-to-b from-neutral-800 to-neutral-900 text-white pt-12 pb-6">
  <div class="container mx-auto px-4">
    <!-- Top section with logo and description -->
    <div class="flex flex-col md:flex-row justify-between items-center mb-10">
      <div class="flex items-center mb-6 md:mb-0">
        <svg class="h-12 w-12 mr-3" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <circle cx="50" cy="50" r="45" fill="#2563eb" opacity="0.2"/>
          <path d="M50 15 L30 30 L30 60 C30 70 40 80 50 85 C60 80 70 70 70 60 L70 30 Z" fill="#2563eb"/>
          <path d="M45 50 L42 53 L48 59 L58 45" stroke="white" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div>
          <h2 class="text-2xl font-bold text-white">ProtectMyMobile</h2>
          <p class="text-neutral-400 text-sm">Protecting UK mobile users since 2025</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <!-- Social Links -->
        <a 
          href="https://reddit.com/r/protectmymobile"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 bg-neutral-700 hover:bg-[#FF4500] rounded-lg transition-colors"
          aria-label="Reddit"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/>
          </svg>
        </a>
        <a 
          href="https://twitter.com/protectmymobile"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 bg-neutral-700 hover:bg-neutral-600 rounded-lg transition-colors"
          aria-label="Twitter/X"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <!-- Ko-fi -->
        <a 
          href="https://ko-fi.com/Z8Z21E3RHF"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-4 py-2 bg-[#FF5E5B] text-white rounded-md font-medium hover:bg-[#FF3D39] transition-colors shadow-sm"
        >
          <span class="mr-2">☕</span> Support Us
        </a>
      </div>
    </div>

    <!-- Main footer content grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 py-8 border-t border-b border-neutral-700">
      <div>
        <h4 class="font-bold text-base md:text-lg mb-3 flex items-center">
          <Shield className="mr-2 h-4 w-4 md:h-5 md:w-5 text-primary" />
          Protection
        </h4>
        <ul class="space-y-2 md:space-y-3">
          <li>
            <a href="/prevention" class="text-neutral-300 hover:text-white transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="h-3 w-3 md:h-4 md:w-4 mr-1 text-primary" />
              Prevention Guide
            </a>
          </li>
          <li>
            <a href="/emergency" class="text-neutral-300 hover:text-white transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="h-3 w-3 md:h-4 md:w-4 mr-1 text-primary" />
              Emergency Actions
            </a>
          </li>
          <li>
            <a href="/security-checkup" class="text-neutral-300 hover:text-white transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="h-3 w-3 md:h-4 md:w-4 mr-1 text-primary" />
              Security Checkup
            </a>
          </li>
          <li>
            <a href="/products" class="text-neutral-300 hover:text-white transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="h-3 w-3 md:h-4 md:w-4 mr-1 text-primary" />
              Product Recommendations
            </a>
          </li>
        </ul>
      </div>
      
      <div>
        <h4 class="font-bold text-base md:text-lg mb-3 flex items-center">
          <Smartphone className="mr-2 h-4 w-4 md:h-5 md:w-5 text-primary" />
          Directories
        </h4>
        <ul class="space-y-2 md:space-y-3">
          <li>
            <a href="/banks" class="text-neutral-300 hover:text-white transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="h-3 w-3 md:h-4 md:w-4 mr-1 text-primary" />
              Bank Directory
            </a>
          </li>
          <li>
            <a href="/mobile-providers" class="text-neutral-300 hover:text-white transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="h-3 w-3 md:h-4 md:w-4 mr-1 text-primary" />
              Mobile Providers
            </a>
          </li>
          <li>
            <a href="/statistics" class="text-neutral-300 hover:text-white transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="h-3 w-3 md:h-4 md:w-4 mr-1 text-primary" />
              Statistics
            </a>
          </li>
        </ul>
      </div>
      
      <div>
        <h4 class="font-bold text-base md:text-lg mb-3 flex items-center">
          <Heart className="mr-2 h-4 w-4 md:h-5 md:w-5 text-primary" />
          Resources
        </h4>
        <ul class="space-y-2 md:space-y-3">
          <li>
            <a href="/the-problem" class="text-neutral-300 hover:text-white transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="h-3 w-3 md:h-4 md:w-4 mr-1 text-primary" />
              The Problem
            </a>
          </li>
          <li>
            <a href="/scenarios" class="text-neutral-300 hover:text-white transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="h-3 w-3 md:h-4 md:w-4 mr-1 text-primary" />
              Scenarios Gallery
            </a>
          </li>
          <li>
            <a href="/resources" class="text-neutral-300 hover:text-white transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="h-3 w-3 md:h-4 md:w-4 mr-1 text-primary" />
              All Resources
            </a>
          </li>
          <li>
            <a href="/news" class="text-neutral-300 hover:text-white transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="h-3 w-3 md:h-4 md:w-4 mr-1 text-primary" />
              Latest News
            </a>
          </li>
          <li>
            <a href="/community-experiences" class="text-neutral-300 hover:text-white transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="h-3 w-3 md:h-4 md:w-4 mr-1 text-primary" />
              Community Experiences
            </a>
          </li>
        </ul>
      </div>
      
      <div>
        <h4 class="font-bold text-base md:text-lg mb-3 flex items-center">
          <Mail className="mr-2 h-4 w-4 md:h-5 md:w-5 text-primary" />
          Contact
        </h4>
        <ul class="space-y-2 md:space-y-3">
          <li>
            <a href="/about-us" class="text-neutral-300 hover:text-white transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="h-3 w-3 md:h-4 md:w-4 mr-1 text-primary" />
              About Us
            </a>
          </li>
          <li>
            <a href="/contact-us" class="text-neutral-300 hover:text-white transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="h-3 w-3 md:h-4 md:w-4 mr-1 text-primary" />
              Contact Us
            </a>
          </li>
          <li>
            <a href="/privacy" class="text-neutral-300 hover:text-white transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="h-3 w-3 md:h-4 md:w-4 mr-1 text-primary" />
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms" class="text-neutral-300 hover:text-white transition-colors duration-200 flex items-center text-sm md:text-base">
              <ChevronRight className="h-3 w-3 md:h-4 md:w-4 mr-1 text-primary" />
              Terms of Service
            </a>
          </li>
        </ul>
      </div>
    </div>
    
    <!-- Bottom section with copyright -->
    <div class="mt-8 text-center text-neutral-400 text-sm">
      <p>&copy; {new Date().getFullYear()} ProtectMyMobile. All rights reserved.</p>
    </div>
  </div>
</footer>
