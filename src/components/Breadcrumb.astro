---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-4 sm:mb-6">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-neutral-500" itemscope itemtype="https://schema.org/BreadcrumbList">
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="/" class="hover:text-primary transition-colors" itemprop="item">
        <span itemprop="name">Home</span>
      </a>
      <meta itemprop="position" content="1" />
    </li>
    {items.map((item, index) => (
      <>
        <li aria-hidden="true" class="text-neutral-300">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          {item.href ? (
            <a href={item.href} class="hover:text-primary transition-colors" itemprop="item">
              <span itemprop="name">{item.label}</span>
            </a>
          ) : (
            <span class="text-neutral-900 font-medium" itemprop="name" aria-current="page">{item.label}</span>
          )}
          <meta itemprop="position" content={String(index + 2)} />
        </li>
      </>
    ))}
  </ol>
</nav>
