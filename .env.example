# Local development
#
# Public build-time values live in `.env` (safe to expose — they are inlined
# into the client bundle):
PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional: Plausible site id. Defaults to the host of PUBLIC_SITE_URL
# (protectmymobile.org). Analytics only load in production builds.
PUBLIC_PLAUSIBLE_DOMAIN=

# Secrets go in `.dev.vars` (picked up by `wrangler dev`) — NEVER `.env`.
# Vite inlines import.meta.env at build time, so a secret in `.env` would be
# baked into dist/server and shipped to anyone who reads the bundle.
# In production set them with: pnpm wrangler secret put <NAME>
#
# CRON_SECRET=            # shared key for /api/cron/* and /api/admin/* routes
# ADMIN_PASSWORD=         # admin login form password
# ADMIN_JWT_SECRET=       # signs admin session cookies (independent, random)
# ADMIN_SESSION_VERSION=  # optional; bump to invalidate all admin sessions
# CONVEX_ADMIN_TOKEN=     # passed as adminToken to admin-gated Convex functions
# RESEND_API_KEY=         # Resend outbound mail
# BUILD_HOOK_URL=         # optional, POSTed after successful news fetches
# TYPESAFE_API_KEY=       # TypeSafe (Jev) news-judgment calls in fetch-news; unset = keyword fallback
