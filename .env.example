# Convex configuration
PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Resend configuration (for email notifications)
RESEND_API_KEY=your-resend-api-key

# Admin password (required for /admin access)
ADMIN_PASSWORD=your-secure-password

# Reddit Bot Configuration
# Create app at: https://www.reddit.com/prefs/apps (choose "script" type)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USERNAME=your-reddit-username
REDDIT_PASSWORD=your-reddit-password
REDDIT_SUBREDDIT=UKPhoneTheft
