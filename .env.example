# Local development
SENTRY_DSN=your_sentry_dsn_here

# Google Search Console: set to the bare verification string only
# (not a full HTML <meta> tag). Same on Netlify Site settings → Environment variables.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Production (Netlify): set SENTRY_DSN in Site settings → Environment variables
# Do NOT commit the real DSN to git.
