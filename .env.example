# Convex configuration
PUBLIC_CONVEX_URL=https://your-project.convex.cloud
CONVEX_URL=https://your-project.convex.cloud

# Shared secret for cron/admin API protection
CRON_SECRET=set-a-strong-random-string

# Resend configuration (for email notifications)
RESEND_API_KEY=your-resend-api-key

# Admin password (required for /admin access)
ADMIN_PASSWORD=your-secure-password


